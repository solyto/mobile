without a token it never fetches itself.\n52\t\t\tif (this.serverHasNoWidgets()) {\n53\t\t\t\tthis.post({ type: 'unsupported' });\n54\t\t\t\treturn;\n55\t\t\t}\n56\t\n57\t\t\ttry {\n58\t\t\t\tconst res = await this.apiService.postWithStatus(apiRoutes.auth.widgetToken, {});\n59\t\n60\t\t\t\tif (!res.ok) {\n61\t\t\t\t\tif (res.status === 404) {\n62\t\t\t\t\t\tthis.rememberServerHasNoWidgets();\n63\t\t\t\t\t\tthis.post({ type: 'unsupported' });\n64\t\t\t\t\t}\n65\t\t\t\t\treturn;\n66\t\t\t\t}\n67\t\n68\t\t\t\tconst data = res.data.data as WidgetTokenResponse;\n69\t\t\t\tthis.post({ type: 'setToken', token: data.token, expiresAt: data.token_expires_at, apiUrl: getApiUrl() });\n70\t\t\t} catch {\n71\t\t\t\t// Offline or throttled: the next trigger tries again.\n72\t\t\t}\n73\t\t}\n74\t\n75\t\tclear(): void {\n76\t\t\tthis.cancelRefresh();\n77\t\t\tthis.post({ type: 'clear' });\n78\t\t}\n79\t\n80\t\tnotifyChanged(): void {\n81\t\t\tif (!this.bridge()) return;\n82\t\n83\t\t\tthis.cancelRefresh();\n84\t\t\tthis.refreshTimer = setTimeout(() => {\n85\t\t\t\tthis.refreshTimer = null;\n86\t\t\t\tthis.post({ type: 'refresh' });\n87\t\t\t}, REFRESH_DEBOUNCE_MS);\n88\t\t}\n89\t\n90\t\tdestroy(): void {\n91\t\t\tthis.cancelRefresh();\n92\t\n93\t\t\tconst bridge = this.bridge();\n94\t\t\tif (bridge && this.started) bridge.onmessage = null;\n95\t\t\tthis.started = false;\n96\t\t}\n97\t\n98\t\tprivate bridge(): SolytoWidgetsBridge | null {\n99\t\t\tif (!IS_MOBILE || !browser) return null;\n100\t\t\treturn window.SolytoWidgets ?? null;\n101\t\t}\n102\t\n103\t\tprivate post(message: WidgetAppMessage): void {\n104\t\t\tthis.bridge()?.postMessage(JSON.stringify(message));\n105\t\t}\n106\t\n107\t\tprivate receive(data: unknown): void {\n108\t\t\tconst message = this.parse(data);\n109\t\t\tif (!message) return;\n110\t\n111\t\t\tif (message.type === 'status') {\n112\t\t\t\tif (message.needsToken && this.isLoggedIn()) void this.issueToken();\n113\t\t\t\treturn;\n114\t\t\t}\n115\t\n116\t\t\tthis.navigate(message.key, message.id);\n117\t\t}\n118\t\n119\t\tprivate parse(data: unknown): WidgetNativeMessage | null {\n120\t\t\tif (typeof data !== 'string') return null;\n121\t\n122\t\t\tlet message: unknown;\n123\t\t\ttry {\n124\t\t\t\tmessage = JSON.parse(data);\n125\t\t\t} catch {\n126\t\t\t\treturn null;\n127\t\t\t}\n128\t\t\tif (typeof message !== 'object' || message === null) return null;\n129\t\n130\t\t\tconst { type, needsToken, key, id } = message as Record<string, unknown>;\n131\t\n132\t\t\tif (type === 'status' && typeof needsToken === 'boolean') return { type, needsToken };\n133\t\t\tif (type === 'navigate' && typeof key === 'string' && (id === undefined || typeof id === 'string')) {\n134\t\t\t\treturn { type, key, id };\n135\t\t\t}\n136\t\n137\t\t\treturn null;\n138\t\t}\n139\t\n140\t\tprivate navigate(key: string, id: string | undefined): void {\n141\t\t\tif (!this.isLoggedIn()) return;\n142\t\n143\t\t\tif (key === 'todo' && id !== undefined && isUuid(id)) {\n144\t\t\t\t// eslint-disable-next-line svelte/no-navigation-without-resolve -- resolve() takes no query string\n145\t\t\t\tvoid goto(`${resolve(urls.todos)}?todo=${id}`);\n146\t\t\t} else if (key === 'calendar') {\n147\t\t\t\tvoid goto(resolve(urls.calendar));\n148\t\t\t} else if (key === 'time_tracking') {\n149\t\t\t\tvoid goto(resolve(urls.timeTracking));\n150\t\t\t} else if (key === 'time_tracking_project' && id !== undefined && isUuid(id)) {\n151\t\t\t\tvoid goto(resolve(urls.timeTrackingProject, { id }));\n152\t\t\t}\n153\t\t}\n154\t\n155\t\tprivate cancelRefresh(): void {\n156\t\t\tif (this.refreshTimer === null) return;\n157\t\n158\t\t\tclearTimeout(this.refreshTimer);\n159\t\t\tthis.refreshTimer = null;\n160\t\t}\n161\t\n162\t\tprivate serverHasNoWidgets(): boolean {\n163\t\t\tconst stored = this.localStorage.getJson(WidgetBridge.LS_UNSUPPORTED_SERVER_KEY) as Partial<UnsupportedServer> | null;\n164\t\t\treturn stored?.apiUrl === getApiUrl() && stored.version === this.apiService.stored