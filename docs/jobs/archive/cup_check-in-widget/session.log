{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DoYGKrzxy1vfswk5EMu3b2","type":"tool_result","content":"package app.solyto.widget;\n\nimport android.content.Context;\nimport android.content.pm.PackageManager;\nimport java.io.ByteArrayOutputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.net.HttpURLConnection;\nimport java.net.URL;\nimport java.nio.charset.StandardCharsets;\nimport org.json.JSONException;\nimport org.json.JSONObject;\n\n/**\n * Calls the widget routes with the widget token. Neither the token nor\n * response bodies are logged.\n */\nfinal class WidgetApi {\n\n    enum Outcome { OK, UNAUTHORIZED, NOT_FOUND, UPGRADE_REQUIRED, TEMPORARY_FAILURE }\n\n    static final class Result {\n        final Outcome outcome;\n        /** The envelope's `data` object; only set for {@link Outcome#OK}. */\n        final JSONObject data;\n\n        Result(Outcome outcome, JSONObject data) {\n            this.outcome = outcome;\n            this.data = data;\n        }\n    }\n\n    private static final String ACTIONS_PATH = \"/api/v1/widgets/actions/\";\n    private static final int TIMEOUT_MS = 15_000;\n    private static final int MAX_BODY_BYTES = 1024 * 1024;\n\n    private WidgetApi() {}\n\n    /** Fetches the kind's data from its widget route. */\n    static Result fetch(Context context, String apiUrl, String token, WidgetKind kind) {\n        HttpURLConnection connection = null;\n        try {\n            connection = open(context, apiUrl + kind.path, \"GET\", token);\n\n            int status = connection.getResponseCode();\n            if (status == 404) return new Result(Outcome.NOT_FOUND, null);\n            if (status != 200) return new Result(outcome(status), null);\n\n            JSONObject envelope = new JSONObject(readBody(connection.getInputStream()));\n            JSONObject data = envelope.optJSONObject(\"data\");\n            if (!envelope.optBoolean(\"success\", false) || data == null) {\n                return new Result(Outcome.TEMPORARY_FAILURE, null);\n            }\n            return new Result(Outcome.OK, data);\n        } catch (IOException | JSONException | RuntimeException e) {\n            return new Result(Outcome.TEMPORARY_FAILURE, null);\n        } finally {\n            if (connection != null) connection.disconnect();\n        }\n    }\n\n    /**\n     * Runs a row action: {@code POST /widgets/actions/{key}/{id}} without a\n     * body. 403 counts as {@link Outcome#NOT_FOUND}: the row is not the user's.\n     */\n    static Outcome postAction(Context context, String apiUrl, String token, String key, String id) {\n        if (!WidgetPayload.isValidActionKey(key) || !WidgetPayload.isValidRowId(id)) {\n            return Outcome.NOT_FOUND;\n        }\n        HttpURLConnection connection = null;\n        try {\n            connection = open(context, apiUrl + ACTIONS_PATH + key + \"/\" + id, \"POST\", token);\n            connection.setDoOutput(true);\n            connection.setFixedLengthStreamingMode(0);\n            connection.getOutputStream().close();\n\n            int status = connection.getResponseCode();\n            if (status == 200) return Outcome.OK;\n            if (status == 403 || status == 404) return Outcome.NOT_FOUND;\n            return outcome(status);\n        } catch (IOException | RuntimeException e) {\n            return Outcome.TEMPORARY_FAILURE;\n        } finally {\n            if (connection != null) connection.disconnect();\n        }\n    }\n\n    private static HttpURLConnection open(Context context, String url, String method, String token)\n            throws IOException {\n        HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();\n        connection.setRequestMethod(method);\n        connection.setConnectTimeout(TIMEOUT_MS);\n        connection.setReadTimeout(TIMEOUT_MS);\n        connection.setUseCaches(false);\n        // A redirect could carry the token to another host.\n        connection.setInstanceFollowRedirects(false);\n        connection.setRequestProperty(\"Authorization\", \"Bearer \" + token);\n        connection.setRequestProperty(\"Accept\", \"application/json\");\n        connection.setRequestProperty(\"X-Client-Version\", appVersion(context));\n        return connection;\n    }\n\n    /** The outcome of a status other than 200, 403 and 404. */\n    private static Outcome outcome(int status) {\n        if (status == 401) return Outcome.UNAUTHORIZED;\n        if (status == 426) return Outcome.UPGRADE_REQUIRED;\n        return Outcome.TEMPORARY_FAILURE;\n    }\n\n    private static String readBody(InputStream stream) throws IOException {\n        try (InputStream in = stream) {\n            ByteArrayOutputStream out = new ByteArrayOutputStream();\n            byte[] buffer = new byte[8192];\n            int read;\n            while ((read = in.read(buffer)) != -1) {\n                if (out.size() + read > MAX_BODY_BYTES) throw new IOException(\"Response too large\");\n                out.write(buffer, 0, read);\n            }\n            return new String(out.toByteArray(), StandardCharsets.UTF_8);\n        }\n    }\n\n    /** The versionName, which build-fdroid.sh sets from package.json, like the app's PUBLIC_VERSION. */\n    private static String appVersion(Context context) {\n        try {\n            String version = context.getPackageManager()\n                    .getPackageInfo(context.getPackageName(), 0).versionName;\n            return version != null ? version : \"\";\n        } catch (PackageManager.NameNotFoundException e) {\n            return \"\";\n        }\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport android.os.Build;\nimport androidx.work.BackoffPolicy;\nimport androidx.work.Data;\nimport androidx.work.ExistingPeriodicWorkPolicy;\nimport androidx.work.ExistingWorkPolicy;\nimport androidx.work.OneTimeWorkRequest;\nimport androidx.work.OutOfQuotaPolicy;\nimport androidx.work.PeriodicWorkRequest;\nimport androidx.work.WorkManager;\nimport java.util.concurrent.TimeUnit;\n\n/**\n * Schedules widget fetches and row actions. Work only exists while a widget\n * is placed. WorkManager stores input data unencrypted, so it never holds the\n * token: workers read it from {@link WidgetTokenStore}.\n */\npublic final class WidgetWork {\n\n    private static final String PERIODIC = \"widget-fetch-periodic\";\n    private static final String NOW = \"widget-fetch-now\";\n    private static final String AT_REFRESH = \"widget-fetch-at-refresh\";\n    private static final String ACTION_TAG = \"widget-action\";\n    private static final String ACTION_PREFIX = \"widget-action-\";\n\n    private static final long PERIOD_MINUTES = 60;\n    private static final long BACKOFF_MINUTES = 5;\n    // Fetch shortly after refresh_at (the next local midnight), not right at it.\n    private static final long REFRESH_AT_DELAY_MS = 60_000;\n\n    private WidgetWork() {}\n\n    /**\n     * Keeps the periodic fetch scheduled. Keeping a periodic job pending also\n     * stops WorkManager from toggling its components when all work is done,\n     * which would make launchers send another widget update.\n     */\n    static void schedulePeriodic(Context context) {\n        PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(\n                WidgetFetchWorker.class, PERIOD_MINUTES, TimeUnit.MINUTES)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n        WorkManager.getInstance(context).enqueueUniquePeriodicWork(\n                PERIODIC, ExistingPeriodicWorkPolicy.KEEP, request);\n    }\n\n    /** A fetch as soon as possible; a newer request replaces a pending one. */\n    public static void fetchNow(Context context) {\n        if (!WidgetKind.anyPlaced(context)) return;\n        WorkManager.getInstance(context).enqueueUniqueWork(NOW, ExistingWorkPolicy.REPLACE, oneTime(0));\n    }\n\n    /** A fetch at a kind's refresh_at (epoch millis). */\n    static void fetchAt(Context context, WidgetKind kind, long refreshAt) {\n        long delay = Math.max(0, refreshAt - System.currentTimeMillis()) + REFRESH_AT_DELAY_MS;\n        WorkManager.getInstance(context).enqueueUniqueWork(\n                atRefresh(kind), ExistingWorkPolicy.REPLACE, oneTime(delay));\n    }\n\n    /** Runs a row action once; while one is enqueued or running for this row, further requests are ignored. */\n    static void runAction(Context context, WidgetKind kind, String key, String id) {\n        OneTimeWorkRequest.Builder builder = new OneTimeWorkRequest.Builder(WidgetActionWorker.class)\n                .addTag(ACTION_TAG)\n                .setInputData(new Data.Builder()\n                        .putString(WidgetActionWorker.INPUT_KIND, kind.id)\n                        .putString(WidgetActionWorker.INPUT_KEY, key)\n                        .putString(WidgetActionWorker.INPUT_ID, id)\n                        .build());\n        // Below API 31, expedited work runs as a foreground service with a notification.\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {\n            builder.setExpedited(OutOfQuotaPolicy.RUN_AS_NON_EXPEDITED_WORK_REQUEST);\n        }\n        WorkManager.getInstance(context).enqueueUniqueWork(\n                ACTION_PREFIX + kind.id + \"-\" + id, ExistingWorkPolicy.KEEP, builder.build());\n    }\n\n    /** Called when a provider's last widget is removed: stops all work once no kind is placed. */\n    static void cancelIfNoWidgets(Context context) {\n        if (!WidgetKind.anyPlaced(context)) cancelAll(context);\n    }\n\n    private static void cancelAll(Context context) {\n        WorkManager workManager = WorkManager.getInstance(context);\n        workManager.cancelUniqueWork(PERIODIC);\n        workManager.cancelUniqueWork(NOW);\n        // AT_REFRESH alone is the name builds before widget kinds used.\n        workManager.cancelUniqueWork(AT_REFRESH);\n        for (WidgetKind kind : WidgetKind.values()) workManager.cancelUniqueWork(atRefresh(kind));\n        workManager.cancelAllWorkByTag(ACTION_TAG);\n    }\n\n    private static String atRefresh(WidgetKind kind) {\n        return AT_REFRESH + \"-\" + kind.id;\n    }\n\n    private static OneTimeWorkRequest oneTime(long delayMillis) {\n        return new OneTimeWorkRequest.Builder(WidgetFetchWorker.class)\n                .setInitialDelay(delayMillis, TimeUnit.MILLISECONDS)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport androidx.annotation.NonNull;\nimport androidx.work.Worker;\nimport androidx.work.WorkerParameters;\n\n/**\n * Runs one row action and applies the widget error contract. Failures are\n * not retried: the row is reverted and nothing is queued for later.\n */\npublic class WidgetActionWorker extends Worker {\n\n    static final String INPUT_KIND = \"kind\";\n    static final String INPUT_KEY = \"key\";\n    static final String INPUT_ID = \"id\";\n\n    public WidgetActionWorker(@NonNull Context context, @NonNull WorkerParameters params) {\n        super(context, params);\n    }\n\n    @NonNull\n    @Override\n    public Result doWork() {\n        Context context = getApplicationContext();\n        String kindId = getInputData().getString(INPUT_KIND);\n        // Actions enqueued by a build before widget kinds carry none; Your Day was the only kind then.\n        WidgetKind kind = kindId == null ? WidgetKind.YOUR_DAY : WidgetKind.fromId(kindId);\n        String key = getInputData().getString(INPUT_KEY);\n        String id = getInputData().getString(INPUT_ID);\n        if (kind == null || !WidgetPayload.isValidActionKey(key) || !WidgetPayload.isValidRowId(id)) {\n            return Result.success();\n        }\n\n        String token = WidgetTokenStore.readToken(context);\n        String apiUrl = WidgetTokenStore.apiUrl(context);\n        if (token == null || apiUrl == null) {\n            WidgetCache.clear(context);\n            WidgetKind.updateAll(context);\n            return Result.success();\n        }\n\n        WidgetApi.Outcome outcome = WidgetApi.postAction(context, apiUrl, token, key, id);\n\n        // A logout or a new token arrived during the request; its own handling wins.\n        if (!token.equals(WidgetTokenStore.readToken(context))) {\n            WidgetCache.revertAction(context, kind, id, false);\n            WidgetKind.updateAll(context);\n            return Result.success();\n        }\n\n        switch (outcome) {\n            case OK:\n            case NOT_FOUND:\n                // Done, or the row is gone: the re-fetch shows the server's state.\n                WidgetCache.finishAction(context, kind, id);\n                WidgetWork.fetchNow(context);\n                break;\n            case UNAUTHORIZED:\n                WidgetTokenStore.clearIfCurrent(context, token);\n                WidgetCache.clear(context);\n                break;\n            case UPGRADE_REQUIRED:\n                WidgetCache.revertAction(context, kind, id, false);\n                WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n                break;\n            default:\n                WidgetCache.revertAction(context, kind, id, true);\n        }\n\n        WidgetKind.updateAll(context);\n        return Result.success();\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.BroadcastReceiver;\nimport android.content.Context;\nimport android.content.Intent;\nimport app.solyto.MainActivity;\nimport org.json.JSONException;\nimport org.json.JSONObject;\n\n/**\n * Receives every tap on a widget list row: a list has a single click\n * template, so row taps (open a route) and checkbox or button taps (run an action) both\n * arrive here. Fill-in extras come from the launcher and are untrusted.\n */\npublic class WidgetActionReceiver extends BroadcastReceiver {\n\n    static final String ACTION_ROW_TAP = \"app.solyto.action.WIDGET_ROW_TAP\";\n    static final String EXTRA_ACTION_KIND = \"app.solyto.extra.WIDGET_ACTION_KIND\";\n    static final String EXTRA_ACTION_TYPE = \"app.solyto.extra.WIDGET_ACTION_TYPE\";\n    static final String EXTRA_ACTION_KEY = \"app.solyto.extra.WIDGET_ACTION_KEY\";\n    static final String EXTRA_ACTION_ID = \"app.solyto.extra.WIDGET_ACTION_ID\";\n\n    @Override\n    public void onReceive(Context context, Intent intent) {\n        if (intent == null || !ACTION_ROW_TAP.equals(intent.getAction())) return;\n\n        String kind;\n        String type;\n        String key;\n        String id;\n        String routeKey;\n        String routeId;\n        try {\n            kind = intent.getStringExtra(EXTRA_ACTION_KIND);\n            type = intent.getStringExtra(EXTRA_ACTION_TYPE);\n            key = intent.getStringExtra(EXTRA_ACTION_KEY);\n            id = intent.getStringExtra(EXTRA_ACTION_ID);\n            routeKey = intent.getStringExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY);\n            routeId = intent.getStringExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID);\n        } catch (RuntimeException e) {\n            // Malformed extras bundle.\n            return;\n        }\n\n        if (type != null) {\n            // On API 31+ the launcher already toggled the CheckBox locally; re-render to undo that.\n            if (!runAction(context, WidgetKind.fromId(kind), type, key, id)) WidgetKind.updateAll(context);\n        } else if (routeKey != null) {\n            openRoute(context, routeKey, routeId);\n        }\n    }\n\n    private static boolean runAction(Context context, WidgetKind kind, String type, String key, String id) {\n        boolean check = WidgetPayload.ACTION_CHECK.equals(type);\n        if (kind == null || !(check || WidgetPayload.ACTION_BUTTON.equals(type))) return false;\n        if (!WidgetPayload.isValidActionKey(key) || !WidgetPayload.isValidRowId(id)) return false;\n\n        // Only rows the widget currently shows with this action, and not already done.\n        if (WidgetCache.state(context) != WidgetCache.State.OK) return false;\n        WidgetPayload payload = cachedPayload(context, kind);\n        WidgetPayload.Item row = payload != null ? payload.findAction(type, key, id) : null;\n        if (row == null || (check && row.actionChecked)) return false;\n\n        // Repeated taps while a call is running are ignored.\n        if (!WidgetCache.startAction(context, kind, id)) return false;\n        kind.render(context);\n        WidgetWork.runAction(context, kind, key, id);\n        return true;\n    }\n\n    /** MainActivity validates the route again: it is exported and gets these extras from anywhere. */\n    private static void openRoute(Context context, String routeKey, String routeId) {\n        Intent open = new Intent(context, MainActivity.class)\n                .setAction(MainActivity.ACTION_WIDGET_ROUTE)\n                .putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, routeKey)\n                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);\n        if (routeId != null) open.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, routeId);\n        context.startActivity(open);\n    }\n\n    private static WidgetPayload cachedPayload(Context context, WidgetKind kind) {\n        String json = WidgetCache.payload(context, kind);\n        if (json == null) return null;\n        try {\n            return WidgetPayload.parse(new JSONObject(json), kind);\n        } catch (JSONException e) {\n            return null;\n        }\n    }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"dae5cf85-b4d2-45c7-b8d0-eb5aafd64190","uuid":"8fea453d-e375-4f6c-8b60-d45de8d6b392","timestamp":"2026-10-29T20:53:35.756Z","tool_use_result":{"stdout":"package app.solyto.widget;\n\nimport android.content.Context;\nimport android.content.pm.PackageManager;\nimport java.io.ByteArrayOutputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.net.HttpURLConnection;\nimport java.net.URL;\nimport java.nio.charset.StandardCharsets;\nimport org.json.JSONException;\nimport org.json.JSONObject;\n\n/**\n * Calls the widget routes with the widget token. Neither the token nor\n * response bodies are logged.\n */\nfinal class WidgetApi {\n\n    enum Outcome { OK, UNAUTHORIZED, NOT_FOUND, UPGRADE_REQUIRED, TEMPORARY_FAILURE }\n\n    static final class Result {\n        final Outcome outcome;\n        /** The envelope's `data` object; only set for {@link Outcome#OK}. */\n        final JSONObject data;\n\n        Result(Outcome outcome, JSONObject data) {\n            this.outcome = outcome;\n            this.data = data;\n        }\n    }\n\n    private static final String ACTIONS_PATH = \"/api/v1/widgets/actions/\";\n    private static final int TIMEOUT_MS = 15_000;\n    private static final int MAX_BODY_BYTES = 1024 * 1024;\n\n    private WidgetApi() {}\n\n    /** Fetches the kind's data from its widget route. */\n    static Result fetch(Context context, String apiUrl, String token, WidgetKind kind) {\n        HttpURLConnection connection = null;\n        try {\n            connection = open(context, apiUrl + kind.path, \"GET\", token);\n\n            int status = connection.getResponseCode();\n            if (status == 404) return new Result(Outcome.NOT_FOUND, null);\n            if (status != 200) return new Result(outcome(status), null);\n\n            JSONObject envelope = new JSONObject(readBody(connection.getInputStream()));\n            JSONObject data = envelope.optJSONObject(\"data\");\n            if (!envelope.optBoolean(\"success\", false) || data == null) {\n                return new Result(Outcome.TEMPORARY_FAILURE, null);\n            }\n            return new Result(Outcome.OK, data);\n        } catch (IOException | JSONException | RuntimeException e) {\n            return new Result(Outcome.TEMPORARY_FAILURE, null);\n        } finally {\n            if (connection != null) connection.disconnect();\n        }\n    }\n\n    /**\n     * Runs a row action: {@code POST /widgets/actions/{key}/{id}} without a\n     * body. 403 counts as {@link Outcome#NOT_FOUND}: the row is not the user's.\n     */\n    static Outcome postAction(Context context, String apiUrl, String token, String key, String id) {\n        if (!WidgetPayload.isValidActionKey(key) || !WidgetPayload.isValidRowId(id)) {\n            return Outcome.NOT_FOUND;\n        }\n        HttpURLConnection connection = null;\n        try {\n            connection = open(context, apiUrl + ACTIONS_PATH + key + \"/\" + id, \"POST\", token);\n            connection.setDoOutput(true);\n            connection.setFixedLengthStreamingMode(0);\n            connection.getOutputStream().close();\n\n            int status = connection.getResponseCode();\n            if (status == 200) return Outcome.OK;\n            if (status == 403 || status == 404) return Outcome.NOT_FOUND;\n            return outcome(status);\n        } catch (IOException | RuntimeException e) {\n            return Outcome.TEMPORARY_FAILURE;\n        } finally {\n            if (connection != null) connection.disconnect();\n        }\n    }\n\n    private static HttpURLConnection open(Context context, String url, String method, String token)\n            throws IOException {\n        HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();\n        connection.setRequestMethod(method);\n        connection.setConnectTimeout(TIMEOUT_MS);\n        connection.setReadTimeout(TIMEOUT_MS);\n        connection.setUseCaches(false);\n        // A redirect could carry the token to another host.\n        connection.setInstanceFollowRedirects(false);\n        connection.setRequestProperty(\"Authorization\", \"Bearer \" + token);\n        connection.setRequestProperty(\"Accept\", \"application/json\");\n        connection.setRequestProperty(\"X-Client-Version\", appVersion(context));\n        return connection;\n    }\n\n    /** The outcome of a status other than 200, 403 and 404. */\n    private static Outcome outcome(int status) {\n        if (status == 401) return Outcome.UNAUTHORIZED;\n        if (status == 426) return Outcome.UPGRADE_REQUIRED;\n        return Outcome.TEMPORARY_FAILURE;\n    }\n\n    private static String readBody(InputStream stream) throws IOException {\n        try (InputStream in = stream) {\n            ByteArrayOutputStream out = new ByteArrayOutputStream();\n            byte[] buffer = new byte[8192];\n            int read;\n            while ((read = in.read(buffer)) != -1) {\n                if (out.size() + read > MAX_BODY_BYTES) throw new IOException(\"Response too large\");\n                out.write(buffer, 0, read);\n            }\n            return new String(out.toByteArray(), StandardCharsets.UTF_8);\n        }\n    }\n\n    /** The versionName, which build-fdroid.sh sets from package.json, like the app's PUBLIC_VERSION. */\n    private static String appVersion(Context context) {\n        try {\n            String version = context.getPackageManager()\n                    .getPackageInfo(context.getPackageName(), 0).versionName;\n            return version != null ? version : \"\";\n        } catch (PackageManager.NameNotFoundException e) {\n            return \"\";\n        }\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport android.os.Build;\nimport androidx.work.BackoffPolicy;\nimport androidx.work.Data;\nimport androidx.work.ExistingPeriodicWorkPolicy;\nimport androidx.work.ExistingWorkPolicy;\nimport androidx.work.OneTimeWorkRequest;\nimport androidx.work.OutOfQuotaPolicy;\nimport androidx.work.PeriodicWorkRequest;\nimport androidx.work.WorkManager;\nimport java.util.concurrent.TimeUnit;\n\n/**\n * Schedules widget fetches and row actions. Work only exists while a widget\n * is placed. WorkManager stores input data unencrypted, so it never holds the\n * token: workers read it from {@link WidgetTokenStore}.\n */\npublic final class WidgetWork {\n\n    private static final String PERIODIC = \"widget-fetch-periodic\";\n    private static final String NOW = \"widget-fetch-now\";\n    private static final String AT_REFRESH = \"widget-fetch-at-refresh\";\n    private static final String ACTION_TAG = \"widget-action\";\n    private static final String ACTION_PREFIX = \"widget-action-\";\n\n    private static final long PERIOD_MINUTES = 60;\n    private static final long BACKOFF_MINUTES = 5;\n    // Fetch shortly after refresh_at (the next local midnight), not right at it.\n    private static final long REFRESH_AT_DELAY_MS = 60_000;\n\n    private WidgetWork() {}\n\n    /**\n     * Keeps the periodic fetch scheduled. Keeping a periodic job pending also\n     * stops WorkManager from toggling its components when all work is done,\n     * which would make launchers send another widget update.\n     */\n    static void schedulePeriodic(Context context) {\n        PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(\n                WidgetFetchWorker.class, PERIOD_MINUTES, TimeUnit.MINUTES)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n        WorkManager.getInstance(context).enqueueUniquePeriodicWork(\n                PERIODIC, ExistingPeriodicWorkPolicy.KEEP, request);\n    }\n\n    /** A fetch as soon as possible; a newer request replaces a pending one. */\n    public static void fetchNow(Context context) {\n        if (!WidgetKind.anyPlaced(context)) return;\n        WorkManager.getInstance(context).enqueueUniqueWork(NOW, ExistingWorkPolicy.REPLACE, oneTime(0));\n    }\n\n    /** A fetch at a kind's refresh_at (epoch millis). */\n    static void fetchAt(Context context, WidgetKind kind, long refreshAt) {\n        long delay = Math.max(0, refreshAt - System.currentTimeMillis()) + REFRESH_AT_DELAY_MS;\n        WorkManager.getInstance(context).enqueueUniqueWork(\n       