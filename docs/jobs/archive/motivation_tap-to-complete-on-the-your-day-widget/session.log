{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DQQ84mXNYwwY81k7adwhMh","type":"tool_result","content":"package app.solyto.widget;\n\nimport android.app.PendingIntent;\nimport android.appwidget.AppWidgetManager;\nimport android.appwidget.AppWidgetProvider;\nimport android.content.ComponentName;\nimport android.content.Context;\nimport android.content.Intent;\nimport android.os.Build;\nimport android.os.Bundle;\nimport android.text.format.DateFormat;\nimport android.view.View;\nimport android.widget.RemoteViews;\nimport androidx.core.widget.RemoteViewsCompat;\nimport app.solyto.MainActivity;\nimport app.solyto.R;\nimport java.util.Date;\nimport org.json.JSONException;\nimport org.json.JSONObject;\n\n/** The read-only \"Your Day\" list widget. Renders from {@link WidgetCache}. */\npublic class YourDayWidgetProvider extends AppWidgetProvider {\n\n    private static final int REQUEST_HEADER = 1;\n    private static final int REQUEST_ROW_TEMPLATE = 2;\n\n    @Override\n    public void onEnabled(Context context) {\n        WidgetWork.schedulePeriodic(context);\n    }\n\n    @Override\n    public void onDisabled(Context context) {\n        WidgetWork.cancelAll(context);\n    }\n\n    @Override\n    public void onUpdate(Context context, AppWidgetManager manager, int[] appWidgetIds) {\n        for (int id : appWidgetIds) render(context, manager, id);\n        WidgetWork.schedulePeriodic(context);\n        WidgetWork.fetchNow(context);\n    }\n\n    @Override\n    public void onAppWidgetOptionsChanged(Context context, AppWidgetManager manager, int appWidgetId,\n            Bundle newOptions) {\n        render(context, manager, appWidgetId);\n    }\n\n    public static boolean hasWidgets(Context context) {\n        return widgetIds(context).length > 0;\n    }\n\n    /** Re-renders every placed Your Day widget from the cache. */\n    public static void updateAll(Context context) {\n        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n        for (int id : widgetIds(context)) render(context, manager, id);\n    }\n\n    private static int[] widgetIds(Context context) {\n        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n        if (manager == null) return new int[0];\n        return manager.getAppWidgetIds(new ComponentName(context, YourDayWidgetProvider.class));\n    }\n\n    private static void render(Context context, AppWidgetManager manager, int appWidgetId) {\n        RemoteViews views = new RemoteViews(context.getPackageName(), R.layout.widget_your_day);\n        PendingIntent openApp = openAppIntent(context);\n        views.setOnClickPendingIntent(R.id.widget_header, openApp);\n        views.setOnClickPendingIntent(R.id.widget_message, openApp);\n        views.setPendingIntentTemplate(R.id.widget_list, rowTemplateIntent(context));\n\n        YourDayPayload payload = null;\n        String message;\n        WidgetCache.State state = WidgetCache.state(context);\n\n        if (WidgetCache.isDeviceUnsupported(context)) {\n            message = context.getString(R.string.widget_not_supported);\n        } else if (state == WidgetCache.State.OK) {\n            payload = parse(WidgetCache.payload(context));\n            message = payload == null\n                    ? context.getString(R.string.widget_update_app)\n                    : payload.emptyLabel != null ? payload.emptyLabel : \"\";\n        } else {\n            message = context.getString(stateMessage(state));\n        }\n\n        views.setTextViewText(R.id.widget_title, payload != null && payload.title != null\n                ? payload.title : context.getString(R.string.widget_your_day_name));\n        renderUpdatedAt(context, views, payload != null);\n\n        RemoteViewsCompat.RemoteCollectionItems.Builder items =\n                new RemoteViewsCompat.RemoteCollectionItems.Builder()\n                        .setHasStableIds(false)\n                        .setViewTypeCount(2);\n        boolean hasRows = payload != null && !payload.items.isEmpty();\n        if (hasRows) {\n            for (int i = 0; i < payload.items.size(); i++) {\n                items.addItem(i, itemView(context, payload.items.get(i)));\n            }\n        }\n        RemoteViewsCompat.setRemoteAdapter(context, views, appWidgetId, R.id.widget_list, items.build());\n\n        views.setViewVisibility(R.id.widget_list, hasRows ? View.VISIBLE : View.GONE);\n        views.setViewVisibility(R.id.widget_message, hasRows ? View.GONE : View.VISIBLE);\n        views.setTextViewText(R.id.widget_message, message);\n\n        manager.updateAppWidget(appWidgetId, views);\n    }\n\n    private static int stateMessage(WidgetCache.State state) {\n        switch (state) {\n            case SIGNED_OUT:\n                return R.string.widget_signed_out;\n            case UNSUPPORTED_SERVER:\n                return R.string.widget_unsupported_server;\n            case UPDATE_APP:\n                return R.string.widget_update_app;\n            default:\n                return R.string.widget_loading;\n        }\n    }\n\n    private static YourDayPayload parse(String json) {\n        if (json == null) return null;\n        try {\n            return YourDayPayload.parse(new JSONObject(json));\n        } catch (JSONException e) {\n            return null;\n        }\n    }\n\n    private static void renderUpdatedAt(Context context, RemoteViews views, boolean hasData) {\n        long fetchedAt = WidgetCache.fetchedAt(context);\n        if (!hasData || fetchedAt <= 0) {\n            views.setViewVisibility(R.id.widget_updated, View.GONE);\n            return;\n        }\n        String time = DateFormat.getTimeFormat(context).format(new Date(fetchedAt));\n        views.setTextViewText(R.id.widget_updated, context.getString(\n                WidgetCache.isOutdated(context) ? R.string.widget_outdated_at : R.string.widget_updated_at, time));\n        views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n    }\n\n    private static RemoteViews itemView(Context context, YourDayPayload.Item item) {\n        if (item.isHeader) {\n            RemoteViews header = new RemoteViews(context.getPackageName(), R.layout.widget_your_day_section);\n            header.setTextViewText(R.id.widget_section_title, item.title);\n            return header;\n        }\n\n        RemoteViews row = new RemoteViews(context.getPackageName(), R.layout.widget_your_day_row);\n        row.setTextViewText(R.id.widget_row_title, item.title);\n        setOptionalText(row, R.id.widget_row_subtitle, item.subtitle);\n        setOptionalText(row, R.id.widget_row_time, item.timeLabel);\n\n        int icon = iconResource(item.icon);\n        if (icon != 0) {\n            row.setImageViewResource(R.id.widget_row_icon, icon);\n            row.setViewVisibility(R.id.widget_row_icon, View.VISIBLE);\n        }\n\n        if (item.routeKey != null) {\n            Intent fillIn = new Intent().putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, item.routeKey);\n            if (item.routeId != null) fillIn.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, item.routeId);\n            row.setOnClickFillInIntent(R.id.widget_row, fillIn);\n        }\n        return row;\n    }\n\n    private static void setOptionalText(RemoteViews views, int viewId, String text) {\n        if (text == null) return;\n        views.setTextViewText(viewId, text);\n        views.setViewVisibility(viewId, View.VISIBLE);\n    }\n\n    private static int iconResource(String icon) {\n        if (\"event\".equals(icon)) return R.drawable.ic_widget_event;\n        if (\"todo\".equals(icon)) return R.drawable.ic_widget_todo;\n        return 0;\n    }\n\n    private static PendingIntent openAppIntent(Context context) {\n        Intent intent = new Intent(context, MainActivity.class)\n                .setAction(Intent.ACTION_MAIN)\n                .addCategory(Intent.CATEGORY_LAUNCHER);\n        return PendingIntent.getActivity(context, REQUEST_HEADER, intent,\n                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);\n    }\n\n    /** Collection rows need a mutable template; each row fills in its route. */\n    private static PendingIntent rowTemplateIntent(Context context) {\n        Intent intent = new Intent(context, MainActivity.class).setAction(MainActivity.ACTION_WIDGET_ROUTE);\n        int mutable = Build.VERSION.SDK_INT >= Build.VERSION_CODES.S ? PendingIntent.FLAG_MUTABLE : 0;\n        return PendingIntent.getActivity(context, REQUEST_ROW_TEMPLATE, intent,\n                PendingIntent.FLAG_UPDATE_CURRENT | mutable);\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport androidx.work.BackoffPolicy;\nimport androidx.work.ExistingPeriodicWorkPolicy;\nimport androidx.work.ExistingWorkPolicy;\nimport androidx.work.OneTimeWorkRequest;\nimport androidx.work.PeriodicWorkRequest;\nimport androidx.work.WorkManager;\nimport java.util.concurrent.TimeUnit;\n\n/**\n * Schedules widget fetches. Work only exists while a widget is placed. No\n * input data is passed: WorkManager stores it unencrypted, so the worker reads\n * the token from {@link WidgetTokenStore}.\n */\npublic final class WidgetWork {\n\n    private static final String PERIODIC = \"widget-fetch-periodic\";\n    private static final String NOW = \"widget-fetch-now\";\n    private static final String AT_REFRESH = \"widget-fetch-at-refresh\";\n\n    private static final long PERIOD_MINUTES = 60;\n    private static final long BACKOFF_MINUTES = 5;\n    // Fetch shortly after refresh_at (the next local midnight), not right at it.\n    private static final long REFRESH_AT_DELAY_MS = 60_000;\n\n    private WidgetWork() {}\n\n    /**\n     * Keeps the periodic fetch scheduled. Keeping a periodic job pending also\n     * stops WorkManager from toggling its components when all work is done,\n     * which would make launchers send another widget update.\n     */\n    static void schedulePeriodic(Context context) {\n        PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(\n                WidgetFetchWorker.class, PERIOD_MINUTES, TimeUnit.MINUTES)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n        WorkManager.getInstance(context).enqueueUniquePeriodicWork(\n                PERIODIC, ExistingPeriodicWorkPolicy.KEEP, request);\n    }\n\n    /** A fetch as soon as possible; a newer request replaces a pending one. */\n    public static void fetchNow(Context context) {\n        if (!YourDayWidgetProvider.hasWidgets(context)) return;\n        WorkManager.getInstance(context).enqueueUniqueWork(NOW, ExistingWorkPolicy.REPLACE, oneTime(0));\n    }\n\n    /** A fetch at the payload's refresh_at (epoch millis). */\n    static void fetchAt(Context context, long refreshAt) {\n        long delay = Math.max(0, refreshAt - System.currentTimeMillis()) + REFRESH_AT_DELAY_MS;\n        WorkManager.getInstance(context).enqueueUniqueWork(\n                AT_REFRESH, ExistingWorkPolicy.REPLACE, oneTime(delay));\n    }\n\n    static void cancelAll(Context context) {\n        WorkManager workManager = WorkManager.getInstance(context);\n        workManager.cancelUniqueWork(PERIODIC);\n        workManager.cancelUniqueWork(NOW);\n        workManager.cancelUniqueWork(AT_REFRESH);\n    }\n\n    private static OneTimeWorkRequest oneTime(long delayMillis) {\n        return new OneTimeWorkRequest.Builder(WidgetFetchWorker.class)\n                .setInitialDelay(delayMillis, TimeUnit.MILLISECONDS)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport androidx.annotation.NonNull;\nimport androidx.work.Worker;\nimport androidx.work.WorkerParameters;\n\n/** Fetches the Your Day data and applies the widget error contract. */\npublic class WidgetFetchWorker extends Worker {\n\n    // Further failures wait for the next periodic fetch.\n    private static final int MAX_RETRIES = 3;\n\n    public WidgetFetchWorker(@NonNull Context context, @NonNull WorkerParameters params) {\n        super(context, params);\n    }\n\n    @NonNull\n    @Override\n    public Result doWork() {\n        Context context = getApplicationContext();\n        if (!YourDayWidgetProvider.hasWidgets(context)) return Result.success();\n\n        String token = WidgetTokenStore.readToken(context);\n        String apiUrl = WidgetTokenStore.apiUrl(context);\n        if (token == null || apiUrl == null) {\n            WidgetCache.clear(context);\n            YourDayWidgetProvider.updateAll(context);\n            return Result.success();\n        }\n\n        WidgetApi.Result result = WidgetApi.fetchYourDay(context, apiUrl, token);\n\n        // A logout or a new token arrived during the request; its own handling wins.\n        if (!token.equals(WidgetTokenStore.readToken(context))) return Result.success();\n\n        Result workResult = Result.success();\n        switch (result.outcome) {\n            case OK:\n                if (YourDayPayload.isNewerSchema(result.data)) {\n                    WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n                    break;\n                }\n                YourDayPayload payload = YourDayPayload.parse(result.data);\n                if (payload == null) {\n                    workResult = failTemporarily(context);\n                    break;\n                }\n                WidgetCache.saveData(context, result.data.toString(), System.currentTimeMillis());\n                if (payload.refreshAt > 0) WidgetWork.fetchAt(context, payload.refreshAt);\n                break;\n            case UNAUTHORIZED:\n                WidgetTokenStore.clearIfCurrent(context, token);\n                WidgetCache.clear(context);\n                break;\n            case NOT_FOUND:\n                WidgetCache.setState(context, WidgetCache.State.UNSUPPORTED_SERVER);\n                break;\n            case UPGRADE_REQUIRED:\n                WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n                break;\n            default:\n                workResult = failTemporarily(context);\n        }\n\n        YourDayWidgetProvider.updateAll(context);\n        return workResult;\n    }\n\n    /** 429, 5xx, offline: keep the last data, mark it outdated and back off. */\n    private Result failTemporarily(Context context) {\n        WidgetCache.markOutdated(context);\n        return getRunAttemptCount() < MAX_RETRIES ? Result.retry() : Result.success();\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport android.content.SharedPreferences;\nimport android.net.Uri;\nimport android.security.keystore.KeyGenParameterSpec;\nimport android.security.keystore.KeyProperties;\nimport android.util.Base64;\nimport android.util.Log;\nimport java.nio.charset.StandardCharsets;\nimport java.security.GeneralSecurityException;\nimport java.security.KeyStore;\nimport java.util.Locale;\nimport javax.crypto.Cipher;\nimport javax.crypto.KeyGenerator;\nimport javax.crypto.SecretKey;\nimport javax.crypto.spec.GCMParameterSpec;\n\n/**\n * Keeps the widget token, encrypted with an AES-GCM key from the\n * AndroidKeyStore. Only the ciphertext, IV, expiry and API URL are written to\n * private SharedPreferences (excluded from backup). Every failure counts as\n * \"no token\"; the token is never stored in plain text and never logged.\n */\npublic final class WidgetTokenStore {\n\n    private static final String TAG = \"WidgetTokenStore\";\n\n    /** Prefs file name; the backup rules exclude {@code widget_token.xml}. */\n    static final String PREFS = \"widget_token\";\n\n    private static final String KEYSTORE = \"AndroidKeyStore\";\n    private static final String KEY_ALIAS = \"solyto_widget_token\";\n    private static final String TRANSFORMATION = \"AES/GCM/NoPadding\";\n    private static final int TAG_BITS = 128;\n    private static final int MAX_TOKEN_LENGTH = 4096;\n    private static final int MAX_URL_LENGTH = 2048;\n\n    private static final String KEY_CIPHERTEXT = \"ciphertext\";\n    private static final String KEY_IV = \"iv\";\n    private static final String KEY_EXPIRES_AT = \"expires_at\";\n    private static final String KEY_API_URL = \"api_url\";\n\n    private WidgetTokenStore() {}\n\n    /**\n     * Stores a token from the app. Returns false (and stores nothing) when the\n     * values are invalid or encryption fails.\n     */\n    public static synchronized boolean save(Context context, String token, String expiresAt, String apiUrl) {\n        if (token == null || token.isEmpty() || token.length() > MAX_TOKEN_LENGTH) return false;\n        long expiresAtMillis = IsoTime.parse(expiresAt);\n        if (expiresAtMillis <= System.currentTimeMillis()) return false;\n        String url = normalizeApiUrl(apiUrl);\n        if (url == null) return false;\n\n        try {\n            Cipher cipher = Cipher.getInstance(TRANSFORMATION);\n            cipher.init(Cipher.ENCRYPT_MODE, getOrCreateKey());\n            cipher.updateAAD(associatedData(expiresAtMillis, url));\n            byte[] ciphertext = cipher.doFinal(token.getBytes(StandardCharsets.UTF_8));\n\n            return prefs(context).edit()\n                    .putString(KEY_CIPHERTEXT, Base64.encodeToString(ciphertext, Base64.NO_WRAP))\n                    .putString(KEY_IV, Base64.encodeToString(cipher.getIV(), Base64.NO_WRAP))\n                    .putLong(KEY_EXPIRES_AT, expiresAtMillis)\n                    .putString(KEY_API_URL, url)\n                    .commit();\n        } catch (GeneralSecurityException | RuntimeException e) {\n            Log.w(TAG, \"Could not encrypt the widget token: \" + e.getClass().getSimpleName());\n            clear(context);\n            return false;\n        }\n    }\n\n    /** The token, or null when there is none, it has expired or cannot be decrypted. */\n    public static synchronized String readToken(Context context) {\n        SharedPreferences prefs = prefs(context);\n        String ciphertext = prefs.getString(KEY_CIPHERTEXT, null);\n        String iv = prefs.getString(KEY_IV, null);\n        String url = prefs.getString(KEY_API_URL, null);\n        long expiresAt = prefs.getLong(KEY_EXPIRES_AT, 0);\n        if (ciphertext == null || iv == null || url == null) return null;\n        if (expiresAt <= System.currentTimeMillis()) return null;\n\n        try {\n            KeyStore keyStore = KeyStore.getInstance(KEYSTORE);\n            keyStore.load(null);\n            SecretKey key = (SecretKey) keyStore.getKey(KEY_ALIAS, null);\n            if (key == null) {\n                clear(context);\n                return null;\n            }\n\n            Cipher cipher = Cipher.getInstance(TRANSFORMATION);\n            cipher.init(Cipher.DECRYPT_MODE, key,\n                    new GCMParameterSpec(TAG_BITS, Base64.decode(iv, Base64.NO_WRAP)));\n            cipher.updateAAD(associatedData(expiresAt, url));\n            byte[] token = cipher.doFinal(Base64.decode(ciphertext, Base64.NO_WRAP));\n            return new String(token, StandardCharsets.UTF_8);\n        } catch (Exception e) {\n            // Invalidated key, restored prefs without the key, tampered data.\n            Log.w(TAG, \"Stored widget token is unreadable: \" + e.getClass().getSimpleName());\n            clear(context);\n            return null;\n        }\n    }\n\n    /** The API URL from the last setToken, without a trailing slash, or null. */\n    public static synchronized String apiUrl(Context context) {\n        return prefs(context).getString(KEY_API_URL, null);\n    }\n\n    public static boolean needsToken(Context context) {\n        return readToken(context) == null;\n    }\n\n    public static synchronized void clear(Context context) {\n        prefs(context).edit().clear().commit();\n    }\n\n    /** Clears the store only if it still holds this token (a newer one may have arrived meanwhile). */\n    static synchronized void clearIfCurrent(Context context, String token) {\n        if (token.equals(readToken(context))) clear(context);\n    }\n\n    /** The bare server URL (http or https, with a host), without trailing slashes, or null. */\n    static String normalizeApiUrl(String apiUrl) {\n        if (apiUrl == null || apiUrl.isEmpty() || apiUrl.length() > MAX_URL_LENGTH) return null;\n        String url = apiUrl.trim();\n        while (url.endsWith(\"/\")) url = url.substring(0, url.length() - 1);\n\n        Uri uri = Uri.parse(url);\n        String scheme = uri.getScheme() == null ? \"\" : uri.getScheme().toLowerCase(Locale.ROOT);\n        if (!scheme.equals(\"https\") && !scheme.equals(\"http\")) return null;\n        if (uri.getHost() == null || uri.getHost().isEmpty()) return null;\n        if (uri.getQuery() != null || uri.getFragment() != null || uri.getUserInfo() != null) return null;\n        return url;\n    }\n\n    private static byte[] associatedData(long expiresAt, String url) {\n        return (expiresAt + \"\\n\" + url).getBytes(StandardCharsets.UTF_8);\n    }\n\n    private static SecretKey getOrCreateKey() throws GeneralSecurityException {\n        try {\n            KeyStore keyStore = KeyStore.getInstance(KEYSTORE);\n            keyStore.load(null);\n            SecretKey existing = (SecretKey) keyStore.getKey(KEY_ALIAS, null);\n            if (existing != null) return existing;\n        } catch (java.io.IOException e) {\n            throw new GeneralSecurityException(e);\n        }\n\n        KeyGenerator generator = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, KEYSTORE);\n        generator.init(new KeyGenParameterSpec.Builder(KEY_ALIAS,\n                KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)\n                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)\n                .setEncryptionPaddings(KeyProperties.ENCRYPTION