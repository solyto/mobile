ue instanceof String)) return null;\n        String s = ((String) value).trim();\n        if (s.isEmpty()) return null;\n        return s.length() > MAX_TEXT_LENGTH ? s.substring(0, MAX_TEXT_LENGTH) : s;\n    }\n}\n","numLines":188,"startLine":1,"totalLines":188}},"tool_result_meta":[{"id":"toolu_014hcdqcWhxwF2h3NJ82VvWN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
