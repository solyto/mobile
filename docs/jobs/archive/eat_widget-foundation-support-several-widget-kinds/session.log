\n54\t    /** Re-renders every placed Your Day widget from the cache. */\n55\t    public static void updateAll(Context context) {\n56\t        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n57\t        for (int id : widgetIds(context)) render(context, manager, id);\n58\t    }\n59\t\n60\t    private static int[] widgetIds(Context context) {\n61\t        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n62\t        if (manager == null) return new int[0];\n63\t        return manager.getAppWidgetIds(new ComponentName(context, YourDayWidgetProvider.class));\n64\t    }\n65\t\n66\t    private static void render(Context context, AppWidgetManager manager, int appWidgetId) {\n67\t        RemoteViews views = new RemoteViews(context.getPackageName(), R.layout.widget_your_day);\n68\t        PendingIntent openApp = openAppIntent(context);\n69\t        views.setOnClickPendingIntent(R.id.widget_header, openApp);\n70\t        views.setOnClickPendingIntent(R.id.widget_message, openApp);\n71\t        views.setPendingIntentTemplate(R.id.widget_list, rowTemplateIntent(context));\n72\t\n73\t        YourDayPayload payload = null;\n74\t        String message;\n75\t        WidgetCache.State state = WidgetCache.state(context);\n76\t\n77\t        if (WidgetCache.isDeviceUnsupported(context)) {\n78\t            message = context.getString(R.string.widget_not_supported);\n79\t        } else if (state == WidgetCache.State.OK) {\n80\t            payload = parse(WidgetCache.payload(context));\n81\t            message = payload == null\n82\t                    ? context.getString(R.string.widget_update_app)\n83\t                    : payload.emptyLabel != null ? payload.emptyLabel : \"\";\n84\t        } else if (state == WidgetCache.State.LOADING && WidgetCache.isOutdated(context)) {\n85\t            // A fetch failed before any data was cached: say so instead of \"Loading…\".\n86\t            message = context.getString(R.string.widget_load_failed);\n87\t        } else {\n88\t            message = context.getString(stateMessage(state));\n89\t        }\n90\t\n91\t        views.setTextViewText(R.id.widget_title, payload != null && payload.title != null\n92\t                ? payload.title : context.getString(R.string.widget_your_day_name));\n93\t        renderUpdatedAt(context, views, payload != null);\n94\t\n95\t        RemoteViewsCompat.RemoteCollectionItems.Builder items =\n96\t                new RemoteViewsCompat.RemoteCollectionItems.Builder()\n97\t                        .setHasStableIds(false)\n98\t                        .setViewTypeCount(2);\n99\t        boolean hasRows = payload != null && !payload.items.isEmpty();\n100\t        if (hasRows) {\n101\t            for (int i = 0; i < payload.items.size(); i++) {\n102\t                items.addItem(i, itemView(context, payload.items.get(i)));\n103\t            }\n104\t        }\n105\t        RemoteViewsCompat.setRemoteAdapter(context, views, appWidgetId, R.id.widget_list, items.build());\n106\t\n107\t        views.setViewVisibility(R.id.widget_list, hasRows ? View.VISIBLE : View.GONE);\n108\t        views.setViewVisibility(R.id.widget_message, hasRows ? View.GONE : View.VISIBLE);\n109\t        views.setTextViewText(R.id.widget_message, message);\n110\t\n111\t        manager.updateAppWidget(appWidgetId, views);\n112\t    }\n113\t\n114\t    private static int stateMessage(WidgetCache.State state) {\n115\t        switch (state) {\n116\t            case SIGNED_OUT:\n117\t                return R.string.widget_signed_out;\n118\t            case UNSUPPORTED_SERVER:\n119\t                return R.string.widget_unsupported_server;\n120\t            case UPDATE_APP:\n121\t                return R.string.widget_update_app;\n122\t            default:\n123\t                return R.string.widget_loading;\n124\t        }\n125\t    }\n126\t\n127\t    private static YourDayPayload parse(String json) {\n128\t        if (json == null) return null;\n129\t        try {\n130\t            return YourDayPayload.parse(new JSONObject(json));\n131\t        } catch (JSONException e) {\n132\t            return null;\n133\t        }\n134\t    }\n135\t\n136\t    private static void renderUpdatedAt(Context context, RemoteViews views, boolean hasData) {\n137\t        long fetchedAt = WidgetCache.fetchedAt(context);\n138\t        if (!hasData || fetchedAt <= 0) {\n139\t            views.setViewVisibility(R.id.widget_updated, View.GONE);\n140\t            return;\n141\t        }\n142\t        if (WidgetCache.hasActionError(context)) {\n143\t            views.setTextViewText(R.id.widget_updated, context.getString(R.string.widget_action_failed));\n144\t            views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n145\t            return;\n146\t        }\n147\t        String time = DateFormat.getTimeFormat(context).format(new Date(fetchedAt));\n148\t        views.setTextViewText(R.id.widget_updated, context.getString(\n149\t                WidgetCache.isOutdated(context) ? R.string.widget_outdated_at : R.string.widget_updated_at, time));\n150\t        views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n151\t    }\n152\t\n153\t    private static RemoteViews itemView(Context context, YourDayPayload.Item item) {\n154\t        if (item.isHeader) {\n155\t            RemoteViews header = new RemoteViews(context.getPackageName(), R.layout.widget_your_day_section);\n156\t            header.setTextViewText(R.id.widget_section_title, item.title);\n157\t            return header;\n158\t        }\n159\t\n160\t        RemoteViews row = new RemoteViews(context.getPackageName(), R.layout.widget_your_day_row);\n161\t        row.setTextViewText(R.id.widget_row_title, item.title);\n162\t        setOptionalText(row, R.id.widget_row_subtitle, item.subtitle);\n163\t        setOptionalText(row, R.id.widget_row_time, item.timeLabel);\n164\t\n165\t        int icon = iconResource(item.icon);\n166\t        if (item.actionType != null) {\n167\t            bindCheck(context, row, item);\n168\t            row.setViewVisibility(R.id.widget_row_icon, View.GONE);\n169\t        } else {\n170\t            row.setViewVisibility(R.id.widget_row_check, View.GONE);\n171\t            if (icon != 0) {\n172\t                row.setImageViewResource(R.id.widget_row_icon, icon);\n173\t                row.setViewVisibility(R.id.widget_row_icon, View.VISIBLE);\n174\t            } else {\n175\t                row.setViewVisibility(R.id.widget_row_icon, View.GONE);\n176\t            }\n177\t        }\n178\t\n179\t        if (item.routeKey != null) {\n180\t            Intent fillIn = new Intent().putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, item.routeKey);\n181\t            if (item.routeId != null) fillIn.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, item.routeId);\n182\t            row.setOnClickFillInIntent(R.id.widget_row, fillIn);\n183\t        }\n184\t        return row;\n185\t    }\n186\t\n187\t    /**\n188\t     * The row's checkbox: checked when the server says so or a local action\n189\t     * is active. On API 31+ the launcher toggles the CheckBox itself, so every\n190\t     * render sets its state explicitly; a reverted row is unchecked again.\n191\t     * The fill-in is always set, so a recycled list view never keeps another\n192\t     * row's; the receiver ignores taps on checked and active rows.\n193\t     */\n194\t    private static void bindCheck(Context context, RemoteViews row, YourDayPayload.Item item) {\n195\t        boolean checked = item.actionChecked || WidgetCache.isActionActive(context, item.id);\n196\t        Intent fillIn = new Intent()\n197\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_TYPE, item.actionType)\n198\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_KEY, item.actionKey)\n199\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_ID, item.id);\n200\t\n201\t        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {\n202\t            row.setCompoundButtonChecked(R.id.widget_row_check, checked);\n203\t            row.setBoolean(R.id.widget_row_check, \"setEnabled\", !checked);\n204\t            row.setOnCheckedChangeResponse(R.id.widget_row_check,\n205\t                    RemoteViews.RemoteResponse.fromFillInIntent(fillIn));\n206\t        } else {\n207\t            row.setImageViewResource(R.id.widget_row_check,\n208\t                    checked ? R.drawable.ic_widget_check_on : R.drawable.ic_widget_todo);\n209\t            row.setOnClickFillInIntent(R.id.widget_row_check, fillIn);\n210\t        }\n211\t        row.setContentDescription(R.id.widget_row_check, context.getString(R.string.widget_action_check));\n212\t        row.setViewVisibility(R.id.widget_row_check, View.VISIBLE);\n213\t    }\n214\t\n215\t    // Always sets visibility: the list reapplies row views to recycled views,\n216\t    // so a row without this text would otherwise keep a previous row's.\n217\t    private static void setOptionalText(RemoteViews views, int viewId, String text) {\n218\t        if (text == null) {\n219\t            views.setViewVisibility(viewId, View.GONE);\n220\t            return;\n221\t        }\n222\t        views.setTextViewText(viewId, text);\n223\t        views.setViewVisibility(viewId, View.VISIBLE);\n224\t    }\n225\t\n226\t    private static int iconResource(String icon) {\n227\t        if (\"event\".equals(icon)) return R.drawable.ic_widget_event;\n228\t        if (\"todo\".equals(icon)) return R.drawable.ic_widget_todo;\n229\t        return 0;\n230\t    }\n231\t\n232\t    private static PendingIntent openAppIntent(Context context) {\n233\t        Intent intent = new Intent(context, MainActivity.class)\n234\t                .setAction(Intent.ACTION_MAIN)\n235\t                .addCategory(Intent.CATEGORY_LAUNCHER);\n236\t        return PendingIntent.getActivity(context, REQUEST_HEADER, intent,\n237\t                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);\n238\t    }\n239\t\n240\t    /**\n241\t     * Collection rows need a mutable template; each row fills in its route or\n242\t     * action. All row taps go to {@link WidgetActionReceiver}, which opens routes itself.\n243\t     */\n244\t    private static PendingIntent rowTemplateIntent(Context context) {\n245\t        Intent intent = new Intent(context, WidgetActionReceiver.class)\n246\t                .setAction(WidgetActionReceiver.ACTION_ROW_TAP);\n247\t        int mutable = Build.VERSION.SDK_INT >= Build.VERSION_CODES.S ? PendingIntent.FLAG_MUTABLE : 0;\n248\t        return PendingIntent.getBroadcast(context, REQUEST_ROW_TEMPLATE, intent,\n249\t                PendingIntent.FLAG_UPDATE_CURRENT | mutable);\n250\t    }\n251\t}\n252\t"}]},"parent_tool_use_id":null,"session_id":"7d08818e-a718-4681-9dcb-edc4bb179adb","uuid":"a97e2ea5-828e-4b8f-9611-8ac48912fb9d","timestamp":"2026-10-29T19:50:17.185Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/android/app/src/main/java/app/solyto/widget/YourDayWidgetProvider.java","content":"package app.solyto.widget;\n\nimport android.app.PendingIntent;\nimport android.appwidget.AppWidgetManager;\nimport android.appwidget.AppWidgetProvider;\nimport android.content.ComponentName;\nimport android.content.Context;\nimport android.content.Intent;\nimport android.os.Build;\nimport android.os.Bundle;\nimport android.text.format.DateFormat;\nimport android.view.View;\nimport android.widget.RemoteViews;\nimport androidx.core.widget.RemoteViewsCompat;\nimport app.solyto.MainActivity;\nimport app.solyto.R;\nimport java.util.Date;\nimport org.json.JSONException;\nimport org.json.JSONObject;\n\n/** The \"Your Day\" list widget. Renders from {@link WidgetCache}. */\npublic class YourDayWidgetProvider extends AppWidgetProvider {\n\n    private static final int REQUEST_HEADER = 1;\n    private static final int REQUEST_ROW_TEMPLATE = 2;\n\n    @Override\n    public void onEnabled(Context context) {\n        WidgetWork.schedulePeriodic(context);\n    }\n\n    @Override\n    public void onDisabled(Context context) {\n        WidgetWork.cancelAll(context);\n    }\n\n    @Override\n    public void onUpdate(Context context, AppWidgetManager manager, int[] appWidgetIds) {\n        for (int id : appWidgetIds) render(context, manager, id);\n        WidgetWork.schedulePeriodic(context);\n        WidgetWork.fetchNow(context);\n    }\n\n    @Override\n    public void onAppWidgetOptionsChanged(Context context, AppWidgetManager manager, int appWidgetId,\n            Bundle newOptions) {\n        render(context, manager, appWidgetId);\n    }\n\n    public static boolean hasWidgets(Context context) {\n        return widgetIds(context).length > 0;\n    }\n\n    /** Re-renders every placed Your Day widget from the cache. */\n    public static void updateAll(Context context) {\n        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n        for (int id : widgetIds(context)) render(context, manager, id);\n    }\n\n    private static int[] widgetIds(Context context) {\n        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n        if (manager == null) return new int[0];\n        return manager.getAppWidgetIds(new ComponentName(context, YourDayWidgetProvider.class));\n    }\n\n    private static void render(Context context, AppWidgetManager manager, int appWidgetId) {\n        RemoteViews views = new RemoteViews(context.getPackageName(), R.layout.widget_your_day);\n        PendingIntent openApp = openAppIntent(context);\n        views.setOnClickPendingIntent(R.id.widget_header, openApp);\n        views.setOnClickPendingIntent(R.id.widget_message, openApp);\n        views.setPendingIntentTemplate(R.id.widget_list, rowTemplateIntent(context));\n\n        YourDayPayload payload = null;\n        String message;\n        WidgetCache.State state = WidgetCache.state(context);\n\n        if (WidgetCache.isDeviceUnsupported(context)) {\n            message = context.getString(R.string.widget_not_supported);\n        } else if (state == WidgetCache.State.OK) {\n            payload = parse(WidgetCache.payload(context));\n            message = payload == null\n                    ? context.getString(R.string.widget_update_app)\n                    : payload.emptyLabel != null ? payload.emptyLabel : \"\";\n        } else if (state == WidgetCache.State.LOADING && WidgetCache.isOutdated(context)) {\n            // A fetch failed before any data was cached: say so instead of \"Loading…\".\n            message = context.getString(R.string.widget_load_failed);\n        } else {\n            message = context.getString(stateMessage(state));\n        }\n\n        views.setTextViewText(R.id.widget_title, payload != null && payload.title != null\n                ? payload.title : context.getString(R.string.widget_your_day_name));\n        renderUpdatedAt(context, views, payload != null);\n\n        RemoteViewsCompat.RemoteCollectionItems.Builder items =\n                new RemoteViewsCompat.RemoteCollectionItems.Builder()\n                        .setHasStableIds(false)\n                        .setViewTypeCount(2);\n        boolean hasRows = payload != null && !payload.items.isEmpty();\n        if (hasRows) {\n            for (int i = 0; i < payload.items.size(); i++) {\n                items.addItem(i, itemView(context, payload.items.get(i)));\n            }\n        }\n        RemoteViewsCompat.setRemoteAdapter(context, views, appWidgetId, R.id.widget_list, items.build());\n\n        views.setViewVisibility(R.id.widget_list, hasRows ? View.VISIBLE : View.GONE);\n        views.setViewVisibility(R.id.widget_message, hasRows ? View.GONE : View.VISIBLE);\n        views.setTextViewText(R.id.widget_message, message);\n\n        manager.updateAppWidget(appWidgetId, views);\n    }\n\n    private static int stateMessage(WidgetCache.State state) {\n        switch (state) {\n            case SIGNED_OUT:\n                return R.string.widget_signed_out;\n            case UNSUPPORTED_SERVER:\n                return R.string.widget_unsupported_server;\n            case UPDATE_APP:\n                return R.string.widget_update_app;\n            default:\n                return R.string.widget_loading;\n        }\n    }\n\n    private static YourDayPayload parse(String json) {\n        if (json == null) return null;\n        try {\n            return YourDayPayload.parse(new JSONObject(json));\n        } catch (JSONException e) {\n            return null;\n        }\n    }\n\n    private static void renderUpdatedAt(Context context, RemoteViews views, boolean hasData) {\n        long fetchedAt = WidgetCache.fetchedAt(context);\n        if (!hasData || fetchedAt <= 0) {\n            views.setViewVisibility(R.id.widget_updated, View.GONE);\n            return;\n        }\n        if (WidgetCache.hasActionError(context)) {\n            views.setTextViewText(R.id.widget_updated, context.getString(R.string.widget_action_failed));\n            views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n            return;\n        }\n        String time = DateFormat.getTimeFormat(context).format(new Date(fetchedAt));\n        views.setTextViewText(R.id.widget_updated, context.getString(\n                WidgetCache.isOutdated(context) ? R.string.widget_outdated_at : R.string.widget_updated_at, time));\n        views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n    }\n\n    private static RemoteViews itemView(Context context, YourDayPayload.Item item) {\n        if (item.isHeader) {\n            RemoteViews header = new RemoteViews(context.getPackageName(), R.layout.widget_your_day_section);\n            header.setTextViewText(R.id.widget_section_title, item.title);\n            return header;\n        }\n\n        RemoteViews row = new RemoteViews(context.getPackageName(), R.layout.widget_your_day_row);\n        row.setTextViewText(R.id.widget_row_title, item.title);\n        setOptionalText(row, R.id.widget_row_subtitle, item.subtitle);\n        setOptionalText(row, R.id.widget_row_time, item.timeLabel);\n\n        int icon = iconResource(item.icon);\n        if (item.actionType != null) {\n            bindCheck(context, row, item);\n            row.setViewVisibility(R.id.widget_row_icon, View.GONE);\n        } else {\n            row.setViewVisibility(R.id.widget_row_check, View.GONE);\n            if (icon != 0) {\n                row.setImageViewResource(R.id.widget_row_icon, icon);\n                row.setViewVisibility(R.id.widget_row_icon, View.VISIBLE);\n            } else {\n                row.setViewVisibility(R.id.widget_row_icon, View.GONE);\n            }\n        }\n\n        if (item.routeKey != null) {\n            Intent fillIn = new Intent().putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, item.routeKey);\n            if (item.routeId != null) fillIn.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, item.routeId);\n            row.setOnClickFillInIntent(R.id.widget_row, fillIn);\n        }\n        return row;\n    }\n\n    /**\n     * The row's checkbox: checked when the server says so or a local action\n     * is active. On API 31+ the launcher toggles the CheckBox itself, so every\n     * render sets its state explicitly; a reverted row is unchecked again.\n     * The fill-in is always set, so a recycled list view never keeps another\n     * row's; the receiver ignores taps on checked and active rows.\n     */\n    private static void bindCheck(Context context, RemoteViews row, YourDayPayload.Item item) {\n        boolean checked = item.actionChecked || WidgetCache.isActionActive(context, item.id);\n        Intent fillIn = new Intent()\n                .putExtra(WidgetActionReceiver.EXTRA_ACTION_TYPE, item.actionType)\n                .putExtra(WidgetActionReceiver.EXTRA_ACTION_KEY, item.actionKey)\n                .putExtra(WidgetActionReceiver.EXTRA_ACTION_ID, item.id);\n\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {\n            row.setCompoundButtonChecked(R.id.widget_row_check, checked);\n            row.setBoolean(R.id.widget_row_check, \"setEnabled\", !checked);\n            row.setOnCheckedChangeResponse(R.id.widget_row_check,\n                    RemoteViews.RemoteResponse.fromFillInIntent(fillIn));\n        } else {\n            row.setImageViewResource(R.id.widget_row_check,\n                    checked ? R.drawable.ic_widget_check_on : R.drawable.ic_widget_todo);\n            row.setOnClickFillInIntent(R.id.widget_row_check, fillIn);\n        }\n        row.setContentDescription(R.id.widget_row_check, context.getString(R.string.widget_action_check));\n        row.setViewVisibility(R.id.widget_row_check, View.VISIBLE);\n    }\n\n    // Always sets visibility: the list reapplies row views to recycled views,\n    // so a row without this text would otherwise keep a previous row's.\n    private static void setOptionalText(RemoteViews views, int viewId, String text) {\n        if (text == null) {\n            views.setViewVisibility(viewId, View.GONE);\n            return;\n        }\n        views.setTextViewText(viewId, text);\n        views.setViewVisibility(viewId, View.VISIBLE);\n    }\n\n    private static int iconResource(String icon) {\n        if (\"event\".equals(icon)) return R.drawable.ic_widget_event;\n        if (\"todo\".equals(icon)) return R.drawable.ic_widget_todo;\n        return 0;\n    }\n\n    private static PendingIntent openAppIntent(Context context) {\n        Intent intent = new Intent(context, MainActivity.class)\n                .setAction(Intent.ACTION_MAIN)\n                .addCategory(Intent.CATEGORY_LAUNCHER);\n        return PendingIntent.getActivity(context, REQUEST_HEADER, intent,\n                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);\n    }\n\n    /**\n     * Collection rows need a mutable template; each row fills in its route or\n     * action. All row taps go to {@link WidgetActionReceiver}, which opens routes itself.\n     */\n    private static PendingIntent rowTemplateIntent(Context context) {\n