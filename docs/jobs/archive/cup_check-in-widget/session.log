{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019WMPBE22aWYZSXY3dNWzcJ","type":"tool_result","content":"1\tpackage app.solyto.widget;\n2\t\n3\timport android.app.PendingIntent;\n4\timport android.appwidget.AppWidgetManager;\n5\timport android.appwidget.AppWidgetProvider;\n6\timport android.content.ComponentName;\n7\timport android.content.Context;\n8\timport android.content.Intent;\n9\timport android.os.Build;\n10\timport android.os.Bundle;\n11\timport android.os.SystemClock;\n12\timport android.text.format.DateFormat;\n13\timport android.view.View;\n14\timport android.widget.RemoteViews;\n15\timport androidx.core.widget.RemoteViewsCompat;\n16\timport app.solyto.MainActivity;\n17\timport app.solyto.R;\n18\timport java.util.Date;\n19\timport org.json.JSONException;\n20\timport org.json.JSONObject;\n21\t\n22\t/** The time tracking widget: the running timer and the projects to start. Renders from {@link WidgetCache}. */\n23\tpublic class TimeTrackingWidgetProvider extends AppWidgetProvider {\n24\t\n25\t    private static final WidgetKind KIND = WidgetKind.TIME_TRACKING;\n26\t    // Distinct from Your Day's, so the kinds' PendingIntents don't replace each other.\n27\t    private static final int REQUEST_HEADER = 3;\n28\t    private static final int REQUEST_ROW_TEMPLATE = 4;\n29\t    private static final int REQUEST_RUNNING_ROUTE = 5;\n30\t    private static final int REQUEST_RUNNING_STOP = 6;\n31\t    private static final String SECTION_RUNNING = \"running\";\n32\t    private static final int BUSY_ALPHA = 90;\n33\t\n34\t    @Override\n35\t    public void onEnabled(Context context) {\n36\t        WidgetWork.schedulePeriodic(context);\n37\t    }\n38\t\n39\t    @Override\n40\t    public void onDisabled(Context context) {\n41\t        WidgetWork.cancelIfNoWidgets(context);\n42\t    }\n43\t\n44\t    @Override\n45\t    public void onUpdate(Context context, AppWidgetManager manager, int[] appWidgetIds) {\n46\t        for (int id : appWidgetIds) render(context, manager, id);\n47\t        WidgetWork.schedulePeriodic(context);\n48\t        WidgetWork.fetchNow(context);\n49\t    }\n50\t\n51\t    @Override\n52\t    public void onAppWidgetOptionsChanged(Context context, AppWidgetManager manager, int appWidgetId,\n53\t            Bundle newOptions) {\n54\t        render(context, manager, appWidgetId);\n55\t    }\n56\t\n57\t    /** Re-renders every placed time tracking widget from the cache. */\n58\t    public static void updateAll(Context context) {\n59\t        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n60\t        for (int id : widgetIds(context)) render(context, manager, id);\n61\t    }\n62\t\n63\t    private static int[] widgetIds(Context context) {\n64\t        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n65\t        if (manager == null) return new int[0];\n66\t        return manager.getAppWidgetIds(new ComponentName(context, TimeTrackingWidgetProvider.class));\n67\t    }\n68\t\n69\t    private static void render(Context context, AppWidgetManager manager, int appWidgetId) {\n70\t        RemoteViews views = new RemoteViews(context.getPackageName(), R.layout.widget_time_tracking);\n71\t        PendingIntent openApp = openAppIntent(context);\n72\t        views.setOnClickPendingIntent(R.id.widget_header, openApp);\n73\t        views.setOnClickPendingIntent(R.id.widget_message, openApp);\n74\t        views.setPendingIntentTemplate(R.id.widget_list, rowTemplateIntent(context));\n75\t\n76\t        WidgetPayload payload = null;\n77\t        String message;\n78\t        WidgetCache.State state = WidgetCache.state(context);\n79\t\n80\t        boolean deviceUnsupported = WidgetCache.isDeviceUnsupported(context);\n81\t        if (!deviceUnsupported && state == WidgetCache.State.OK) {\n82\t            payload = parse(WidgetCache.payload(context, KIND));\n83\t        }\n84\t\n85\t        if (deviceUnsupported) {\n86\t            message = context.getString(R.string.widget_not_supported);\n87\t        } else if (payload != null) {\n88\t            message = payload.emptyLabel != null ? payload.emptyLabel : \"\";\n89\t        } else if ((state == WidgetCache.State.LOADING || state == WidgetCache.State.OK)\n90\t                && WidgetCache.isOutdated(context, KIND)) {\n91\t            // A fetch failed before any data was cached: say so instead of \"Loading…\".\n92\t            message = context.getString(R.string.widget_load_failed);\n93\t        } else {\n94\t            // OK without data of this kind yet (e.g. right after an app update) shows \"Loading…\".\n95\t            message = context.getString(stateMessage(state));\n96\t        }\n97\t\n98\t        views.setTextViewText(R.id.widget_title, payload != null && payload.title != null\n99\t                ? payload.title : context.getString(R.string.widget_time_tracking_name));\n100\t        renderUpdatedAt(context, views, payload != null);\n101\t\n102\t        // The running section goes into the fixed area above the list (see the layout).\n103\t        WidgetPayload.Item running = null;\n104\t        RemoteViewsCompat.RemoteCollectionItems.Builder items =\n105\t                new RemoteViewsCompat.RemoteCollectionItems.Builder()\n106\t                        .setHasStableIds(false)\n107\t                        .setViewTypeCount(2);\n108\t        int rowCount = 0;\n109\t        if (payload != null) {\n110\t            for (WidgetPayload.Item item : payload.items) {\n111\t                if (SECTION_RUNNING.equals(item.section)) {\n112\t                    if (running == null && !item.isHeader && item.liveElapsed && item.at > 0) running = item;\n113\t                    continue;\n114\t                }\n115\t                items.addItem(rowCount++, itemView(context, item));\n116\t            }\n117\t        }\n118\t        RemoteViewsCompat.setRemoteAdapter(context, views, appWidgetId, R.id.widget_list, items.build());\n119\t        renderRunning(context, views, running);\n120\t\n121\t        boolean hasRows = rowCount > 0;\n122\t        views.setViewVisibility(R.id.widget_list, hasRows ? View.VISIBLE : View.GONE);\n123\t        // With only a running timer (its project is the only one), neither list nor message shows.\n124\t        views.setViewVisibility(R.id.widget_message, hasRows || running != null ? View.GONE : View.VISIBLE);\n125\t        views.setTextViewText(R.id.widget_message, message);\n126\t\n127\t        manager.updateAppWidget(appWidgetId, views);\n128\t    }\n129\t\n130\t    private static int stateMessage(WidgetCache.State state) {\n131\t        switch (state) {\n132\t            case SIGNED_OUT:\n133\t                return R.string.widget_signed_out;\n134\t            case UNSUPPORTED_SERVER:\n135\t                return R.string.widget_unsupported_server;\n136\t            case UPDATE_APP:\n137\t                return R.string.widget_update_app;\n138\t            default:\n139\t                return R.string.widget_loading;\n140\t        }\n141\t    }\n142\t\n143\t    private static WidgetPayload parse(String json) {\n144\t        if (json == null) return null;\n145\t        try {\n146\t            return WidgetPayload.parse(new JSONObject(json), KIND);\n147\t        } catch (JSONException e) {\n148\t            return null;\n149\t        }\n150\t    }\n151\t\n152\t    private static void renderUpdatedAt(Context context, RemoteViews views, boolean hasData) {\n153\t        long fetchedAt = WidgetCache.fetchedAt(context, KIND);\n154\t        if (!hasData || fetchedAt <= 0) {\n155\t            views.setViewVisibility(R.id.widget_updated, View.GONE);\n156\t            return;\n157\t        }\n158\t        if (WidgetCache.hasActionError(context, KIND)) {\n159\t            views.setTextViewText(R.id.widget_updated, context.getString(R.string.widget_time_tracking_failed));\n160\t            views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n161\t            return;\n162\t        }\n163\t        String time = DateFormat.getTimeFormat(context).format(new Date(fetchedAt));\n164\t        int label = WidgetCache.isOutdated(context, KIND) ? R.string.widget_outdated_at : R.string.widget_updated_at;\n165\t        views.setTextViewText(R.id.widget_updated, context.getString(label, time));\n166\t        views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n167\t    }\n168\t\n169\t    /**\n170\t     * The running timer, outside the list so its Chronometer ticks. Not a list\n171\t     * row, so its taps use their own immutable PendingIntents instead of the\n172\t     * row template: the route goes to MainActivity (which validates it again),\n173\t     * the stop button to {@link WidgetActionReceiver} like a row button.\n174\t     */\n175\t    private static void renderRunning(Context context, RemoteViews views, WidgetPayload.Item item) {\n176\t        if (item == null) {\n177\t            views.setChronometer(R.id.widget_running_elapsed, SystemClock.elapsedRealtime(), null, false);\n178\t            views.setViewVisibility(R.id.widget_running, View.GONE);\n179\t            return;\n180\t        }\n181\t\n182\t        views.setTextViewText(R.id.widget_running_title, item.title);\n183\t        if (item.subtitle != null) {\n184\t            views.setTextViewText(R.id.widget_running_subtitle, item.subtitle);\n185\t            views.setViewVisibility(R.id.widget_running_subtitle, View.VISIBLE);\n186\t        } else {\n187\t            views.setViewVisibility(R.id.widget_running_subtitle, View.GONE);\n188\t        }\n189\t        views.setInt(R.id.widget_running_dot, \"setColorFilter\",\n190\t                item.color != WidgetPayload.NO_COLOR ? item.color : context.getColor(R.color.widget_accent));\n191\t\n192\t        long elapsed = Math.max(0, System.currentTimeMillis() - item.at);\n193\t        views.setChronometer(R.id.widget_running_elapsed, SystemClock.elapsedRealtime() - elapsed, null, true);\n194\t\n195\t        if (item.routeKey != null) {\n196\t            Intent open = new Intent(context, MainActivity.class)\n197\t                    .setAction(MainActivity.ACTION_WIDGET_ROUTE)\n198\t                    .putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, item.routeKey)\n199\t                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);\n200\t            if (item.routeId != null) open.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, item.routeId);\n201\t            views.setOnClickPendingIntent(R.id.widget_running, PendingIntent.getActivity(context,\n202\t                    REQUEST_RUNNING_ROUTE, open, PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE));\n203\t        }\n204\t\n205\t        if (WidgetPayload.ACTION_BUTTON.equals(item.actionType)) {\n206\t            boolean busy = WidgetCache.isActionActive(context, KIND, item.id);\n207\t            Intent stop = new Intent(context, WidgetActionReceiver.class)\n208\t                    .setAction(WidgetActionReceiver.ACTION_ROW_TAP)\n209\t                    .putExtra(WidgetActionReceiver.EXTRA_ACTION_KIND, KIND.id)\n210\t                    .putExtra(WidgetActionReceiver.EXTRA_ACTION_TYPE, item.actionType)\n211\t                    .putExtra(WidgetActionReceiver.EXTRA_ACTION_KEY, item.actionKey)\n212\t                    .putExtra(WidgetActionReceiver.EXTRA_ACTION_ID, item.id);\n213\t            views.setOnClickPendingIntent(R.id.widget_running_button, PendingIntent.getBroadcast(context,\n214\t                    REQUEST_RUNNING_STOP, stop, PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE));\n215\t            views.setContentDescription(R.id.widget_running_button, context.getString(R.string.widget_action_stop));\n216\t            views.setInt(R.id.widget_running_button, \"setImageAlpha\", busy ? BUSY_ALPHA : 255);\n217\t            views.setBoolean(R.id.widget_running_button, \"setEnabled\", !busy);\n218\t            views.setViewVisibility(R.id.widget_running_button, View.VISIBLE);\n219\t        } else {\n220\t            views.setViewVisibility(R.id.widget_running_button, View.GONE);\n221\t        }\n222\t\n223\t        views.setViewVisibility(R.id.widget_running, View.VISIBLE);\n224\t    }\n225\t\n226\t    // The list reapplies row views to recycled views, so every view state is set\n227\t    // explicitly; a row would otherwise keep a previous row's.\n228\t    private static RemoteViews itemView(Context context, WidgetPayload.Item item) {\n229\t        if (item.isHeader) {\n230\t            RemoteViews header = new RemoteViews(context.getPackageName(), R.layout.widget_time_tracking_section);\n231\t            header.setTextViewText(R.id.widget_section_title, item.title);\n232\t            return header;\n233\t        }\n234\t\n235\t        RemoteViews row = new RemoteViews(context.getPackageName(), R.layout.widget_time_tracking_row);\n236\t        row.setTextViewText(R.id.widget_row_title, item.title);\n237\t        if (item.subtitle != null) {\n238\t            row.setTextViewText(R.id.widget_row_subtitle, item.subtitle);\n239\t            row.setViewVisibility(R.id.widget_row_subtitle, View.VISIBLE);\n240\t        } else {\n241\t            row.setViewVisibility(R.id.widget_row_subtitle, View.GONE);\n242\t        }\n243\t\n244\t        row.setInt(R.id.widget_row_dot, \"setColorFilter\",\n245\t                item.color != WidgetPayload.NO_COLOR ? item.color : context.getColor(R.color.widget_accent));\n246\t\n247\t        boolean running = item.liveElapsed && item.at > 0;\n248\t        row.setInt(R.id.widget_row, \"setBackgroundResource\", running ? R.drawable.widget_running_background : 0);\n249\t        row.setViewVisibility(R.id.widget_row_icon, running && \"timer\".equals(item.icon) ? View.VISIBLE : View.GONE);\n250\t        if (running) {\n251\t            long elapsed = Math.max(0, System.currentTimeMillis() - item.at);\n252\t            row.setChronometer(R.id.widget_row_elapsed, SystemClock.elapsedRealtime() - elapsed, null, true);\n253\t            row.setViewVisibility(R.id.widget_row_elapsed, View.VISIBLE);\n254\t        } else {\n255\t            row.setChronometer(R.id.widget_row_elapsed, SystemClock.elapsedRealtime(), null, false);\n256\t            row.setViewVisibility(R.id.widget_row_elapsed, View.GONE);\n257\t        }\n258\t\n259\t        if (WidgetPayload.ACTION_BUTTON.equals(item.actionType)) {\n260\t            bindButton(context, row, item);\n261\t        } else {\n262\t            row.setViewVisibility(R.id.widget_row_button, View.GONE);\n263\t        }\n264\t\n265\t        Intent routeFillIn = new Intent();\n266\t        if (item.routeKey != null) {\n267\t            routeFillIn.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, item.routeKey);\n268\t            if (item.routeId != null) routeFillIn.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, item.routeId);\n269\t        }\n270\t        row.setOnClickFillInIntent(R.id.widget_row, routeFillIn);\n271\t        return row;\n272\t    }\n273\t\n274\t    /**\n275\t     * The row's start or stop button, dimmed and disabled while its action is\n276\t     * active. The fill-in is always set; the receiver ignores taps on active rows.\n277\t     */\n278\t    private static void bindButton(Context context, RemoteViews row, WidgetPayload.Item item) {\n279\t        boolean busy = WidgetCache.isActionActive(context, KIND, item.id);\n280\t        boolean stop = \"stop\".equals(item.actionIcon);\n281\t        Intent fillIn = new Intent()\n282\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_KIND, KIND.id)\n283\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_TYPE, item.actionType)\n284\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_KEY, item.actionKey)\n285\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_ID, item.id);\n286\t\n287\t        row.setImageViewResource(R.id.widget_row_button, stop ? R.drawable.ic_widget_stop : R.drawable.ic_widget_play);\n288\t        row.setContentDescription(R.id.widget_row_button,\n289\t                context.getString(stop ? R.string.widget_action_stop : R.string.widget_action_start));\n290\t        row.setInt(R.id.widget_row_button, \"setImageAlpha\", busy ? BUSY_ALPHA : 255);\n291\t        row.setBoolean(R.id.widget_row_button, \"setEnabled\", !busy);\n292\t        row.setOnClickFillInIntent(R.id.widget_row_button, fillIn);\n293\t        row.setViewVisibility(R.id.widget_row_button, View.VISIBLE);\n294\t    }\n295\t\n296\t    private static PendingIntent openAppIntent(Context context) {\n297\t        Intent intent = new Intent(context, MainActivity.class)\n298\t                .setAction(Intent.ACTION_MAIN)\n299\t                .addCategory(Intent.CATEGORY_LAUNCHER);\n300\t        return PendingIntent.getActivity(context, REQUEST_HEADER, intent,\n301\t                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);\n302\t    }\n303\t\n304\t    /**\n305\t     * Collection rows need a mutable template; each row fills in its route or\n306\t     * action. All row taps go to {@link WidgetActionReceiver}, which opens routes itself.\n307\t     */\n308\t    private static PendingIntent rowTemplateIntent(Context context) {\n309\t        Intent intent = new Intent(context, WidgetActionReceiver.class)\n310\t                .setAction(WidgetActionReceiver.ACTION_ROW_TAP);\n311\t        int mutable = Build.VERSION.SDK_INT >= Build.VERSION_CODES.S ? PendingIntent.FLAG_MUTABLE : 0;\n312\t        return PendingIntent.getBroadcast(context, REQUEST_ROW_TEMPLATE, intent,\n313\t                PendingIntent.FLAG_UPDATE_CURRENT | mutable);\n314\t    }\n315\t}\n316\t"}]},"parent_tool_use_id":null,"session_id":"06ad74aa-1ba4-4cae-8c42-95d32284c601","uuid":"7e96fc76-d885-4f61-a21b-80ad8e2d7e07","timestamp":"2026-10-29T20:52:05.926Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/android/app/src/main/java/app/solyto/widget/TimeTrackingWidgetProvider.java","content":"package app.solyto.widget;\n\nimport android.app.PendingIntent;\nimport android.appwidget.AppWidgetManager;\nimport android.appwidget.AppWidgetProvider;\nimport android.content.ComponentName;\nimport android.content.Context;\nimport android.content.Intent;\nimport android.os.Build;\nimport android.os.Bundle;\nimport android.os.SystemClock;\nimport android.text.format.DateFormat;\nimport android.view.View;\nimport android.widget.RemoteViews;\nimport androidx.core.widget.RemoteViewsCompat;\nimport app.solyto.MainActivity;\nimport app.solyto.R;\nimport java.util.Date;\nimport org.json.JSONException;\nimport org.json.JSONObject;\n\n/** The time tracking widget: the running timer and the projects to start. Renders from {@link WidgetCache}. */\npublic class TimeTrackingWidgetProvider extends AppWidgetProvider {\n\n    private static final WidgetKind KIND = WidgetKind.TIME_TRACKING;\n    // Distinct from Your Day's, so the kinds' PendingIntents don't replace each other.\n    private static final int REQUEST_HEADER = 3;\n    private static final int REQUEST_ROW_TEMPLATE = 4;\n    private static final int REQUEST_RUNNING_ROUTE = 5;\n    private static final int REQUEST_RUNNING_STOP = 6;\n    private static final String SECTION_RUNNING = \"running\";\n    private static final int BUSY_ALPHA = 90;\n\n    @Override\n    public void onEnabled(Context context) {\n        WidgetWork.schedulePeriodic(context);\n    }\n\n    @Override\n    public void onDisabled(Context context) {\n        WidgetWork.cancelIfNoWidgets(context);\n    }\n\n    @Override\n    public void onUpdate(Context context, AppWidgetManager manager, int[] appWidgetIds) {\n        for (int id : appWidgetIds) render(context, manager, id);\n        WidgetWork.schedulePeriodic(context);\n        WidgetWork.fetchNow(context);\n    }\n\n    @Override\n    public void onAppWidgetOptionsChanged(Context context, AppWidgetManager manager, int appWidgetId,\n            Bundle newOptions) {\n        render(context, manager, appWidgetId);\n    }\n\n    /** Re-renders every placed time tracking widget from the cache. */\n    public static void updateAll(Context context) {\n        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n        for (int id : widgetIds(context)) render(context, manager, id);\n    }\n\n    private static int[] widgetIds(Context context) {\n        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n        if (manager == null) return new int[0];\n        return manager.getAppWidgetIds(new ComponentName(context, TimeTrackingWidgetProvider.class));\n    }\n\n    private static void render(Context context, AppWidgetManager manager, int appWidgetId) {\n        RemoteViews views = new RemoteViews(context.getPackageName(), R.layout.widget_time_tracking);\n        PendingIntent openApp = openAppIntent(context);\n        views.setOnClickPendingIntent(R.id.widget_header, openApp);\n        views.setOnClickPendingIntent(R.id.widget_message, openApp);\n        views.setPendingIntentTemplate(R.id.widget_list, rowTemplateIntent(context));\n\n        WidgetPayload payload = null;\n        String message;\n        WidgetCache.State state = WidgetCache.state(context);\n\n        boolean deviceUnsupported = WidgetCache.isDeviceUnsupported(context);\n        if (!deviceUnsupported && state == WidgetCache.State.OK) {\n            payload = parse(WidgetCache.payload(context, KIND));\n        }\n\n        if (deviceUnsupported) {\n            message = context.getString(R.string.widget_not_supported);\n        } else if (payload != null) {\n            message = payload.emptyLabel != null ? payload.emptyLabel : \"\";\n        } else if ((state == WidgetCache.State.LOADING || state == WidgetCache.State.OK)\n                && WidgetCache.isOutdated(context, KIND)) {\n            // A fetch failed before any data was cached: say so instead of \"Loading…\".\n            message = context.getString(R.string.widget_load_failed);\n        } else {\n            // OK without data of this kind yet (e.g. right after an app update) shows \"Loading…\".\n            message = context.getString(stateMessage(state));\n        }\n\n        views.setTextViewText(R.id.widget_title, payload != null && payload.title != null\n                ? payload.title : context.getString(R.string.widget_time_tracking_name));\n        renderUpdatedAt(context, views, payload != null);\n\n        // The running section goes into the fixed area above the list (see the layout).\n        WidgetPayload.Item running = null;\n        RemoteViewsCompat.RemoteCollectionItems.Builder items =\n                new RemoteViewsCompat.RemoteCollectionItems.Builder()\n                        .setHasStableIds(false)\n                        .setViewTypeCount(2);\n        int rowCount = 0;\n        if (payload != null) {\n            for (WidgetPayload.Item item : payload.items) {\n                if (SECTION_RUNNING.equals(item.section)) {\n                    if (running == null && !item.isHeader && item.liveElapsed && item.at > 0) running = item;\n                    continue;\n                }\n                items.addItem(rowCount++, itemView(context, item));\n            }\n        }\n        RemoteViewsCompat.setRemoteAdapter(context, views, appWidgetId, R.id.widget_list, items.build());\n        renderRunning(context, views, running);\n\n        boolean hasRows = rowCount > 0;\n        views.setViewVisibility(R.id.widget_list, hasRows ? View.VISIBLE : View.GONE);\n        // With only a running timer (its project is the only one), neither list nor message shows.\n        views.setViewVisibility(R.id.widget_message, hasRows || running != null ? View.GONE : View.VISIBLE);\n        views.setTextViewText(R.id.widget_message, message);\n\n        manager.updateAppWidget(appWidgetId, views);\n    }\n\n    private static int stateMessage(WidgetCache.State state) {\n        switch (state) {\n            case SIGNED_OUT:\n                return R.string.widget_signed_out;\n            case UNSUPPORTED_SERVER:\n                return R.string.widget_unsupported_server;\n            case UPDATE_APP:\n                return R.string.widget_update_app;\n            default:\n                return R.string.widget_loading;\n        }\n    }\n\n    private static WidgetPayload parse(String json) {\n        if (json == null) return null;\n        try {\n            return WidgetPayload.parse(new JSONObject(json), KIND);\n        } catch (JSONException e) {\n            return null;\n        }\n    }\n\n    private static void renderUpdatedAt(Context context, RemoteViews views, boolean hasData) {\n        long fetchedAt = WidgetCache.fetchedAt(context, KIND);\n        if (!hasData || fetchedAt <= 0) {\n            views.setViewVisibility(R.id.widget_updated, View.GONE);\n            return;\n        }\n        if (WidgetCache.hasActionError(context, KIND)) {\n            views.setTextViewText(R.id.widget_updated, context.getString(R.string.widget_time_tracking_failed));\n            views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n            return;\n        }\n        String time = DateFormat.getTimeFormat(context).format(new Date(fetchedAt));\n        int label = WidgetCache.isOutdated(context, KIND) ? R.string.widget_outdated_at : R.string.widget_updated_at;\n        views.setTextViewText(R.id.widget_updated, context.getString(label, time));\n        views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n    }\n\n    /**\n     * The running timer, outside the list so its Chronometer ticks. Not a list\n     * row, so its taps use their own immutable PendingIntents instead of the\n     * row template: the route goes to MainActivity (which validates it again),\n     * the stop button to {@link WidgetActionReceiver} like a row button.\n     */\n    private static void renderRunning(Context context, RemoteViews views, WidgetPayload.Item item) {\n        if (item == null) {\n            views.setChronometer(R.id.widget_running_elapsed, SystemClock.elapsedRealtime(), null, false);\n            views.setViewVisibility(R.id.widget_running, View.GONE);\n            return;\n        }\n\n        views.setTextViewText(R.id.widget_running_title, item.title);\n        if (item.subtitle != null) {\n            views.setTextViewText(R.id.widget_running_subtitle, item.subtitle);\n            views.setViewVisibility(R.id.widget_running_subtitle, View.VISIBLE);\n        } else {\n            views.setViewVisibility(R.id.widget_running_subtitle, View.GONE);\n        }\n        views.setInt(R.id.widget_running_dot, \"setColorFilter\",\n                item.color != WidgetPayload.NO_COLOR ? item.color : context.getColor(R.color.widget_accent));\n\n        long elapsed = Math.max(0, System.currentTimeMillis() - item.at);\n        views.setChronometer(R.id.widget_running_elapsed, SystemClock.elapsedRealtime() - elapsed, null, true);\n\n        if (item.routeKey != null) {\n            Intent open = new Intent(context, MainActivity.class)\n                    .setAction(MainActivity.ACTION_WIDGET_ROUTE)\n                    .putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, item.routeKey)\n                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);\n            if (item.routeId != null) open.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, item.routeId);\n            views.setOnClickPendingIntent(R.id.widget_running, PendingIntent.getActivity(context,\n                    REQUEST_RUNNING_ROUTE, open, PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE));\n        }\n\n        if (WidgetPayload.ACTION_BUTTON.equals(item.actionType)) {\n            boolean busy = WidgetCache.isActionActive(context, KIND, item.id);\n            Intent stop = new Intent(context, WidgetActionReceiver.class)\n                    .setAction(WidgetActionReceiver.ACTION_ROW_TAP)\n                    .putExtra(WidgetActionReceiver.EXTRA_ACTION_KIND, KIND.id)\n                    .putExtra(WidgetActionReceiver.EXTRA_ACTION_TYPE, item.actionType)\n                    .putExtra(WidgetActionReceiver.EXTRA_ACTION_KEY, item.actionKey)\n                    .putExtra(WidgetActionReceiver.EXTRA_ACTION_ID, item.id);\n            views.setOnClickPendingIntent(R.id.widget_running_button, PendingIntent.getBroadcast(context,\n                    REQUEST_RUNNING_STOP, stop, PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE));\n            views.setContentDescription(R.id.widget_running_button, context.getString(R.string.widget_action_stop));\n            views.setInt(R.id.widget_running_button, \"setImageAlpha\", busy ? BUSY_ALPHA : 255);\n            views.setBoolean(R.id.widget_running_button, \"setEnabled\", !busy);\n            views.setViewVisibility(R.id.widget_running_button, View.VISIBLE);\n        } else {\n            views.setViewVisibility(R.id.widget_running_button, View.GONE);\n        }\n\n        views.setViewVisibility(R.id.widget_running, View.VISIBLE);\n    }\n\n    // The list reapplies row views to recycled views, so every view state is set\n    // explicitly; a row would otherwise keep a previous row's.\n    private static RemoteViews itemView(Context context, WidgetPayload.Item item) {\n        if (item.isHeader) {\n            RemoteViews header = new RemoteViews(context.getPackageName(), R.layout.widget_time_tracking_section);\n            header.setTextViewText(R.id.widget_section_title, item.title);\n            return header;\n        }\n\n        RemoteViews row = new RemoteViews(context.getPackageName(), R.layout.widget_time_tracking_row);\n        row.setTextViewText(R.id.widget_row_title, item.title);\n        if (item.subtitle != null) {\n            row.setTextViewText(R.id.widget_row_subtitle, item.subtitle);\n            row.setViewVisibility(R.id.widget_row_subtitle, View.VISIBLE);\n        } else {\n            row.setViewVisibility(R.id.widget_row_subtitle, View.GONE);\n        }\n\n        row.setInt(R.id.widget_row_dot, \"setColorFilter\",\n                item.color != WidgetPayload.NO_COLOR ? item.color : context.getColor(R.color.widget_accent));\n\n        boolean running = item.liveElapsed && item.at > 0;\n        row.setInt(R.id.widget_row, \"setBackgroundResource\", running ? R.drawable.widget_running_background : 0);\n        row.setViewVisibility(R.id.widget_row_icon, running && \"timer\".equals(item.icon) ? View.VISIBLE : View.GONE);\n        if (running) {\n            long elapsed = Math.max(0, System.currentTimeMillis() - item.at);\n            row.setChronometer(R.id.widget_row_elapsed, SystemClock.elapsedRealtime() - elapsed, null, true);\n            row.setViewVisibility(R.id.widget_row_elapsed, View.VISIBLE);\n        } else {\n            row.setChronometer(R.id.widget_row_elapsed, SystemClock.elapsedRealtime(), null, false);\n            row.setViewVisibility(R.id.widget_row_elapsed, View.GONE);\n        }\n\n        if (WidgetPayload.ACTION_BUTTON.equals(item.actionType)) {\n            bindButton(context, row, item);\n        } else {\n            row.setViewVisibility(R.id.widget_row_button, View.GONE);\n        }\n\n        Intent routeFillIn = new Intent();\n        if (item.routeKey != null) {\n            routeFillIn.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, item.routeKey);\n            if (item.routeId != null) routeFillIn.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, item.routeId);\n        }\n        row.setOnClickFillInIntent(R.id.widget_row, routeFillIn);\n        return row;\n    }\n\n    /**\n     * The row's start or stop button, dimmed and disabled while its action is\n     * active. The fill-in is always set; the receiver ignores taps on active rows.\n     */\n    private static void bindButton(Context context, RemoteViews row, WidgetPayload.Item item) {\n        boolean busy = WidgetCache.isActionActive(context, KIND, item.id);\n        boolean stop = \"stop\".equals(item.actionIcon);\n        Intent fillIn = new Intent()\n                .putExtra(WidgetActionReceiver.EXTRA_ACTION_KIND, KIND.id)\n                .putExtra(WidgetActionReceiver.EXTRA_ACTION_TYPE, item.actionType)\n                .putExtra(WidgetActionReceiver.EXTRA_ACTION_KEY, item.actionKey)\n                .putExtra(WidgetActionReceiver.EXTRA_ACTION_ID, item.id);\n\n        row.setImageViewResource(R.id.widget_row_button, stop ? R.drawable.ic_widget_stop : R.drawable.ic_widget_play);\n        row.setContentDescription(R.id.widget_row_button,\n                context.getString(stop ? R.string.widget_action_stop : R.string.widget_action_start));\n        row.setInt(R.id.widget_row_button, \"setImageAlpha\", busy ? BUSY_ALPHA : 255);\n        row.setBoolean(R.id.widget_row_button, \"setEnabled\", !busy);\n        row.setOnClickFillInIntent(R.id.widget_row_button, fillIn);\n        row.setViewVisibility(R.id.widget_row_button, View.VISIBLE);\n    }\n\n    private static PendingIntent openAppIntent(Context context) {\n        Intent intent = new Intent(context, MainActivity.class)\n                .setAction(Intent.ACTION_MAIN)\n                .addCategory(Intent.CATEGORY_LAUNCHER);\n        return PendingIntent.getActivity(context, REQUEST_HEADER, intent,\n                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);\n    }\n\n    /**\n     * Collection rows need a mutable template; each row fills in its route or\n     * action. All row taps go to {@link WidgetActionReceiver}, which opens routes itself.\n     */\n    private static PendingIntent rowTemplateIntent(Context context) {\n        Intent intent = new Intent(context, WidgetActionReceiver.class)\n                .setAction(WidgetActionReceiver.ACTION_ROW_TAP);\n        int mutable = Build.VERSION.SDK_INT >= Build.VERSION_CODES.S ? PendingIntent.FLAG_MUTABLE : 0;\n        return PendingIntent.getBroadcast(context, REQUEST_ROW_TEMPLATE, intent,\n                PendingIntent.FLAG_UPDATE_CURRENT | mutable);\n    }\n}\n","numLines":316,"startLine":1,"totalLines":316}},"tool_result_meta":[{"id":"toolu_019WMPBE22aWYZSXY3dNWzcJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}