\t        /** The row id; only set together with an action. */\n45\t        final String id;\n46\t        /** A known action type ({@link #ACTION_CHECK}) or null when the row has no action. */\n47\t        final String actionType;\n48\t        final String actionKey;\n49\t        final boolean actionChecked;\n50\t\n51\t        Item(boolean isHeader, String title, String subtitle, String timeLabel, String icon,\n52\t                String routeKey, String routeId, String id, String actionType, String actionKey,\n53\t                boolean actionChecked) {\n54\t            this.isHeader = isHeader;\n55\t            this.title = title;\n56\t            this.subtitle = subtitle;\n57\t            this.timeLabel = timeLabel;\n58\t            this.icon = icon;\n59\t            this.routeKey = routeKey;\n60\t            this.routeId = routeId;\n61\t            this.id = id;\n62\t            this.actionType = actionType;\n63\t            this.actionKey = actionKey;\n64\t            this.actionChecked = actionChecked;\n65\t        }\n66\t    }\n67\t\n68\t    final String title;\n69\t    final String emptyLabel;\n70\t    final List<Item> items;\n71\t    /** Epoch millis when the data goes stale, or -1. */\n72\t    final long refreshAt;\n73\t\n74\t    private YourDayPayload(String title, String emptyLabel, List<Item> items, long refreshAt) {\n75\t        this.title = title;\n76\t        this.emptyLabel = emptyLabel;\n77\t        this.items = items;\n78\t        this.refreshAt = refreshAt;\n79\t    }\n80\t\n81\t    static boolean isValidActionKey(String key) {\n82\t        return key != null && key.length() <= MAX_ACTION_KEY_LENGTH && ACTION_KEY.matcher(key).matches();\n83\t    }\n84\t\n85\t    static boolean isValidRowId(String id) {\n86\t        return id != null && ROW_ID.matcher(id).matches();\n87\t    }\n88\t\n89\t    /** The row with this id and action, or null. */\n90\t    Item findAction(String type, String key, String id) {\n91\t        for (Item item : items) {\n92\t            if (item.actionType != null && item.actionType.equals(type)\n93\t                    && item.actionKey.equals(key) && item.id.equals(id)) {\n94\t                return item;\n95\t            }\n96\t        }\n97\t        return null;\n98\t    }\n99\t\n100\t    static boolean isNewerSchema(JSONObject data) {\n101\t        return data.optInt(\"schema_version\", SCHEMA_VERSION) > SCHEMA_VERSION;\n102\t    }\n103\t\n104\t    /** Null when the data is not a Your Day payload this version can read. */\n105\t    static YourDayPayload parse(JSONObject data) {\n106\t        if (data == null || !KIND.equals(data.optString(\"kind\")) || isNewerSchema(data)) return null;\n107\t\n108\t        JSONObject labels = data.optJSONObject(\"labels\");\n109\t        String title = labels != null ? text(labels, \"title\") : null;\n110\t        String emptyLabel = labels != null ? text(labels, \"empty\") : null;\n111\t\n112\t        List<Item> items = new ArrayList<>();\n113\t        JSONArray sections = data.optJSONArray(\"sections\");\n114\t        if (sections != null) {\n115\t            for (int i = 0; i < sections.length(); i++) {\n116\t                JSONObject section = sections.optJSONObject(i);\n117\t                if (section == null || !SECTION_KEYS.contains(section.optString(\"key\"))) continue;\n118\t                addSection(items, section);\n119\t            }\n120\t        }\n121\t\n122\t        return new YourDayPayload(title, emptyLabel, Collections.unmodifiableList(items),\n123\t                IsoTime.parse(data.optString(\"refresh_at\", null)));\n124\t    }\n125\t\n126\t    private static void addSection(List<Item> items, JSONObject section) {\n127\t        JSONArray rows = section.optJSONArray(\"rows\");\n128\t        if (rows == null) return;\n129\t\n130\t        List<Item> sectionRows = new ArrayList<>();\n131\t        for (int i = 0; i < rows.length() && sectionRows.size() < MAX_ROWS_PER_SECTION; i++) {\n132\t            Item row = parseRow(rows.optJS