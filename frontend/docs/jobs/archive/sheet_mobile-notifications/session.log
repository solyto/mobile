{"type":"tool_use","timestamp":1789192417731,"sessionID":"ses_f6bdb1309ffeCKH5Utz6H6w7B1","part":{"type":"tool","tool":"write","callID":"call_629affadd1784b5984e7e739","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"Minimal mock of the solyto REST API for UI render verification.\"\"\"\nimport json\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\n\nFUTURE = \"2030-01-01T00:00:00+00:00\"\n\nUSER = {\n    \"id\": \"user-1\",\n    \"name\": \"Test User\",\n    \"email\": \"test@solyto.app\",\n    \"role\": \"user\",\n    \"profile\": {\"profile_image_path\": None},\n    \"settings\": {\n        \"language\": \"en\",\n        \"timezone\": \"UTC\",\n        \"date_format\": \"YYYY-MM-DD\",\n        \"time_format\": \"24\",\n        \"widgets\": \"[]\",\n        \"ai_enabled\": False,\n        \"navigation\": \"[]\",\n        \"openai_api_key\": None,\n        \"first_visit\": False,\n        \"temperature_unit\": \"c\",\n    },\n    \"created_at\": \"2026-01-01T00:00:00+00:00\",\n    \"updated_at\": \"2026-01-01T00:00:00+00:00\",\n    \"additional_info_last_updated_at\": \"2026-01-01T00:00:00+00:00\",\n}\n\nNOTIFICATIONS = [\n    {\n        \"id\": \"n1\",\n        \"title\": \"Friend request\",\n        \"body\": \"Leander wants to connect with you\",\n        \"link\": \"/contacts\",\n        \"read_at\": None,\n        \"created_at\": \"2026-09-11T09:00:00+00:00\",\n    },\n    {\n        \"id\": \"n2\",\n        \"title\": \"Daily reminder\",\n        \"body\": \"Check in today\",\n        \"link\": None,\n        \"read_at\": None,\n        \"created_at\": \"2026-09-11T08:00:00+00:00\",\n    },\n    {\n        \"id\": \"n3\",\n        \"title\": \"Release\",\n        \"body\": \"Version 2.4 is available\",\n        \"link\": \"/dev-requests\",\n        \"read_at\": \"2026-09-10T10:00:00+00:00\",\n        \"created_at\": \"2026-09-10T10:00:00+00:00\",\n    },\n]\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def _send(self, obj, code=200):\n        body = json.dumps(obj).encode()\n        self.send_response(code)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_GET(self):\n        if self.path == \"/api/v1/users/me\":\n            self._send({\"data\": USER})\n        elif self.path == \"/api/v1/notifications\":\n            self._send({\"data\": NOTIFICATIONS})\n        else:\n            self._send({\"data\": []})\n\n    def do_POST(self):\n        if self.path == \"/api/v1/auth/refresh\":\n            self._send(\n                {\n                    \"data\": {\n                        \"token\": \"mock-token\",\n                        \"token_type\": \"Bearer\",\n                        \"token_expires_at\": FUTURE,\n                        \"user\": USER,\n                    }\n                }\n            )\n        else:\n            self._send({\"data\": {}})\n\n    def log_message(self, *args):\n        pass\n\n\nif __name__ == \"__main__\":\n    HTTPServer((\"127.0.0.1\", 8000), Handler).serve_forever()","filePath":"/tmp/mock_api.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/tmp/mock_api.py","exists":false,"truncated":false},"title":"../tmp/mock_api.py","time":{"start":1789192417726,"end":1789192417731}},"id":"prt_0942d99c40014PLZi14VbWvcaw","sessionID":"ses_f6bdb1309ffeCKH5Utz6H6w7B1","messageID":"msg_0942d8cbd001Y6nrlkxpf0KxkF"}}
