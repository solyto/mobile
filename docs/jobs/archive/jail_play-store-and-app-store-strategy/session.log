{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JmyxmzmHdYWXdsXxJVCarS","type":"tool_result","content":"apply plugin: 'com.android.application'\n\nandroid {\n    namespace = \"app.solyto\"\n    compileSdk = rootProject.ext.compileSdkVersion\n    defaultConfig {\n        applicationId \"app.solyto\"\n        minSdkVersion rootProject.ext.minSdkVersion\n        targetSdkVersion rootProject.ext.targetSdkVersion\n        versionCode 10015\n        versionName \"1.0.15\"\n        testInstrumentationRunner \"androidx.test.runner.AndroidJUnitRunner\"\n        aaptOptions {\n             // Files and dirs to omit from the packaged assets dir, modified to accommodate modern web apps.\n             // Default: https://android.googlesource.com/platform/frameworks/base/+/282e181b58cf72b6ca770dc7ca5f91f135444502/tools/aapt/AaptAssets.cpp#61\n            ignoreAssetsPattern = '!.svn:!.git:!.ds_store:!*.scc:.*:!CVS:!thumbs.db:!picasa.ini:!*~'\n        }\n    }\n    signingConfigs {\n        release {\n            if (System.getenv(\"KEYSTORE_PATH\")) {\n                storeFile file(System.getenv(\"KEYSTORE_PATH\"))\n                storePassword System.getenv(\"STORE_PASSWORD\")\n                keyAlias System.getenv(\"KEY_ALIAS\")\n                keyPassword System.getenv(\"KEY_PASSWORD\")\n            }\n        }\n    }\n    buildTypes {\n        release {\n            minifyEnabled false\n            proguardFiles getDefaultProguardFile('proguard-android.txt'), 'proguard-rules.pro'\n            signingConfig signingConfigs.release\n        }\n    }\n}\n\nrepositories {\n    flatDir{\n        dirs '../capacitor-cordova-android-plugins/src/main/libs', 'libs'\n    }\n}\n\ndependencies {\n    implementation fileTree(include: ['*.jar'], dir: 'libs')\n    implementation \"androidx.appcompat:appcompat:$androidxAppCompatVersion\"\n    implementation \"androidx.coordinatorlayout:coordinatorlayout:$androidxCoordinatorLayoutVersion\"\n    implementation \"androidx.core:core-splashscreen:$coreSplashScreenVersion\"\n    implementation \"androidx.swiperefreshlayout:swiperefreshlayout:$androidxSwipeRefreshLayoutVersion\"\n    implementation project(':capacitor-android')\n    testImplementation \"junit:junit:$junitVersion\"\n    androidTestImplementation \"androidx.test.ext:junit:$androidxJunitVersion\"\n    androidTestImplementation \"androidx.test.espresso:espresso-core:$androidxEspressoCoreVersion\"\n    implementation project(':capacitor-cordova-android-plugins')\n}\n\napply from: 'capacitor.build.gradle'\next {\n    minSdkVersion = 24\n    compileSdkVersion = 36\n    targetSdkVersion = 36\n    androidxActivityVersion = '1.11.0'\n    androidxAppCompatVersion = '1.7.1'\n    androidxCoordinatorLayoutVersion = '1.3.0'\n    androidxCoreVersion = '1.17.0'\n    androidxFragmentVersion = '1.8.9'\n    coreSplashScreenVersion = '1.2.0'\n    androidxWebkitVersion = '1.14.0'\n    androidxSwipeRefreshLayoutVersion = '1.1.0'\n    junitVersion = '4.13.2'\n    androidxJunitVersion = '1.3.0'\n    androidxEspressoCoreVersion = '3.7.0'\n    cordovaAndroidVersion = '14.0.1'\n}<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\">\n\n    <application\n        android:allowBackup=\"true\"\n        android:icon=\"@mipmap/ic_launcher\"\n        android:label=\"@string/app_name\"\n        android:roundIcon=\"@mipmap/ic_launcher_round\"\n        android:supportsRtl=\"true\"\n        android:theme=\"@style/AppTheme\">\n\n        <activity\n            android:configChanges=\"orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density\"\n            android:name=\".MainActivity\"\n            android:label=\"@string/title_activity_main\"\n            android:theme=\"@style/AppTheme.NoActionBarLaunch\"\n            android:launchMode=\"singleTask\"\n            android:exported=\"true\">\n\n            <intent-filter>\n                <action android:name=\"android.intent.action.MAIN\" />\n                <category android:name=\"android.intent.category.LAUNCHER\" />\n            </intent-filter>\n\n            <intent-filter>\n                <action android:name=\"android.intent.action.SEND\" />\n                <category android:name=\"android.intent.category.DEFAULT\" />\n                <data android:mimeType=\"text/plain\" />\n            </intent-filter>\n\n            <intent-filter>\n                <action android:name=\"android.intent.action.VIEW\" />\n                <category android:name=\"android.intent.category.DEFAULT\" />\n                <category android:name=\"android.intent.category.BROWSABLE\" />\n                <data android:scheme=\"@string/custom_url_scheme\" />\n            </intent-filter>\n\n        </activity>\n\n        <provider\n            android:name=\"androidx.core.content.FileProvider\"\n            android:authorities=\"${applicationId}.fileprovider\"\n            android:exported=\"false\"\n            android:grantUriPermissions=\"true\">\n            <meta-data\n                android:name=\"android.support.FILE_PROVIDER_PATHS\"\n                android:resource=\"@xml/file_paths\"></meta-data>\n        </provider>\n    </application>\n\n    <!-- Permissions -->\n\n    <uses-permission android:name=\"android.permission.INTERNET\" />\n</manifest>\n{\n  \"appId\": \"app.solyto\",\n  \"appName\": \"solyto\",\n  \"webDir\": \"frontend/build\",\n  \"server\": {\n    \"androidScheme\": \"https\",\n    \"hostname\": \"my.solyto.app\"\n  },\n  \"android\": {\n    \"adjustMarginsForEdgeToEdge\": \"auto\"\n  }\n}\n{\n  \"name\": \"mobile\",\n  \"version\": \"1.0.15\",\n  \"description\": \"\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n  },\n  \"keywords\": [],\n  \"author\": \"\",\n  \"license\": \"ISC\",\n  \"type\": \"commonjs\",\n  \"devDependencies\": {\n    \"@capacitor/android\": \"^7.6.8\",\n    \"@capacitor/cli\": \"^7.6.8\",\n    \"@capacitor/core\": \"^7.6.8\"\n  }\n}\npackage app.solyto;\n\nimport android.content.Intent;\nimport android.content.res.Configuration;\nimport android.graphics.drawable.ColorDrawable;\nimport android.os.Build;\nimport android.os.Bundle;\nimport android.os.Handler;\nimport android.os.Looper;\nimport android.view.ViewGroup;\nimport android.webkit.WebView;\nimport android.widget.FrameLayout;\nimport androidx.core.content.ContextCompat;\nimport androidx.core.view.ViewCompat;\nimport androidx.core.view.WindowCompat;\nimport androidx.core.view.WindowInsetsControllerCompat;\nimport com.getcapacitor.BridgeActivity;\nimport com.getcapacitor.WebViewListener;\n\npublic class MainActivity extends BridgeActivity {\n\n    // Safety net: hide the spinner even if no page-load callback arrives.\n    private static final long REFRESH_TIMEOUT_MS = 15000;\n\n    private final Handler mainHandler = new Handler(Looper.getMainLooper());\n    private final Runnable stopRefreshing = this::finishRefresh;\n    // Where the spinner rests below the top of the WebView (SwipeRefreshLayout's default).\n    private static final int REFRESH_INDICATOR_REST_DP = 64;\n\n    private PullToRefreshLayout swipeRefresh;\n    private int appliedIndicatorTop = 0;\n\n    @Override\n    protected void onCreate(Bundle savedInstanceState) {\n        registerPlugin(PullToRefreshPlugin.class);\n        super.onCreate(savedInstanceState);\n        setupPullToRefresh();\n        handleShareIntent(getIntent());\n        applySystemBarAppearance();\n        styleRefreshIndicator();\n    }\n\n    @Override\n    protected void onNewIntent(Intent intent) {\n        super.onNewIntent(intent);\n        handleShareIntent(intent);\n    }\n\n    @Override\n    public void onConfigurationChanged(Configuration newConfig) {\n        super.onConfigurationChanged(newConfig);\n        applySystemBarAppearance();\n        styleRefreshIndicator();\n    }\n\n    /**\n     * Wraps the Capacitor WebView in a SwipeRefreshLayout so pulling down from\n     * the top reloads the page with the standard Material spinner.\n     * PullToRefreshPlugin decides whether a pull may start (see there).\n     *\n     * The WebView is put into an intermediate FrameLayout because Capacitor's\n     * edge-to-edge handling (\"adjustMarginsForEdgeToEdge\") insets the WebView\n     * via its layout margins, and SwipeRefreshLayout ignores child margins.\n     */\n    private void setupPullToRefresh() {\n        WebView webView = getBridge().getWebView();\n        if (!(webView.getParent() instanceof ViewGroup)) return;\n        ViewGroup parent = (ViewGroup) webView.getParent();\n\n        int index = parent.indexOfChild(webView);\n        ViewGroup.LayoutParams webViewParams = webView.getLayoutParams();\n        parent.removeView(webView);\n\n        FrameLayout container = new FrameLayout(this);\n        container.addView(webView, webViewParams instanceof ViewGroup.MarginLayoutParams\n                ? new FrameLayout.LayoutParams((ViewGroup.MarginLayoutParams) webViewParams)\n                : new FrameLayout.LayoutParams(\n                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n\n        swipeRefresh = new PullToRefreshLayout(this);\n        PullToRefreshPlugin gate = (PullToRefreshPlugin) getBridge()\n                .getPlugin(\"PullToRefresh\").getInstance();\n        swipeRefresh.setGate(new PullToRefreshLayout.Gate() {\n            @Override\n            public void onTouchDown() {\n                gate.onTouchDown();\n            }\n\n            @Override\n            public boolean canContentScrollUp() {\n                return gate.canContentScrollUp(webView);\n            }\n        });\n        swipeRefresh.addView(container, new ViewGroup.LayoutParams(\n                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n        parent.addView(swipeRefresh, index, new ViewGroup.LayoutParams(\n                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n\n        swipeRefresh.setOnRefreshListener(() -> {\n            mainHandler.removeCallbacks(stopRefreshing);\n            mainHandler.postDelayed(stopRefreshing, REFRESH_TIMEOUT_MS);\n            webView.reload();\n        });\n\n        getBridge().addWebViewListener(new WebViewListener() {\n            @Override\n            public void onPageLoaded(WebView view) {\n                finishRefresh();\n            }\n\n            @Override\n            public void onReceivedError(WebView view) {\n                finishRefresh();\n            }\n        });\n\n        // Keep the spinner below the status bar: under edge-to-edge (Android\n        // 15+) the WebView's top margin is the status bar height.\n        webView.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {\n            if (t != ot) v.post(this::applyRefreshIndicatorOffset);\n        });\n\n        // Re-dispatch insets so the WebView gets its edge-to-edge margins in\n        // its new parent.\n        ViewCompat.requestApplyInsets(swipeRefresh);\n    }\n\n    private void finishRefresh() {\n        mainHandler.removeCallbacks(stopRefreshing);\n        if (swipeRefresh != null && swipeRefresh.isRefreshing()) {\n            swipeRefresh.setRefreshing(false);\n        }\n        applyRefreshIndicatorOffset();\n    }\n\n    /** Positions the spinner relative to the top of the WebView. */\n    private void applyRefreshIndicatorOffset() {\n        // setProgressViewOffset() resets the indicator, so never call it while\n        // a refresh is showing; finishRefresh() calls this again afterwards.\n        if (swipeRefresh == null || swipeRefresh.isRefreshing()) return;\n        int top = getBridge().getWebView().getTop();\n        if (top == appliedIndicatorTop) return;\n        appliedIndicatorTop = top;\n\n        int restingDistance = Math.round(\n                REFRESH_INDICATOR_REST_DP * getResources().getDisplayMetrics().density);\n        swipeRefresh.setProgressViewOffset(false,\n                top - swipeRefresh.getProgressCircleDiameter(), top + restingDistance);\n    }\n\n    /** Spinner colours that follow the system light/dark mode. */\n    private void styleRefreshIndicator() {\n        if (swipeRefresh == null) return;\n        boolean darkMode = (getResources().getConfiguration().uiMode\n                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;\n        swipeRefresh.setProgressBackgroundColorSchemeColor(ContextCompat.getColor(\n                this, darkMode ? R.color.solyto_surface_dark : R.color.solyto_bg_light));\n        swipeRefresh.setColorSchemeColors(\n                ContextCompat.getColor(this, R.color.solyto_lightblue),\n                ContextCompat.getColor(this, R.color.solyto_green));\n    }\n\n    private void handleShareIntent(Intent intent) {\n        if (intent == null) return;\n        if (!Intent.ACTION_SEND.equals(intent.getAction())) return;\n        if (!\"text/plain\".equals(intent.getType())) return;\n\n        String sharedText = intent.getStringExtra(Intent.EXTRA_TEXT);\n        if (sharedText == null || sharedText.isEmpty()) return;\n\n        String encoded = android.net.Uri.encode(sharedText);\n        getBridge().getWebView().post(() ->\n            getBridge().getWebView().loadUrl(\"https://my.solyto.app/share?q=\" + encoded)\n        );\n    }\n\n    private void applySystemBarAppearance() {\n        // Edge-to-edge is only enforced on Android 15+ (API 35). On older\n        // versions the system bars are opaque and drawn by the framework.\n        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.VANILLA_ICE_CREAM) {\n            return;\n        }\n\n        boolean darkMode = (getResources().getConfiguration().uiMode\n                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;\n\n        // The WebView is inset by the system bar insets, so the area behind the\n        // transparent bars shows the window background. Match the web app's\n        // background color so there is no visible strip.\n        getWindow().setBackgroundDrawable(new ColorDrawable(ContextCompat.getColor(\n                this, darkMode ? R.color.solyto_bg_dark : R.color.solyto_bg_light)));\n\n        // Use dark bar icons on a light background and light icons on a dark one.\n        WindowInsetsControllerCompat controller =\n                WindowCompat.getInsetsController(getWindow(), getWindow().getDecorView());\n        controller.setAppearanceLightStatusBars(!darkMode);\n        controller.setAppearanceLightNavigationBars(!darkMode);\n    }\n}\npackage app.solyto;\n\nimport android.content.Context;\nimport android.view.MotionEvent;\nimport androidx.annotation.NonNull;\nimport androidx.swiperefreshlayout.widget.SwipeRefreshLayout;\n\n/**\n * SwipeRefreshLayout that tells the gate when a new touch starts.\n *\n * On ACTION_DOWN the page has not seen the touch yet, so the gate cannot know\n * whether a pull is allowed. The down event is always let through (so the\n * layout records the start position); the decision is made on the following\n * move events, once the page has answered.\n */\nclass PullToRefreshLayout extends SwipeRefreshLayout {\n\n    interface Gate {\n        void onTouchDown();\n\n        boolean canContentScrollUp();\n    }\n\n    private Gate gate;\n    private boolean handlingDown = false;\n\n    PullToRefreshLayout(@NonNull Context context) {\n        super(context);\n        setOnChildScrollUpCallback((parent, child) ->\n                !handlingDown && gate != null && gate.canContentScrollUp());\n    }\n\n    void setGate(Gate gate) {\n        this.gate = gate;\n    }\n\n    @Override\n    public boolean onInterceptTouchEvent(MotionEvent ev) {\n        if (ev.getActionMasked() != MotionEvent.ACTION_DOWN) {\n            return super.onInterceptTouchEvent(ev);\n        }\n        if (gate != null) gate.onTouchDown();\n        handlingDown = true;\n        try {\n            return super.onInterceptTouchEvent(ev);\n        } finally {\n            handlingDown = false;\n        }\n    }\n}\npackage app.solyto;\n\nimport android.os.SystemClock;\nimport android.webkit.JavascriptInterface;\nimport android.webkit.WebView;\nimport com.getcapacitor.Plugin;\nimport com.getcapacitor.WebViewListener;\nimport com.getcapacitor.annotation.CapacitorPlugin;\n\n/**\n * Decides whether a pull-down gesture may start a refresh.\n *\n * The web app never scrolls the document itself; content scrolls inside nested\n * elements, so the WebView always reports \"at top\". A small script injected\n * into each page checks, on every touchstart, whether anything under the finger\n * is scrolled down or is an overlay (modal, dialog, fixed sheet) or handles its\n * own touch gestures, and reports the result through a JavascriptInterface.\n *\n * This is a Capacitor plugin only so that the JavascriptInterface is added\n * during bridge setup, before the first page is loaded (interfaces added later\n * only show up after the next page load).\n */\n@CapacitorPlugin(name = \"PullToRefresh\")\npublic class PullToRefreshPlugin extends Plugin {\n\n    static final String JS_INTERFACE = \"SolytoPullToRefresh\";\n\n    // How long a touch waits for the page's answer before refresh is allowed\n    // anyway (e.g. the page's main thread is busy or the script failed).\n    private static final long JS_ANSWER_TIMEOUT_MS = 300;\n\n    private static final String SCRIPT = \"(function () {\"\n            + \"  var bridge = window.\" + JS_INTERFACE + \";\"\n            + \"  if (!bridge) return;\"\n            + \"  if (window.__solytoPullToRefresh) { bridge.ready(); return; }\"\n            + \"  window.__solytoPullToRefresh = true;\"\n            + \"  var OVERLAY = 'dialog[open], [role=\\\"dialog\\\"], [role=\\\"alertdialog\\\"], [aria-modal=\\\"true\\\"]';\"\n            + \"  function blocksPull(el) {\"\n            + \"    if (window.visualViewport && window.visualViewport.scale > 1.01) return true;\"\n            + \"    var root = document.scrollingElement;\"\n            + \"    if (root && root.scrollTop > 0) return true;\"\n            + \"    for (var n = el; n && n.nodeType === 1 && n !== document.documentElement; n = n.parentElement) {\"\n            + \"      if (n.scrollTop > 0) return true;\"\n            + \"      if (n.matches(OVERLAY)) return true;\"\n            + \"      var s = getComputedStyle(n);\"\n            + \"      if (s.position === 'fixed') return true;\"\n            + \"      var ta = s.touchAction;\"\n            + \"      if (ta && ta !== 'auto' && ta !== 'manipulation'\"\n            + \"          && ta.indexOf('pan-y') < 0 && ta.indexOf('pan-down') < 0) return true;\"\n            + \"    }\"\n            + \"    return false;\"\n            + \"  }\"\n            + \"  var blocked = false;\"\n            + \"  window.addEventListener('touchstart', function (e) {\"\n            + \"    var t = e.target;\"\n            + \"    if (t && t.nodeType !== 1) t = t.parentElement;\"\n            + \"    try { blocked = e.touches.length > 1 || blocksPull(t); } catch (err) { blocked = true; }\"\n            + \"    bridge.report(blocked);\"\n            + \"  }, { capture: true, passive: true });\"\n            // A page handler that calls preventDefault() on touchmove (drag and\n            // drop, custom gestures) owns the gesture. Check after all\n            // listeners have run.\n            + \"  window.addEventListener('touchmove', function (e) {\"\n            + \"    if (blocked) return;\"\n            + \"    setTimeout(function () {\"\n            + \"      if (e.defaultPrevented && !blocked) { blocked = true; bridge.report(true); }\"\n            + \"    }, 0);\"\n            + \"  }, { passive: true });\"\n            + \"  bridge.ready();\"\n            + \"})();\";\n\n    // Written from the JavaBridge thread, read on the main thread.\n    private volatile boolean scriptReady = false;\n    private volatile boolean answered = false;\n    private volatile boolean blocked = false;\n\n    // Main thread only.\n    private long touchDownTime = 0;\n\n    @Override\n    public void load() {\n        WebView webView = getBridge().getWebView();\n        webView.addJavascriptInterface(new JsInterface(), JS_INTERFACE);\n        getBridge().addWebViewListener(new WebViewListener() {\n            @Override\n            public void onPageStarted(WebView view) {\n                scriptReady = false;\n            }\n\n            @Override\n            public void onPageLoaded(WebView view) {\n                view.evaluateJavascript(SCRIPT, null);\n            }\n        });\n    }\n\n    /** Called on the main thread when a new touch sequence starts. */\n    void onTouchDown() {\n        answered = false;\n        blocked = false;\n        touchDownTime = SystemClock.uptimeMillis();\n    }\n\n    /**\n     * Whether the content under the finger can still scroll up (or otherwise\n     * owns the gesture), i.e. a pull must not start a refresh.\n     */\n    boolean canContentScrollUp(WebView webView) {\n        if (!scriptReady) {\n            // No script on this page (still loading, error page): fall back to\n            // the WebView's own scroll position.\n            return webView.canScrollVertically(-1);\n        }\n        if (!answered) {\n            // Wait briefly for the page's touchstart answer.\n            return SystemClock.uptimeMillis() - touchDownTime < JS_ANSWER_TIMEOUT_MS;\n        }\n        return blocked;\n    }\n\n    private class JsInterface {\n        @JavascriptInterface\n        public void ready() {\n            scriptReady = true;\n        }\n\n        @JavascriptInterface\n        public void report(boolean isBlocked) {\n            blocked = isBlocked;\n            answered = true;\n        }\n    }\n}\nMainActivity.java\nPullToRefreshLayout.java\nPullToRefreshPlugin.java","is_error":false}]},"parent_tool_use_id":null,"session_id":"8263a2d0-7a74-4d55-80cb-40597ee31eb7","uuid":"8238857b-7969-4e4a-b9b1-4cb19af9cb1c","timestamp":"2026-10-17T14:53:13.570Z","tool_use_result":{"stdout":"apply plugin: 'com.android.application'\n\nandroid {\n    namespace = \"app.solyto\"\n    compileSdk = rootProject.ext.compileSdkVersion\n    defaultConfig {\n        applicationId \"app.solyto\"\n        minSdkVersion rootProject.ext.minSdkVersion\n        targetSdkVersion rootProject.ext.targetSdkVersion\n        versionCode 10015\n        versionName \"1.0.15\"\n        testInstrumentationRunner \"androidx.test.runner.AndroidJUnitRunner\"\n        aaptOptions {\n             // Files and dirs to omit from the packaged assets dir, modified to accommodate modern web apps.\n             // Default: https://android.googlesource.com/platform/frameworks/base/+/282e181b58cf72b6ca770dc7ca5f91f135444502/tools/aapt/AaptAssets.cpp#61\n            ignoreAssetsPattern = '!.svn:!.git:!.ds_store:!*.scc:.*:!CVS:!thumbs.db:!picasa.ini:!*~'\n        }\n    }\n    signingConfigs {\n        release {\n            if (System.getenv(\"KEYSTORE_PATH\")) {\n                storeFile file(System.getenv(\"KEYSTORE_PATH\"))\n                storePassword System.getenv(\"STORE_PASSWORD\")\n                keyAlias System.getenv(\"KEY_ALIAS\")\n                keyPassword System.getenv(\"KEY_PASSWORD\")\n            }\n        }\n    }\n    buildTypes {\n        release {\n            minifyEnabled false\n            proguardFiles getDefaultProguardFile('proguard-android.txt'), 'proguard-rules.pro'\n            signingConfig signingConfigs.release\n        }\n    }\n}\n\nrepositories {\n    flatDir{\n        dirs '../capacitor-cordova-android-plugins/src/main/libs', 'libs'\n    }\n}\n\ndependencies {\n    implementation fileTree(include: ['*.jar'], dir: 'libs')\n    implementation \"androidx.appcompat:appcompat:$androidxAppCompatVersion\"\n    implementation \"androidx.coordinatorlayout:coordinatorlayout:$androidxCoordinatorLayoutVersion\"\n    implementation \"androidx.core:core-splashscreen:$coreSplashScreenVersion\"\n    implementation \"androidx.swiperefreshlayout:swiperefreshlayout:$androidxSwipeRefreshLayoutVersion\"\n    implementation project(':capacitor-android')\n    testImplementation \"junit:junit:$junitVersion\"\n    androidTestImplementation \"androidx.test.ext:junit:$androidxJunitVersion\"\n    androidTestImplementation \"androidx.test.espresso:espresso-core:$androidxEspressoCoreVersion\"\n    implementation project(':capacitor-cordova-android-plugins')\n}\n\napply from: 'capacitor.build.gradle'\next {\n    minSdkVersion = 24\n    compileSdkVersion = 36\n    targetSdkVersion = 36\n    androidxActivityVersion = '1.11.0'\n    androidxAppCompatVersion = '1.7.1'\n    androidxCoordinatorLayoutVersion = '1.3.0'\n    androidxCoreVersion = '1.17.0'\n    androidxFragmentVersion = '1.8.9'\n    coreSplashScreenVersion = '1.2.0'\n    androidxWebkitVersion = '1.14.0'\n    androidxSwipeRefreshLayoutVersion = '1.1.0'\n    junitVersion = '4.13.2'\n    androidxJunitVersion = '1.3.0'\n    androidxEspressoCoreVersion = '3.7.0'\n    cordovaAndroidVersion = '14.0.1'\n}<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\">\n\n    <application\n        android:allowBackup=\"true\"\n        android:icon=\"@mipmap/ic_launcher\"\n        android:label=\"@string/app_name\"\n        android:roundIcon=\"@mipmap/ic_launcher_round\"\n        android:supportsRtl=\"true\"\n        android:theme=\"@style/AppTheme\">\n\n        <activity\n            android:configChanges=\"orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density\"\n            android:name=\".MainActivity\"\n            android:label=\"@string/title_activity_main\"\n            android:theme=\"@style/AppTheme.NoActionBarLaunch\"\n            android:launchMode=\"singleTask\"\n            android:exported=\"true\">\n\n            <intent-filter>\n                <action android:name=\"android.intent.action.MAIN\" />\n                <category android:name=\"android.intent.category.LAUNCHER\" />\n            </intent-filter>\n\n            <intent-filter>\n                <action android:name=\"android.intent.action.SEND\" />\n                <category android:name=\"android.intent.category.DEFAULT\" />\n                <data android:mimeType=\"text/plain\" />\n            </intent-filter>\n\n            <intent-filter>\n                <action android:name=\"android.intent.action.VIEW\" />\n                <category android:name=\"android.intent.category.DEFAULT\" />\n                <category android:name=\"android.intent.category.BROWSABLE\" />\n                <data android:scheme=\"@string/custom_url_scheme\" />\n            </intent-filter>\n\n        </activity>\n\n        <provider\n            android:name=\"androidx.core.content.FileProvider\"\n            android:authorities=\"${applicationId}.fileprovider\"\n            android:exported=\"false\"\n            android:grantUriPermissions=\"true\">\n            <meta-data\n                android:name=\"android.support.FILE_PROVIDER_PATHS\"\n                android:resource=\"@xml/file_paths\"></meta-data>\n        </provider>\n    </application>\n\n    <!-- Permissions -->\n\n    <uses-permission android:name=\"android.permission.INTERNET\" />\n</manifest>\n{\n  \"appId\": \"app.solyto\",\n  \"appName\": \"solyto\",\n  \"webDir\": \"frontend/build\",\n  \"server\": {\n    \"androidScheme\": \"https\",\n    \"hostname\": \"my.solyto.app\"\n  },\n  \"android\": {\n    \"adjustMarginsForEdgeToEdge\": \"auto\"\n  }\n}\n{\n  \"name\": \"mobile\",\n  \"version\": \"1.0.15\",\n  \"description\": \"\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n  },\n  \"keywords\": [],\n  \"author\": \"\",\n  \"license\": \"ISC\",\n  \"type\": \"commonjs\",\n  \"devDependencies\": {\n    \"@capacitor/android\": \"^7.6.8\",\n    \"@capacitor/cli\": \"^7.6.8\",\n    \"@capacitor/core\": \"^7.6.8\"\n  }\n}\npackage app.solyto;\n\nimport android.content.Intent;\nimport android.content.res.Configuration;\nimport android.graphics.drawable.ColorDrawable;\nimport android.os.Build;\nimport android.os.Bundle;\nimport android.os.Handler;\nimport android.os.Looper;\nimport android.view.ViewGroup;\nimport android.webkit.WebView;\nimport android.widget.FrameLayout;\nimport androidx.core.content.ContextCompat;\nimport androidx.core.view.ViewCompat;\nimport androidx.core.view.WindowCompat;\nimport androidx.core.view.WindowInsetsControllerCompat;\nimport com.getcapacitor.BridgeActivity;\nimport com.getcapacitor.WebViewListener;\n\npublic class MainActivity extends BridgeActivity {\n\n    // Safety net: hide the spinner even if no page-load callback arrives.\n    private static final long REFRESH_TIMEOUT_MS = 15000;\n\n    private final Handler mainHandler = new Handler(Looper.getMainLooper());\n    private final Runnable stopRefreshing = this::finishRefresh;\n    // Where the spinner rests below the top of the WebView (SwipeRefreshLayout's default).\n    private static final int REFRESH_INDICATOR_REST_DP = 64;\n\n    private PullToRefreshLayout swipeRefresh;\n    private int appliedIndicatorTop = 0;\n\n    @Override\n    protected void onCreate(Bundle savedInstanceState) {\n        registerPlugin(PullToRefreshPlugin.class);\n        super.onCreate(savedInstanceState);\n        setupPullToRefresh();\n        handleShareIntent(getIntent());\n        applySystemBarAppearance();\n        styleRefreshIndicator();\n    }\n\n    @Override\n    protected void onNewIntent(Intent intent) {\n        super.onNewIntent(intent);\n        handleShareIntent(intent);\n    }\n\n    @Override\n    public void onConfigurationChanged(Configuration newConfig) {\n        super.onConfigurationChanged(newConfig);\n        applySystemBarAppearance();\n        styleRefreshIndicator();\n    }\n\n    /**\n     * Wraps the Capacitor WebView in a SwipeRefreshLayout so pulling down from\n     * the top reloads the page with the standard Material spinner.\n     * PullToRefreshPlugin decides whether a pull may start (see there).\n     *\n     * The WebView is put into an intermediate FrameLayout because Capacitor's\n     * edge-to-edge handling (\"adjustMarginsForEdgeToEdge\") insets the WebView\n     * via its layout margins, and SwipeRefreshLayout ignores child margins.\n     */\n    private void setupPullToRefresh() {\n        WebView webView = getBridge().getWebView();\n        if (!(webView.getParent() instanceof ViewGroup)) return;\n        ViewGroup parent = (ViewGroup) webView.getParent();\n\n        int index = parent.indexOfChild(webView);\n        ViewGroup.LayoutParams webViewParams = webView.getLayoutParams();\n        parent.removeView(webView);\n\n        FrameLayout container = new FrameLayout(this);\n        container.addView(webView, webViewParams instanceof ViewGroup.MarginLayoutParams\n                ? new FrameLayout.LayoutParams((ViewGroup.MarginLayoutParams) webViewParams)\n                : new FrameLayout.LayoutParams(\n                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n\n        swipeRefresh = new PullToRefreshLayout(this);\n        PullToRefreshPlugin gate = (PullToRefreshPlugin) getBridge()\n                .getPlugin(\"PullToRefresh\").getInstance();\n        swipeRefresh.setGate(new PullToRefreshLayout.Gate() {\n            @Override\n            public void onTouchDown() {\n                gate.onTouchDown();\n            }\n\n            @Override\n            public boolean canContentScrollUp() {\n                return gate.canContentScrollUp(webView);\n            }\n        });\n        swipeRefresh.addView(container, new ViewGroup.LayoutParams(\n                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n        parent.addView(swipeRefresh, index, new ViewGroup.LayoutParams(\n                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n\n        swipeRefresh.setOnRefreshListener(() -> {\n            mainHandler.removeCallbacks(stopRefreshing);\n            mainHandler.postDelayed(stopRefreshing, REFRESH_TIMEOUT_MS);\n            webView.reload();\n        });\n\n        getBridge().addWebViewListener(new WebViewListener() {\n            @Override\n            public void onPageLoaded(WebView view) {\n                finishRefresh();\n            }\n\n            @Override\n            public void onReceivedError(WebView view) {\n                finishRefresh();\n            }\n        });\n\n        // Keep the spinner below the status bar: under edge-to-edge (Android\n        // 15+) the WebView's top margin is the status bar height.\n        webView.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {\n            if (t != ot) v.post(this::applyRefreshIndicatorOffset);\n        });\n\n        // Re-dispatch insets so the WebView gets its edge-to-edge margins in\n        // its new parent.\n        ViewCompat.requestApplyInsets(swipeRefresh);\n    }\n\n    private void finishRefresh() {\n        mainHandler.removeCallbacks(stopRefreshing);\n        if (swipeRefresh != null && swipeRefresh.isRefreshing()) {\n            swipeRefresh.setRefreshing(false);\n        }\n        applyRefreshIndicatorOffset();\n    }\n\n    /** Positions the spinner relative to the top of the WebView. */\n    private void applyRefreshIndicatorOffset() {\n        // setProgressViewOffset() resets the indicator, so never call it while\n        // a refresh is showing; finishRefresh() calls this again afterwards.\n        if (swipeRefresh == null || swipeRefresh.isRefreshing()) return;\n        int top = getBridge().getWebView().getTop();\n        if (top == appliedIndicatorTop) return;\n        appliedIndicatorTop = top;\n\n        int restingDistance = Math.round(\n                REFRESH_INDICATOR_REST_DP * getResources().getDisplayMetrics().density);\n        swipeRefresh.setProgressViewOffset(false,\n                top - swipeRefresh.getProgressCircleDiameter(), top + restingDistance);\n    }\n\n    /** Spinner colours that follow the system light/dark mode. */\n    private void styleRefreshIndicator() {\n        if (swipeRefresh == null) return;\n        boolean darkMode = (getResources().getConfiguration().uiMode\n                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;\n        swipeRefresh.setProgressBackgroundColorSchemeColor(ContextCompat.getColor(\n                this, darkMode ? R.color.solyto_surface_dark : R.color.solyto_bg_light));\n        swipeRefresh.setColorSchemeColors(\n                ContextCompat.getColor(this, R.color.solyto_lightblue),\n                ContextCompat.getColor(this, R.color.solyto_green));\n    }\n\n    private void handleShareIntent(Intent intent) {\n        if (intent == null) return;\n        if (!Intent.ACTION_SEND.equals(intent.getAction())) return;\n        if (!\"text/plain\".equals(intent.getType())) return;\n\n        String sharedText = intent.getStringExtra(Intent.EXTRA_TEXT);\n        if (sharedText == null || sharedText.isEmpty()) return;\n\n        String encoded = android.net.Uri.encode(sharedText);\n        getBridge().getWebView().post(() ->\n            getBridge().getWebView().loadUrl(\"https://my.solyto.app/share?q=\" + encoded)\n        );\n    }\n\n    private void applySystemBarAppearance() {\n        // Edge-to-edge is only enforced on Android 15+ (API 35). On older\n        // versions the system bars are opaque and drawn by the framework.\n        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.VANILLA_ICE_CREAM) {\n            return;\n        }\n\n        boolean darkMode = (getResources().getConfiguration().uiMode\n                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;\n\n        // The WebView is inset by the system bar insets, so the area behind the\n        // transparent bars shows the window background. Match the web app's\n        // background color so there is no visible strip.\n        getWindow().setBackgroundDrawable(new ColorDrawable(ContextCompat.getColor(\n                this, darkMode ? R.color.solyto_bg_dark : R.color.solyto_bg_light)));\n\n        // Use dark bar icons on a light background and light icons on a dark one.\n        WindowInsetsControllerCompat controller =\n                WindowCompat.getInsetsController(getWindow(), getWindow().getDecorView());\n        controller.setAppearanceLightStatusBars(!darkMode);\n        controller.setAppearanceLightNavigationBars(!darkMode);\n    }\n}\npackage app.solyto;\n\nimport android.content.Context;\nimport android.view.MotionEvent;\nimport androidx.annotation.NonNull;\nimport androidx.swiperefreshlayout.widget.SwipeRefreshLayout;\n\n/**\n * SwipeRefreshLayout that tells the gate when a new touch starts.\n *\n * On ACTION_DOWN the page has not seen the touch yet, so the gate cannot know\n * whether a pull is allowed. The down event is always let through (so the\n * layout records the start position); the decision is made on the following\n * move events, once the page has answered.\n */\nclass PullToRefreshLayout extends SwipeRefreshLayout {\n\n    interface Gate {\n        void onTouchDown();\n\n        boolean canContentScrollUp();\n    }\n\n    private Gate gate;\n    private boolean handlingDown = false;\n\n    PullToRefreshLayout(@NonNull Context context) {\n        super(context);\n        setOnChildScrollUpCallback((parent, child) ->\n                !handlingDown && gate != null && gate.canContentScrollUp());\n    }\n\n    void setGate(Gate gate) {\n        this.gate = gate;\n    }\n\n    @Override\n    public boolean onInterceptTouchEvent(MotionEvent ev) {\n        if (ev.getActionMasked() != MotionEvent.ACTION_DOWN) {\n            return super.onInterceptTouchEvent(ev);\n        }\n        if (gate != null) gate.onTouchDown();\n        handlingDown = true;\n        try {\n            return super.onInterceptTouchEvent(ev);\n        } finally {\n            handlingDown = false;\n        }\n    }\n}\npackage app.solyto;\n\nimport android.os.SystemClock;\nimport android.webkit.JavascriptInterface;\nimport android.webkit.WebView;\nimport com.getcapacitor.Plugin;\nimport com.getcapacitor.WebViewListener;\nimport com.getcapacitor.annotation.CapacitorPlugin;\n\n/**\n * Decides whether a pull-down gesture may start a refresh.\n *\n * The web app never scrolls the document itself; content scrolls inside nested\n * elements, so the WebView always reports \"at top\". A small script injected\n * into each page checks, on every touchstart, whether anything under the finger\n * is scrolled down or is an overlay (modal, dialog, fixed sheet) or handles its\n * own touch gestures, and reports the result through a JavascriptInterface.\n *\n * This is a Capacitor plugin only so that the JavascriptInterface is added\n * during bridge setup, before the first page is loaded (interfaces added later\n * only show up after the next page load).\n */\n@CapacitorPlugin(name = \"PullToRefresh\")\npublic class PullToRefreshPlugin extends Plugin {\n\n    static final String JS_INTERFACE = \"SolytoPullToRefresh\";\n\n    // How long a touch waits for the page's answer before refresh is allowed\n    // anyway (e.g. the page's main thread is busy or the script failed).\n    private static final long JS_ANSWER_TIMEOUT_MS = 300;\n\n    private static final String SCRIPT = \"(function () {\"\n            + \"  var bridge = window.\" + JS_INTERFACE + \";\"\n            + \"  if (!bridge) return;\"\n            + \"  if (window.__solytoPullToRefresh) { bridge.ready(); return; }\"\n            + \"  window.__solytoPullToRefresh = true;\"\n            + \"  var OVERLAY = 'dialog[open], [role=\\\"dialog\\\"], [role=\\\"alertdialog\\\"], [aria-modal=\\\"true\\\"]';\"\n            + \"  function blocksPull(el) {\"\n            + \"    if (window.visualViewport && window.visualViewport.scale > 1.01) return true;\"\n            + \"    var root = document.scrollingElement;\"\n            + \"    if (root && root.scrollTop > 0) return true;\"\n            + \"    for (var n = el; n && n.nodeType === 1 && n !== document.documentElement; n = n.parentElement) {\"\n            + \"      if (n.scrollTop > 0) return true;\"\n            + \"      if (n.matches(OVERLAY)) return true;\"\n            + \"      var s = getComputedStyle(n);\"\n            + \"      if (s.position === 'fixed') return true;\"\n            + \"      var ta = s.touchAction;\"\n            + \"      if (ta && ta !== 'auto' && ta !== 'manipulation'\"\n            + \"          && ta.indexOf('pan-y') < 0 && ta.indexOf('pan-down') < 0) return true;\"\n            + \"    }\"\n            + \"    return false;\"\n            + \"  }\"\n            + \"  var blocked = false;\"\n            + \"  window.addEventListener('touchstart', function (e) {\"\n            + \"    var t = e.target;\"\n            + \"    if (t && t.nodeType !== 1) t = t.parentElement;\"\n            + \"    try { blocked = e.touches.length > 1 || blocksPull(t); } catch (err) { blocked = true; }\"\n            + \"    bridge.report(blocked);\"\n            + \"  }, { capture: true, passive: true });\"\n            // A page handler that calls preventDefault() on touchmove (drag and\n            // drop, custom gestures) owns the gesture. Check after all\n            // listeners have run.\n            + \"  window.addEventListener('touchmove', function (e) {\"\n            + \"    if (blocked) return;\"\n            + \"    setTimeout(function () {\"\n            + \"      if (e.defaultPrevented && !blocked) { blocked = true; bridge.report(true); }\"\n            + \"    }, 0);\"\n            + \"  }, { passive: true });\"\n            + \"  bridge.ready();\"\n            + \"})();\";\n\n    // Written from the JavaBridge thread, read on the main thread.\n    private volatile boolean scriptReady = false;\n    private volatile boolean answered = false;\n    private volatile boolean blocked = false;\n\n    // Main thread only.\n    private long touchDownTime = 0;\n\n    @Override\n    public void load() {\n        WebView webView = getBridge().getWebView();\n        webView.addJavascriptInterface(new JsInterface(), JS_INTERFACE);\n        getBridge().addWebViewListener(new WebViewListener() {\n            @Override\n            public void onPageStarted(WebView view) {\n                scriptReady = false;\n            }\n\n            @Override\n            public void onPageLoaded(WebView view) {\n                view.evaluateJavascript(SCRIPT, null);\n            }\n        });\n    }\n\n    /** Called on the main thread when a new touch sequence starts. */\n    void onTouchDown() {\n        answered = false;\n        blocked = false;\n        touchDownTime = SystemClock.uptimeMillis();\n    }\n\n    /**\n     * Whether the content under the finger can still scroll up (or otherwise\n     * owns the gesture), i.e. a pull must not start a refresh.\n     */\n    boolean canContentScrollUp(WebView webView) {\n        if (!scriptReady) {\n            // No script on this page (still loading, error page): fall back to\n            // the WebView's own scroll position.\n            return webView.canScrollVertically(-1);\n        }\n        if (!answered) {\n            // Wait briefly for the page's touchstart answer.\n            return SystemClock.uptimeMillis() - touchDownTime < JS_ANSWER_TIMEOUT_MS;\n        }\n        return blocked;\n    }\n\n    private class JsInterface {\n        @JavascriptInterface\n        public void ready() {\n            scriptReady = true;\n        }\n\n        @JavascriptInterface\n        public void report(boolean isBlocked) {\n            blocked = isBlocked;\n            answered = true;\n        }\n    }\n}\nMainAc