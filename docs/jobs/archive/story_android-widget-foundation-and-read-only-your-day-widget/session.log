{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BzChWYuHFTbr9DEnYss4yM","type":"tool_result","content":"1\tpackage app.solyto;\n2\t\n3\timport android.content.Intent;\n4\timport android.content.res.Configuration;\n5\timport android.graphics.Color;\n6\timport android.graphics.drawable.GradientDrawable;\n7\timport android.os.Build;\n8\timport android.os.Bundle;\n9\timport android.os.Handler;\n10\timport android.os.Looper;\n11\timport android.view.ViewGroup;\n12\timport android.view.Window;\n13\timport android.view.WindowManager;\n14\timport android.webkit.WebView;\n15\timport android.widget.FrameLayout;\n16\timport androidx.core.content.ContextCompat;\n17\timport androidx.core.graphics.ColorUtils;\n18\timport androidx.core.graphics.Insets;\n19\timport androidx.core.view.ViewCompat;\n20\timport androidx.core.view.WindowCompat;\n21\timport androidx.core.view.WindowInsetsCompat;\n22\timport androidx.core.view.WindowInsetsControllerCompat;\n23\timport com.getcapacitor.BridgeActivity;\n24\timport com.getcapacitor.WebViewListener;\n25\t\n26\tpublic class MainActivity extends BridgeActivity {\n27\t\n28\t    // Safety net: hide the spinner even if no page-load callback arrives.\n29\t    private static final long REFRESH_TIMEOUT_MS = 15000;\n30\t\n31\t    private final Handler mainHandler = new Handler(Looper.getMainLooper());\n32\t    private final Runnable stopRefreshing = this::finishRefresh;\n33\t    // Where the spinner rests below the top of the WebView (SwipeRefreshLayout's default).\n34\t    private static final int REFRESH_INDICATOR_REST_DP = 64;\n35\t\n36\t    private PullToRefreshLayout swipeRefresh;\n37\t    private int appliedIndicatorTop = 0;\n38\t    // Bar colours matching the page, reported by SystemBarsPlugin.\n39\t    private Integer pageStatusBarColor = null;\n40\t    private Integer pageNavigationBarColor = null;\n41\t\n42\t    @Override\n43\t    protected void onCreate(Bundle savedInstanceState) {\n44\t        registerPlugin(PullToRefreshPlugin.class);\n45\t        registerPlugin(SystemBarsPlugin.class);\n46\t        super.onCreate(savedInstanceState);\n47\t        applyKeyboardInsets();\n48\t        setupPullToRefresh();\n49\t        handleShareIntent(getIntent());\n50\t        applySystemBarAppearance();\n51\t        styleRefreshIndicator();\n52\t    }\n53\t\n54\t    @Override\n55\t    protected void onNewIntent(Intent intent) {\n56\t        super.onNewIntent(intent);\n57\t        handleShareIntent(intent);\n58\t    }\n59\t\n60\t    @Override\n61\t    public void onConfigurationChanged(Configuration newConfig) {\n62\t        super.onConfigurationChanged(newConfig);\n63\t        applySystemBarAppearance();\n64\t        styleRefreshIndicator();\n65\t    }\n66\t\n67\t    /**\n68\t     * Wraps the Capacitor WebView in a SwipeRefreshLayout so pulling down from\n69\t     * the top reloads the page with the standard Material spinner.\n70\t     * PullToRefreshPlugin decides whether a pull may start (see there).\n71\t     *\n72\t     * The WebView is put into an intermediate FrameLayout because Capacitor's\n73\t     * edge-to-edge handling (\"adjustMarginsForEdgeToEdge\") insets the WebView\n74\t     * via its layout margins, and SwipeRefreshLayout ignores child margins.\n75\t     */\n76\t    private void setupPullToRefresh() {\n77\t        WebView webView = getBridge().getWebView();\n78\t        if (!(webView.getParent() instanceof ViewGroup)) return;\n79\t        ViewGroup parent = (ViewGroup) webView.getParent();\n80\t\n81\t        int index = parent.indexOfChild(webView);\n82\t        ViewGroup.LayoutParams webViewParams = webView.getLayoutParams();\n83\t        parent.removeView(webView);\n84\t\n85\t        FrameLayout container = new FrameLayout(this);\n86\t        container.addView(webView, webViewParams instanceof ViewGroup.MarginLayoutParams\n87\t                ? new FrameLayout.LayoutParams((ViewGroup.MarginLayoutParams) webViewParams)\n88\t                : new FrameLayout.LayoutParams(\n89\t                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n90\t\n91\t        swipeRefresh = new PullToRefreshLayout(this);\n92\t        PullToRefreshPlugin gate = (PullToRefreshPlugin) getBridge()\n93\t                .getPlugin(\"PullToRefresh\").getInstance();\n94\t        swipeRefresh.setGate(new PullToRefreshLayout.Gate() {\n95\t            @Override\n96\t            public void onTouchDown() {\n97\t                gate.onTouchDown();\n98\t            }\n99\t\n100\t            @Override\n101\t            public boolean canContentScrollUp() {\n102\t                return gate.canContentScrollUp(webView);\n103\t            }\n104\t        });\n105\t        swipeRefresh.addView(container, new ViewGroup.LayoutParams(\n106\t                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n107\t        parent.addView(swipeRefresh, index, new ViewGroup.LayoutParams(\n108\t                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n109\t\n110\t        swipeRefresh.setOnRefreshListener(() -> {\n111\t            mainHandler.removeCallbacks(stopRefreshing);\n112\t            mainHandler.postDelayed(stopRefreshing, REFRESH_TIMEOUT_MS);\n113\t            webView.reload();\n114\t        });\n115\t\n116\t        getBridge().addWebViewListener(new WebViewListener() {\n117\t            @Override\n118\t            public void onPageLoaded(WebView view) {\n119\t                finishRefresh();\n120\t            }\n121\t\n122\t            @Override\n123\t            public void onReceivedError(WebView view) {\n124\t                finishRefresh();\n125\t            }\n126\t        });\n127\t\n128\t        // Keep the spinner below the status bar: under edge-to-edge (Android\n129\t        // 15+) the WebView's top margin is the status bar height.\n130\t        webView.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {\n131\t            if (t != ot) v.post(this::applyRefreshIndicatorOffset);\n132\t        });\n133\t\n134\t        // Re-dispatch insets so the WebView gets its edge-to-edge margins in\n135\t        // its new parent.\n136\t        ViewCompat.requestApplyInsets(swipeRefresh);\n137\t    }\n138\t\n139\t    /**\n140\t     * Replaces Capacitor's edge-to-edge insets listener with one that also\n141\t     * respects the keyboard. Under edge-to-edge (Android 15+) the window is no\n142\t     * longer resized for the keyboard and Capacitor only insets the WebView by\n143\t     * the system bars, so the keyboard covered the WebView and the page never\n144\t     * noticed it (visualViewport did not shrink). Insetting the bottom by the\n145\t     * keyboard height shrinks the WebView, so dvh-sized layouts such as the\n146\t     * bottom sheet end up above the keyboard.\n147\t     */\n148\t    private void applyKeyboardInsets() {\n149\t        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.VANILLA_ICE_CREAM) return;\n150\t\n151\t        ViewCompat.setOnApplyWindowInsetsListener(getBridge().getWebView(), (v, windowInsets) -> {\n152\t            Insets bars = windowInsets.getInsets(\n153\t                    WindowInsetsCompat.Type.systemBars() | WindowInsetsCompat.Type.displayCutout());\n154\t            Insets ime = windowInsets.getInsets(WindowInsetsCompat.Type.ime());\n155\t            ViewGroup.MarginLayoutParams mlp = (ViewGroup.MarginLayoutParams) v.getLayoutParams();\n156\t            mlp.leftMargin = bars.left;\n157\t            mlp.topMargin = bars.top;\n158\t            mlp.rightMargin = bars.right;\n159\t            mlp.bottomMargin = Math.max(bars.bottom, ime.bottom);\n160\t            v.setLayoutParams(mlp);\n161\t            return WindowInsetsCompat.CONSUMED;\n162\t        });\n163\t    }\n164\t\n165\t    private void finishRefresh() {\n166\t        mainHandler.removeCallbacks(stopRefreshing);\n167\t        if (swipeRefresh != null && swipeRefresh.isRefreshing()) {\n168\t            swipeRefresh.setRefreshing(false);\n169\t        }\n170\t        applyRefreshIndicatorOffset();\n171\t    }\n172\t\n173\t    /** Positions the spinner relative to the top of the WebView. */\n174\t    private void applyRefreshIndicatorOffset() {\n175\t        // setProgressViewOffset() resets the indicator, so never call it while\n176\t        // a refresh is showing; finishRefresh() calls this again afterwards.\n177\t        if (swipeRefresh == null || swipeRefresh.isRefreshing()) return;\n178\t        int top = getBridge().getWebView().getTop();\n179\t        if (top == appliedIndicatorTop) return;\n180\t        appliedIndicatorTop = top;\n181\t\n182\t        int restingDistance = Math.round(\n183\t                REFRESH_INDICATOR_REST_DP * getResources().getDisplayMetrics().density);\n184\t        swipeRefresh.setProgressViewOffset(false,\n185\t                top - swipeRefresh.getProgressCircleDiameter(), top + restingDistance);\n186\t    }\n187\t\n188\t    /** Spinner colours that follow the system light/dark mode. */\n189\t    private void styleRefreshIndicator() {\n190\t        if (swipeRefresh == null) return;\n191\t        boolean darkMode = (getResources().getConfiguration().uiMode\n192\t                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;\n193\t        swipeRefresh.setProgressBackgroundColorSchemeColor(ContextCompat.getColor(\n194\t                this, darkMode ? R.color.solyto_surface_dark : R.color.solyto_bg_light));\n195\t        swipeRefresh.setColorSchemeColors(\n196\t                ContextCompat.getColor(this, R.color.solyto_lightblue),\n197\t                ContextCompat.getColor(this, R.color.solyto_green));\n198\t    }\n199\t\n200\t    private void handleShareIntent(Intent intent) {\n201\t        if (intent == null) return;\n202\t        if (!Intent.ACTION_SEND.equals(intent.getAction())) return;\n203\t        if (!\"text/plain\".equals(intent.getType())) return;\n204\t\n205\t        String sharedText = intent.getStringExtra(Intent.EXTRA_TEXT);\n206\t        if (sharedText == null || sharedText.isEmpty()) return;\n207\t\n208\t        String encoded = android.net.Uri.encode(sharedText);\n209\t        getBridge().getWebView().post(() ->\n210\t            getBridge().getWebView().loadUrl(\"https://my.solyto.app/share?q=\" + encoded)\n211\t        );\n212\t    }\n213\t\n214\t    /** Called by SystemBarsPlugin; null when the page has no matching colours. */\n215\t    void setPageBarColors(Integer statusBarColor, Integer navigationBarColor) {\n216\t        pageStatusBarColor = statusBarColor;\n217\t        pageNavigationBarColor = navigationBarColor;\n218\t        applySystemBarAppearance();\n219\t    }\n220\t\n221\t    /**\n222\t     * Gives the system bars the colours reported by the page, falling back to\n223\t     * the default light/dark background (following the system's dark mode)\n224\t     * until the page reports them or when it has none.\n225\t     */\n226\t    private void applySystemBarAppearance() {\n227\t        boolean darkMode = (getResources().getConfiguration().uiMode\n228\t                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;\n229\t        int defaultColor = ContextCompat.getColor(\n230\t                this, darkMode ? R.color.solyto_bg_dark : R.color.solyto_bg_light);\n231\t        int statusBarColor = pageStatusBarColor != null ? pageStatusBarColor : defaultColor;\n232\t        int navigationBarColor = pageNavigationBarColor != null ? pageNavigationBarColor : defaultColor;\n233\t        boolean lightStatusBar = isLightColor(statusBarColor);\n234\t        boolean lightNavigationBar = isLightColor(navigationBarColor);\n235\t        Window window = getWindow();\n236\t\n237\t        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.VANILLA_ICE_CREAM) {\n238\t            // Edge-to-edge (Android 15+): the WebView is inset by the system\n239\t            // bar insets, so the area behind the transparent bars shows the\n240\t            // window background. Its middle is covered by the WebView.\n241\t            window.setBackgroundDrawable(new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,\n242\t                    new int[] { statusBarColor, statusBarColor, navigationBarColor, navigationBarColor }));\n243\t        } else {\n244\t            window.addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);\n245\t            window.setStatusBarColor(statusBarColor);\n246\t            // Dark navigation bar icons need Android 8; keep the bar black\n247\t            // below that rather than showing light icons on a light colour.\n248\t            window.setNavigationBarColor(\n249\t                    Build.VERSION.SDK_INT >= Build.VERSION_CODES.O || !lightNavigationBar\n250\t                            ? navigationBarColor : Color.BLACK);\n251\t        }\n252\t\n253\t        // The page sets no html/body background and sizes its container to\n254\t        // the whole-pixel window.innerHeight, so a sub-pixel strip of the\n255\t        // WebView's own (white) background shows below the page. Paint it\n256\t        // in the navigation bar colour instead.\n257\t        getBridge().getWebView().setBackgroundColor(navigationBarColor);\n258\t\n259\t        // Without this, the 3-button navigation bar gets a translucent scrim\n260\t        // over the colour.\n261\t        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {\n262\t            window.setNavigationBarContrastEnforced(false);\n263\t        }\n264\t\n265\t        WindowInsetsControllerCompat controller =\n266\t                WindowCompat.getInsetsController(window, window.getDecorView());\n267\t        controller.setAppearanceLightStatusBars(lightStatusBar);\n268\t        controller.setAppearanceLightNavigationBars(lightNavigationBar);\n269\t    }\n270\t\n271\t    /** Whether dark icons contrast better than light ones on this colour. */\n272\t    private static boolean isLightColor(int color) {\n273\t        return ColorUtils.calculateContrast(Color.BLACK, color)\n274\t                > ColorUtils.calculateContrast(Color.WHITE, color);\n275\t    }\n276\t}\n277\t"}]},"parent_tool_use_id":null,"session_id":"0e8c61e8-895f-4f65-b097-20b0f80cb23c","uuid":"6f2d3e70-e111-4752-9ffc-88fe8c75d32e","timestamp":"2026-10-29T16:42:49.469Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/android/app/src/main/java/app/solyto/MainActivity.java","content":"package app.solyto;\n\nimport android.content.Intent;\nimport android.content.res.Configuration;\nimport android.graphics.Color;\nimport android.graphics.drawable.GradientDrawable;\nimport android.os.Build;\nimport android.os.Bundle;\nimport android.os.Handler;\nimport android.os.Looper;\nimport android.view.ViewGroup;\nimport android.view.Window;\nimport android.view.WindowManager;\nimport android.webkit.WebView;\nimport android.widget.FrameLayout;\nimport androidx.core.content.ContextCompat;\nimport androidx.core.graphics.ColorUtils;\nimport androidx.core.graphics.Insets;\nimport androidx.core.view.ViewCompat;\nimport androidx.core.view.WindowCompat;\nimport androidx.core.view.WindowInsetsCompat;\nimport androidx.core.view.WindowInsetsControllerCompat;\nimport com.getcapacitor.BridgeActivity;\nimport com.getcapacitor.WebViewListener;\n\npublic class MainActivity extends BridgeActivity {\n\n    // Safety net: hide the spinner even if no page-load callback arrives.\n    private static final long REFRESH_TIMEOUT_MS = 15000;\n\n    private final Handler mainHandler = new Handler(Looper.getMainLooper());\n    private final Runnable stopRefreshing = this::finishRefresh;\n    // Where the spinner rests below the top of the WebView (SwipeRefreshLayout's default).\n    private static final int REFRESH_INDICATOR_REST_DP = 64;\n\n    private PullToRefreshLayout swipeRefresh;\n    private int appliedIndicatorTop = 0;\n    // Bar colours matching the page, reported by SystemBarsPlugin.\n    private Integer pageStatusBarColor = null;\n    private Integer pageNavigationBarColor = null;\n\n    @Override\n    protected void onCreate(Bundle savedInstanceState) {\n        registerPlugin(PullToRefreshPlugin.class);\n        registerPlugin(SystemBarsPlugin.class);\n        super.onCreate(savedInstanceState);\n        applyKeyboardInsets();\n        setupPullToRefresh();\n        handleShareIntent(getIntent());\n        applySystemBarAppearance();\n        styleRefreshIndicator();\n    }\n\n    @Override\n    protected void onNewIntent(Intent intent) {\n        super.onNewIntent(intent);\n        handleShareIntent(intent);\n    }\n\n    @Override\n    public void onConfigurationChanged(Configuration newConfig) {\n        super.onConfigurationChanged(newConfig);\n        applySystemBarAppearance();\n        styleRefreshIndicator();\n    }\n\n    /**\n     * Wraps the Capacitor WebView in a SwipeRefreshLayout so pulling down from\n     * the top reloads the page with the standard Material spinner.\n     * PullToRefreshPlugin decides whether a pull may start (see there).\n     *\n     * The WebView is put into an intermediate FrameLayout because Capacitor's\n     * edge-to-edge handling (\"adjustMarginsForEdgeToEdge\") insets the WebView\n     * via its layout margins, and SwipeRefreshLayout ignores child margins.\n     */\n    private void setupPullToRefresh() {\n        WebView webView = getBridge().getWebView();\n        if (!(webView.getParent() instanceof ViewGroup)) return;\n        ViewGroup parent = (ViewGroup) webView.getParent();\n\n        int index = parent.indexOfChild(webView);\n        ViewGroup.LayoutParams webViewParams = webView.getLayoutParams();\n        parent.removeView(webView);\n\n        FrameLayout container = new FrameLayout(this);\n        container.addView(webView, webViewParams instanceof ViewGroup.MarginLayoutParams\n                ? new FrameLayout.LayoutParams((ViewGroup.MarginLayoutParams) webViewParams)\n                : new FrameLayout.LayoutParams(\n                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n\n        swipeRefresh = new PullToRefreshLayout(this);\n        PullToRefreshPlugin gate = (PullToRefreshPlugin) getBridge()\n                .getPlugin(\"PullToRefresh\").getInstance();\n        swipeRefresh.setGate(new PullToRefreshLayout.Gate() {\n            @Override\n            public void onTouchDown() {\n                gate.onTouchDown();\n            }\n\n            @Override\n            public boolean canContentScrollUp() {\n                return gate.canContentScrollUp(webView);\n            }\n        });\n        swipeRefresh.addView(container, new ViewGroup.LayoutParams(\n                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n        parent.addView(swipeRefresh, index, new ViewGroup.LayoutParams(\n                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n\n        swipeRefresh.setOnRefreshListener(() -> {\n            mainHandler.removeCallbacks(stopRefreshing);\n            mainHandler.postDelayed(stopRefreshing, REFRESH_TIMEOUT_MS);\n            webView.reload();\n        });\n\n        getBridge().addWebViewListener(new WebViewListener() {\n            @Override\n            public void onPageLoaded(WebView view) {\n                finishRefresh();\n            }\n\n            @Override\n            public void onReceivedError(WebView view) {\n                finishRefresh();\n            }\n        });\n\n        // Keep the spinner below the status bar: under edge-to-edge (Android\n        // 15+) the WebView's top margin is the status bar height.\n        webView.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {\n            if (t != ot) v.post(this::applyRefreshIndicatorOffset);\n        });\n\n        // Re-dispatch insets so the WebView gets its edge-to-edge margins in\n        // its new parent.\n        ViewCompat.requestApplyInsets(swipeRefresh);\n    }\n\n    /**\n     * Replaces Capacitor's edge-to-edge insets listener with one that also\n     * respects the keyboard. Under edge-to-edge (Android 15+) the window is no\n     * longer resized for the keyboard and Capacitor only insets the WebView by\n     * the system bars, so the keyboard covered the WebView and the page never\n     * noticed it (visualViewport did not shrink). Insetting the bottom by the\n     * keyboard height shrinks the WebView, so dvh-sized layouts such as the\n     * bottom sheet end up above the keyboard.\n     */\n    private void applyKeyboardInsets() {\n        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.VANILLA_ICE_CREAM) return;\n\n        ViewCompat.setOnApplyWindowInsetsListener(getBridge().getWebView(), (v, windowInsets) -> {\n            Insets bars = windowInsets.getInsets(\n                    WindowInsetsCompat.Type.systemBars() | WindowInsetsCompat.Type.displayCutout());\n            Insets ime = windowInsets.getInsets(WindowInsetsCompat.Type.ime());\n            ViewGroup.MarginLayoutParams mlp = (ViewGroup.MarginLayoutParams) v.getLayoutParams();\n            mlp.leftMargin = bars.left;\n            mlp.topMargin = bars.top;\n            mlp.rightMargin = bars.right;\n            mlp.bottomMargin = Math.max(bars.bottom, ime.bottom);\n            v.setLayoutParams(mlp);\n            return WindowInsetsCompat.CONSUMED;\n        });\n    }\n\n    private void finishRefresh() {\n        mainHandler.removeCallbacks(stopRefreshing);\n        if (swipeRefresh != null && swipeRefresh.isRefreshing()) {\n            swipeRefresh.setRefreshing(false);\n        }\n        applyRefreshIndicatorOffset();\n    }\n\n    /** Positions the spinner relative to the top of the WebView. */\n    private void applyRefreshIndicatorOffset() {\n        // setProgressViewOffset() resets the indicator, so never call it while\n        // a refresh is showing; finishRefresh() calls this again afterwards.\n        if (swipeRefresh == null || swipeRefresh.isRefreshing()) return;\n        int top = getBridge().getWebView().getTop();\n        if (top == appliedIndicatorTop) return;\n        appliedIndicatorTop = top;\n\n        int restingDistance = Math.round(\n                REFRESH_INDICATOR_REST_DP * getResources().getDisplayMetrics().density);\n        swipeRefresh.setProgressViewOffset(false,\n                top - swipeRefresh.getProgressCircleDiameter(), top + restingDistance);\n    }\n\n    /** Spinner colours that follow the system light/dark mode. */\n    private void styleRefreshIndicator() {\n        if (swipeRefresh == null) return;\n        boolean darkMode = (getResources().getConfiguration().uiMode\n                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;\n        swipeRefresh.setProgressBackgroundColorSchemeColor(ContextCompat.getColor(\n                this, darkMode ? R.color.solyto_surface_dark : R.color.solyto_bg_light));\n        swipeRefresh.setColorSchemeColors(\n                ContextCompat.getColor(this, R.color.solyto_lightblue),\n                ContextCompat.getColor(this, R.color.solyto_green));\n    }\n\n    private void handleShareIntent(Intent intent) {\n        if (intent == null) return;\n        if (!Intent.ACTION_SEND.equals(intent.getAction())) return;\n        if (!\"text/plain\".equals(intent.getType())) return;\n\n        String sharedText = intent.getStringExtra(Intent.EXTRA_TEXT);\n        if (sharedText == null || sharedText.isEmpty()) return;\n\n        String encoded = android.net.Uri.encode(sharedText);\n        getBridge().getWebView().post(() ->\n            getBridge().getWebView().loadUrl(\"https://my.solyto.app/share?q=\" + encoded)\n        );\n    }\n\n    /** Called by SystemBarsPlugin; null when the page has no matching colours. */\n    void setPageBarColors(Integer statusBarColor, Integer navigationBarColor) {\n        pageStatusBarColor = statusBarColor;\n        pageNavigationBarColor = navigationBarColor;\n        applySystemBarAppearance();\n    }\n\n    /**\n     * Gives the system bars the colours reported by the page, falling back to\n     * the default light/dark background (following the system's dark mode)\n     * until the page reports them or when it has none.\n     */\n    private void applySystemBarAppearance() {\n        boolean darkMode = (getResources().getConfiguration().uiMode\n                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;\n        int defaultColor = ContextCompat.getColor(\n                this, darkMode ? R.color.solyto_bg_dark : R.color.solyto_bg_light);\n        int statusBarColor = pageStatusBarColor != null ? pageStatusBarColor : defaultColor;\n        int navigationBarColor = pageNavigationBarColor != null ? pageNavigationBarColor : defaultColor;\n        boolean lightStatusBar = isLightColor(statusBarColor);\n        boolean lightNavigationBar = isLightColor(navigationBarColor);\n        Window window = getWindow();\n\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.VANILLA_ICE_CREAM) {\n            // Edge-to-edge (Android 15+): the WebView is inset by the system\n            // bar insets, so the area behind the transparent bars shows the\n            // window background. Its middle is covered by the WebView.\n            window.setBackgroundDrawable(new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,\n                    new int[] { statusBarColor, statusBarColor, navigationBarColor, navigationBarColor }));\n        } else {\n            window.addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);\n            window.setStatusBarColor(statusBarColor);\n            // Dark navigation bar icons need Android 8; keep the bar black\n            // below that rather than showing light icons on a light colour.\n            window.setNavigationBarColor(\n                    Build.VERSION.SDK_INT >= Build.VERSION_CODES.O || !lightNavigationBar\n                            ? navigationBarColor : Color.BLACK);\n        }\n\n        // The page sets no html/body background and sizes its container to\n        // the whole-pixel window.innerHeight, so a sub-pixel strip of the\n        // WebView's own (white) background shows below the page. Paint it\n        // in the navigation bar colour instead.\n        getBridge().getWebView().setBackgroundColor(navigationBarColor);\n\n        // Without this, the 3-button navigation bar gets a translucent scrim\n        // over the colour.\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {\n            window.setNavigationBarContrastEnforced(false);\n        }\n\n        WindowInsetsControllerCompat controller =\n                WindowCompat.getInsetsController(window, window.getDecorView());\n        controller.setAppearanceLightStatusBars(lightStatusBar);\n        controller.setAppearanceLightNavigationBars(lightNavigationBar);\n    }\n\n    /** Whether dark icons contrast better than light ones on this colour. */\n    private static boolean isLightColor(int color) {\n        return ColorUtils.calculateContrast(Color.BLACK, color)\n                > ColorUtils.calculateContrast(Color.WHITE, color);\n    }\n}\n","numLines":277,"startLine":1,"totalLines":277}},"tool_result_meta":[{"id":"toolu_01BzChWYuHFTbr9DEnYss4yM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
