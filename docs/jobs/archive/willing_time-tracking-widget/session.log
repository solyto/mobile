{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0132t4QriPndcrdS444dqMb7","type":"tool_result","content":"1\tpackage app.solyto.widget;\n2\t\n3\timport java.util.ArrayList;\n4\timport java.util.Arrays;\n5\timport java.util.Collections;\n6\timport java.util.HashSet;\n7\timport java.util.List;\n8\timport java.util.Set;\n9\timport java.util.regex.Pattern;\n10\timport org.json.JSONArray;\n11\timport org.json.JSONObject;\n12\t\n13\t/**\n14\t * Widget data (schema version 1), the format all widget kinds share,\n15\t * flattened into section headers and rows. Unknown sections, icons and fields\n16\t * are ignored and malformed rows skipped. All text is display-ready from the server.\n17\t */\n18\tfinal class WidgetPayload {\n19\t\n20\t    static final int SCHEMA_VERSION = 1;\n21\t\n22\t    private static final Set<String> ICONS = new HashSet<>(Arrays.asList(\"event\", \"todo\"));\n23\t    private static final int MAX_ROWS_PER_SECTION = 20;\n24\t    private static final int MAX_TEXT_LENGTH = 500;\n25\t\n26\t    /** Row action UI types native can render; rows with other types get no control. */\n27\t    static final String ACTION_CHECK = \"check\";\n28\t    private static final Pattern ACTION_KEY = Pattern.compile(\"[a-z][a-z0-9_.-]*\");\n29\t    private static final int MAX_ACTION_KEY_LENGTH = 64;\n30\t    // Path-segment safe and covers the UUIDs the server sends.\n31\t    private static final Pattern ROW_ID = Pattern.compile(\"[A-Za-z0-9-]{1,64}\");\n32\t\n33\t    static final class Item {\n34\t        final boolean isHeader;\n35\t        final String title;\n36\t        final String subtitle;\n37\t        final String timeLabel;\n38\t        /** \"event\", \"todo\" or null. */\n39\t        final String icon;\n40\t        final String routeKey;\n41\t        final String routeId;\n42\t        /** The row id; only set together with an action. */\n43\t        final String id;\n44\t        /** A known action type ({@link #ACTION_CHECK}) or null when the row has no action. */\n45\t        final String actionType;\n46\t        final String actionKey;\n47\t        final boolean actionChecked;\n48\t\n49\t        Item(boolean isHeader, String title, String subtitle, String timeLabel, String icon,\n50\t                String routeKey, String routeId, String id, String actionType, String actionKey,\n51\t                boolean actionChecked) {\n52\t            this.isHeader = isHeader;\n53\t            this.title = title;\n54\t            this.subtitle = subtitle;\n55\t            this.timeLabel = timeLabel;\n56\t            this.icon = icon;\n57\t            this.routeKey = routeKey;\n58\t            this.routeId = routeId;\n59\t            this.id = id;\n60\t            this.actionType = actionType;\n61\t            this.actionKey = actionKey;\n62\t            this.actionChecked = actionChecked;\n63\t        }\n64\t    }\n65\t\n66\t    final String title;\n67\t    final String emptyLabel;\n68\t    final List<Item> items;\n69\t    /** Epoch millis when the data goes stale, or -1. */\n70\t    final long refreshAt;\n71\t\n72\t    private WidgetPayload(String title, String emptyLabel, List<Item> items, long refreshAt) {\n73\t        this.title = title;\n74\t        this.emptyLabel = emptyLabel;\n75\t        this.items = items;\n76\t        this.refreshAt = refreshAt;\n77\t    }\n78\t\n79\t    static boolean isValidActionKey(String key) {\n80\t        return key != null && key.length() <= MAX_ACTION_KEY_LENGTH && ACTION_KEY.matcher(key).matches();\n81\t    }\n82\t\n83\t    static boolean isValidRowId(String id) {\n84\t        return id != null && ROW_ID.matcher(id).matches();\n85\t    }\n86\t\n87\t    /** The row with this id and action, or null. */\n88\t    Item findAction(String type, String key, String id) {\n89\t        for (Item item : items) {\n90\t            if (item.actionType != null && item.actionType.equals(type)\n91\t                    && item.actionKey.equals(key) && item.id.equals(id)) {\n92\t                return item;\n93\t            }\n94\t        }\n95\t        return null;\n96\t    }\n97\t\n98\t    static boolean isNewerSchema(JSONObject data) {\n99\t        return data.optInt(\"schema_version\", SCHEMA_VERSION) > SCHEMA_VERSION;\n100\t    }\n101\t\n102\t    /** Null when the data is not a payload of this kind this version can read. */\n103\t    static WidgetPayload parse(JSONObject data, WidgetKind kind) {\n104\t        if (data == null || !kind.id.equals(data.optString(\"kind\")) || isNewerSchema(data)) return null;\n105\t\n106\t        JSONObject labels = data.optJSONObject(\"labels\");\n107\t        String title = labels != null ? text(labels, \"title\") : null;\n108\t        String emptyLabel = labels != null ? text(labels, \"empty\") : null;\n109\t\n110\t        List<Item> items = new ArrayList<>();\n111\t        JSONArray sections = data.optJSONArray(\"sections\");\n112\t        if (sections != null) {\n113\t            for (int i = 0; i < sections.length(); i++) {\n114\t                JSONObject section = sections.optJSONObject(i);\n115\t                if (section == null || !kind.sectionKeys.contains(section.optString(\"key\"))) continue;\n116\t                addSection(items, section);\n117\t            }\n118\t        }\n119\t\n120\t        return new WidgetPayload(title, emptyLabel, Collections.unmodifiableList(items),\n121\t                IsoTime.parse(data.optString(\"refresh_at\", null)));\n122\t    }\n123\t\n124\t    private static void addSection(List<Item> items, JSONObject section) {\n125\t        JSONArray rows = section.optJSONArray(\"rows\");\n126\t        if (rows == null) return;\n127\t\n128\t        List<Item> sectionRows = new ArrayList<>();\n129\t        for (int i = 0; i < rows.length() && sectionRows.size() < MAX_ROWS_PER_SECTION; i++) {\n130\t            Item row = parseRow(rows.optJSONObject(i));\n131\t            if (row != null) sectionRows.add(row);\n132\t        }\n133\t        if (sectionRows.isEmpty()) return;\n134\t\n135\t        String sectionTitle = text(section, \"title\");\n136\t        if (sectionTitle != null) items.add(new Item(true, sectionTitle, null, null, null, null, null, null, null, null, false));\n137\t        items.addAll(sectionRows);\n138\t    }\n139\t\n140\t    private static Item parseRow(JSONObject row) {\n141\t        if (row == null) return null;\n142\t        String title = text(row, \"title\");\n143\t        if (title == null) return null;\n144\t\n145\t        String icon = row.optString(\"icon\", null);\n146\t        if (!ICONS.contains(icon)) icon = null;\n147\t\n148\t        String routeKey = null;\n149\t        String routeId = null;\n150\t        JSONObject route = row.optJSONObject(\"route\");\n151\t        if (route != null) {\n152\t            routeKey = text(route, \"key\");\n153\t            routeId = text(route, \"id\");\n154\t        }\n155\t\n156\t        String id = null;\n157\t        String actionType = null;\n158\t        String actionKey = null;\n159\t        boolean actionChecked = false;\n160\t        JSONObject action = row.optJSONObject(\"action\");\n161\t        String rowId = text(row, \"id\");\n162\t        if (action != null && isValidRowId(rowId)) {\n163\t            String type = text(action, \"type\");\n164\t            String key = text(action, \"key\");\n165\t            if (ACTION_CHECK.equals(type) && isValidActionKey(key)) {\n166\t                id = rowId;\n167\t                actionType = type;\n168\t                actionKey = key;\n169\t                actionChecked = action.optBoolean(\"checked\", false);\n170\t            }\n171\t        }\n172\t\n173\t        return new Item(false, title, text(row, \"subtitle\"), text(row, \"time_label\"), icon, routeKey, routeId,\n174\t                id, actionType, actionKey, actionChecked);\n175\t    }\n176\t\n177\t    /** A non-empty string field, cut to a sane length, or null. */\n178\t    private static String text(JSONObject object, String name) {\n179\t        Object valu