<?xml version="1.0" encoding="utf-8"?>
<!--
    An own yes/no tracker: name, then the check. Laid out on the rating rows' grid
    (five equal cells, 2dp margins each side): the name takes four cells, so the
    check sits under the last rating button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_log_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingBottom="4dp">

    <!-- Four cells: their weight plus the margins of four buttons. -->
    <TextView
        android:id="@+id/widget_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_weight="4"
        android:ellipsize="end"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:singleLine="true"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/widget_toggle"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginHorizontal="2dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:scaleType="fitCenter" />
</LinearLayout>
