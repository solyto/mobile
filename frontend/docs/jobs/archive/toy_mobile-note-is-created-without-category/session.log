{"type":"tool_use","timestamp":1788619916492,"sessionID":"ses_f8df34085ffedgwCvVGAM3ECYG","part":{"type":"tool","tool":"read","callID":"call_8f2b8acb1670426c948a8028","state":{"status":"completed","input":{"filePath":"/workspace/tests/unit/services/TodoFilterService.test.ts"},"output":"<path>/workspace/tests/unit/services/TodoFilterService.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, it, expect } from 'vitest';\n2: import TodoFilterService from '$lib/services/TodoFilterService';\n3: import type { Todo, TodoCategory, TodoWorkspace } from '$lib/types/todo';\n4: import type { Tag } from '$lib/types/tag';\n5: \n6: function todo(overrides: Partial<Todo> = {}): Todo {\n7: \treturn {\n8: \t\tid: '1',\n9: \t\ttitle: 'Test todo',\n10: \t\tdescription: '',\n11: \t\tlink: null,\n12: \t\tpriority: 'medium',\n13: \t\tstatus: 'pending',\n14: \t\teffort: null,\n15: \t\tprogress: null,\n16: \t\tis_completed: false,\n17: \t\tdue_at: '',\n18: \t\tcategory: null,\n19: \t\ttags: [],\n20: \t\tsubtasks: [],\n21: \t\trelevance: null,\n22: \t\trecurrence_frequency: null,\n23: \t\trecurrence_interval: 1,\n24: \t\trecurrence_ends_at: null,\n25: \t\tparent_task_id: null,\n26: \t\tauto_generated: false,\n27: \t\tcreated_at: '',\n28: \t\tupdated_at: '',\n29: \t\tcompleted_at: '',\n30: \t\t...overrides\n31: \t};\n32: }\n33: \n34: function category(id: number, title = 'Category'): TodoCategory {\n35: \treturn { id, title, created_at: '', updated_at: '' };\n36: }\n37: \n38: function tag(id: number, name = 'tag'): Tag {\n39: \treturn { id, name, color: '#000000', created_at: '', updated_at: '' };\n40: }\n41: \n42: function workspace(id: number, categories: TodoCategory[], hideable = false): TodoWorkspace {\n43: \treturn { id, title: 'WS', is_hideable: hideable, categories, created_at: '', updated_at: '' };\n44: }\n45: \n46: const service = new TodoFilterService();\n47: \n48: describe('filterByPriority', () => {\n49: \tit('keeps only todos with the matching priority', () => {\n50: \t\tconst todos = [\n51: \t\t\ttodo({ priority: 'high' }),\n52: \t\t\ttodo({ priority: 'low' }),\n53: \t\t\ttodo({ priority: 'high' })\n54: \t\t];\n55: \t\texpect(service.filterByPriority('high', todos)).toHaveLength(2);\n56: \t\texpect(service.filterByPriority('low', todos)).toHaveLength(1);\n57: \t\texpect(service.filterByPriority('medium', todos)).toHaveLength(0);\n58: \t});\n59: });\n60: \n61: describe('filterByStatus', () => {\n62: \tit('keeps only todos with the matching status', () => {\n63: \t\tconst todos = [\n64: \t\t\ttodo({ status: 'pending' }),\n65: \t\t\ttodo({ status: 'in-progress' }),\n66: \t\t\ttodo({ status: 'backlog' })\n67: \t\t];\n68: \t\texpect(service.filterByStatus('pending', todos)).toHaveLength(1);\n69: \t\texpect(service.filterByStatus('in-progress', todos)).toHaveLength(1);\n70: \t\texpect(service.filterByStatus('backlog', todos)).toHaveLength(1);\n71: \t});\n72: });\n73: \n74: describe('filterByEffort', () => {\n75: \tit('matches todos with the given effort', () => {\n76: \t\tconst todos = [todo({ effort: 'low' }), todo({ effort: 'high' }), todo({ effort: null })];\n77: \t\texpect(service.filterByEffort('low', todos)).toHaveLength(1);\n78: \t\texpect(service.filterByEffort('high', todos)).toHaveLength(1);\n79: \t});\n80: \n81: \tit('treats null effort as medium', () => {\n82: \t\tconst todos = [todo({ effort: null }), todo({ effort: 'medium' }), todo({ effort: 'low' })];\n83: \t\texpect(service.filterByEffort('medium', todos)).toHaveLength(2);\n84: \t});\n85: });\n86: \n87: describe('filterOutBacklog', () => {\n88: \tit('removes backlog todos and keeps the rest', () => {\n89: \t\tconst todos = [\n90: \t\t\ttodo({ status: 'backlog' }),\n91: \t\t\ttodo({ status: 'pending' }),\n92: \t\t\ttodo({ status: 'backlog' })\n93: \t\t];\n94: \t\texpect(service.filterOutBacklog(todos)).toHaveLength(1);\n95: \t\texpect(service.filterOutBacklog(todos)[0].status).toBe('pending');\n96: \t});\n97: });\n98: \n99: describe('filterByDueDate', () => {\n100: \t// TZ=UTC (set in vitest.config.ts) so YYYY-MM-DD strings parse as midnight local\n101: \tconst todayStr = new Date().toISOString().split('T')[0];\n102: \tconst tomorrowStr = (() => {\n103: \t\tconst d = new Date();\n104: \t\td.setDate(d.getDate() + 1);\n105: \t\treturn d.toISOString().split('T')[0];\n106: \t})();\n107: \n108: \tit('filters by today', () => {\n109: \t\tconst todos = [\n110: \t\t\ttodo({ due_at: todayStr }),\n111: \t\t\ttodo({ due_at: '2099-01-01' }),\n112: \t\t\ttodo({ due_at: '' })\n113: \t\t];\n114: \t\tconst result = service.filterByDueDate('today', todos);\n115: \t\texpect(result).toHaveLength(1);\n116: \t\texpect(result[0].due_at).toBe(todayStr);\n117: \t});\n118: \n119: \tit('filters by tomorrow', () => {\n120: \t\tconst todos = [todo({ due_at: tomorrowStr }), todo({ due_at: todayStr })];\n121: \t\texpect(service.filterByDueDate('tomorrow', todos)).toHaveLength(1);\n122: \t});\n123: \n124: \tit('filters overdue (past dates only)', () => {\n125: \t\tconst todos = [todo({ due_at: '2000-01-01' }), todo({ due_at: '2099-01-01' })];\n126: \t\texpect(service.filterByDueDate('overdue', todos)).toHaveLength(1);\n127: \t});\n128: \n129: \tit('filters today-overdue (today and past combined)', () => {\n130: \t\tconst todos = [\n131: \t\t\ttodo({ due_at: todayStr }),\n132: \t\t\ttodo({ due_at: '2000-01-01' }),\n133: \t\t\ttodo({ due_at: '2099-01-01' })\n134: \t\t];\n135: \t\texpect(service.filterByDueDate('today-overdue', todos)).toHaveLength(2);\n136: \t});\n137: \n138: \tit('excludes todos with an empty due date', () => {\n139: \t\texpect(service.filterByDueDate('today', [todo({ due_at: '' })])).toHaveLength(0);\n140: \t});\n141: });\n142: \n143: describe('filterByCategory', () => {\n144: \tit('keeps only todos in the given category', () => {\n145: \t\tconst cat1 = category(1);\n146: \t\tconst cat2 = category(2);\n147: \t\tconst todos = [\n148: \t\t\ttodo({ category: cat1 }),\n149: \t\t\ttodo({ category: cat2 }),\n150: \t\t\ttodo({ category: null })\n151: \t\t];\n152: \t\texpect(service.filterByCategory(1, todos)).toHaveLength(1);\n153: \t\texpect(service.filterByCategory(99, todos)).toHaveLength(0);\n154: \t});\n155: });\n156: \n157: describe('filterByTag', () => {\n158: \tit('keeps todos that have the given tag', () => {\n159: \t\tconst t1 = tag(10);\n160: \t\tconst t2 = tag(20);\n161: \t\tconst todos = [todo({ tags: [t1, t2] }), todo({ tags: [t2] }), todo({ tags: [] })];\n162: \t\texpect(service.filterByTag(10, todos)).toHaveLength(1);\n163: \t\texpect(service.filterByTag(20, todos)).toHaveLength(2);\n164: \t\texpect(service.filterByTag(99, todos)).toHaveLength(0);\n165: \t});\n166: });\n167: \n168: describe('filterByWorkspace', () => {\n169: \tit('keeps todos whose category belongs to the workspace', () => {\n170: \t\tconst cat1 = category(1);\n171: \t\tconst cat2 = category(2);\n172: \t\tconst ws = workspace(1, [cat1]);\n173: \t\tconst todos = [\n174: \t\t\ttodo({ category: cat1 }),\n175: \t\t\ttodo({ category: cat2 }),\n176: \t\t\ttodo({ category: null })\n177: \t\t];\n178: \t\texpect(service.filterByWorkspace(ws, todos)).toHaveLength(1);\n179: \t});\n180: });\n181: \n182: describe('filterByHideIt', () => {\n183: \tit('hides todos whose category is in a hideable workspace', () => {\n184: \t\tconst cat = category(1);\n185: \t\tconst hideable = workspace(1, [cat], true);\n186: \t\tconst todos = [\n187: \t\t\ttodo({ category: cat }),\n188: \t\t\ttodo({ category: category(2) }),\n189: \t\t\ttodo({ category: null })\n190: \t\t];\n191: \t\tconst result = service.filterByHideIt(todos, [hideable]);\n192: \t\texpect(result).toHaveLength(2);\n193: \t\texpect(result.every((t) => t.category?.id !== 1)).toBe(true);\n194: \t});\n195: \n196: \tit('keeps todos with no category regardless of workspaces', () => {\n197: \t\tconst hideable = workspace(1, [category(1)], true);\n198: \t\texpect(service.filterByHideIt([todo({ category: null })], [hideable])).toHaveLength(1);\n199: \t});\n200: \n201: \tit('does not hide todos from non-hideable workspaces', () => {\n202: \t\tconst cat = category(1);\n203: \t\tconst visible = workspace(1, [cat], false);\n204: \t\texpect(service.filterByHideIt([todo({ category: cat })], [visible])).toHaveLength(1);\n205: \t});\n206: });\n207: \n208: describe('filter (dispatch)', () => {\n209: \tit('routes priority filter correctly', () => {\n210: \t\tconst todos = [todo({ priority: 'high' }), todo({ priority: 'low' })];\n211: \t\texpect(service.filter({ type: 'priority', value: 'high' }, todos)).toHaveLength(1);\n212: \t});\n213: \n214: \tit('routes status filter correctly', () => {\n215: \t\tconst todos = [todo({ status: 'pending' }), todo({ status: 'backlog' })];\n216: \t\texpect(service.filter({ type: 'status', value: 'pending' }, todos)).toHaveLength(1);\n217: \t});\n218: \n219: \tit('returns all todos for unknown filter type', () => {\n220: \t\t// @ts-expect-error testing fallback path\n221: \t\texpect(service.filter({ type: 'unknown', value: '' }, [todo(), todo()])).toHaveLength(2);\n222: \t});\n223: });\n224: \n225: describe('filterByDueDate (week)', () => {\n226: \tit('keeps only todos due within the current week', () => {\n227: \t\t// isDateThisWeek uses a Sunday-start week: today - getDay() to +6 days\n228: \t\tconst now = new Date();\n229: \t\tconst startOfWeek = new Date(now);\n230: \t\tstartOfWeek.setDate(now.getDate() - now.getDay());\n231: \t\tconst endOfWeek = new Date(now);\n232: \t\tendOfWeek.setDate(startOfWeek.getDate() + 6);\n233: \n234: \t\tconst todos = [\n235: \t\t\ttodo({ due_at: startOfWeek.toISOString().split('T')[0] }),\n236: \t\t\ttodo({ due_at: endOfWeek.toISOString().split('T')[0] }),\n237: \t\t\ttodo({ due_at: '2099-01-01' }),\n238: \t\t\ttodo({ due_at: '' })\n239: \t\t];\n240: \n241: \t\texpect(service.filterByDueDate('week', todos)).toHaveLength(2);\n242: \t});\n243: \n244: \tit('routes the week filter through the dispatch method', () => {\n245: \t\tconst now = new Date();\n246: \t\tconst todos = [\n247: \t\t\ttodo({ due_at: now.toISOString().split('T')[0] }),\n248: \t\t\ttodo({ due_at: '2099-01-01' })\n249: \t\t];\n250: \t\texpect(service.filter({ type: 'due', value: 'week' }, todos)).toHaveLength(1);\n251: \t});\n252: });\n253: \n254: describe('filterCategoriesByHideIt', () => {\n255: \tit('removes categories that belong to a hideable workspace', () => {\n256: \t\tconst cat1 = category(1);\n257: \t\tconst cat2 = category(2);\n258: \t\tconst hideable = workspace(1, [cat1], true);\n259: \t\tconst visible = workspace(2, [cat2], false);\n260: \n261: \t\tconst result = service.filterCategoriesByHideIt(\n262: \t\t\t[cat1, cat2, category(3)],\n263: \t\t\t[hideable, visible]\n264: \t\t);\n265: \t\texpect(result.map((c) => c.id)).toEqual([2, 3]);\n266: \t});\n267: \n268: \tit('keeps all categories when no workspace is hideable', () => {\n269: \t\tconst cats = [category(1), category(2)];\n270: \t\texpect(\n271: \t\t\tservice.filterCategoriesByHideIt(cats, [workspace(1, [cats[0]], false)])\n272: \t\t).toHaveLength(2);\n273: \t});\n274: \n275: \tit('keeps categories not assigned to any hideable workspace', () => {\n276: \t\tconst cat = category(1);\n277: \t\tconst result = service.filterCategoriesByHideIt([cat], [workspace(1, [category(9)], true)]);\n278: \t\texpect(result.map((c) => c.id)).toEqual([1]);\n279: \t});\n280: });\n\n(End of file - total 280 lines)\n</content>","metadata":{"preview":"import { describe, it, expect } from 'vitest';\nimport TodoFilterService from '$lib/services/TodoFilterService';\nimport type { Todo, TodoCategory, TodoWorkspace } from '$lib/types/todo';\nimport type { Tag } from '$lib/types/tag';\n\nfunction todo(overrides: Partial<Todo> = {}): Todo {\n\treturn {\n\t\tid: '1',\n\t\ttitle: 'Test todo',\n\t\tdescription: '',\n\t\tlink: null,\n\t\tpriority: 'medium',\n\t\tstatus: 'pending',\n\t\teffort: null,\n\t\tprogress: null,\n\t\tis_completed: false,\n\t\tdue_at: '',\n\t\tcategory: null,\n\t\ttags: [],\n\t\tsubtasks: [],","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/tests/unit/services/TodoFilterService.test.ts","text":"import { describe, it, expect } from 'vitest';\nimport TodoFilterService from '$lib/services/TodoFilterService';\nimport type { Todo, TodoCategory, TodoWorkspace } from '$lib/types/todo';\nimport type { Tag } from '$lib/types/tag';\n\nfunction todo(overrides: Partial<Todo> = {}): Todo {\n\treturn {\n\t\tid: '1',\n\t\ttitle: 'Test todo',\n\t\tdescription: '',\n\t\tlink: null,\n\t\tpriority: 'medium',\n\t\tstatus: 'pending',\n\t\teffort: null,\n\t\tprogress: null,\n\t\tis_completed: false,\n\t\tdue_at: '',\n\t\tcategory: null,\n\t\ttags: [],\n\t\tsubtasks: [],\n\t\trelevance: null,\n\t\trecurrence_frequency: null,\n\t\trecurrence_interval: 1,\n\t\trecurrence_ends_at: null,\n\t\tparent_task_id: null,\n\t\tauto_generated: false,\n\t\tcreated_at: '',\n\t\tupdated_at: '',\n\t\tcompleted_at: '',\n\t\t...overrides\n\t};\n}\n\nfunction category(id: number, title = 'Category'): TodoCategory {\n\treturn { id, title, created_at: '', updated_at: '' };\n}\n\nfunction tag(id: number, name = 'tag'): Tag {\n\treturn { id, name, color: '#000000', created_at: '', updated_at: '' };\n}\n\nfunction workspace(id: number, categories: TodoCategory[], hideable = false): TodoWorkspace {\n\treturn { id, title: 'WS', is_hideable: hideable, categories, created_at: '', updated_at: '' };\n}\n\nconst service = new TodoFilterService();\n\ndescribe('filterByPriority', () => {\n\tit('keeps only todos with the matching priority', () => {\n\t\tconst todos = [\n\t\t\ttodo({ priority: 'high' }),\n\t\t\ttodo({ priority: 'low' }),\n\t\t\ttodo({ priority: 'high' })\n\t\t];\n\t\texpect(service.filterByPriority('high', todos)).toHaveLength(2);\n\t\texpect(service.filterByPriority('low', todos)).toHaveLength(1);\n\t\texpect(service.filterByPriority('medium', todos)).toHaveLength(0);\n\t});\n});\n\ndescribe('filterByStatus', () => {\n\tit('keeps only todos with the matching status', () => {\n\t\tconst todos = [\n\t\t\ttodo({ status: 'pending' }),\n\t\t\ttodo({ status: 'in-progress' }),\n\t\t\ttodo({ status: 'backlog' })\n\t\t];\n\t\texpect(service.filterByStatus('pending', todos)).toHaveLength(1);\n\t\texpect(service.filterByStatus('in-progress', todos)).toHaveLength(1);\n\t\texpect(service.filterByStatus('backlog', todos)).toHaveLength(1);\n\t});\n});\n\ndescribe('filterByEffort', () => {\n\tit('matches todos with the given effort', () => {\n\t\tconst todos = [todo({ effort: 'low' }), todo({ effort: 'high' }), todo({ effort: null })];\n\t\texpect(service.filterByEffort('low', todos)).toHaveLength(1);\n\t\texpect(service.filterByEffort('high', todos)).toHaveLength(1);\n\t});\n\n\tit('treats null effort as medium', () => {\n\t\tconst todos = [todo({ effort: null }), todo({ effort: 'medium' }), todo({ effort: 'low' })];\n\t\texpect(service.filterByEffort('medium', todos)).toHaveLength(2);\n\t});\n});\n\ndescribe('filterOutBacklog', () => {\n\tit('removes backlog todos and keeps the rest', () => {\n\t\tconst todos = [\n\t\t\ttodo({ status: 'backlog' }),\n\t\t\ttodo({ status: 'pending' }),\n\t\t\ttodo({ status: 'backlog' })\n\t\t];\n\t\texpect(service.filterOutBacklog(todos)).toHaveLength(1);\n\t\texpect(service.filterOutBacklog(todos)[0].status).toBe('pending');\n\t});\n});\n\ndescribe('filterByDueDate', () => {\n\t// TZ=UTC (set in vitest.config.ts) so YYYY-MM-DD strings parse as midnight local\n\tconst todayStr = new Date().toISOString().split('T')[0];\n\tconst tomorrowStr = (() => {\n\t\tconst d = new Date();\n\t\td.setDate(d.getDate() + 1);\n\t\treturn d.toISOString().split('T')[0];\n\t})();\n\n\tit('filters by today', () => {\n\t\tconst todos = [\n\t\t\ttodo({ due_at: todayStr }),\n\t\t\ttodo({ due_at: '2099-01-01' }),\n\t\t\ttodo({ due_at: '' })\n\t\t];\n\t\tconst result = service.filterByDueDate('today', todos);\n\t\texpect(result).toHaveLength(1);\n\t\texpect(result[0].due_at).toBe(todayStr);\n\t});\n\n\tit('filters by tomorrow', () => {\n\t\tconst todos = [todo({ due_at: tomorrowStr }), todo({ due_at: todayStr })];\n\t\texpect(service.filterByDueDate('tomorrow', todos)).toHaveLength(1);\n\t});\n\n\tit('filters overdue (past dates only)', () => {\n\t\tconst todos = [todo({ due_at: '2000-01-01' }), todo({ due_at: '2099-01-01' })];\n\t\texpect(service.filterByDueDate('overdue', todos)).toHaveLength(1);\n\t});\n\n\tit('filters today-overdue (today and past combined)', () => {\n\t\tconst todos = [\n\t\t\ttodo({ due_at: todayStr }),\n\t\t\ttodo({ due_at: '2000-01-01' }),\n\t\t\ttodo({ due_at: '2099-01-01' })\n\t\t];\n\t\texpect(service.filterByDueDate('today-overdue', todos)).toHaveLength(2);\n\t});\n\n\tit('excludes todos with an empty due date', () => {\n\t\texpect(service.filterByDueDate('today', [todo({ due_at: '' })])).toHaveLength(0);\n\t});\n});\n\ndescribe('filterByCategory', () => {\n\tit('keeps only todos in the given category', () => {\n\t\tconst cat1 = category(1);\n\t\tconst cat2 = category(2);\n\t\tconst todos = [\n\t\t\ttodo({ category: cat1 }),\n\t\t\ttodo({ category: cat2 }),\n\t\t\ttodo({ category: null })\n\t\t];\n\t\texpect(service.filterByCategory(1, todos)).toHaveLength(1);\n\t\texpect(service.filterByCategory(99, todos)).toHaveLength(0);\n\t});\n});\n\ndescribe('filterByTag', () => {\n\tit('keeps todos that have the given tag', () => {\n\t\tconst t1 = tag(10);\n\t\tconst t2 = tag(20);\n\t\tconst todos = [todo({ tags: [t1, t2] }), todo({ tags: [t2] }), todo({ tags: [] })];\n\t\texpect(service.filterByTag(10, todos)).toHaveLength(1);\n\t\texpect(service.filterByTag(20, todos)).toHaveLength(2);\n\t\texpect(service.filterByTag(99, todos)).toHaveLength(0);\n\t});\n});\n\ndescribe('filterByWorkspace', () => {\n\tit('keeps todos whose category belongs to the workspace', () => {\n\t\tconst cat1 = category(1);\n\t\tconst cat2 = category(2);\n\t\tconst ws = workspace(1, [cat1]);\n\t\tconst todos = [\n\t\t\ttodo({ category: cat1 }),\n\t\t\ttodo({ category: cat2 }),\n\t\t\ttodo({ category: null })\n\t\t];\n\t\texpect(service.filterByWorkspace(ws, todos)).toHaveLength(1);\n\t});\n});\n\ndescribe('filterByHideIt', () => {\n\tit('hides todos whose category is in a hideable workspace', () => {\n\t\tconst cat = category(1);\n\t\tconst hideable = workspace(1, [cat], true);\n\t\tconst todos = [\n\t\t\ttodo({ category: cat }),\n\t\t\ttodo({ category: category(2) }),\n\t\t\ttodo({ category: null })\n\t\t];\n\t\tconst result = service.filterByHideIt(todos, [hideable]);\n\t\texpect(result).toHaveLength(2);\n\t\texpect(result.every((t) => t.category?.id !== 1)).toBe(true);\n\t});\n\n\tit('keeps todos with no category regardless of workspaces', () => {\n\t\tconst hideable = workspace(1, [category(1)], true);\n\t\texpect(service.filterByHideIt([todo({ category: null })], [hideable])).toHaveLength(1);\n\t});\n\n\tit('does not hide todos from non-hideable workspaces', () => {\n\t\tconst cat = category(1);\n\t\tconst visible = workspace(1, [cat], false);\n\t\texpect(service.filterByHideIt([todo({ category: cat })], [visible])).toHaveLength(1);\n\t});\n});\n\ndescribe('filter (dispatch)', () => {\n\tit('routes priority filter correctly', () => {\n\t\tconst todos = [todo({ priority: 'high' }), todo({ priority: 'low' })];\n\t\texpect(service.filter({ type: 'priority', value: 'high' }, todos)).toHaveLength(1);\n\t});\n\n\tit('routes status filter correctly', () => {\n\t\tconst todos = [todo({ status: 'pending' }), todo({ status: 'backlog' })];\n\t\texpect(service.filter({ type: 'status', value: 'pending' }, todos)).toHaveLength(1);\n\t});\n\n\tit('returns all todos for unknown filter type', () => {\n\t\t// @ts-expect-error testing fallback path\n\t\texpect(service.filter({ type: 'unknown', value: '' }, [todo(), todo()])).toHaveLength(2);\n\t});\n});\n\ndescribe('filterByDueDate (week)', () => {\n\tit('keeps only todos due within the current week', () => {\n\t\t// isDateThisWeek uses a Sunday-start week: today - getDay() to +6 days\n\t\tconst now = new Date();\n\t\tconst startOfWeek = new Date(now);\n\t\tstartOfWeek.setDate(now.getDate() - now.getDay());\n\t\tconst endOfWeek = new Date(now);\n\t\tendOfWeek.setDate(startOfWeek.getDate() + 6);\n\n\t\tconst todos = [\n\t\t\ttodo({ due_at: startOfWeek.toISOString().split('T')[0] }),\n\t\t\ttodo({ due_at: endOfWeek.toISOString().split('T')[0] }),\n\t\t\ttodo({ due_at: '2099-01-01' }),\n\t\t\ttodo({ due_at: '' })\n\t\t];\n\n\t\texpect(service.filterByDueDate('week', todos)).toHaveLength(2);\n\t});\n\n\tit('routes the week filter through the dispatch method', () => {\n\t\tconst now = new Date();\n\t\tconst todos = [\n\t\t\ttodo({ due_at: now.toISOString().split('T')[0] }),\n\t\t\ttodo({ due_at: '2099-01-01' })\n\t\t];\n\t\texpect(service.filter({ type: 'due', value: 'week' }, todos)).toHaveLength(1);\n\t});\n});\n\ndescribe('filterCategoriesByHideIt', () => {\n\tit('removes categories that belong to a hideable workspace', () => {\n\t\tconst cat1 = category(1);\n\t\tconst cat2 = category(2);\n\t\tconst hideable = workspace(1, [cat1], true);\n\t\tconst visible = workspace(2, [cat2], false);\n\n\t\tconst result = service.filterCategoriesByHideIt(\n\t\t\t[cat1, cat2, category(3)],\n\t\t\t[hideable, visible]\n\t\t);\n\t\texpect(result.map((c) => c.id)).toEqual([2, 3]);\n\t});\n\n\tit('keeps all categories when no workspace is hideable', () => {\n\t\tconst cats = [category(1), category(2)];\n\t\texpect(\n\t\t\tservice.filterCategoriesByHideIt(cats, [workspace(1, [cats[0]], false)])\n\t\t).toHaveLength(2);\n\t});\n\n\tit('keeps categories not assigned to any hideable workspace', () => {\n\t\tconst cat = category(1);\n\t\tconst result = service.filterCategoriesByHideIt([cat], [workspace(1, [category(9)], true)]);\n\t\texpect(result.map((c) => c.id)).toEqual([1]);\n\t});\n});","lineStart":1,"lineEnd":280,"totalLines":280,"truncated":false}},"title":"tests/unit/services/TodoFilterService.test.ts","time":{"start":1788619916484,"end":1788619916489}},"id":"prt_0720e03e7001OZfPAb6P5s2pi4","sessionID":"ses_f8df34085ffedgwCvVGAM3ECYG","messageID":"msg_0720