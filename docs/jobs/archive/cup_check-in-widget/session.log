{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018eTHdYcaPSmsdLMTgnGnj4","type":"tool_result","content":"1\tpackage app.solyto.widget;\n2\t\n3\timport android.content.Context;\n4\timport android.os.Build;\n5\timport androidx.work.BackoffPolicy;\n6\timport androidx.work.Data;\n7\timport androidx.work.ExistingPeriodicWorkPolicy;\n8\timport androidx.work.ExistingWorkPolicy;\n9\timport androidx.work.OneTimeWorkRequest;\n10\timport androidx.work.OutOfQuotaPolicy;\n11\timport androidx.work.PeriodicWorkRequest;\n12\timport androidx.work.WorkManager;\n13\timport java.util.concurrent.TimeUnit;\n14\t\n15\t/**\n16\t * Schedules widget fetches and row actions. Work only exists while a widget\n17\t * is placed. WorkManager stores input data unencrypted, so it never holds the\n18\t * token: workers read it from {@link WidgetTokenStore}.\n19\t */\n20\tpublic final class WidgetWork {\n21\t\n22\t    private static final String PERIODIC = \"widget-fetch-periodic\";\n23\t    private static final String NOW = \"widget-fetch-now\";\n24\t    private static final String AT_REFRESH = \"widget-fetch-at-refresh\";\n25\t    private static final String ACTION_TAG = \"widget-action\";\n26\t    private static final String ACTION_PREFIX = \"widget-action-\";\n27\t\n28\t    private static final long PERIOD_MINUTES = 60;\n29\t    private static final long BACKOFF_MINUTES = 5;\n30\t    // Fetch shortly after refresh_at (the next local midnight), not right at it.\n31\t    private static final long REFRESH_AT_DELAY_MS = 60_000;\n32\t\n33\t    private WidgetWork() {}\n34\t\n35\t    /**\n36\t     * Keeps the periodic fetch scheduled. Keeping a periodic job pending also\n37\t     * stops WorkManager from toggling its components when all work is done,\n38\t     * which would make launchers send another widget update.\n39\t     */\n40\t    static void schedulePeriodic(Context context) {\n41\t        PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(\n42\t                WidgetFetchWorker.class, PERIOD_MINUTES, TimeUnit.MINUTES)\n43\t                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n44\t                .build();\n45\t        WorkManager.getInstance(context).enqueueUniquePeriodicWork(\n46\t                PERIODIC, ExistingPeriodicWorkPolicy.KEEP, request);\n47\t    }\n48\t\n49\t    /** A fetch as soon as possible; a newer request replaces a pending one. */\n50\t    public static void fetchNow(Context context) {\n51\t        if (!WidgetKind.anyPlaced(context)) return;\n52\t        WorkManager.getInstance(context).enqueueUniqueWork(NOW, ExistingWorkPolicy.REPLACE, oneTime(0));\n53\t    }\n54\t\n55\t    /** A fetch at a kind's refresh_at (epoch millis). */\n56\t    static void fetchAt(Context context, WidgetKind kind, long refreshAt) {\n57\t        long delay = Math.max(0, refreshAt - System.currentTimeMillis()) + REFRESH_AT_DELAY_MS;\n58\t        WorkManager.getInstance(context).enqueueUniqueWork(\n59\t                atRefresh(kind), ExistingWorkPolicy.REPLACE, oneTime(delay));\n60\t    }\n61\t\n62\t    /** Runs a row action once; while one is enqueued or running for this row, further requests are ignored. */\n63\t    static void runAction(Context context, WidgetKind kind, String key, String id) {\n64\t        OneTimeWorkRequest.Builder builder = new OneTimeWorkRequest.Builder(WidgetActionWorker.class)\n65\t                .addTag(ACTION_TAG)\n66\t                .setInputData(new Data.Builder()\n67\t                        .putString(WidgetActionWorker.INPUT_KIND, kind.id)\n68\t                        .putString(WidgetActionWorker.INPUT_KEY, key)\n69\t                        .putString(WidgetActionWorker.INPUT_ID, id)\n70\t                        .build());\n71\t        // Below API 31, expedited work runs as a foreground service with a notification.\n72\t        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {\n73\t            builder.setExpedited(OutOfQuotaPolicy.RUN_AS_NON_EXPEDITED_WORK_REQUEST);\n74\t        }\n75\t        WorkManager.getInstance(context).enqueueUniqueWork(\n76\t                ACTION_PREFIX + kind.id + \"-\" + id, ExistingWorkPolicy.KEEP, builder.build());\n77\t    }\n78\t\n79\t    /** Called when a provider's last widget is removed: stops all work once no kind is placed. */\n80\t    static void cancelIfNoWidgets(Context context) {\n81\t        if (!WidgetKind.anyPlaced(context)) cancelAll(context);\n82\t    }\n83\t\n84\t    private static void cancelAll(Context context) {\n85\t        WorkManager workManager = WorkManager.getInstance(context);\n86\t        workManager.cancelUniqueWork(PERIODIC);\n87\t        workManager.cancelUniqueWork(NOW);\n88\t        // AT_REFRESH alone is the name builds before widget kinds used.\n89\t        workManager.cancelUniqueWork(AT_REFRESH);\n90\t        for (WidgetKind kind : WidgetKind.values()) workManager.cancelUniqueWork(atRefresh(kind));\n91\t        workManager.cancelAllWorkByTag(ACTION_TAG);\n92\t    }\n93\t\n94\t    private static String atRefresh(WidgetKind kind) {\n95\t        return AT_REFRESH + \"-\" + kind.id;\n96\t    }\n97\t\n98\t    private static OneTimeWorkRequest oneTime(long delayMillis) {\n99\t        return new OneTimeWorkRequest.Builder(WidgetFetchWorker.class)\n100\t                .setInitialDelay(delayMillis, TimeUnit.MILLISECONDS)\n101\t                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n102\t                .build();\n103\t    }\n104\t}\n105\t"}]},"parent_tool_use_id":null,"session_id":"06ad74aa-1ba4-4cae-8c42-95d32284c601","uuid":"bc7f3d45-299e-462f-b1cf-7e233898f14d","timestamp":"2026-10-29T20:52:04.978Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/android/app/src/main/java/app/solyto/widget/WidgetWork.java","content":"package app.solyto.widget;\n\nimport android.content.Context;\nimport android.os.Build;\nimport androidx.work.BackoffPolicy;\nimport androidx.work.Data;\nimport androidx.work.ExistingPeriodicWorkPolicy;\nimport androidx.work.ExistingWorkPolicy;\nimport androidx.work.OneTimeWorkRequest;\nimport androidx.work.OutOfQuotaPolicy;\nimport androidx.work.PeriodicWorkRequest;\nimport androidx.work.WorkManager;\nimport java.util.concurrent.TimeUnit;\n\n/**\n * Schedules widget fetches and row actions. Work only exists while a widget\n * is placed. WorkManager stores input data unencrypted, so it never holds the\n * token: workers read it from {@link WidgetTokenStore}.\n */\npublic final class WidgetWork {\n\n    private static final String PERIODIC = \"widget-fetch-periodic\";\n    private static final String NOW = \"widget-fetch-now\";\n    private static final String AT_REFRESH = \"widget-fetch-at-refresh\";\n    private static final String ACTION_TAG = \"widget-action\";\n    private static final String ACTION_PREFIX = \"widget-action-\";\n\n    private static final long PERIOD_MINUTES = 60;\n    private static final long BACKOFF_MINUTES = 5;\n    // Fetch shortly after refresh_at (the next local midnight), not right at it.\n    private static final long REFRESH_AT_DELAY_MS = 60_000;\n\n    private WidgetWork() {}\n\n    /**\n     * Keeps the periodic fetch scheduled. Keeping a periodic job pending also\n     * stops WorkManager from toggling its components when all work is done,\n     * which would make launchers send another widget update.\n     */\n    static void schedulePeriodic(Context context) {\n        PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(\n                WidgetFetchWorker.class, PERIOD_MINUTES, TimeUnit.MINUTES)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n        WorkManager.getInstance(context).enqueueUniquePeriodicWork(\n                PERIODIC, ExistingPeriodicWorkPolicy.KEEP, request);\n    }\n\n    /** A fetch as soon as possible; a newer request replaces a pending one. */\n    public static void fetchNow(Context context) {\n        if (!WidgetKind.anyPlaced(context)) return;\n        WorkManager.getInstance(context).enqueueUniqueWork(NOW, ExistingWorkPolicy.REPLACE, oneTime(0));\n    }\n\n    /** A fetch at a kind's refresh_at (epoch millis). */\n    static void fetchAt(Context context, WidgetKind kind, long refreshAt) {\n        long delay = Math.max(0, refreshAt - System.currentTimeMillis()) + REFRESH_AT_DELAY_MS;\n        WorkManager.getInstance(context).enqueueUniqueWork(\n                atRefresh(kind), ExistingWorkPolicy.REPLACE, oneTime(delay));\n    }\n\n    /** Runs a row action once; while one is enqueued or running for this row, further requests are ignored. */\n    static void runAction(Context context, WidgetKind kind, String key, String id) {\n        OneTimeWorkRequest.Builder builder = new OneTimeWorkRequest.Builder(WidgetActionWorker.class)\n                .addTag(ACTION_TAG)\n                .setInputData(new Data.Builder()\n                        .putString(WidgetActionWorker.INPUT_KIND, kind.id)\n                        .putString(WidgetActionWorker.INPUT_KEY, key)\n                        .putString(WidgetActionWorker.INPUT_ID, id)\n                        .build());\n        // Below API 31, expedited work runs as a foreground service with a notification.\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {\n            builder.setExpedited(OutOfQuotaPolicy.RUN_AS_NON_EXPEDITED_WORK_REQUEST);\n        }\n        WorkManager.getInstance(context).enqueueUniqueWork(\n                ACTION_PREFIX + kind.id + \"-\" + id, ExistingWorkPolicy.KEEP, builder.build());\n    }\n\n    /** Called when a provider's last widget is removed: stops all work once no kind is placed. */\n    static void cancelIfNoWidgets(Context context) {\n        if (!WidgetKind.anyPlaced(context)) cancelAll(context);\n    }\n\n    private static void cancelAll(Context context) {\n        WorkManager workManager = WorkManager.getInstance(context);\n        workManager.cancelUniqueWork(PERIODIC);\n        workManager.cancelUniqueWork(NOW);\n        // AT_REFRESH alone is the name builds before widget kinds used.\n        workManager.cancelUniqueWork(AT_REFRESH);\n        for (WidgetKind kind : WidgetKind.values()) workManager.cancelUniqueWork(atRefresh(kind));\n        workManager.cancelAllWorkByTag(ACTION_TAG);\n    }\n\n    private static String atRefresh(WidgetKind kind) {\n        return AT_REFRESH + \"-\" + kind.id;\n    }\n\n    private static OneTimeWorkRequest oneTime(long delayMillis) {\n        return new OneTimeWorkRequest.Builder(WidgetFetchWorker.class)\n                .setInitialDelay(delayMillis, TimeUnit.MILLISECONDS)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n    }\n}\n","numLines":105,"startLine":1,"totalLines":105}},"tool_result_meta":[{"id":"toolu_018eTHdYcaPSmsdLMTgnGnj4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
