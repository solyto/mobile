{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014pSnNeBLyGo2pxf9RFbPVg","type":"tool_result","content":"package app.solyto.widget;\n\nimport android.content.Context;\nimport androidx.annotation.NonNull;\nimport androidx.work.Worker;\nimport androidx.work.WorkerParameters;\n\n/** Fetches the Your Day data and applies the widget error contract. */\npublic class WidgetFetchWorker extends Worker {\n\n    // Further failures wait for the next periodic fetch.\n    private static final int MAX_RETRIES = 3;\n\n    public WidgetFetchWorker(@NonNull Context context, @NonNull WorkerParameters params) {\n        super(context, params);\n    }\n\n    @NonNull\n    @Override\n    public Result doWork() {\n        Context context = getApplicationContext();\n        if (!YourDayWidgetProvider.hasWidgets(context)) return Result.success();\n\n        String token = WidgetTokenStore.readToken(context);\n        String apiUrl = WidgetTokenStore.apiUrl(context);\n        if (token == null || apiUrl == null) {\n            WidgetCache.clear(context);\n            YourDayWidgetProvider.updateAll(context);\n            return Result.success();\n        }\n\n        WidgetApi.Result result = WidgetApi.fetchYourDay(context, apiUrl, token);\n\n        // A logout or a new token arrived during the request; its own handling wins.\n        if (!token.equals(WidgetTokenStore.readToken(context))) return Result.success();\n\n        Result workResult = Result.success();\n        switch (result.outcome) {\n            case OK:\n                if (YourDayPayload.isNewerSchema(result.data)) {\n                    WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n                    break;\n                }\n                YourDayPayload payload = YourDayPayload.parse(result.data);\n                if (payload == null) {\n                    workResult = failTemporarily(context);\n                    break;\n                }\n                WidgetCache.saveData(context, result.data.toString(), System.currentTimeMillis());\n                if (payload.refreshAt > 0) WidgetWork.fetchAt(context, payload.refreshAt);\n                break;\n            case UNAUTHORIZED:\n                WidgetTokenStore.clearIfCurrent(context, token);\n                WidgetCache.clear(context);\n                break;\n            case NOT_FOUND:\n                WidgetCache.setState(context, WidgetCache.State.UNSUPPORTED_SERVER);\n                break;\n            case UPGRADE_REQUIRED:\n                WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n                break;\n            default:\n                workResult = failTemporarily(context);\n        }\n\n        YourDayWidgetProvider.updateAll(context);\n        return workResult;\n    }\n\n    /** 429, 5xx, offline: keep the last data, mark it outdated and back off. */\n    private Result failTemporarily(Context context) {\n        WidgetCache.markOutdated(context);\n        return getRunAttemptCount() < MAX_RETRIES ? Result.retry() : Result.success();\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport android.os.Build;\nimport androidx.work.BackoffPolicy;\nimport androidx.work.Data;\nimport androidx.work.ExistingPeriodicWorkPolicy;\nimport androidx.work.ExistingWorkPolicy;\nimport androidx.work.OneTimeWorkRequest;\nimport androidx.work.OutOfQuotaPolicy;\nimport androidx.work.PeriodicWorkRequest;\nimport androidx.work.WorkManager;\nimport java.util.concurrent.TimeUnit;\n\n/**\n * Schedules widget fetches and row actions. Work only exists while a widget\n * is placed. WorkManager stores input data unencrypted, so it never holds the\n * token: workers read it from {@link WidgetTokenStore}.\n */\npublic final class WidgetWork {\n\n    private static final String PERIODIC = \"widget-fetch-periodic\";\n    private static final String NOW = \"widget-fetch-now\";\n    private static final String AT_REFRESH = \"widget-fetch-at-refresh\";\n    private static final String ACTION_TAG = \"widget-action\";\n    private static final String ACTION_PREFIX = \"widget-action-\";\n\n    private static final long PERIOD_MINUTES = 60;\n    private static final long BACKOFF_MINUTES = 5;\n    // Fetch shortly after refresh_at (the next local midnight), not right at it.\n    private static final long REFRESH_AT_DELAY_MS = 60_000;\n\n    private WidgetWork() {}\n\n    /**\n     * Keeps the periodic fetch scheduled. Keeping a periodic job pending also\n     * stops WorkManager from toggling its components when all work is done,\n     * which would make launchers send another widget update.\n     */\n    static void schedulePeriodic(Context context) {\n        PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(\n                WidgetFetchWorker.class, PERIOD_MINUTES, TimeUnit.MINUTES)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n        WorkManager.getInstance(context).enqueueUniquePeriodicWork(\n                PERIODIC, ExistingPeriodicWorkPolicy.KEEP, request);\n    }\n\n    /** A fetch as soon as possible; a newer request replaces a pending one. */\n    public static void fetchNow(Context context) {\n        if (!YourDayWidgetProvider.hasWidgets(context)) return;\n        WorkManager.getInstance(context).enqueueUniqueWork(NOW, ExistingWorkPolicy.REPLACE, oneTime(0));\n    }\n\n    /** A fetch at the payload's refresh_at (epoch millis). */\n    static void fetchAt(Context context, long refreshAt) {\n        long delay = Math.max(0, refreshAt - System.currentTimeMillis()) + REFRESH_AT_DELAY_MS;\n        WorkManager.getInstance(context).enqueueUniqueWork(\n                AT_REFRESH, ExistingWorkPolicy.REPLACE, oneTime(delay));\n    }\n\n    /** Runs a row action once; while one is enqueued or running for this row, further requests are ignored. */\n    static void runAction(Context context, String key, String id) {\n        OneTimeWorkRequest.Builder builder = new OneTimeWorkRequest.Builder(WidgetActionWorker.class)\n                .addTag(ACTION_TAG)\n                .setInputData(new Data.Builder()\n                        .putString(WidgetActionWorker.INPUT_KEY, key)\n                        .putString(WidgetActionWorker.INPUT_ID, id)\n                        .build());\n        // Below API 31, expedited work runs as a foreground service with a notification.\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {\n            builder.setExpedited(OutOfQuotaPolicy.RUN_AS_NON_EXPEDITED_WORK_REQUEST);\n        }\n        WorkManager.getInstance(context).enqueueUniqueWork(\n                ACTION_PREFIX + id, ExistingWorkPolicy.KEEP, builder.build());\n    }\n\n    static void cancelAll(Context context) {\n        WorkManager workManager = WorkManager.getInstance(context);\n        workManager.cancelUniqueWork(PERIODIC);\n        workManager.cancelUniqueWork(NOW);\n        workManager.cancelUniqueWork(AT_REFRESH);\n        workManager.cancelAllWorkByTag(ACTION_TAG);\n    }\n\n    private static OneTimeWorkRequest oneTime(long delayMillis) {\n        return new OneTimeWorkRequest.Builder(WidgetFetchWorker.class)\n                .setInitialDelay(delayMillis, TimeUnit.MILLISECONDS)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.BroadcastReceiver;\nimport android.content.Context;\nimport android.content.Intent;\nimport app.solyto.MainActivity;\nimport org.json.JSONException;\nimport org.json.JSONObject;\n\n/**\n * Receives every tap on a widget list row: a list has a single click\n * template, so row taps (open a route) and checkbox taps (run an action) both\n * arrive here. Fill-in extras come from the launcher and are untrusted.\n */\npublic class WidgetActionReceiver extends BroadcastReceiver {\n\n    static final String ACTION_ROW_TAP = \"app.solyto.action.WIDGET_ROW_TAP\";\n    static final String EXTRA_ACTION_TYPE = \"app.solyto.extra.WIDGET_ACTION_TYPE\";\n    static final String EXTRA_ACTION_KEY = \"app.solyto.extra.WIDGET_ACTION_KEY\";\n    static final String EXTRA_ACTION_ID = \"app.solyto.extra.WIDGET_ACTION_ID\";\n\n    @Override\n    public void onReceive(Context context, Intent intent) {\n        if (intent == null || !ACTION_ROW_TAP.equals(intent.getAction())) return;\n\n        String type;\n        String key;\n        String id;\n        String routeKey;\n        String routeId;\n        try {\n            type = intent.getStringExtra(EXTRA_ACTION_TYPE);\n            key = intent.getStringExtra(EXTRA_ACTION_KEY);\n            id = intent.getStringExtra(EXTRA_ACTION_ID);\n            routeKey = intent.getStringExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY);\n            routeId = intent.getStringExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID);\n        } catch (RuntimeException e) {\n            // Malformed extras bundle.\n            return;\n        }\n\n        if (type != null) {\n            // On API 31+ the launcher already toggled the CheckBox locally; re-render to undo that.\n            if (!runAction(context, type, key, id)) YourDayWidgetProvider.updateAll(context);\n        } else if (routeKey != null) {\n            openRoute(context, routeKey, routeId);\n        }\n    }\n\n    private static boolean runAction(Context context, String type, String key, String id) {\n        if (!YourDayPayload.ACTION_CHECK.equals(type)) return false;\n        if (!YourDayPayload.isValidActionKey(key) || !YourDayPayload.isValidRowId(id)) return false;\n\n        // Only rows the widget currently shows with this action, and not already done.\n        if (WidgetCache.state(context) != WidgetCache.State.OK) return false;\n        YourDayPayload payload = cachedPayload(context);\n        YourDayPayload.Item row = payload != null ? payload.findAction(type, key, id) : null;\n        if (row == null || row.actionChecked) return false;\n\n        // Repeated taps while a call is running are ignored.\n        if (!WidgetCache.startAction(context, id)) return false;\n        YourDayWidgetProvider.updateAll(context);\n        WidgetWork.runAction(context, key, id);\n        return true;\n    }\n\n    /** MainActivity validates the route again: it is exported and gets these extras from anywhere. */\n    private static void openRoute(Context context, String routeKey, String routeId) {\n        Intent open = new Intent(context, MainActivity.class)\n                .setAction(MainActivity.ACTION_WIDGET_ROUTE)\n                .putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, routeKey)\n                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);\n        if (routeId != null) open.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, routeId);\n        context.startActivity(open);\n    }\n\n    private static YourDayPayload cachedPayload(Context context) {\n        String json = WidgetCache.payload(context);\n        if (json == null) return null;\n        try {\n            return YourDayPayload.parse(new JSONObject(json));\n        } catch (JSONException e) {\n            return null;\n        }\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport androidx.annotation.NonNull;\nimport androidx.work.Worker;\nimport androidx.work.WorkerParameters;\n\n/**\n * Runs one row action and applies the widget error contract. Failures are\n * not retried: the row is reverted and nothing is queued for later.\n */\npublic class WidgetActionWorker extends Worker {\n\n    static final String INPUT_KEY = \"key\";\n    static final String INPUT_ID = \"id\";\n\n    public WidgetActionWorker(@NonNull Context context, @NonNull WorkerParameters params) {\n        super(context, params);\n    }\n\n    @NonNull\n    @Override\n    public Result doWork() {\n        Context context = getApplicationContext();\n        String key = getInputData().getString(INPUT_KEY);\n        String id = getInputData().getString(INPUT_ID);\n        if (!YourDayPayload.isValidActionKey(key) || !YourDayPayload.isValidRowId(id)) return Result.success();\n\n        String token = WidgetTokenStore.readToken(context);\n        String apiUrl = WidgetTokenStore.apiUrl(context);\n        if (token == null || apiUrl == null) {\n            WidgetCache.clear(context);\n            YourDayWidgetProvider.updateAll(context);\n            return Result.success();\n        }\n\n        WidgetApi.Outcome outcome = WidgetApi.postAction(context, apiUrl, token, key, id);\n\n        // A logout or a new token arrived during the request; its own handling wins.\n        if (!token.equals(WidgetTokenStore.readToken(context))) {\n            WidgetCache.revertAction(context, id, false);\n            YourDayWidgetProvider.updateAll(context);\n            return Result.success();\n        }\n\n        switch (outcome) {\n            case OK:\n            case NOT_FOUND:\n                // Done, or the row is gone: the re-fetch shows the server's state.\n                WidgetCache.finishAction(context, id);\n                WidgetWork.fetchNow(context);\n                break;\n            case UNAUTHORIZED:\n                WidgetTokenStore.clearIfCurrent(context, token);\n                WidgetCache.clear(context);\n                break;\n            case UPGRADE_REQUIRED:\n                WidgetCache.revertAction(context, id, false);\n                WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n                break;\n            default:\n                WidgetCache.revertAction(context, id, true);\n        }\n\n        YourDayWidgetProvider.updateAll(context);\n        return Result.success();\n    }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"873d920e-99f3-48cf-a47e-12a4b25809a2","uuid":"34416231-4b48-47c4-8d0e-b95f4dfc9ad8","timestamp":"2026-10-29T19:51:35.511Z","tool_use_result":{"stdout":"package app.solyto.widget;\n\nimport android.content.Conte