ate == WidgetCache.State.LOADING || state == WidgetCache.State.OK)\n124\t+                && WidgetCache.isOutdated(context, KIND)) {\n125\t+            // A fetch failed before any data was cached: say so instead of \"Loading…\".\n126\t+            message = context.getString(R.string.widget_load_failed);\n127\t+        } else {\n128\t+            // OK without data of this kind yet (e.g. right after an app update) shows \"Loading…\".\n129\t+            message = context.getString(stateMessage(state));\n130\t+        }\n131\t+\n132\t+        views.setTextViewText(R.id.widget_title, payload != null && payload.title != null\n133\t+                ? payload.title : context.getString(R.string.widget_check_in_name));\n134\t+        renderUpdatedAt(context, views, payload != null);\n135\t+\n136\t+        RemoteViewsCompat.RemoteCollectionItems.Builder items =\n137\t+                new RemoteViewsCompat.RemoteCollectionItems.Builder()\n138\t+                        .setHasStableIds(false)\n139\t+                        .setViewTypeCount(1);\n140\t+        int rowCount = 0;\n141\t+        if (payload != null) {\n142\t+            for (WidgetPayload.Item item : payload.items) {\n143\t+                // No section titles: the widget title is enough.\n144\t+                if (item.isHeader) continue;\n145\t+                items.addItem(rowCount++, itemView(context, item));\n146\t+            }\n147\t+        }\n148\t+        RemoteViewsCompat.setRemoteAdapter(context, views, appWidgetId, R.id.widget_list, items.build());\n149\t+\n150\t+        boolean hasRows = rowCount > 0;\n151\t+        views.setViewVisibility(R.id.widget_list, hasRows ? View.VISIBLE : View.GONE);\n152\t+        views.setViewVisibility(R.id.widget_message, hasRows ? View.GONE : View.VISIBLE);\n153\t+        views.setTextViewText(R.id.widget_message, message);\n154\t+\n155\t+        manager.updateAppWidget(appWidgetId, views);\n156\t+    }\n157\t+\n158\t+    private static int stateMessage(WidgetCache.S