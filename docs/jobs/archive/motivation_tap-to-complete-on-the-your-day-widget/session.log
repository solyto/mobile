     YourDayWidgetProvider.updateAll(context);\n83\t+        WidgetWork.runAction(context, key, id);\n84\t+    }\n85\t+\n86\t+    /** MainActivity validates the route again: it is exported and gets these extras from anywhere. */\n87\t+    private static void openRoute(Context context, String routeKey, String routeId) {\n88\t+        Intent open = new Intent(context, MainActivity.class)\n89\t+                .setAction(MainActivity.ACTION_WIDGET_ROUTE)\n90\t+                .putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, routeKey)\n91\t+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);\n92\t+        if (routeId != null) open.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, routeId);\n93\t+        context.startActivity(open);\n94\t+    }\n95\t+\n96\t+    private static YourDayPayload cachedPayload(Context context) {\n97\t+        String json = WidgetCache.payload(context);\n98\t+        if (json == null) return null;\n99\t+        try {\n100\t+            return YourDayPayload.parse(new JSONObject(json));\n101\t+        } catch (JSONException e) {\n102\t+            return null;\n103\t+        }\n104\t+    }\n105\t+}\n106\tdiff --git a/android/app/src/main/java/app/solyto/widget/WidgetActionWorker.java b/android/app/src/main/java/app/solyto/widget/WidgetActionWorker.java\n107\tnew file mode 100644\n108\tindex 0000000..c78a430\n109\t--- /dev/null\n110\t+++ b/android/app/src/main/java/app/solyto/widget/WidgetActionWorker.java\n111\t@@ -0,0 +1,68 @@\n112\t+package app.solyto.widget;\n113\t+\n114\t+import android.content.Context;\n115\t+import androidx.annotation.NonNull;\n116\t+import androidx.work.Worker;\n117\t+import androidx.work.WorkerParameters;\n118\t+\n119\t+/**\n120\t+ * Runs one row action and applies the widget error contract. Failures are\n121\t+ * not retried: the row is reverted and nothing is queued for later.\n122\t+ */\n123\t+public class WidgetActionWorker extends Worker {\n124\t+\n125\t+    static final String INPUT_KEY = \"key\";\n126\t+    static final String INPUT_ID = \"id\";\n127\t+\n128\t+    public WidgetActionWorker(@NonNull Context context, @NonNull WorkerParameters params) {\n129\t+        super(context, params);\n130\t+    }\n131\t+\n132\t+    @NonNull\n133\t+    @Override\n134\t+    public Result doWork() {\n135\t+        Context context = getApplicationContext();\n136\t+        String key = getInputData().getString(INPUT_KEY);\n137\t+        String id = getInputData().getString(INPUT_ID);\n138\t+        if (!YourDayPayload.isValidActionKey(key) || !YourDayPayload.isValidRowId(id)) return Result.success();\n139\t+\n140\t+        String token = WidgetTokenStore.readToken(context);\n141\t+        String apiUrl = WidgetTokenStore.apiUrl(context);\n142\t+        if (token == null || apiUrl == null) {\n143\t+            WidgetCache.clear(context);\n144\t+            YourDayWidgetProvider.updateAll(context);\n145\t+            return Result.success();\n146\t+        }\n147\t+\n148\t+        WidgetApi.Outcome outcome = WidgetApi.postAction(context, apiUrl, token, key, id);\n149\t+\n150\t+        // A logout or a new token arrived during the request; its own handling wins.\n151\t+        if (!token.equals(WidgetTokenStore.readToken(context))) {\n152\t+            WidgetCache.revertAction(context, id, false);\n153\t+            YourDayWidgetProvider.updateAll(context);\n154\t+            return Result.success();\n155\t+        }\n156\t+\n157\t+        switch (outcome) {\n158\t+            case OK:\n159\t+            case NOT_FOUND:\n160\t+                // Done, or the row is gone: the re-fetch shows the server's state.\n161\t+                WidgetCache.finishAction(context, id);\n162\t+                WidgetWork.fetchNow(context);\n163\t+                break;\n164\t+            case UNAUTHORIZED:\n165\t+                WidgetTokenStore.clearIfCurrent(context, token);\n166\t+                WidgetCache.clear(context);\n167\t+                break;\n168\t+            case UPGRADE_REQUIRED:\n169\t+                WidgetCache.revertAction(context, id, false);\n170\t+                WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n171\t+                break;\n172\t+            default:\n173\t+                WidgetCache.revertAction(context, id, true);\n174\t+        }\n175\t+\n176\t+        YourDayWidgetProvider.updateAll(context);\n177\t+        return Result.success();\n178\t+    }\n179\t+}\n180\tdiff --git a/android/app/src/main/java/app/solyto/widget/WidgetApi.java b/android/app/src/main/java/app/solyto/widget/WidgetApi.java\n181\tindex 0ecc268..ca34605 100644\n182\t--- a/android/app/src/main/java/app/solyto/widget/WidgetApi.java\n183\t+++ b/android/app/src/main/java/app/solyto/widget/WidgetApi.java\n184\t@@ -31,6 +31,7 @@ final class WidgetApi {\n185\t     }\n186\t \n187\t     private static final String YOUR_DAY_PATH = \"/api/v1/widgets/your-day\";\n188\t+    private static final String ACTIONS_PATH = \"/api/v1/widgets/actions/\";\n189\t     private static final int TIMEOUT_MS = 15_000;\n190\t     private static final int MAX_BODY_BYTES = 1024 * 1024;\n191\t \n192\t@@ -39,22 +40,11 @@ final class WidgetApi {\n193\t     static Result fetchYourDay(Context context, String apiUrl, String token) {\n194\t         HttpURLConnection connection = null;\n195\t         try {\n196\t-            connection = (HttpURLConnection) new URL(apiUrl + YOUR_DAY_PATH).openConnection();\n197\t-            connection.setRequestMethod(\"GET\");\n198\t-            connection.setConnectTimeout(TIMEOUT_MS);\n199\t-            connection.setReadTimeout(TIMEOUT_MS);\n200\t-            connection.setUseCaches(false);\n201\t-            // A redirect could carry the token to another host.\n202\t-            connection.setInstanceFollowRedirects(false);\n203\t-            connection.setRequestProperty(\"Authorization\", \"Bearer \" + token);\n204\t-            connection.setRequestProperty(\"Accept\", \"application/json\");\n205\t-            connection.setRequestProperty(\"X-Client-Version\", appVersion(context));\n206\t+            connection = open(context, apiUrl + YOUR_DAY_PATH, \"GET\", token);\n207\t \n208\t             int status = connection.getResponseCode();\n209\t-            if (status == 401) return new Result(Outcome.UNAUTHORIZED, null);\n210\t             if (status == 404) return new Result(Outcome.NOT_FOUND, null);\n211\t-            if (status == 426) return new Result(Outcome.UPGRADE_REQUIRED, null);\n212\t-            if (status != 200) return new Result(Outcome.TEMPORARY_FAILURE, null);\n213\t+            if (status != 200) return new Result(outcome(status), null);\n214\t \n215\t             JSONObject envelope = new JSONObject(readBody(connection.getInputStream()));\n216\t             JSONObject data = envelope.optJSONObject(\"data\");\n217\t@@ -69,6 +59,54 @@ final class WidgetApi {\n218\t         }\n219\t     }\n220\t \n221\t+    /**\n222\t+     * Runs a row action: {@code POST /widgets/actions/{key}/{id}} without a\n223\t+     * body. 403 counts as {@link Outcome#NOT_FOUND}: the row is not the user's.\n224\t+     */\n225\t+    static Outcome postAction(Context context, String apiUrl, String token, String key, String id) {\n226\t+        if (!YourDayPayload.isValidActionKey(key) || !YourDayPayload.isValidRowId(id)) {\n227\t+            return Outcome.NOT_FOUND;\n228\t+        }\n229\t+        HttpURLConnection connection = null;\n230\t+        try {\n231\t+            connection = open(context, apiUrl + ACTIONS_PATH + key + \"/\" + id, \"POST\", token);\n232\t+            connection.setDoOutput(true);\n233\t+            connection.setFixedLengthStreamingMode(0);\n234\t+            connection.getOutputStream().close();\n235\t+\n236\t+            int status = connection.getResponseCode();\n237\t+            if (status == 200) return Outcome.OK;\n238\t+            if (status == 403 || status == 404) return Outcome.NOT_FOUND;\n239\t+            return outcome(status);\n240\t+        } catch (IOException | RuntimeException e) {\n241\t+            return Outcome.TEMPORARY_FAILURE;\n242\t+        } finally {\n243\t+            if (connection != null) connection.disconnect();\n244\t+        }\n245\t+    }\n246\t+\n247\t+    private static HttpURLConnection open(Context context, String url, String method, String token)\n248\t+            throws IOException {\n249\t+        HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();\n250\t+        connection.setRequestMethod(method);\n251\t+        connection.setConnectTimeout(TIMEOUT_MS);\n252\t+        connection.setReadTimeout(TIMEOUT_MS);\n253\t+        connection.setUseCaches(false);\n254\t+        // A redirect could carry the token to another host.\n255\t+        connection.setInstanceFollowRedirects(false);\n256\t+        connection.setRequestProperty(\"Authorization\", \"Bearer \" + token);\n257\t+        connection.setRequestProperty(\"Accept\", \"application/json\");\n258\t+        connection.setRequestProperty(\"X-Client-Version\", appVersion(context));\n259\t+        return connection;\n260\t+    }\n261\t+\n262\t+    /** The outcome of a status other than 200, 403 and 404. */\n263\t+    private static Outcome outcome(int status) {\n264\t+        if (status == 401) return Outcome.UNAUTHORIZED;\n265\t+        if (status == 426) return Outcome.UPGRADE_REQUIRED;\n266\t+        return Outcome.TEMPORARY_FAILURE;\n267\t+    }\n268\t+\n269\t     private static String readBody(InputStream stream) throws IOException {\n270\t         try (InputStream in = stream) {\n271\t             ByteArrayOutputStream out = new ByteArrayOutputStream();\n272\tdiff --git a/android/app/src/main/java/app/solyto/widget/WidgetCache.java b/android/app/src/main/java/app/solyto/widget/WidgetCache.java\n273\tindex 3107c56..93f4175 100644\n274\t--- a/android/app/src/main/java/app/solyto/widget/WidgetCache.java\n275\t+++ b/android/app/src/main/java/app/solyto/widget/WidgetCache.java\n276\t@@ -2,6 +2,11 @@ package app.solyto.widget;\n277\t \n278\t import android.content.Context;\n279\t import android.content.SharedPreferences;\n280\t+import java.util.ArrayList;\n281\t+import java.util.Iterator;\n282\t+import java.util.List;\n283\t+import org.json.JSONException;\n284\t+import org.json.JSONObject;\n285\t \n286\t /**\n287\t  * The last widget payload and the state the widgets show, in private\n288\t@@ -19,6 +24,13 @@ public final class WidgetCache {\n289\t     private static final String KEY_FETCHED_AT = \"fetched_at\";\n290\t     private static final String KEY_OUTDATED = \"outdated\";\n291\t     private static final String KEY_DEVICE_UNSUPPORTED = \"device_unsupported\";\n292\t+    private static final String KEY_ACTION_ROWS = \"action_rows\";\n293\t+    private static final String KEY_ACTION_ERROR = \"action_error\";\n294\t+\n295\t+    // Row ids with an action call running (value: start time), or done and waiting\n296\t+    // for the re-fetch (value: minus the finish time).\n297\t+    // Drops entries that are never resolved, e.g. when their work was cancelled or the re-fetch fails.\n298\t+    private static final long ACTION_TTL_MS = 5 * 60_000;\n299\t \n300\t     private WidgetCache() {}\n301\t \n302\t@@ -51,15 +63,74 @@ public final class WidgetCache {\n303\t         return prefs(context).getBoolean(KEY_DEVICE_UNSUPPORTED, false);\n304\t     }\n305\t \n306\t-    static void saveData(Context context, String payload, long fetchedAt) {\n307\t+    /**\n308\t+     * Stores fresh data. Rows whose action finished now show the server's\n309\t+     * state; rows with a call still running stay shown as done.\n310\t+     */\n311\t+    static synchronized void saveData(Context context, String payload, long fetchedAt) {\n312\t+        JSONObject rows = actionRows(context);\n313\t+        for (String id : keys(rows)) {\n314\t+            if (rows.optLong(id) < 0) rows.remove(id);\n315\t+        }\n316\t         prefs(context).edit()\n317\t                 .putString(KEY_STATE, State.OK.name())\n318\t                 .putString(KEY_PAYLOAD, payload)\n319\t                 .putLong(KEY_FETCHED_AT, fetchedAt)\n320\t                 .putBoolean(KEY_OUTDATED, false)\n321\t+                .putString(KEY_ACTION_ROWS, rows.toString())\n322\t+                .putBoolean(KEY_ACTION_ERROR, false)\n323\t                 .commit();\n324\t     }\n325\t \n326\t+    /** Whether the row is shown as done locally: its action is running or waiting for the re-fetch. */\n327\t+    static synchronized boolean isActionActive(Context context, String id) {\n328\t+        return actionRows(context).has(id);\n329\t+    }\n330\t+\n331\t+    /**\n332\t+     * Marks the row's action as running and clears the error state. Returns\n333\t+     * false when an action for this row is already active.\n334\t+     */\n335\t+    static synchronized boolean startAction(Context context, String id) {\n336\t+        JSONObject rows = actionRows(context);\n337\t+        if (rows.has(id)) return false;\n338\t+        try {\n339\t+            rows.put(id, System.currentTimeMillis());\n340\t+        } catch (JSONException e) {\n341\t+            return false;\n342\t+        }\n343\t+        prefs(context).edit()\n344\t+                .putString(KEY_ACTION_ROWS, rows.toString())\n345\t+                .putBoolean(KEY_ACTION_ERROR, false)\n346\t+                .commit();\n347\t+        return true;\n348\t+    }\n349\t+\n350\t+    /** The action succeeded: the row stays shown as done until the next saved fetch. */\n351\t+    static synchronized void finishAction(Context context, String id) {\n352\t+        JSONObject rows = actionRows(context);\n353\t+        if (!rows.has(id)) return;\n354\t+        try {\n355\t+            rows.put(id, -System.currentTimeMillis());\n356\t+        } catch (JSONException e) {\n357\t+            return;\n358\t+        }\n359\t+        prefs(context).edit().putString(KEY_ACTION_ROWS, rows.toString()).commit();\n360\t+    }\n361\t+\n362\t+    /** The action did not happen: the row shows its server state again, optionally with the error state. */\n363\t+    static synchronized void revertAction(Context context, String id, boolean showError) {\n364\t+        JSONObject rows = actionRows(context);\n365\t+        rows.remove(id);\n366\t+        SharedPreferences.Editor editor = prefs(context).edit().putString(KEY_ACTION_ROWS, rows.toString());\n367\t+        if (showError) editor.putBoolean(KEY_ACTION_ERROR, true);\n368\t+        editor.commit();\n369\t+    }\n370\t+\n371\t+    static boolean hasActionError(Context context) {\n372\t+        return prefs(context).getBoolean(KEY_ACTION_ERROR, false);\n373\t+    }\n374\t+\n375\t     public static void setState(Context context, State state) {\n376\t         prefs(context).edit().putString(KEY_STATE, state.name()).commit();\n377\t     }\n378\t@@ -76,15 +147,40 @@ public final class WidgetCache {\n379\t     }\n380\t \n381\t     /** Deletes the cached data; the widgets show the signed-out state. */\n382\t-    public static void clear(Context context) {\n383\t+    public static synchronized void clear(Context context) {\n384\t         prefs(context).edit()\n385\t                 .remove(KEY_PAYLOAD)\n386\t                 .remove(KEY_FETCHED_AT)\n387\t                 .remove(KEY_OUTDATED)\n388\t+                .remove(KEY_ACTION_ROWS)\n389\t+                .remove(KEY_ACTION_ERROR)\n390\t                 .putString(KEY_STATE, State.SIGNED_OUT.name())\n391\t                 .commit();\n392\t     }\n393\t \n394\t+    /** The active action rows, without entries older than {@link #ACTION_TTL_MS}. */\n395\t+    private static JSONObject actionRows(Context context) {\n396\t+        JSONObject rows;\n397\t+        try {\n398\t+            rows = new JSONObject(prefs(context).getString(KEY_ACTION_ROWS, \"{}\"));\n399\t+        } catch (JSONException e) {\n400\t+            return new JSONObject();\n401\t+        }\n402\t+        long now = System.currentTimeMillis();\n403\t+        for (String id : keys(rows)) {\n