{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011dgHDPPkRf1714FJjLgk8U","type":"tool_result","content":"1\tpackage app.solyto.widget;\n2\t\n3\timport android.content.Context;\n4\timport android.content.SharedPreferences;\n5\timport java.util.ArrayList;\n6\timport java.util.Iterator;\n7\timport java.util.List;\n8\timport org.json.JSONException;\n9\timport org.json.JSONObject;\n10\t\n11\t/**\n12\t * The last widget payload and the state the widgets show, in private\n13\t * SharedPreferences excluded from backup. {@link #clear} wipes the data.\n14\t */\n15\tpublic final class WidgetCache {\n16\t\n17\t    /** Prefs file name; the backup rules exclude {@code widget_cache.xml}. */\n18\t    static final String PREFS = \"widget_cache\";\n19\t\n20\t    public enum State { LOADING, OK, SIGNED_OUT, UNSUPPORTED_SERVER, UPDATE_APP }\n21\t\n22\t    private static final String KEY_STATE = \"state\";\n23\t    private static final String KEY_PAYLOAD = \"payload\";\n24\t    private static final String KEY_FETCHED_AT = \"fetched_at\";\n25\t    private static final String KEY_OUTDATED = \"outdated\";\n26\t    private static final String KEY_DEVICE_UNSUPPORTED = \"device_unsupported\";\n27\t    private static final String KEY_ACTION_ROWS = \"action_rows\";\n28\t    private static final String KEY_ACTION_ERROR = \"action_error\";\n29\t\n30\t    // Row ids with an action call running (value: start time), or done and waiting\n31\t    // for the re-fetch (value: minus the finish time).\n32\t    // Drops entries that are never resolved, e.g. when their work was cancelled or the re-fetch fails.\n33\t    private static final long ACTION_TTL_MS = 5 * 60_000;\n34\t\n35\t    private WidgetCache() {}\n36\t\n37\t    public static State state(Context context) {\n38\t        try {\n39\t            return State.valueOf(prefs(context).getString(KEY_STATE, State.LOADING.name()));\n40\t        } catch (IllegalArgumentException e) {\n41\t            return State.LOADING;\n42\t  