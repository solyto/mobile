*\n91\t     * Marks the row's action as running and clears the error state. Returns\n92\t     * false when an action for this row is already active.\n93\t     */\n94\t    static synchronized boolean startAction(Context context, String id) {\n95\t        JSONObject rows = actionRows(context);\n96\t        if (rows.has(id)) return false;\n97\t        try {\n98\t            rows.put(id, System.currentTimeMillis());\n99\t        } catch (JSONException e) {\n100\t            return false;\n101\t        }\n102\t        prefs(context).edit()\n103\t                .putString(KEY_ACTION_ROWS, rows.toString())\n104\t                .putBoolean(KEY_ACTION_ERROR, false)\n105\t                .commit();\n106\t        return true;\n107\t    }\n108\t\n109\t    /** The action succeeded: the row stays shown as done until the next saved fetch. */\n110\t    static synchronized void finishAction(Context context, String id) {\n111\t        JSONObject rows = actionRows(context);\n112\t        if (!rows.has(id)) return;\n113\t        try {\n114\t            rows.put(id, -System.currentTimeMillis());\n115\t        } catch (JSONException e) {\n116\t            return;\n117\t        }\n118\t        prefs(context).edit().putString(KEY_ACTION_ROWS, rows.toString()).commit();\n119\t    }\n120\t\n121\t    /** The action did not happen: the row shows its server state again, optionally with the error state. */\n122\t    static synchronized void revertAction(Context context, String id, boolean showError) {\n123\t        JSONObject rows = actionRows(context);\n124\t        rows.remove(id);\n125\t        SharedPreferences.Editor editor = prefs(context).edit().putString(KEY_ACTION_ROWS, rows.toString());\n126\t        if (showError) editor.putBoolean(KEY_ACTION_ERROR, true);\n127\t        editor.commit();\n128\t    }\n129\t\n130\t    static boolean hasActionError(Context context) {\n131\t        return prefs(context).getBoolean(KEY_ACTION_ERROR, false);\n132\t    }\n133\t\n134\t    public static void 