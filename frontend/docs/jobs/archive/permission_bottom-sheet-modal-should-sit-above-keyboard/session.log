ction\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git branch -d*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git branch -D*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git branch --delete*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git branch --move*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git branch --copy*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git reset*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git clean*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git gc*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git prune*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git reflog*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git push*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git fetch*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git pull*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git checkout*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git switch*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git restore*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git stash*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git remote*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git tag -d*\",\"action\":\"deny\"},{\"permission\":\"bash\",\"pattern\":\"git update-ref*\",\"action\":\"deny\"}]","time":{"start":1788619966913,"end":1788619966941}},"id":"prt_0720ec73e001oKWrbZS6vfFmh6","sessionID":"ses_f8df14e3affe3wwrFMZEf9YPmr","messageID":"msg_0720eb2d5001LWUjlFBCQF6juD"}}
