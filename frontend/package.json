{
	"name": "pwa",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"a11y_click_events_have_key_events:ignore,a11y_no_static_element_interactions:ignore,state_referenced_locally:ignore\"",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --compiler-warnings \"a11y_click_events_have_key_events:ignore,a11y_no_static_element_interactions:ignore,state_referenced_locally:ignore\"",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@lucide/svelte": "1.59.0",
		"@sveltejs/adapter-auto": "6.1.0",
		"@sveltejs/adapter-node": "5.3.2",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.8",
		"@types/canvas-confetti": "1.9.0",
		"@vitest/coverage-v8": "4.1.12",
		"eslint": "10.13.0",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jsdom": "26.1.0",
		"marked": "18.1.1",
		"svelte": "5.57.2",
		"svelte-awesome-color-picker": "4.1.0",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.2",
		"typescript-eslint": "8.71.2",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	},
	"dependencies": {
		"@fontsource/barlow": "5.3.0",
		"@fontsource/cinzel": "5.3.0",
