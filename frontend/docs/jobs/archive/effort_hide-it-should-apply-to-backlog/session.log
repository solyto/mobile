' | 'kanban' | 'overview' | 'card'>('list');\n49\t\tsortByScore = $state<boolean>(false);\n50\t\ttodosScored = $state<boolean>(false);\n51\t\thideItActive = $state<boolean>(false);\n52\t\trecentlyCreated = $state<string | null>(null);\n53\t\tquickCreateOpen = $state<boolean>(false);\n54\t\tauth: Auth;\n55\t\tapiService: ApiService;\n56\t\tlocalStorage: LocalStorageService;\n57\t\tfilterService = new TodoFilterService();\n58\t\tsortingService = new TodoSortingService();\n59\t\tgroupingService = new TodoGroupingService();\n60\t\trelevanceService = new TodoRelevanceService();\n61\t\n62\t\tconstructor(\n63\t\t\tauth: Auth = getAuth(),\n64\t\t\tapiService: ApiService = new ApiService(auth.getToken()),\n65\t\t\tlocalStorage: LocalStorageService = new LocalStorageService()\n66\t\t) {\n67\t\t\tthis.auth = auth;\n68\t\t\tthis.apiService = apiService;\n69\t\t\tthis.localStorage = localStorage;\n70\t\n71\t\t\t// Restore synchronously so every filter pass (including the ones run by\n72\t\t\t// load() before the workspaces request resolves) already sees the\n73\t\t\t// persisted value instead of the default false.\n74\t\t\tthis.hideItActive = this.localStorage.getBool(Todos.LS_HIDE_IT_KEY) ?? false;\n75\t\t}\n76\t\n77\t\tasync load(): Promise<void> {\n78\t\t\tconst res = await this.apiService.list(apiRoutes.todos.list);\n79\t\n80\t\t\tif (res) {\n81\t\t\t\tthis.loaded = true;\n82\t\t\t\tthis.todos = res.data as Todo[];\n83\t\t\t\tthis.filteredTodos = this.todos;\n84\t\t\t\tthis.checkUrlForFilter();\n85\t\t\t}\n86\t\n87\t\t\tif (this.sortByScore) {\n88\t\t\t\tthis.loadScores();\n89\t\t\t} else {\n90\t\t\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n91\t\t\t}\n92\t\n93\t\t\tthis.groupByStatus();\n94\t\n95\t\t\ttry {\n96\t\t\t\tawait Promise.all([this.loadCategories(), this.loadWorkspaces()]);\n97\t\t\t} finally {\n98\t\t\t\t// Always re-apply hide-it once the parallel loads settled: a failed\n99\t\t\t\t// or rejected workspaces/categories request must not skip this.\n100\t\t\t\tthis.loadHideIt();\n101\t\t\t}\n102\t\t}\n103\t\n104\t\tasync loadCategories(): Promise<void> {\n105\t\t\tconst res = await this.apiService.list(apiRoutes.todos.listCategories);\n106\t\n107\t\t\tif (res) this.categories = res.data as TodoCategory[];\n108\t\t\tthis.categories = this.sortingService.sortCategories(this.categories);\n109\t\t\tthis.filteredCategories = this.categories;\n110\t\t}\n111\t\n112\t\tasync loadWorkspaces(retries: number = 1): Promise<void> {\n113\t\t\t// Treated like a failed request (null) so a network error gets the same\n114\t\t\t// single retry as a non-ok response. An empty workspaces list would\n115\t\t\t// silently disable hide-it filtering for the whole page lifetime.\n116\t\t\tconst res = await this.apiService.list(apiRoutes.todos.listWorkspaces).catch(() => null);\n117\t\n118\t\t\tif (res) {\n119\t\t\t\tthis.workspaces = res.data as TodoWorkspace[];\n120\t\t\t\treturn;\n121\t\t\t}\n122\t\n123\t\t\tif (retries > 0) {\n124\t\t\t\tawait this.loadWorkspaces(retries - 1);\n125\t\t\t}\n126\t\t}\n127\t\n128\t\tchangeView(view: 'list' | 'kanban' | 'overview' | 'card'): void {\n129\t\t\tthis.view = view;\n130\t\t}\n131\t\n132\t\ttoggleSortByScore(): void {\n133\t\t\tif (!this.sortByScore) {\n134\t\t\t\tthis.loadScores();\n135\t\t\t} else {\n136\t\t\t\tthis.useFilters(this.activeFilters);\n137\t\t\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n138\t\t\t}\n139\t\n140\t\t\tthis.groupByStatus();\n141\t\n142\t\t\tthis.sortByScore = !this.sortByScore;\n143\t\t}\n144\t\n145\t\tloadScores(): void {\n146\t\t\tthis.todos = this.relevanceService.getScoredTodos(this.todos);\n147\t\t\tthis.todosScored = true;\n148\t\t\tthis.useFilters(this.activeFilters);\n149\t\t\tthis.filteredTodos = this.sortingService.sortByScore(this.filteredTodos);\n150\t\t}\n151\t\n152\t\tgroupByStatus(): void {\n153\t\t\tthis.groupedTodos = this.groupingService.groupByStatus(this.filteredTodos);\n154\t\t}\n155\t\n156\t\tcheckUrlForFilter(): void {\n157\t\t\tconst type = page.url.searchParams.get('filterType'),\n158\t\t\t\tvalue: string | number | null = page.url.searchParams.get('filterValue');\n159\t\n160\t\t\tif (type && value) {\n161\t\t\t\tif (type !== 'workspace') {\n162\t\t\t\t\tthis.addFilter({ type: type as TodoFilterType, value });\n163\t\t\t\t}\n164\t\t\t}\n165\t\n166\t\t\tthis.useFilters(this.activeFilters);\n167\t\t}\n168\t\n169\t\tuseFilters(filters: TodoFilter[]): void {\n170\t\t\t// Set before the hide-it guard below (which reads it via\n171\t\t\t// isCategoryFilterActive()/isTagFilterActive()) so that guard reflects\n172\t\t\t// the filters being applied, not the previous selection.\n173\t\t\tthis.activeFilters = filters;\n174\t\t\tthis.filteredTodos = this.todos;\n175\t\n176\t\t\tconst visibilityThreshold = new SvelteDate();\n177\t\t\tvisibilityThreshold.setDate(visibilityThreshold.getDate() + 3);\n178\t\t\tthis.filteredTodos = this.filteredTodos.filter(\n179\t\t\t\t(t) =>\n180\t\t\t\t\t!t.auto_generated ||\n181\t\t\t\t\tt.due_at === null ||\n182\t\t\t\t\tnew SvelteDate(t.due_at) <= visibilityThreshold\n183\t\t\t);\n184\t\n185\t\t\tif (!filters.some((f) => f.type === 'status' && f.value === 'backlog')) {\n186\t\t\t\tthis.filteredTodos = this.filterService.filterOutBacklog(this.filteredTodos);\n187\t\t\t}\n188\t\n189\t\t\tif (\n190\t\t\t\tthis.hideItActive &&\n191\t\t\t\tthis.activeWorkspace === null &&\n192\t\t\t\t!this.isCategoryFilterActive() &&\n193\t\t\t\t!this.isTagFilterActive()\n194\t\t\t) {\n195\t\t\t\tthis.filteredTodos = this.filterService.filterByHideIt(\n196\t\t\t\t\tthis.filteredTodos,\n197\t\t\t\t\tthis.workspaces\n198\t\t\t\t);\n199\t\t\t}\n200\t\n201\t\t\tfor (const filter of filters) {\n202\t\t\t\tthis.filteredTodos = this.filterService.filter(filter, this.filteredTodos);\n203\t\t\t}\n204\t\n205\t\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n206\t\t\tthis.groupByStatus();\n207\t\t}\n208\t\n209\t\tfilterCategories(): void {\n210\t\t\tif (this.hideItActive) {\n211\t\t\t\tthis.filteredCategories = this.filterService.filterCategoriesByHideIt(\n212\t\t\t\t\tthis.categories,\n213\t\t\t\t\tthis.workspaces\n214\t\t\t\t);\n215\t\t\t} else {\n216\t\t\t\tthis.filteredCategories = this.categories;\n217\t\t\t}\n218\t\t}\n219\t\n220\t\taddFilter(filter: TodoFilter): void {\n221\t\t\tthis.activeFilters.push(filter);\n222\t\t}\n223\t\n224\t\tremoveFilter(filter: TodoFilter): void {\n225\t\t\tthis.activeFilters = this.activeFilters.filter((f) => f !== filter);\n226\t\t}\n227\t\n228\t\tclearFilters(): void {\n229\t\t\tthis.activeFilters = [];\n230\t\t}\n231\t\n232\t\tisFilterActive(filter: TodoFilter): boolean {\n233\t\t\treturn this.activeFilters.some((f) => f.type === filter.type && f.value === filter.value);\n234\t\t}\n235\t\n236\t\tisCategoryFilterActive(): boolean {\n237\t\t\treturn this.activeFilters.some((f) => f.type === 'category');\n238\t\t}\n239\t\n240\t\tisTagFilterActive(): boolean {\n241\t\t\treturn this.activeFilters.some((f) => f.type === 'tag');\n242\t\t}\n243\t\n244\t\ttoggleHideIt(): void {\n245\t\t\tthis.hideItActive = !this.hideItActive;\n246\t\t\tthis.useFilters(this.activeFilters);\n247\t\t\tthis.filterCategories();\n248\t\n249\t\t\tthis.localStorage.setBool(Todos.LS_HIDE_IT_KEY, this.hideItActive);\n250\t\t}\n251\t\n252\t\tloadHideIt(): void {\n253\t\t\t// Re-reads storage so a toggle issued while load() was still in flight\n254\t\t\t// wins over the constructor restore, then re-applies the filters now\n255\t\t\t// that workspaces (which decide what hide-it removes) are loaded.\n256\t\t\tthis.hideItActive = this.localStorage.getBool(Todos.LS_HIDE_IT_KEY) ?? false;\n257\t\t\tif (this.hideItActive) {\n258\t\t\t\tthis.filterCategories();\n259\t\t\t\tthis.useFilters(this.activeFilters);\n260\t\t\t}\n261\t\t}\n262\t\n263\t\tasync quickCreate(input: string): Promise<{ ok: boolean; recurrenceIgnored: boolean }> {\n264\t\t\tconst recurrenceIgnored = /repeat:/i.test(input) && !/due:/i.test(input);\n265\t\n266\t\t\tconst request: CreateTodoRequest = { title: input };\n267\t\n268\t\t\tif (this.activeFilters.some((f) => f.type === 'tag')) {\n269\t\t\t\trequest.tags = [this.activeFilters.find((f) => f.type === 'tag')?.value as number];\n270\t\t\t}\n271\t\n272\t\t\tif (this.activeFilters.some((f) => f.type === 'category')) {\n273\t\t\t\trequest.category_id = this.activeFilters.find((f) => f.type === 'category')\n274\t\t\t\t\t?.value as number;\n275\t\t\t}\n276\t\n277\t\t\tconst res = await this.apiService.create(apiRoutes.todos.create, request);\n278\t\n279\t\t\tif (res) {\n280\t\t\t\tconst todo = res.data as Todo;\n281\t\t\t\tthis.recentlyCreated = todo.id;\n282\t\t\t\tawait this.load();\n283\t\n284\t\t\t\tsetTimeout(() => {\n285\t\t\t\t\tthis.recentlyCreated = null;\n286\t\t\t\t}, 10000);\n287\t\n288\t\t\t\treturn Promise.resolve({ ok: true, recurrenceIgnored });\n289\t\t\t}\n290\t\n291\t\t\treturn Promise.resolve({ ok: false, recurrenceIgnored: false });\n292\t\t}\n293\t\n294\t\tasync delete(todo: Todo): Promise<boolean> {\n295\t\t\tconst ok = await this.apiService.delete(apiRoutes.todos.delete, todo.id);\n296\t\t\tif (ok) await this.load();\n297\t\t\treturn ok;\n298\t\t}\n299\t\n300\t\tasync createCategory(title: string): Promise<TodoCategory | null> {\n301\t\t\tconst request: CreateTodoCategoryRequest = { title };\n302\t\t\tconst res = await this.apiService.create(apiRoutes.todos.createCategory, request);\n303\t\t\tif (res) await this.loadCategories();\n304\t\t\treturn res ? (res.data as TodoCategory) : null;\n305\t\t}\n306\t\n307\t\tasync updateCategory(\n308\t\t\tcategory: TodoCategory,\n309\t\t\trequest: UpdateTodoCategoryRequest\n310\t\t): Promise<boolean> {\n311\t\t\tconst res = await this.apiService.update(\n312\t\t\t\tapiRoutes.todos.updateCategory,\n313\t\t\t\tcategory.id,\n314\t\t\t\trequest\n315\t\t\t);\n316\t\t\tif (res) await Promise.all([this.loadCategories(), this.loadWorkspaces()]);\n317\t\t\treturn res;\n318\t\t}\n319\t\n320\t\tasync deleteCatego