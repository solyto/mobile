\tif (!authToken || !user) return;\n53: \n54: \t\tconst expiresAt = new SvelteDate(authToken.expires_at).getTime();\n55: \n56: \t\tif (expiresAt > Date.now()) {\n57: \t\t\tthis.user = user;\n58: \t\t\tthis.authToken = authToken;\n59: \t\t\tthis.apiService.updateAuthToken(this.getToken()!);\n60: \t\t\tthis.loggedIn = true;\n61: \n62: \t\t\tif (this.shouldRefresh(expiresAt)) {\n63: \t\t\t\tawait this.refresh();\n64: \t\t\t}\n65: \n66: \t\t\tawait this.loadAdditionalData();\n67: \n68: \t\t\tthis.save();\n69: \t\t} else {\n70: \t\t\tthis.localStorage.destroy(Auth.LS_AUTH_KEY);\n71: \t\t}\n72: \t}\n73: \n74: \tpublic async loadAdditionalData(): Promise<void> {\n75: \t\tif (!this.user) return;\n76: \t\tconst res = await this.apiService.get(apiRoutes.users.get, null);\n77: \t\tif (res) this.user = res.data as User;\n78: \t\tthis.save();\n79: \t}\n80: \n81: \tpublic save(): void {\n82: \t\tthis.localStorage.setJson(Auth.LS_AUTH_KEY, {\n83: \t\t\tuser: this.user,\n84: \t\t\tauthToken: this.authToken\n85: \t\t});\n86: \t}\n87: \n88: \tprivate clear(): void {\n89: \t\tthis.localStorage.destroy(Auth.LS_AUTH_KEY);\n90: \t\tthis.user = null;\n91: \t\tthis.authToken = null;\n92: \t\tthis.loggedIn = false;\n93: \t}\n94: \n95: \tasync login(email: string, password: string): Promise<boolean> {\n96: \t\tconst request: LoginRequest = { email, password, platform: PLATFORM };\n97: \t\tconst res = await this.apiService.post(apiRoutes.auth.login, request);\n98: \n99: \t\tif (!res) return Promise.resolve(false);\n100: \t\tconst login = res.data as LoginResponse;\n101: \n102: \t\tthis.user = login.user;\n103: \t\tthis.authToken = {\n104: \t\t\ttoken: login.token,\n105: \t\t\ttoken_type: login.token_type,\n106: \t\t\texpires_at: login.token_expires_at\n107: \t\t};\n108: \t\tthis.loggedIn = true;\n109: \t\tthis.apiService.updateAuthToken(this.getToken()!);\n110: \n111: \t\tthis.save();\n112: \t\tawait this.loadAdditionalData();\n113: \n114: \t\treturn Promise.resolve(true);\n115: \t}\n116: \n117: \tprivate shouldRefresh(expiresAt: number): boolean {\n118: \t\tconst thresholdDays = IS_NATIVE ? 14 : 5;\n119: \t\treturn expiresAt < Date.now() + thresholdDays * 24 * 60 * 60 * 1000;\n120: \t}\n121: \n122: \tasync refresh(): Promise<boolean> {\n123: \t\tthis.apiService.updateAuthToken(this.getToken()!);\n124: \t\tconst res = await this.apiService.post(apiRoutes.auth.refresh, {});\n125: \n126: \t\tif (!res) return Promise.resolve(false);\n127: \t\tconst refresh = res.data as LoginResponse;\n128: \n129: \t\tthis.user = refresh.user;\n130: \t\tthis.authToken = {\n131: \t\t\ttoken: refresh.token,\n132: \t\t\ttoken_type: refresh.token_type,\n133: \t\t\texpires_at: refresh.token_expires_at\n134: \t\t};\n135: \t\tthis.loggedIn = true;\n136: \n137: \t\tthis.save();\n138: \n139: \t\treturn Promise.resolve(true);\n140: \t}\n141: \n142: \tlogout(): void {\n143: \t\tthis.clear();\n144: \t}\n145: \n146: \tisAdmin(): boolean {\n147: \t\treturn this.user?.role === 'admin' || this.user?.role === 'super_admin';\n148: \t}\n149: \n150: \tasync register(request: RegisterRequest): Promise<AuthActionResponse> {\n151: \t\treturn this.apiService.postRaw<AuthActionResponse>(apiRoutes.auth.register, request);\n152: \t}\n153: \n154: \tasync verify(request: VerifyRequest): Promise<VerifyActionResponse> {\n155: \t\treturn this.apiService.postRaw<VerifyActionResponse>(apiRoutes.auth.verify, request);\n156: \t}\n157: \n158: \tasync forgotPassword(email: string, platform: string): Promise<void> {\n159: \t\tawait this.apiService.post(apiRoutes.auth.forgotPassword, { email, platform });\n160: \t}\n161: \n162: \tasync resetPassword(token: string, email: string, password: string, passwordConfirmation: string): Promise<AuthActionResponse> {\n163: \t\treturn this.apiService.postRaw<AuthActionResponse>(apiRoutes.auth.resetPassword, {\n164: \t\t\ttoken,\n165: \t\t\temail,\n166: \t\t\tpassword,\n167: \t\t\tpassword_confirmation: passwordConfirmation\n168: \t\t});\n169: \t}\n170: \n171: \tasync passkeyAuthenticationOptions(): Promise<PasskeyAuthenticationOptions | null> {\n172: \t\tconst res = await this.apiService.post(apiRoutes.auth.passkeys.authenticateOptions, {});\n173: \t\treturn (res?.data ?? null) as PasskeyAuthenticationOptions | null;\n174: \t}\n175: \n176: \tasync passkeyAuthenticate(response: object): Promise<void> {\n177: \t\tconst res = await this.apiService.postRaw<PasskeyActionResponse>(apiRoutes.auth.passkeys.authenticate, { response, platform: PLATFORM });\n178: \t\tif (!res.success) {\n179: \t\t\tthrow new Error(res.message ?? 'Passkey authentication failed');\n180: \t\t}\n181: \t\tconst data = res.data as LoginResponse;\n182: \t\tthis.user = data.user;\n183: \t\tthis.authToken = {\n184: \t\t\ttoken: data.token,\n185: \t\t\ttoken_type: data.token_type,\n186: \t\t\texpires_at: data.token_expires_at\n187: \t\t};\n188: \t\tthis.loggedIn = true;\n189: \t\tthis.apiService.updateAuthToken(this.getToken()!);\n190: \t\tthis.save();\n191: \t\tawait this.loadAdditionalData();\n192: \t}\n193: \n194: \tasync passkeyRegistrationOptions(): Promise<PasskeyRegistrationOptions | null> {\n195: \t\tconst res = await this.apiService.post(apiRoutes.auth.passkeys.registerOptions, {});\n196: \t\treturn (res?.data ?? null) as PasskeyRegistrationOptions | null;\n197: \t}\n198: \n199: \tasync passkeyRegister(response: object, name: string): Promise<void> {\n200: \t\tconst res = await this.apiService.postRaw<PasskeyActionResponse>(apiRoutes.auth.passkeys.register, { response, name });\n201: \t\tif (!res.success) {\n202: \t\t\tthrow new Error(res.message ?? 'Registration failed');\n203: \t\t}\n204: \t}\n205: \n206: \tasync getPasskeys(): Promise<Passkey[]> {\n207: \t\tconst res = await this.apiService.get(apiRoutes.auth.passkeys.list, null);\n208: \t\treturn (res?.data ?? []) as Passkey[];\n209: \t}\n210: \n211: \tasync deletePasskey(id: string): Promise<void> {\n212: \t\tawait this.apiService.delete(apiRoutes.auth.passkeys.delete, id);\n213: \t}\n214: \n215: \tasync renamePasskey(id: string, name: string): Promise<void> {\n216: \t\tawait this.apiService.update(apiRoutes.auth.passkeys.update, id, { name });\n217: \t}\n218: \n219: \tgetToken(): string | null {\n220: \t\treturn this.authToken?.token ?? null;\n221: \t}\n222: \n223: \tasync updateNavigation(navigation: string): Promise<boolean> {\n224: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateNavigationSettings, {\n225: \t\t\tnavigation\n226: \t\t});\n227: \t\treturn Promise.resolve(res);\n228: \t}\n229: \n230: \tasync updateTimezone(timezone: string): Promise<boolean> {\n231: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateTimezone, {\n232: \t\t\ttimezone\n233: \t\t});\n234: \t\treturn Promise.resolve(res);\n235: \t}\n236: \n237: \tasync updateDateFormat(dateFormat: string): Promise<boolean> {\n238: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateDateFormat, {\n239: \t\t\tdate_format: dateFormat\n240: \t\t});\n241: \t\treturn Promise.resolve(res);\n242: \t}\n243: \n244: \tasync updateTimeFormat(timeFormat: string): Promise<boolean> {\n245: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateTimeFormat, {\n246: \t\t\ttime_format: timeFormat\n247: \t\t});\n248: \t\treturn Promise.resolve(res);\n249: \t}\n250: \n251: \tasync updateLanguage(language: string): Promise<boolean> {\n252: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateLanguage, {\n253: \t\t\tlanguage\n254: \t\t});\n255: \t\tif (res) await this.loadAdditionalData();\n256: \t\treturn Promise.resolve(res);\n257: \t}\n258: \n259: \tasync completeOnboarding(): Promise<boolean> {\n260: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.completeOnboarding, {});\n261: \t\tif (res && this.user?.settings) {\n262: \t\t\tthis.user.settings.first_visit = false;\n263: \t\t\tthis.save();\n264: \t\t}\n265: \t\treturn Promise.resolve(res);\n266: \t}\n267: \n268: \tasync setOpenaiApiKey(key: string | null): Promise<boolean> {\n269: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateOpenaiApiKey, { key });\n270: \t\tawait this.loadAdditionalData();\n271: \t\treturn Promise.resolve(res);\n272: \t}\n273: \n274: \tasync setProfileImage(file: File): Promise<boolean> {\n275: \t\tif (!file.type.startsWith('image/')) {\n276: \t\t\treturn Promise.resolve(false);\n277: \t\t}\n278: \n279: \t\tconst formData = new FormData();\n280: \t\tformData.append('profile_image', file);\n281: \n282: \t\tconst res = await this.apiService.postFormData(\n283: \t\t\tapiRoutes.users.updateProfileImage,\n284: \t\t\tformData\n285: \t\t);\n286: \t\tawait this.loadAdditionalData();\n287: \t\treturn Promise.resolve(res);\n288: \t}\n289: \n290: \tasync getPublicProfile(userId: string): Promise<User | null> {\n291: \t\tif (this.profileCache.has(userId)) return this.profileCache.get(userId)!;\n292: \t\tconst res = await this.apiService.get(apiRoutes.users.getPublicProfile, userId);\n293: \t\tconst user = res?.data as User | null;\n294: \t\tif (user) this.profileCache.set(userId, user);\n295: \t\treturn user;\n296: \t}\n297: \n298: \tgetDateInUserPreferredFormat(input: string | Date): string {\n299: \t\treturn formatDate(input, this?.user?.settings?.date_format ?? null);\n300: \t}\n301: \n302: \tgetDateWithoutYearInUserPreferredFormat(input: string | Date): string {\n303: \t\treturn formatDateWithoutYear(input, this?.user?.settings?.date_format ?? null);\n304: \t}\n305: \n306: \tgetDateWithWeekdayInUserPreferredFormat(input: string | Date): string {\n307: \t\treturn formatDateWithWeekday(input, this?.user?.settings?.date_format ?? null, this?.user?.settings?.language ?? undefined);\n308: \t}\n309: \n310: \tgetDateTimeInUserPreferredFormat(input: string | Date): string {\n311: \t\treturn formatDateTime(\n312: \t\t\tinput,\n313: \t\t\tthis?.user?.settings?.date_format ?? null,\n314: \t\t\tthis?.user?.settings?.time_format ?? null\n315: \t\t);\n316: \t}\n317: \n318: \tgetTimeInUserPreferredFormat(input: string | Date): string {\n319: \t\treturn formatTime(input, this?.user?.settings?.time_format ?? null);\n320: \t}\n321: \n322: \tgetTimeWithSecondsInUserPreferredFormat(input: string | Date): string {\n323: \t\treturn formatTimeWithSeconds(input, this?.user?.settings?.time_format ?? null);\n324: \t}\n325: \n326: \tgetTemperatureInUserPreferredFormat(temperature: number): number {\n327: \t\tif (this?.user?.settings?.temperature_unit === 'c') return temperature;\n328: \n329: \t\treturn Math.round((temperature * 9) / 5 + 32);\n330: \t}\n331: }\n332: \n333: const AUTH_KEY = Symbol('SOLYTO_AUTH');\n334: \n335: export function setAuth(): Auth {\n336: \treturn setContext(AUTH_KEY, new Auth());\n337: }\n338: \n339: export function getAuth(): Auth {\n340: \treturn getContext<Auth>(AUTH_KEY);\n341: }\n\n(End of file - total 341 lines)\n</content>","metadata":{"preview":"import type {\n\tAuthToken,\n\tUser,\n\tLoginRequest,\n\tLoginResponse,\n\tRegisterRequest,\n\tVerifyRequest,\n\tAuthActionResponse,\n\tVerifyActionResponse,\n\tPasskeyActionResponse,\n\tPasskeyAuthenticationOptions,\n\tPasskeyRegistrationOptions,\n\tPasskey\n} from '$lib/types/auth';\nimport { IS_NATIVE, PLATFORM } from '$lib/config/platform';\nimport { setContext, getContext } from 'svelte';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport ApiService from '$lib/services/ApiService';\nimport LocalStorageService from '$lib/services/LocalStorageService';\nimport { SvelteDate, SvelteMap } from 'svelte/reactivity';","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/state/Auth.svelte.ts","text":"import type {\n\tAuthToken,\n\tUser,\n\tLoginRequest,\n\tLoginResponse,\n\tRegisterRequest,\n\tVerifyRequest,\n\tAuthActionResponse,\n\tVerifyActionResponse,\n\tPasskeyActionResponse,\n\tPasskeyAuthenticationOptions,\n\tPasskeyRegistrationOptions,\n\tPasskey\n} from '$lib/types/auth';\nimport { IS_NATIVE, PLATFORM } from '$lib/config/platform';\nimport { setContext, getContext } from 'svelte';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport ApiService from '$lib/services/ApiService';\nimport LocalStorageService from '$lib/services/LocalStorageService';\nimport { SvelteDate, SvelteMap } from 'svelte/reactivity';\nimport {\n\tformatDate,\n\tformatDateTime,\n\tformatDateWithoutYear,\n\tformatDateWithWeekday,\n\tformatTime,\n\tformatTimeWithSeconds\n} from '$lib/helpers/DateHelper';\n\nexport class Auth {\n\tstatic readonly LS_AUTH_KEY: string = 'auth';\n\n\tloggedIn = $state<boolean>(false);\n\tauthToken = $state<AuthToken | null>(null);\n\tuser = $state<User | null>(null);\n\tapiService: ApiService;\n\tlocalStorage = new LocalStorageService();\n\tprofileCache = new SvelteMap<string, User>();\n\n\tconstructor() {\n\t\tthis.apiService = new ApiService(null);\n\t\tthis.load().then();\n\t}\n\n\tprivate async load(): Promise<void> {\n\t\tconst savedAuth = this.localStorage.getJson(Auth.LS_AUTH_KEY);\n\n\t\tif (!savedAuth) return;\n\n\t\tconst { user, authToken } = savedAuth as { user: User; authToken: AuthToken }\n\n\t\tif (!authToken || !user) return;\n\n\t\tconst expiresAt = new SvelteDate(authToken.expires_at).getTime();\n\n\t\tif (expiresAt > Date.now()) {\n\t\t\tthis.user = user;\n\t\t\tthis.authToken = authToken;\n\t\t\tthis.apiService.updateAuthToken(this.getToken()!);\n\t\t\tthis.loggedIn = true;\n\n\t\t\tif (this.shouldRefresh(expiresAt)) {\n\t\t\t\tawait this.refresh();\n\t\t\t}\n\n\t\t\tawait this.loadAdditionalData();\n\n\t\t\tthis.save();\n\t\t} else {\n\t\t\tthis.localStorage.destroy(Auth.LS_AUTH_KEY);\n\t\t}\n\t}\n\n\tpublic async loadAdditionalData(): Promise<void> {\n\t\tif (!this.user) return;\n\t\tconst res = await this.apiService.get(apiRoutes.users.get, null);\n\t\tif (res) this.user = res.data as User;\n\t\tthis.save();\n\t}\n\n\tpublic save(): void {\n\t\tthis.localStorage.setJson(Auth.LS_AUTH_KEY, {\n\t\t\tuser: this.user,\n\t\t\tauthToken: this.authToken\n\t\t});\n\t}\n\n\tprivate clear(): void {\n\t\tthis.localStorage.destroy(Auth.LS_AUTH_KEY);\n\t\tthis.user = null;\n\t\tthis.authToken = null;\n\t\tthis.loggedIn = false;\n\t}\n\n\tasync login(email: string, password: string): Promise<boolean> {\n\t\tconst request: LoginRequest = { email, password, platform: PLATFORM };\n\t\tconst res = await this.apiService.post(apiRoutes.auth.login, request);\n\n\t\tif (!res) return Promise.resolve(false);\n\t\tconst login = res.data as LoginResponse;\n\n\t\tthis.user = login.user;\n\t\tthis.authToken = {\n\t\t\ttoken: login.token,\n\t\t\ttoken_type: login.token_type,\n\t\t\texpires_at: login.token_expires_at\n\t\t};\n\t\tthis.loggedIn = true;\n\t\tthis.apiService.updateAuthToken(this.getToken()!);\n\n\t\tthis.save();\n\t\tawait this.loadAdditionalData();\n\n\t\treturn Promise.resolve(true);\n\t}\n\n\tprivate shouldRefresh(expiresAt: number): boolean {\n\t\tconst thresholdDays = IS_NATIVE ? 14 : 5;\n\t\treturn expiresAt < Date.now() + thresholdDays * 24 * 60 * 60 * 1000;\n\t}\n\n\tasync refresh(): Promise<boolean> {\n\t\tthis.apiService.updateAuthToken(this.getToken()!);\n\t\tconst res = await this.apiService.post(apiRoutes.auth.refresh, {});\n\n\t\tif (!res) return Promise.resolve(false);\n\t\tconst refresh = res.data as LoginResponse;\n\n\t\tthis.user = refresh.user;\n\t\tthis.authToken = {\n\t\t\ttoken: refresh.token,\n\t\t\ttoken_type: refresh.token_type,\n\t\t\texpires_at: refresh.token_expires_at\n\t\t};\n\t\tthis.loggedIn = true;\n\n\t\tthis.save();\n\n\t\treturn Promise.resolve(true);\n\t}\n\n\tlogout(): void {\n\t\tthis.clear();\n\t}\n\n\tisAdmin(): boolean {\n\t\treturn this.user?.role === 'admin' || this.user?.role === 'super_admin';\n\t}\n\n\tasync register(request: RegisterRequest): Promise<AuthActionResponse> {\n\t\treturn this.apiService.postRaw<AuthActionResponse>(apiRoutes.auth.register, request);\n\t}\n\n\tasync verify(request: VerifyRequest): Promise<VerifyActionResponse> {\n\t\treturn this.apiService.postRaw<VerifyActionResponse>(apiRoutes.auth