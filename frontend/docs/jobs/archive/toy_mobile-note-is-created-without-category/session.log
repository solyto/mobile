', category_id: 1 }),\n99: \t\t\t\tnote({ id: '2', category_id: null }),\n100: \t\t\t\tnote({ id: '3', category_id: 1 })\n101: \t\t\t];\n102: \t\t\texpect(n.getNotesForCategory(1).map((x) => x.id)).toEqual(['1', '3']);\n103: \t\t\texpect(n.getNotesForCategory(null).map((x) => x.id)).toEqual(['2']);\n104: \t\t});\n105: \n106: \t\tit('getCategoryTitle resolves top-level categories', () => {\n107: \t\t\tconst n = new NotesSvelte();\n108: \t\t\tn.categories = [category(1, 'Work'), category(2, 'Private')];\n109: \t\t\texpect(n.getCategoryTitle(1)).toBe('Work');\n110: \t\t});\n111: \n112: \t\tit('getCategoryTitle resolves child categories', () => {\n113: \t\t\tconst n = new NotesSvelte();\n114: \t\t\tn.categories = [category(1, 'Work', { children: [category(5, 'Projects')] })];\n115: \t\t\texpect(n.getCategoryTitle(5)).toBe('Projects');\n116: \t\t});\n117: \n118: \t\tit('getCategoryTitle returns a dash for unknown categories', () => {\n119: \t\t\tconst n = new NotesSvelte();\n120: \t\t\tn.categories = [category(1, 'Work')];\n121: \t\t\texpect(n.getCategoryTitle(99)).toBe('-');\n122: \t\t});\n123: \t});\n124: \n125: \tdescribe('collapsed categories', () => {\n126: \t\tit('loads persisted collapsed categories from storage', () => {\n127: \t\t\tstorage.getJson.mockReturnValue([1, 2]);\n128: \t\t\tconst n = new NotesSvelte();\n129: \t\t\texpect(n.collapsedCategories).toEqual([1, 2]);\n130: \t\t\texpect(storage.getJson).toHaveBeenCalledWith(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY);\n131: \t\t});\n132: \n133: \t\tit('defaults to an empty list when nothing is stored', () => {\n134: \t\t\tstorage.getJson.mockReturnValue(null);\n135: \t\t\tconst n = new NotesSvelte();\n136: \t\t\texpect(n.collapsedCategories).toEqual([]);\n137: \t\t});\n138: \n139: \t\tit('toggleCollapseCategory adds and removes ids and persists', () => {\n140: \t\t\tconst n = new NotesSvelte();\n141: \t\t\tn.toggleCollapseCategory(3);\n142: \t\t\texpect(n.isCategoryCollapsed(3)).toBe(true);\n143: \t\t\texpect(sto