{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01229bycjz8KsuBQoAB8Je5n","type":"tool_result","content":"1\tpackage app.solyto.widget;\n2\t\n3\timport android.app.PendingIntent;\n4\timport android.appwidget.AppWidgetManager;\n5\timport android.appwidget.AppWidgetProvider;\n6\timport android.content.ComponentName;\n7\timport android.content.Context;\n8\timport android.content.Intent;\n9\timport android.os.Build;\n10\timport android.os.Bundle;\n11\timport android.text.format.DateFormat;\n12\timport android.view.View;\n13\timport android.widget.RemoteViews;\n14\timport androidx.core.widget.RemoteViewsCompat;\n15\timport app.solyto.MainActivity;\n16\timport app.solyto.R;\n17\timport java.util.Date;\n18\timport org.json.JSONException;\n19\timport org.json.JSONObject;\n20\t\n21\t/** The \"Your Day\" list widget. Renders from {@link WidgetCache}. */\n22\tpublic class YourDayWidgetProvider extends AppWidgetProvider {\n23\t\n24\t    private static final WidgetKind KIND = WidgetKind.YOUR_DAY;\n25\t    private static final int REQUEST_HEADER = 1;\n26\t    private static final int REQUEST_ROW_TEMPLATE = 2;\n27\t\n28\t    @Override\n29\t    public void onEnabled(Context context) {\n30\t        WidgetWork.schedulePeriodic(context);\n31\t    }\n32\t\n33\t    @Override\n34\t    public void onDisabled(Context context) {\n35\t        WidgetWork.cancelIfNoWidgets(context);\n36\t    }\n37\t\n38\t    @Override\n39\t    public void onUpdate(Context context, AppWidgetManager manager, int[] appWidgetIds) {\n40\t        for (int id : appWidgetIds) render(context, manager, id);\n41\t        WidgetWork.schedulePeriodic(context);\n42\t        WidgetWork.fetchNow(context);\n43\t    }\n44\t\n45\t    @Override\n46\t    public void onAppWidgetOptionsChanged(Context context, AppWidgetManager manager, int appWidgetId,\n47\t            Bundle newOptions) {\n48\t        render(context, manager, appWidgetId);\n49\t    }\n50\t\n51\t    /** Re-renders every placed Your Day widget from the cache. */\n52\t    public static void updateAll(Context context) {\n53\t        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n54\t        for (int id : widgetIds(context)) render(context, manager, id);\n55\t    }\n56\t\n57\t    private static int[] widgetIds(Context context) {\n58\t        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n59\t        if (manager == null) return new int[0];\n60\t        return manager.getAppWidgetIds(new ComponentName(context, YourDayWidgetProvider.class));\n61\t    }\n62\t\n63\t    private static void render(Context context, AppWidgetManager manager, int appWidgetId) {\n64\t        RemoteViews views = new RemoteViews(context.getPackageName(), R.layout.widget_your_day);\n65\t        PendingIntent openApp = openAppIntent(context);\n66\t        views.setOnClickPendingIntent(R.id.widget_header, openApp);\n67\t        views.setOnClickPendingIntent(R.id.widget_message, openApp);\n68\t        views.setPendingIntentTemplate(R.id.widget_list, rowTemplateIntent(context));\n69\t\n70\t        WidgetPayload payload = null;\n71\t        String message;\n72\t        WidgetCache.State state = WidgetCache.state(context);\n73\t\n74\t        boolean deviceUnsupported = WidgetCache.isDeviceUnsupported(context);\n75\t        if (!deviceUnsupported && state == WidgetCache.State.OK) {\n76\t            payload = parse(WidgetCache.payload(context, KIND));\n77\t        }\n78\t\n79\t        if (deviceUnsupported) {\n80\t            message = context.getString(R.string.widget_not_supported);\n81\t        } else if (payload != null) {\n82\t            message = payload.emptyLabel != null ? payload.emptyLabel : \"\";\n83\t        } else if ((state == WidgetCache.State.LOADING || state == WidgetCache.State.OK)\n84\t                && WidgetCache.isOutdated(context, KIND)) {\n85\t            // A fetch failed before any data was cached: say so instead of \"Loading…\".\n86\t            message = context.getString(R.string.widget_load_failed);\n87\t        } else {\n88\t            // OK without data of this kind yet (e.g. right after an app update) shows \"Loading…\".\n89\t            message = context.getString(stateMessage(state));\n90\t        }\n91\t\n92\t        views.setTextViewText(R.id.widget_title, payload != null && payload.title != null\n93\t                ? payload.title : context.getString(R.string.widget_your_day_name));\n94\t        renderUpdatedAt(context, views, payload != null);\n95\t\n96\t        RemoteViewsCompat.RemoteCollectionItems.Builder items =\n97\t                new RemoteViewsCompat.RemoteCollectionItems.Builder()\n98\t                        .setHasStableIds(false)\n99\t                        .setViewTypeCount(2);\n100\t        boolean hasRows = payload != null && !payload.items.isEmpty();\n101\t        if (hasRows) {\n102\t            for (int i = 0; i < payload.items.size(); i++) {\n103\t                items.addItem(i, itemView(context, payload.items.get(i)));\n104\t            }\n105\t        }\n106\t        RemoteViewsCompat.setRemoteAdapter(context, views, appWidgetId, R.id.widget_list, items.build());\n107\t\n108\t        views.setViewVisibility(R.id.widget_list, hasRows ? View.VISIBLE : View.GONE);\n109\t        views.setViewVisibility(R.id.widget_message, hasRows ? View.GONE : View.VISIBLE);\n110\t        views.setTextViewText(R.id.widget_message, message);\n111\t\n112\t        manager.updateAppWidget(appWidgetId, views);\n113\t    }\n114\t\n115\t    private static int stateMessage(WidgetCache.State state) {\n116\t        switch (state) {\n117\t            case SIGNED_OUT:\n118\t                return R.string.widget_signed_out;\n119\t            case UNSUPPORTED_SERVER:\n120\t                return R.string.widget_unsupported_server;\n121\t            case UPDATE_APP:\n122\t                return R.string.widget_update_app;\n123\t            default:\n124\t                return R.string.widget_loading;\n125\t        }\n126\t    }\n127\t\n128\t    private static WidgetPayload parse(String json) {\n129\t        if (json == null) return null;\n130\t        try {\n131\t            return WidgetPayload.parse(new JSONObject(json), KIND);\n132\t        } catch (JSONException e) {\n133\t            return null;\n134\t        }\n135\t    }\n136\t\n137\t    private static void renderUpdatedAt(Context context, RemoteViews views, boolean hasData) {\n138\t        long fetchedAt = WidgetCache.fetchedAt(context, KIND);\n139\t        if (!hasData || fetchedAt <= 0) {\n140\t            views.setViewVisibility(R.id.widget_updated, View.GONE);\n141\t            return;\n142\t        }\n143\t        if (WidgetCache.hasActionError(context, KIND)) {\n144\t            views.setTextViewText(R.id.widget_updated, context.getString(R.string.widget_action_failed));\n145\t            views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n146\t            return;\n147\t        }\n148\t        String time = DateFormat.getTimeFormat(context).format(new Date(fetchedAt));\n149\t        int label = WidgetCache.isOutdated(context, KIND) ? R.string.widget_outdated_at : R.string.widget_updated_at;\n150\t        views.setTextViewText(R.id.widget_updated, context.getString(label, time));\n151\t        views.setViewVisibility(R.id.widget_updated, View.VISIBLE);\n152\t    }\n153\t\n154\t    private static RemoteViews itemView(Context context, WidgetPayload.Item item) {\n155\t        if (item.isHeader) {\n156\t            RemoteViews header = new RemoteViews(context.getPackageName(), R.layout.widget_your_day_section);\n157\t            header.setTextViewText(R.id.widget_section_title, item.title);\n158\t            return header;\n159\t        }\n160\t\n161\t        RemoteViews row = new RemoteViews(context.getPackageName(), R.layout.widget_your_day_row);\n162\t        row.setTextViewText(R.id.widget_row_title, item.title);\n163\t        setOptionalText(row, R.id.widget_row_subtitle, item.subtitle);\n164\t        setOptionalText(row, R.id.widget_row_time, item.timeLabel);\n165\t\n166\t        int icon = iconResource(item.icon);\n167\t        if (item.actionType != null) {\n168\t            bindCheck(context, row, item);\n169\t            row.setViewVisibility(R.id.widget_row_icon, View.GONE);\n170\t        } else {\n171\t            row.setViewVisibility(R.id.widget_row_check, View.GONE);\n172\t            if (icon != 0) {\n173\t                row.setImageViewResource(R.id.widget_row_icon, icon);\n174\t                row.setViewVisibility(R.id.widget_row_icon, View.VISIBLE);\n175\t            } else {\n176\t                row.setViewVisibility(R.id.widget_row_icon, View.GONE);\n177\t            }\n178\t        }\n179\t\n180\t        if (item.routeKey != null) {\n181\t            Intent fillIn = new Intent().putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, item.routeKey);\n182\t            if (item.routeId != null) fillIn.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, item.routeId);\n183\t            row.setOnClickFillInIntent(R.id.widget_row, fillIn);\n184\t        }\n185\t        return row;\n186\t    }\n187\t\n188\t    /**\n189\t     * The row's checkbox: checked when the server says so or a local action\n190\t     * is active. On API 31+ the launcher toggles the CheckBox itself, so every\n191\t     * render sets its state explicitly; a reverted row is unchecked again.\n192\t     * The fill-in is always set, so a recycled list view never keeps another\n193\t     * row's; the receiver ignores taps on checked and active rows.\n194\t     */\n195\t    private static void bindCheck(Context context, RemoteViews row, WidgetPayload.Item item) {\n196\t        boolean checked = item.actionChecked || WidgetCache.isActionActive(context, KIND, item.id);\n197\t        Intent fillIn = new Intent()\n198\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_KIND, KIND.id)\n199\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_TYPE, item.actionType)\n200\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_KEY, item.actionKey)\n201\t                .putExtra(WidgetActionReceiver.EXTRA_ACTION_ID, item.id);\n202\t\n203\t        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {\n204\t            row.setCompoundButtonChecked(R.id.widget_row_check, checked);\n205\t            row.setBoolean(R.id.widget_row_check, \"setEnabled\", !checked);\n206\t            row.setOnCheckedChangeResponse(R.id.widget_row_check,\n207\t                    RemoteViews.RemoteResponse.fromFillInIntent(fillIn));\n208\t        } else {\n209\t            row.setImageViewResource(R.id.widget_row_check,\n210\t                    checked ? R.drawable.ic_widget_check_on : R.drawable.ic_widget_todo);\n211\t            row.setOnClickFillInIntent(R.id.widget_row_check, fillIn);\n212\t        }\n213\t        row.setContentDescription(R.id.widget_row_check, context.getString(R.string.widget_action_check));\n214\t        row.setViewVisibility(R.id.widget_row_check, View.VISIBLE);\n215\t    }\n216\t\n217\t    // Always sets visibility: the list reapplies row views to recycled views,\n218\t    // so a row without this text would otherwise keep a previous row's.\n219\t    private static void setOptionalText(RemoteViews views, int viewId, String text) {\n220\t        if (text == null) {\n221\t            views.setViewVisibility(viewId, View.GONE);\n222\t            return;\n223\t        }\n224\t        views.setTextViewText(viewId, text);\n225\t        views.setViewVisibility(viewId, View.VISIBLE);\n226\t    }\n227\t\n228\t    private static int iconResource(String icon) {\n229\t        if (\"event\".equals(icon)) return R.drawable.ic_widget_event;\n230\t        if (\"todo\".equals(icon)) return R.drawable.ic_widget_todo;\n231\t        return 0;\n232\t    }\n233\t\n234\t    private static PendingIntent openAppIntent(Context context) {\n235\t        Intent intent = new Intent(context, MainActivity.class)\n236\t                .setAction(Intent.ACTION_MAIN)\n237\t                .addCate