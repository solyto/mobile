{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KprdSyyADCC8kdwrCXqEH3","type":"tool_result","content":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    android:id=\"@+id/widget_root\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@drawable/widget_background\"\n    android:orientation=\"vertical\"\n    android:padding=\"12dp\">\n\n    <LinearLayout\n        android:id=\"@+id/widget_header\"\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:gravity=\"center_vertical\"\n        android:orientation=\"horizontal\"\n        android:paddingBottom=\"6dp\">\n\n        <TextView\n            android:id=\"@+id/widget_title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_weight=\"1\"\n            android:ellipsize=\"end\"\n            android:singleLine=\"true\"\n            android:text=\"@string/widget_time_tracking_name\"\n            android:textColor=\"@color/widget_text\"\n            android:textSize=\"16sp\"\n            android:textStyle=\"bold\" />\n\n        <TextView\n            android:id=\"@+id/widget_updated\"\n            android:layout_width=\"wrap_content\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"8dp\"\n            android:singleLine=\"true\"\n            android:textColor=\"@color/widget_text_secondary\"\n            android:textSize=\"12sp\"\n            android:visibility=\"gone\" />\n    </LinearLayout>\n\n    <!--\n        The running timer lives outside the list: a Chronometer inside a\n        collection row does not tick on many launchers.\n    -->\n    <LinearLayout\n        android:id=\"@+id/widget_running\"\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_co