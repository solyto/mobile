D, KIND.id)\n234\t+                .putExtra(WidgetActionReceiver.EXTRA_ACTION_TYPE, item.actionType)\n235\t+                .putExtra(WidgetActionReceiver.EXTRA_ACTION_KEY, item.actionKey)\n236\t+                .putExtra(WidgetActionReceiver.EXTRA_ACTION_ID, item.id)\n237\t+                .putExtra(WidgetActionReceiver.EXTRA_ACTION_VALUE, option.value);\n238\t+\n239\t+        row.setImageViewResource(viewId, iconRes(option.icon));\n240\t+        row.setInt(viewId, \"setColorFilter\", option.color);\n241\t+        row.setInt(viewId, \"setBackgroundResource\", selected ? R.drawable.widget_check_in_option_selected : 0);\n242\t+        row.setContentDescription(viewId, context.getString(\n243\t+                selected ? R.string.widget_check_in_option_selected : R.string.widget_check_in_option,\n244\t+                item.title, index + 1, item.options.size()));\n245\t+        row.setInt(viewId, \"setImageAlpha\", busy ? BUSY_ALPHA : 255);\n246\t+        row.setBoolean(viewId, \"setEnabled\", !busy);\n247\t+        row.setOnClickFillInIntent(viewId, fillIn);\n248\t+        row.setViewVisibility(viewId, View.VISIBLE);\n249\t+    }\n250\t+\n251\t+    /** The drawable for one of {@link WidgetPayload#OPTION_ICONS}. */\n252\t+    private static int iconRes(String icon) {\n253\t+        switch (icon) {\n254\t+            case \"mood_1\": return R.drawable.ic_widget_checkin_mood_1;\n255\t+            case \"mood_2\": return R.drawable.ic_widget_checkin_mood_2;\n256\t+            case \"mood_3\": return R.drawable.ic_widget_checkin_mood_3;\n257\t+            case \"mood_4\": return R.drawable.ic_widget_checkin_mood_4;\n258\t+            case \"mood_5\": return R.drawable.ic_widget_checkin_mood_5;\n259\t+            case \"sport_dumbbell\": return R.drawable.ic_widget_checkin_sport_dumbbell;\n260\t+            case \"sport_bike\": return R.drawable.ic_widget_checkin_sport_bike;\n261\t+            case \"sport_mountain\": return R.drawable.ic_widget_checkin_sport_mountain;\n2