{"type":"tool_use","timestamp":1788619782438,"sessionID":"ses_f8df42ffdffeMnfPr2offFS97i","part":{"type":"tool","tool":"read","callID":"call_d5fd7a50192d4ae1a6559e7e","state":{"status":"completed","input":{"filePath":"/workspace/src/lib/state/Notes.svelte.ts"},"output":"<path>/workspace/src/lib/state/Notes.svelte.ts</path>\n<type>file</type>\n<content>\n1: import type {\n2: \tCreateNoteCategoryRequest,\n3: \tCreateNoteRequest,\n4: \tNote,\n5: \tNoteCategory,\n6: \tUpdateNoteCategoryRequest,\n7: \tUpdateNoteRequest\n8: } from '$lib/types/note';\n9: import { setContext, getContext, tick } from 'svelte';\n10: import { getAuth } from '$lib/state/Auth.svelte';\n11: import { page } from '$app/state';\n12: import { goto } from '$app/navigation';\n13: import { urls } from '$lib/config/urls';\n14: import { resolve } from '$app/paths';\n15: import ApiService from '$lib/services/ApiService';\n16: import LocalStorageService from '$lib/services/LocalStorageService';\n17: import { apiRoutes } from '$lib/config/apiRoutes';\n18: import { SvelteDate } from 'svelte/reactivity';\n19: \n20: export class NotesSvelte {\n21: \tstatic readonly LS_COLLAPSED_CATEGORIES_KEY: string = 'notes.collapsedCategories';\n22: \n23: \tloaded = $state<boolean>(false);\n24: \tnotes = $state<Note[]>([]);\n25: \tnewestNotes = $state<Note[]>([]);\n26: \tlastUpdatedNotes = $state<Note[]>([]);\n27: \tfavoriteNotes = $state<Note[]>([]);\n28: \tcategories = $state<NoteCategory[]>([]);\n29: \tcollapsedCategories = $state<number[]>([]);\n30: \tactiveNote = $state<Note | null>(null);\n31: \tmodalOpen = $state<boolean>(false);\n32: \tcreateType = $state<'note' | 'category'>('note');\n33: \tcreateParent = $state<number | null>(null);\n34: \trightClickMenuOpen = $state<boolean>(false);\n35: \trightClickMenuX = $state<number>(0);\n36: \trightClickMenuY = $state<number>(0);\n37: \trightClickType = $state<'note' | 'category'>('note');\n38: \trightClickId = $state<number | string | null>(null);\n39: \tdraggedNote = $state<Note | null>(null);\n40: \tdragTarget = $state<NoteCategory | null>(null);\n41: \tinput = $state<HTMLInputElement | null>(null);\n42: \tinputValue = $state<string>('');\n43: \tauth = getAuth();\n44: \tapiService: ApiService;\n45: \tlocalStorage = new LocalStorageService();\n46: \n47: \tconstructor() {\n48: \t\tthis.apiService = new ApiService(this.auth.getToken());\n49: \t\tthis.loadCollapsedCategories();\n50: \t}\n51: \n52: \tasync load(): Promise<void> {\n53: \t\tconst res = await this.apiService.list(apiRoutes.notes.list);\n54: \t\tif (res) {\n55: \t\t\tthis.loaded = true;\n56: \t\t\tthis.notes = res.data as Note[];\n57: \t\t\tthis.newestNotes = this.getNewestNotes();\n58: \t\t\tthis.lastUpdatedNotes = this.getLastUpdatedNotes();\n59: \t\t\tthis.favoriteNotes = this.getFavorites();\n60: \t\t\tthis.checkUrlForActiveNote();\n61: \t\t}\n62: \t}\n63: \n64: \tloadCollapsedCategories(): void {\n65: \t\tconst stored = this.localStorage.getJson(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY);\n66: \t\tthis.collapsedCategories = (stored as number[] | null) ?? [];\n67: \t}\n68: \n69: \tsaveCollapsedCategories(): void {\n70: \t\tthis.localStorage.setJson(\n71: \t\t\tNotesSvelte.LS_COLLAPSED_CATEGORIES_KEY,\n72: \t\t\tthis.collapsedCategories\n73: \t\t);\n74: \t}\n75: \n76: \tcheckUrlForActiveNote(): void {\n77: \t\tif (page.params.id) {\n78: \t\t\tthis.selectNote(page.params.id);\n79: \t\t}\n80: \t}\n81: \n82: \tasync loadCategories(): Promise<void> {\n83: \t\tconst res = await this.apiService.list(apiRoutes.notes.listCategories);\n84: \t\tif (res) this.categories = res.data as NoteCategory[];\n85: \t}\n86: \n87: \ttoggleCollapseCategory(categoryId: number): void {\n88: \t\tif (this.collapsedCategories.includes(categoryId)) {\n89: \t\t\tthis.collapsedCategories = this.collapsedCategories.filter((c) => c !== categoryId);\n90: \t\t} else {\n91: \t\t\tthis.collapsedCategories.push(categoryId);\n92: \t\t}\n93: \n94: \t\tthis.saveCollapsedCategories();\n95: \t}\n96: \n97: \tisCategoryCollapsed(categoryId: number): boolean {\n98: \t\treturn this.collapsedCategories.includes(categoryId);\n99: \t}\n100: \n101: \tgetNotesForCategory(categoryId: number | null): Note[] {\n102: \t\treturn this.notes.filter((n) => n.category_id === categoryId);\n103: \t}\n104: \n105: \tgetCategoryTitle(categoryId: number): string {\n106: \t\tfor (const cat of this.categories) {\n107: \t\t\tif (cat.id === categoryId) return cat.title;\n108: \t\t\tif (cat.children) {\n109: \t\t\t\tfor (const child of cat.children) {\n110: \t\t\t\t\tif (child.id === categoryId) return child.title;\n111: \t\t\t\t}\n112: \t\t\t}\n113: \t\t}\n114: \n115: \t\treturn '-';\n116: \t}\n117: \n118: \tgetLastUpdatedNotes(): Note[] {\n119: \t\treturn [...this.notes]\n120: \t\t\t.sort(\n121: \t\t\t\t(a, b) =>\n122: \t\t\t\t\tnew SvelteDate(b.updated_at).getTime() - new SvelteDate(a.updated_at).getTime()\n123: \t\t\t)\n124: \t\t\t.slice(0, 5);\n125: \t}\n126: \n127: \tgetNewestNotes(): Note[] {\n128: \t\treturn [...this.notes]\n129: \t\t\t.sort(\n130: \t\t\t\t(a, b) =>\n131: \t\t\t\t\tnew SvelteDate(b.created_at).getTime() - new SvelteDate(a.created_at).getTime()\n132: \t\t\t)\n133: \t\t\t.slice(0, 5);\n134: \t}\n135: \n136: \tgetFavorites(): Note[] {\n137: \t\treturn [...this.notes].filter((n) => n.is_favorite);\n138: \t}\n139: \n140: \tselectNote(noteId: string): void {\n141: \t\tthis.activeNote = this.notes.find((n) => n.id === noteId) ?? null;\n142: \t}\n143: \n144: \tasync openModal(type: 'note' | 'category', edit: boolean = false): Promise<void> {\n145: \t\tif (type === 'category' && edit && this.rightClickId) {\n146: \t\t\tthis.inputValue =\n147: \t\t\t\tthis.categories.filter((c) => c.id === this.rightClickId)[0]?.title ?? '';\n148: \t\t} else {\n149: \t\t\tthis.inputValue = '';\n150: \t\t}\n151: \n152: \t\tthis.createType = type;\n153: \t\tthis.modalOpen = true;\n154: \n155: \t\tawait tick();\n156: \n157: \t\tsetTimeout(() => this.input?.focus(), 100);\n158: \t}\n159: \n160: \tcloseModal(): void {\n161: \t\tthis.modalOpen = false;\n162: \t}\n163: \n164: \topenRightClickMenu(event: MouseEvent, type: 'note' | 'category', id: number | string): void {\n165: \t\tevent.preventDefault();\n166: \n167: \t\tthis.rightClickType = type;\n168: \t\tthis.rightClickMenuX = event.clientX;\n169: \t\tthis.rightClickMenuY = event.clientY;\n170: \t\tthis.rightClickId = id;\n171: \t\tthis.createParent = type === 'category' ? id as number : null;\n172: \t\tthis.rightClickMenuOpen = true;\n173: \t}\n174: \n175: \tcloseRightClickMenu(): void {\n176: \t\tthis.rightClickMenuOpen = false;\n177: \t}\n178: \n179: \tasync dragToCategory(): Promise<void> {\n180: \t\tif (this.draggedNote === null) return;\n181: \n182: \t\tconst request: UpdateNoteRequest = {\n183: \t\t\tcategory_id: this.dragTarget ? this.dragTarget.id : null\n184: \t\t};\n185: \t\tconst ok = await this.apiService.update(\n186: \t\t\tapiRoutes.notes.update,\n187: \t\t\tthis.draggedNote.id,\n188: \t\t\trequest\n189: \t\t);\n190: \t\tif (ok) await this.load();\n191: \t\treturn Promise.resolve();\n192: \t}\n193: \n194: \tasync create(): Promise<Note | null> {\n195: \t\tif (this.inputValue === '') {\n196: \t\t\treturn null;\n197: \t\t}\n198: \n199: \t\tconst request: CreateNoteRequest =\n200: \t\t\tthis.createParent !== null\n201: \t\t\t\t? { title: this.inputValue, category_id: this.createParent }\n202: \t\t\t\t: { title: this.inputValue };\n203: \t\tconst res = await this.apiService.create(apiRoutes.notes.create, request);\n204: \n205: \t\tif (!res) {\n206: \t\t\tthis.inputValue = '';\n207: \t\t\tthis.createParent = null;\n208: \t\t\tthis.rightClickMenuOpen = false;\n209: \t\t\treturn null;\n210: \t\t}\n211: \n212: \t\tconst note = res.data as Note;\n213: \n214: \t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n215: \t\t\tthis.toggleCollapseCategory(this.createParent);\n216: \t\t}\n217: \n218: \t\tthis.inputValue = '';\n219: \t\tthis.createParent = null;\n220: \t\tthis.rightClickMenuOpen = false;\n221: \n222: \t\tawait this.load();\n223: \t\tthis.activeNote = this.notes.find((n) => n.id === note.id) ?? note;\n224: \t\tawait goto(resolve(urls.note, { id: note.id }));\n225: \n226: \t\treturn note;\n227: \t}\n228: \n229: \tasync createCategory(edit: boolean = false): Promise<NoteCategory | null> {\n230: \t\tif (this.inputValue === '') {\n231: \t\t\treturn null;\n232: \t\t}\n233: \n234: \t\tlet res;\n235: \n236: \t\tif (edit && this.rightClickId) {\n237: \t\t\tconst request: UpdateNoteCategoryRequest = { title: this.inputValue };\n238: \t\t\tres = await this.apiService.update(\n239: \t\t\t\tapiRoutes.notes.updateCategory,\n240: \t\t\t\tthis.rightClickId,\n241: \t\t\t\trequest\n242: \t\t\t);\n243: \t\t} else {\n244: \t\t\tconst request: CreateNoteCategoryRequest =\n245: \t\t\t\tthis.createParent !== null\n246: \t\t\t\t\t? { title: this.inputValue, parent_id: this.createParent }\n247: \t\t\t\t\t: { title: this.inputValue };\n248: \t\t\tres = await this.apiService.create(apiRoutes.notes.createCategory, request);\n249: \t\t}\n250: \n251: \t\tif (res) await this.loadCategories();\n252: \n253: \t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n254: \t\t\tthis.toggleCollapseCategory(this.createParent);\n255: \t\t}\n256: \n257: \t\tthis.inputValue = '';\n258: \t\tthis.createParent = null;\n259: \t\tthis.rightClickMenuOpen = false;\n260: \n261: \t\treturn res && typeof res === 'object' ? (res.data as NoteCategory) : null;\n262: \t}\n263: \n264: \tasync saveContent(): Promise<boolean> {\n265: \t\tconst request: UpdateNoteRequest = { content: this.activeNote!.content };\n266: \t\tconst ok = await this.apiService.update(\n267: \t\t\tapiRoutes.notes.update,\n268: \t\t\tthis.activeNote!.id,\n269: \t\t\trequest\n270: \t\t);\n271: \t\tif (ok) await this.load();\n272: \t\treturn ok;\n273: \t}\n274: \n275: \tasync changeTitle(title: string): Promise<boolean> {\n276: \t\tconst request: UpdateNoteRequest = { title: title };\n277: \t\tconst ok = await this.apiService.update(\n278: \t\t\tapiRoutes.notes.update,\n279: \t\t\tthis.activeNote!.id,\n280: \t\t\trequest\n281: \t\t);\n282: \t\tif (ok) await this.load();\n283: \t\treturn ok;\n284: \t}\n285: \n286: \tasync updateFavoriteStatus(note: Note, isFavorite: boolean): Promise<boolean> {\n287: \t\tconst request: UpdateNoteRequest = { is_favorite: isFavorite };\n288: \t\tconst ok = await this.apiService.update(\n289: \t\t\tapiRoutes.notes.update,\n290: \t\t\tthis.activeNote!.id,\n291: \t\t\trequest\n292: \t\t);\n293: \t\tif (ok) await this.load();\n294: \t\treturn ok;\n295: \t}\n296: \n297: \tasync addTag(tagId: number): Promise<boolean> {\n298: \t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n299: \t\tconst request: UpdateNoteRequest = { tags: tagIds.concat([tagId]) };\n300: \t\tconst ok = await this.apiService.update(\n301: \t\t\tapiRoutes.notes.update,\n302: \t\t\tthis.activeNote!.id,\n303: \t\t\trequest\n304: \t\t);\n305: \n306: \t\tif (ok) await this.load();\n307: \t\treturn ok;\n308: \t}\n309: \n310: \tasync removeTag(tagId: number): Promise<boolean> {\n311: \t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n312: \t\tconst request: UpdateNoteRequest = { tags: tagIds.filter((id) => id != tagId) };\n313: \t\tconst ok = await this.apiService.update(\n314: \t\t\tapiRoutes.notes.update,\n315: \t\t\tthis.activeNote!.id,\n316: \t\t\trequest\n317: \t\t);\n318: \n319: \t\tif (ok) await this.load();\n320: \t\treturn ok;\n321: \t}\n322: \n323: \tasync delete(): Promise<boolean> {\n324: \t\tif (this.rightClickType === 'category' || typeof this.rightClickId !== 'string') {\n325: \t\t\treturn false;\n326: \t\t}\n327: \n328: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.rightClickId);\n329: \t\tif (ok) {\n330: \t\t\tif (this.activeNote?.id === this.rightClickId) {\n331: \t\t\t\tawait goto(resolve(urls.notes));\n332: \t\t\t}\n333: \n334: \t\t\tawait this.load();\n335: \t\t\tthis.closeRightClickMenu();\n336: \t\t}\n337: \t\treturn ok;\n338: \t}\n339: \n340: \tasync deleteActiveNote(): Promise<boolean> {\n341: \t\tif (!this.activeNote) return false;\n342: \n343: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.activeNote.id);\n344: \t\tif (ok) {\n345: \t\t\tawait goto(resolve(urls.notes));\n346: \t\t\tawait this.load();\n347: \t\t}\n348: \t\treturn ok;\n349: \t}\n350: \n351: \tasync deleteCategory(): Promise<boolean> {\n352: \t\tif (this.rightClickType === 'note' || typeof this.rightClickId !== 'number') {\n353: \t\t\treturn false;\n354: \t\t}\n355: \n356: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.deleteCategory, this.rightClickId);\n357: \t\tif (ok) await this.loadCategories();\n358: \t\tthis.closeRightClickMenu();\n359: \t\treturn ok;\n360: \t}\n361: \n362: \tasync importFile(file: File): Promise<boolean> {\n363: \t\tconst formData = new FormData();\n364: \t\tformData.append('file', file);\n365: \t\tconst ok = await this.apiService.post(apiRoutes.notes.import, formData);\n366: \n367: \t\tif (ok) {\n368: \t\t\tawait this.load();\n369: \t\t\treturn true;\n370: \t\t}\n371: \n372: \t\treturn false;\n373: \t}\n374: }\n375: \n376: const NOTES_KEY = Symbol('SOLYTO_NOTES');\n377: \n378: export function setNotes(): NotesSvelte {\n379: \treturn setContext(NOTES_KEY, new NotesSvelte());\n380: }\n381: \n382: export function getNotes(): NotesSvelte {\n383: \treturn getContext<NotesSvelte>(NOTES_KEY);\n384: }\n\n(End of file - total 384 lines)\n</content>","metadata":{"preview":"import type {\n\tCreateNoteCategoryRequest,\n\tCreateNoteRequest,\n\tNote,\n\tNoteCategory,\n\tUpdateNoteCategoryRequest,\n\tUpdateNoteRequest\n} from '$lib/types/note';\nimport { setContext, getContext, tick } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport { page } from '$app/state';\nimport { goto } from '$app/navigation';\nimport { urls } from '$lib/config/urls';\nimport { resolve } from '$app/paths';\nimport ApiService from '$lib/services/Ap