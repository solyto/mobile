{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FfLXkEtKbmWhgt5ecxUVj2","type":"tool_result","content":"#!/usr/bin/env bash\n# Build the committed frontend (mobile/frontend) and sync it into the Android project.\n# Run by F-Droid (prebuild) and by the GitHub release workflow. No network fetch of app source.\nset -e\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nROOT=\"$SCRIPT_DIR/..\"\nGRADLE=\"$ROOT/android/app/build.gradle\"\n\nVERSION_NAME=$(node -p \"require('$ROOT/package.json').version\")\nVERSION_CODE=$(echo \"$VERSION_NAME\" | awk -F. '{ printf \"%d%02d%02d\", $1, $2, $3 }')\n\necho \"→ Setting version $VERSION_NAME ($VERSION_CODE)...\"\nsed -i \"s/versionCode [0-9]*/versionCode $VERSION_CODE/\" \"$GRADLE\"\nsed -i \"s/versionName \\\"[^\\\"]*\\\"/versionName \\\"$VERSION_NAME\\\"/\" \"$GRADLE\"\n\necho \"→ Building frontend...\"\ncd \"$ROOT/frontend\"\nnpm ci --engine-strict=false\nPUBLIC_MOBILE=true PUBLIC_VERSION=\"$VERSION_NAME\" PUBLIC_REDIRECT_AFTER_LOGOUT=/ npm run build\n\necho \"→ Syncing to Capacitor...\"\ncd \"$ROOT\"\nnpm install\nnpx cap sync android\n\necho \"✓ Done\"\n#!/usr/bin/env bash\nset -e\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"$SCRIPT_DIR/../.env\"\n\nif [ -z \"$VERSION\" ]; then\n  echo \"Usage: VERSION=1.0.8 make release\"\n  exit 1\nfi\n\ncd \"$SCRIPT_DIR/..\"\n\nVERSION_CODE=$(echo \"$VERSION\" | awk -F. '{ printf \"%d%02d%02d\", $1, $2, $3 }')\n\necho \"→ Refreshing vendored frontend from ../app...\"\n\"$SCRIPT_DIR/vendor.sh\"\n\necho \"→ Setting version $VERSION ($VERSION_CODE)...\"\nnpm pkg set version=\"$VERSION\"\nsed -i \"s/versionCode [0-9]*/versionCode $VERSION_CODE/\" android/app/build.gradle\nsed -i \"s/versionName \\\"[^\\\"]*\\\"/versionName \\\"$VERSION\\\"/\" android/app/build.gradle\n\ngit add frontend package.json android/app/build.gradle\ngit diff --cached --quiet || git commit -m \"chore: release v$VERSION\"\ngit tag \"v$VERSION\"\ngit push origin main \"v$VERSION\"\nname: Release\n\non:\n  push:\n    tags:\n      - 'v*'\n\npermissions:\n  contents: write\n\njobs:\n  release:\n    runs-on: ubuntu-latest\n\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          path: mobile\n\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n\n      - uses: actions/setup-java@v4\n        with:\n          distribution: temurin\n          java-version: 21\n\n      - name: Set version from tag\n        working-directory: mobile\n        run: |\n          VERSION=\"${GITHUB_REF_NAME#v}\"\n          npm pkg set version=\"$VERSION\"\n\n      - name: Install mobile dependencies\n        working-directory: mobile\n        run: npm install\n\n      - name: Build web assets\n        working-directory: mobile\n        run: bash scripts/build-fdroid.sh\n\n      - name: Decode keystore\n        run: echo \"${{ secrets.KEYSTORE_BASE64 }}\" | base64 -d > mobile/keystore.jks\n\n      - name: Build release APK\n        working-directory: mobile/android\n        env:\n          KEYSTORE_PATH: ${{ github.workspace }}/mobile/keystore.jks\n          STORE_PASSWORD: ${{ secrets.STORE_PASSWORD }}\n          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}\n          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}\n        run: ./gradlew assembleRelease\n\n      - name: Rename APK\n        run: |\n          VERSION=\"${GITHUB_REF_NAME#v}\"\n          mv mobile/android/app/build/outputs/apk/release/app-release.apk \\\n             mobile/android/app/build/outputs/apk/release/solyto-${VERSION}.apk\n\n      - name: Upload to GitHub Release\n        uses: softprops/action-gh-release@v2\n        with:\n          files: mobile/android/app/build/outputs/apk/release/solyto-*.apk\nCategories:\n  - Calendar & Agenda\n  - Contact\n  - Inventory\n  - Note\n  - Task\nLicense: AGPL-3.0-only\nAuthorName: Leander Muskalla\nWebSite: https://solyto.app\nSourceCode: https://github.com/solyto/mobile\nIssueTracker: https://github.com/solyto/mobile/issues\nChangelog: https://github.com/solyto/mobile/releases\n\nAutoName: solyto\n\nRepoType: git\nRepo: https://github.com/solyto/mobile\n\nBuilds:\n  - versionName: 1.0.12\n    versionCode: 10012\n    commit: 114935c396199e08ff296fec5b3de1321c10b5f7\n    subdir: android/app\n    sudo:\n      - apt-get update\n      - apt-get install -y nodejs npm\n    gradle:\n      - yes\n    prebuild: bash ../../scripts/build-fdroid.sh\n    scandelete:\n      - frontend/node_modules\n      - node_modules/@capacitor/cli\n\n  - versionName: 1.0.13\n    versionCode: 10013\n    commit: 99e501bbaafa95528e1dee2815ef204ebf2e3cdb\n    subdir: android/app\n    sudo:\n      - apt-get update\n      - apt-get install -y nodejs npm\n    gradle:\n      - yes\n    prebuild: bash ../../scripts/build-fdroid.sh\n    scandelete:\n      - frontend/node_modules\n      - node_modules/@capacitor/cli\n\n  - versionName: 1.0.15\n    versionCode: 10015\n    commit: a2b4182d0819af8b076782b7f5174c71795185e1\n    subdir: android/app\n    sudo:\n      - apt-get update\n      - apt-get install -y nodejs npm\n    gradle:\n      - yes\n    prebuild: bash ../../scripts/build-fdroid.sh\n    scandelete:\n      - frontend/node_modules\n      - node_modules/@capacitor/cli\n\nAutoUpdateMode: Version\nUpdateCheckMode: Tags\nCurrentVersion: 1.0.15\nCurrentVersionCode: 10015\nfastlane/metadata/android/en-US/short_description.txt\nfastlane/metadata/android/en-US/full_description.txt\nfastlane/metadata/android/en-US/title.txt\nfastlane/metadata/android/en-US/images/icon.png\nfastlane/metadata/android/en-US/changelogs/10012.txt\nfastlane/metadata/android/en-US/images/phoneScreenshots/5.png\nfastlane/metadata/android/en-US/images/phoneScreenshots/3.png\nfastlane/metadata/android/en-US/images/phoneScreenshots/1.png\nfastlane/metadata/android/en-US/images/phoneScreenshots/4.png\nfastlane/metadata/android/en-US/images/phoneScreenshots/2.png\nrelease.yml\n.PHONY: build build-fdroid sync open run releas