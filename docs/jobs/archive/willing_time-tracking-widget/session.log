{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TNKxz2tb5n2zDJBJqYn75H","type":"tool_result","content":"1\tpackage app.solyto.widget;\n2\t\n3\timport android.content.Context;\n4\timport android.content.SharedPreferences;\n5\timport java.util.ArrayList;\n6\timport java.util.Iterator;\n7\timport java.util.List;\n8\timport org.json.JSONException;\n9\timport org.json.JSONObject;\n10\t\n11\t/**\n12\t * The last payload of each widget kind and the state the widgets show, in\n13\t * private SharedPreferences excluded from backup. The state is global (token\n14\t * and server); payload, fetch time, outdated flag and action state are per\n15\t * kind, under kind-prefixed keys. {@link #clear} wipes the data.\n16\t */\n17\tpublic final class WidgetCache {\n18\t\n19\t    /** Prefs file name; the backup rules exclude {@code widget_cache.xml}. */\n20\t    static final String PREFS = \"widget_cache\";\n21\t\n22\t    public enum State { LOADING, OK, SIGNED_OUT, UNSUPPORTED_SERVER, UPDATE_APP }\n23\t\n24\t    private static final String KEY_STATE = \"state\";\n25\t    private static final String KEY_PAYLOAD = \"payload\";\n26\t    private static final String KEY_FETCHED_AT = \"fetched_at\";\n27\t    private static final String KEY_OUTDATED = \"outdated\";\n28\t    private static final String KEY_DEVICE_UNSUPPORTED = \"device_unsupported\";\n29\t    private static final String KEY_ACTION_ROWS = \"action_rows\";\n30\t    private static final String KEY_ACTION_ERROR = \"action_error\";\n31\t    private static final String[] KIND_KEYS =\n32\t            {KEY_PAYLOAD, KEY_FETCHED_AT, KEY_OUTDATED, KEY_ACTION_ROWS, KEY_ACTION_ERROR};\n33\t    // Set once the unprefixed keys of the single-kind cache are dropped.\n34\t    private static final String KEY_PER_KIND = \"per_kind\";\n35\t\n36\t    // Row ids with an action call running (value: start time), or done and waiting\n37\t    // for the re-fetch (value: minus the finish time).\n38\t    // Drops entries that are never resolved, e.g. when their work was cancelled or the re-fetch fails.\n39\t    private static final long ACTION_TTL_MS = 5 * 60_000;\n40\t\n41\t    private WidgetCache() {}\n42\t\n43\t    public static State state(Context context) {\n44\t        try {\n45\t            return State.valueOf(prefs(context).getString(KEY_STATE, State.LOADING.name()));\n46\t        } catch (IllegalArgumentException e) {\n47\t            return State.LOADING;\n48\t        }\n49\t    }\n50\t\n51\t    /** The `data` object of the last successful response, as JSON, or null. */\n52\t    static String payload(Context context, WidgetKind kind) {\n53\t        return prefs(context).getString(key(kind, KEY_PAYLOAD), null);\n54\t    }\n55\t\n56\t    static long fetchedAt(Context context, WidgetKind kind) {\n57\t        return prefs(context).getLong(key(kind, KEY_FETCHED_AT), 0);\n58\t    }\n59\t\n60\t    static boolean isOutdated(Context context, WidgetKind kind) {\n61\t        return prefs(context).getBoolean(key(kind, KEY_OUTDATED), false);\n62\t    }\n63\t\n64\t    /**\n65\t     * Whether the WebView lacks the message listener the bridge needs. Set\n66\t     * again on every app start, since a WebView update can add the feature.\n67\t     */\n68\t    static boolean isDeviceUnsupported(Context context) {\n69\t        return prefs(context).getBoolean(KEY_DEVICE_UNSUPPORTED, false);\n70\t    }\n71\t\n72\t    /**\n73\t     * Stores fresh data. Rows whose action finished now show the server's\n74\t     * state; rows with a call still running stay shown as done.\n75\t     */\n76\t    static synchronized void saveData(Context context, WidgetKind kind, String payload, long fetchedAt) {\n77\t        JSONObject rows = actionRows(context, kind);\n78\t        for (String id : keys(rows)) {\n79\t            if (rows.optLong(id) < 0) rows.remove(id);\n80\t        }\n81\t        prefs(context).edit()\n82\t                .putString(KEY_STATE, State.OK.name())\n83\t                .putString(key(kind, KEY_PAYLOAD), payload)\n84\t                .putLong(key(kind, KEY_FETCHED_AT), fetchedAt)\n85\t                .putBoolean(key(kind, KEY_OUTDATED), false)\n86\t                .putString(key(kind, KEY_ACTION_ROWS), rows.toString())\n87\t                .putBoolean(key(kind, KEY_ACTION_ERROR), false)\n88\t                .commit();\n89\t    }\n90\t\n91\t    /** Whether the row is shown as done locally: its action is running or waiting for the re-fetch. */\n92\t    static synchronized boolean isActionActive(Context context, WidgetKind kind, String id) {\n93\t        return actionRows(context, kind).has(id);\n94\t    }\n95\t\n96\t    /**\n97\t     * Marks the row's action as running and clears the error state. Returns\n98\t     * false when an action for this row is already active.\n99\t     */\n100\t    static synchronized boolean startAction(Context context, WidgetKind kind, String id) {\n101\t        JSONObject rows = actionRows(context, kind);\n102\t        if (rows.has(id)) return false;\n103\t        try {\n104\t            rows.put(id, System.currentTimeMillis());\n105\t        } catch (JSONException e) {\n106\t            return false;\n107\t        }\n108\t        prefs(context).edit()\n109\t                .putString(key(kind, KEY_ACTION_ROWS), rows.toString())\n110\t                .putBoolean(key(kind, KEY_ACTION_ERROR), false)\n111\t                .commit();\n112\t        return true;\n113\t    }\n114\t\n115\t    /** The action succeeded: the row stays shown as done until the next saved fetch. */\n116\t    static synchronized void finishAction(Context context, WidgetKind kind, String id) {\n117\t        JSONObject rows = actionRows(context, kind);\n118\t        if (!rows.has(id)) return;\n119\t        try {\n120\t            rows.put(id, -System.currentTimeMillis());\n121\t        } catch (JSONException e) {\n122\t            return;\n123\t        }\n124\t        prefs(context).edit().putString(key(kind, KEY_ACTION_ROWS), rows.toString()).commit();\n125\t    }\n126\t\n127\t    /** The action did not happen: the row shows its server state again, optionally with the error state. */\n128\t    static synchronized void revertAction(Context context, WidgetKind kind, String id, boolean showError) {\n129\t        JSONObject rows = actionRows(context, kind);\n130\t        rows.remove(id);\n131\t        SharedPreferences.Editor editor =\n132\t                prefs(context).edit().putString(key(kind, KEY_ACTION_ROWS), rows.toString());\n133\t        if (showError) editor.putBoolean(key(kind, KEY_ACTION_ERROR), true);\n134\t        editor.commit();\n135\t    }\n136\t\n137\t    static boolean hasActionError(Context context, WidgetKind kind) {\n138\t        return prefs(context).getBoolean(key(kind, KEY_ACTION_ERROR), false);\n139\t    }\n140\t\n141\t    public static void setState(Context context, State state) {\n142\t        prefs(context).edit().putString(KEY_STATE, state.name()).commit();\n143\t    }\n144\t\n145\t    static void markOutdated(Context context, WidgetKind kind) {\n146\t        prefs(context).edit().putBoolean(key(kind, KEY_OUTDATED), true).commit();\n147\t    }\n148\t\n149\t    /** Returns whether the value changed. */\n150\t    public static boolean setDeviceUnsupported(Context context, boolean unsupported) {\n151\t        if (isDeviceUnsupported(context) == unsupported) return false;\n152\t        prefs(context).edit().putBoolean(KEY_DEVICE_UNSUPPORTED, unsupported).commit();\n153\t        return true;\n154\t    }\n155\t\n156\t    /** Deletes the cached data; the widgets show the signed-out state. */\n157\t    public static synchronized void clear(Context context) {\n158\t        SharedPreferences.Editor editor = prefs(context).edit();\n159\t        for (WidgetKind kind : WidgetKind.values()) {\n160\t            for (String name : KIND_KEYS) editor.remove(key(kind, name));\n161\t        }\n162\t        editor.putString(KEY_STATE, State.SIGNED_OUT.name()).commit();\n163\t    }\n164\t\n165\t    /** The active acti