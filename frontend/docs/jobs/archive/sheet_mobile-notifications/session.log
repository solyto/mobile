9: \n50: \tdestroy(): void {\n51: \t\tthis.stopPolling();\n52: \t\tif (this.visibilityHandler) {\n53: \t\t\tdocument.removeEventListener('visibilitychange', this.visibilityHandler);\n54: \t\t\tthis.visibilityHandler = null;\n55: \t\t}\n56: \t}\n57: \n58: \tprivate stopPolling(): void {\n59: \t\tif (this.pollInterval !== null) {\n60: \t\t\tclearInterval(this.pollInterval);\n61: \t\t\tthis.pollInterval = null;\n62: \t\t}\n63: \t}\n64: \n65: \tgetUnread(): UserNotification[] {\n66: \t\treturn this.notifications.filter((n) => !n.read_at);\n67: \t}\n68: \n69: \tasync markRead(notification: UserNotification): Promise<void> {\n70: \t\tawait this.apiService.update(apiRoutes.notifications.markRead, notification.id, {});\n71: \t}\n72: \n73: \tasync markAllRead(): Promise<void> {\n74: \t\tawait this.apiService.create(apiRoutes.notifications.markAllRead, {});\n75: \t\tthis.notifications = this.notifications.map((n) => ({\n76: \t\t\t...n,\n77: \t\t\tread_at: n.read_at ?? new Date().toISOString()\n78: \t\t}));\n79: \t}\n80: }\n81: \n82: const USER_NOTIFICATIONS_KEY = Symbol('SOLYTO_USER_NOTIFICATIONS');\n83: \n84: export function setUserNotifications(): UserNotifications {\n85: \treturn setContext(USER_NOTIFICATIONS_KEY, new UserNotifications());\n86: }\n87: \n88: export function getUserNotifications(): UserNotifications {\n89: \treturn getContext<UserNotifications>(USER_NOTIFICATIONS_KEY);\n90: }\n\n(End of file - total 90 lines)\n</content>","metadata":{"preview":"import { getContext, setContext } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport ApiService from '$lib/services/ApiService';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport type { UserNotification } from '$lib/types/user_notification';\n\nconst POLL_INTERVAL_MS = 5 * 60 * 1000;\n\nexport class UserNotifications {\n\tnotifications = $state<UserNotification[]>([]);\n\tloaded = $state<boolean>(false);\n\tauth = getAuth();\n\tapiService: ApiService;\n\tprivate pollInterval: ReturnType<typeof setInterval> | null = null;\n\tprivate visibilityHandler: (() => void) | null = null;\n\n\tconstructor() {\n\t\tthis.apiService = new ApiService(this.auth.getToken());\n\t}\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/state/UserNotifications.svelte.ts","text":"import { getContext, setContext } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport ApiService from '$lib/services/ApiService';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport type { UserNotification } from '$lib/types/user_notification';\n\nconst POLL_INTERVAL_MS = 5 * 60 * 1000;\n\nexport class UserNotifications {\n\tnotifications = $state<UserNotification[]>([]);\n\tloaded = $state<boolean>(false);\n\tauth = getAuth();\n\tapiService: ApiService;\n\tprivate pollInterval: ReturnType<typeof setInterval> | null = null;\n\tprivate visibilityHandler: (() => void) | null = null;\n\n\tconstructor() {\n\t\tthis.apiService = new ApiService(this.auth.getToken());\n\t}\n\n\tasync load(): Promise<void> {\n\t\tawait this.fetch();\n\t\tthis.startPolling();\n\n\t\tthis.visibilityHandler = () => {\n\t\t\tif (document.hidden) {\n\t\t\t\tthis.stopPolling();\n\t\t\t} else {\n\t\t\t\tthis.fetch();\n\t\t\t\tthis.startPolling();\n\t\t\t}\n\t\t};\n\n\t\tdocument.addEventListener('visibilitychange', this.visibilityHandler);\n\t}\n\n\tprivate startPolling(): void {\n\t\tthis.stopPolling();\n\t\tthis.pollInterval = setInterval(() => this.fetch(), POLL_INTERVAL_MS);\n\t}\n\n\tprivate async fetch(): Promise<void> {\n\t\tconst res = await this.apiService.list(apiRoutes.notifications.list);\n\t\tif (res) {\n\t\t\tthis.notifications = res.data as UserNotification[];\n\t\t\tthis.loaded = true;\n\t\t}\n\t}\n\n\tdestroy(): void {\n\t\tthis.stopPolling();\n\t\tif (this.visibilityHandler) {\n\t\t\tdocument.removeEventListener('visibilitychange', this.visibilityHandler);\n\t\t\tthis.visibilityHandler = null;\n\t\t}\n\t}\n\n\tprivate stopPolling(): void {\n\t\tif (this.pollInterval !== null) {\n\t\t\tclearInterval(this.pollInterval);\n\t\t\tthis.pollInterval = null;\n\t\t}\n\t}\n\n\tgetUnread(): UserNotification[] {\n\t\treturn this.notifications.filter((n) => !n.read_at);\n\t}\n\n\tasync markRead(notification: UserNotification): Promise<void> {\n\t\tawait this.apiService.update(apiRoutes.notifications.markRead, notification.id, {});\n\t}\n\n\tasync markAllRead(): Promise<void> {\n\t\tawait this.apiService.create(apiRoutes.notifications.markAllRead, {});\n\t\tthis.notifications = this.notifications.map((n) => ({\n\t\t\t...n,\n\t\t\tread_at: n.read_at ?? new Date().toISOString()\n\t\t}));\n\t}\n}\n\nconst USER_NOTIFICATIONS_KEY = Symbol('SOLYTO_USER_NOTIFICATIONS');\n\nexport function setUserNotifications(): UserNotifications {\n\treturn setContext(USER_NOTIFICATIONS_KEY, new UserNotifications());\n}\n\nexport function getUserNotifications(): UserNotifications {\n\treturn getContext<UserNotifications>(USER_NOTIFICATIONS_KEY);\n}","lineStart":1,"lineEnd":90,"totalLines":90,"truncated":false}},"title":"src/lib/state/UserNotifications.svelte.ts","time":{"start":1789191852068,"end":1789191852072}},"id":"prt_094250e5b001wnIaj8w4sAL5Gp","sessionID":"ses_f6bdb1309ffeCKH5Utz6H6w7B1","messageID":"msg_0942502a400155WdgkhQODd72Y"}}
