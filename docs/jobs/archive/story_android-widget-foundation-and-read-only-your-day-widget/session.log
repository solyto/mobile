{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgWsQ8b57vHUcehEZzVMv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016oesb7xY8sEoRhXx639G7t","name":"Bash","input":{"command":"cd /workspace/android/app/src/main/java/app/solyto/widget && cat > WidgetWork.java <<'EOF'\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport androidx.work.BackoffPolicy;\nimport androidx.work.ExistingPeriodicWorkPolicy;\nimport androidx.work.ExistingWorkPolicy;\nimport androidx.work.OneTimeWorkRequest;\nimport androidx.work.PeriodicWorkRequest;\nimport androidx.work.WorkManager;\nimport java.util.concurrent.TimeUnit;\n\n/**\n * Schedules widget fetches. Work only exists while a widget is placed. No\n * input data is passed: WorkManager stores it unencrypted, so the worker reads\n * the token from {@link WidgetTokenStore}.\n */\npublic final class WidgetWork {\n\n    private static final String PERIODIC = \"widget-fetch-periodic\";\n    private static final String NOW = \"widget-fetch-now\";\n    private static final String AT_REFRESH = \"widget-fetch-at-refresh\";\n\n    private static final long PERIOD_MINUTES = 60;\n    private static final long BACKOFF_MINUTES = 5;\n    // Fetch shortly after refresh_at (the next local midnight), not right at it.\n    private static final long REFRESH_AT_DELAY_MS = 60_000;\n\n    private WidgetWork() {}\n\n    /**\n     * Keeps the periodic fetch scheduled. Keeping a periodic job pending also\n     * stops WorkManager from toggling its components when all work is done,\n     * which would make launchers send another widget update.\n     */\n    static void schedulePeriodic(Context context) {\n        PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(\n                WidgetFetchWorker.class, PERIOD_MINUTES, TimeUnit.MINUTES)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n        WorkManager.getInstance(context).enqueueUniquePeriodicWork(\n                PERIODIC, ExistingPeriodicWorkPolicy.KEEP, request);\n    }\n\n    /** A fetch as soon as possible; a newer request replaces a pending one. */\n    public static void fetchNow(Context context) {\n        if (!YourDayWidgetProvider.hasWidgets(context)) return;\n        WorkManager.getInstance(context).enqueueUniqueWork(NOW, ExistingWorkPolicy.REPLACE, oneTime(0));\n    }\n\n    /** A fetch at the payload's refresh_at (epoch millis). */\n    static void fetchAt(Context context, long refreshAt) {\n        long delay = Math.max(0, refreshAt - System.currentTimeMillis()) + REFRESH_AT_DELAY_MS;\n        WorkManager.getInstance(context).enqueueUniqueWork(\n                AT_REFRESH, ExistingWorkPolicy.REPLACE, oneTime(delay));\n    }\n\n    static void cancelAll(Context context) {\n        WorkManager workManager = WorkManager.getInstance(context);\n        workManager.cancelUniqueWork(PERIODIC);\n        workManager.cancelUniqueWork(NOW);\n        workManager.cancelUniqueWork(AT_REFRESH);\n    }\n\n    private static OneTimeWorkRequest oneTime(long delayMillis) {\n        return new OneTimeWorkRequest.Builder(WidgetFetchWorker.class)\n                .setInitialDelay(delayMillis, TimeUnit.MILLISECONDS)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n    }\n}\nEOF\ncat > WidgetFetchWorker.java <<'EOF'\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport androidx.annotation.NonNull;\nimport androidx.work.Worker;\nimport androidx.work.WorkerParameters;\n\n/** Fetches the Your Day data and applies the widget error contract. */\npublic class WidgetFetchWorker extends Worker {\n\n    // Further failures wait for the next periodic fetch.\n    private static final int MAX_RETRIES = 3;\n\n    public WidgetFetchWorker(@NonNull Context context, @NonNull WorkerParameters params) {\n        super(context, params);\n    }\n\n    @NonNull\n    @Override\n    public Result doWork() {\n        Context context = getApplicationContext();\n        if (!YourDayWidgetProvider.hasWidgets(context)) return Result.success();\n\n        String token = WidgetTokenStore.readToken(context);\n        String apiUrl = WidgetTokenStore.apiUrl(context);\n        if (token == null || apiUrl == null) {\n            WidgetCache.clear(context);\n            YourDayWidgetProvider.updateAll(context);\n            return Result.success();\n        }\n\n        WidgetApi.Result result = WidgetApi.fetchYourDay(context, apiUrl, token);\n\n        // A logout or a new token arrived during the request; its own handling wins.\n        if (!token.equals(WidgetTokenStore.readToken(context))) return Result.success();\n\n        Result workResult = Result.success();\n        switch (result.outcome) {\n            case OK:\n                if (YourDayPayload.isNewerSchema(result.data)) {\n                    WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n                    break;\n                }\n                YourDayPayload payload = YourDayPayload.parse(result.data);\n                if (payload == null) {\n                    workResult = failTemporarily(context);\n                    break;\n                }\n                WidgetCache.saveData(context, result.data.toString(), System.currentTimeMillis());\n                if (payload.refreshAt > 0) WidgetWork.fetchAt(context, payload.refreshAt);\n                break;\n            case UNAUTHORIZED:\n                WidgetTokenStore.clearIfCurrent(context, token);\n                WidgetCache.clear(context);\n                break;\n            case NOT_FOUND:\n                WidgetCache.setState(context, WidgetCache.State.UNSUPPORTED_SERVER);\n                break;\n            case UPGRADE_REQUIRED:\n                WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n                break;\n            default:\n                workResult = failTemporarily(context);\n        }\n\n        YourDayWidgetProvider.updateAll(context);\n        return workResult;\n    }\n\n    /** 429, 5xx, offline: keep the last data, mark it outdated and back off. */\n    private Result failTemporarily(Context context) {\n        WidgetCache.markOutdated(context);\n        return getRunAttemptCount() < MAX_RETRIES ? Result.retry() : Result.success();\n    }\n}\nEOF\ncd /workspace && git add -A android && git commit -qm \"Add widget fetch worker and scheduling\" && echo ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1990,"cache_read_input_tokens":79716,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1990},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"af113cdf-2a00-442d-a3a5-a4319c5fcc06","uuid":"41c9445e-1d62-440c-b08a-c52c3db88363","timestamp":"2026-10-29T16:48:27.667Z","request_id":"req_011CgWsQ8KCquMDqNLW1rXSm","wire_tool_inputs":{"toolu_016oesb7xY8sEoRhXx639G7t":{"command":"cd /workspace/android/app/src/main/java/app/solyto/widget && cat > WidgetWork.java <<'EOF'\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport androidx.work.BackoffPolicy;\nimport androidx.work.ExistingPeriodicWorkPolicy;\nimport androidx.work.ExistingWorkPolicy;\nimport androidx.work.OneTimeWorkRequest;\nimport androidx.work.PeriodicWorkRequest;\nimport androidx.work.WorkManager;\nimport java.util.concurrent.TimeUnit;\n\n/**\n * Schedules widget fetches. Work only exists while a widget is placed. No\n * input data is passed: WorkManager stores it unencrypted, so the worker reads\n * the token from {@link WidgetTokenStore}.\n */\npublic final class WidgetWork {\n\n    private static final String PERIODIC = \"widget-fetch-periodic\";\n    private static final String NOW = \"widget-fetch-now\";\n    private static final String AT_REFRESH = \"widget-fetch-at-refresh\";\n\n    private static final long PERIOD_MINUTES = 60;\n    private static final long BACKOFF_MINUTES = 5;\n    // Fetch shortly after refresh_at (the next local midnight), not right at it.\n    private static final long REFRESH_AT_DELAY_MS = 60_000;\n\n    private WidgetWork() {}\n\n    /**\n     * Keeps the periodic fetch scheduled. Keeping a periodic job pending also\n     * stops WorkManager from toggling its components when all work is done,\n     * which would make launchers send another widget update.\n     */\n    static void schedulePeriodic(Context context) {\n        PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(\n                WidgetFetchWorker.class, PERIOD_MINUTES, TimeUnit.MINUTES)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n        WorkManager.getInstance(context).enqueueUniquePeriodicWork(\n                PERIODIC, ExistingPeriodicWorkPolicy.KEEP, request);\n    }\n\n    /** A fetch as soon as possible; a newer request replaces a pending one. */\n    public static void fetchNow(Context context) {\n        if (!YourDayWidgetProvider.hasWidgets(context)) return;\n        WorkManager.getInstance(context).enqueueUniqueWork(NOW, ExistingWorkPolicy.REPLACE, oneTime(0));\n    }\n\n    /** A fetch at the payload's refresh_at (epoch millis). */\n    static void fetchAt(Context context, long refreshAt) {\n        long delay = Math.max(0, refreshAt - System.currentTimeMillis()) + REFRESH_AT_DELAY_MS;\n        WorkManager.getInstance(context).enqueueUniqueWork(\n                AT_REFRESH, ExistingWorkPolicy.REPLACE, oneTime(delay));\n    }\n\n    static void cancelAll(Context context) {\n        WorkManager workManager = WorkManager.getInstance(context);\n        workManager.cancelUniqueWork(PERIODIC);\n        workManager.cancelUniqueWork(NOW);\n        workManager.cancelUniqueWork(AT_REFRESH);\n    }\n\n    private static OneTimeWorkRequest oneTime(long delayMillis) {\n        return new OneTimeWorkRequest.Builder(WidgetFetchWorker.class)\n                .setInitialDelay(delayMillis, TimeUnit.MILLISECONDS)\n                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, BACKOFF_MINUTES, TimeUnit.MINUTES)\n                .build();\n    }\n}\nEOF\ncat > WidgetFetchWorker.java <<'EOF'\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport androidx.annotation.NonNull;\nimport androidx.work.Worker;\nimport androidx.work.WorkerParameters;\n\n/** Fetches the Your Day data and applies the widget error contract. */\npublic class WidgetFetchWorker extends Worker {\n\n    // Further failures wait for the next periodic fetch.\n    private static final int MAX_RETRIES = 3;\n\n    public WidgetFetchWorker(@NonNull Context context, @NonNull WorkerParameters params) {\n        super(context, params);\n    }\n\n    @NonNull\n    @Override\n    public Result doWork() {\n        Context context = getApplicationContext();\n        if (!YourDayWidgetProvider.hasWidgets(context)) return Result.success();\n\n        String token = WidgetTokenStore.readToken(context);\n        String apiUrl = WidgetTokenStore.apiUrl(context);\n        if (token == null || apiUrl == null) {\n            WidgetCache.clear(context);\n            YourDayWidgetProvider.updateAll(context);\n            return Result.success();\n        }\n\n        WidgetApi.Result result = WidgetApi.fetchYourDay(context, apiUrl, token);\n\n        // A logout or a new token arrived during the request; its own handling wins.\n        if (!token.equals(WidgetTokenStore.readToken(context))) return Result.success();\n\n        Result workResult = Result.success();\n        switch (result.outcome) {\n            case OK:\n                if (YourDayPayload.isNewerSchema(result.data)) {\n                    WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n                    break;\n                }\n                YourDayPayload payload = YourDayPayload.parse(result.data);\n                if (payload == null) {\n                    workResult = failTemporarily(context);\n                    break;\n                }\n                WidgetCache.saveData(context, result.data.toString(), System.currentTimeMillis());\n                if (payload.refreshAt > 0) WidgetWork.fetchAt(context, payload.refreshAt);\n                break;\n            case UNAUTHORIZED:\n                WidgetTokenStore.clearIfCurrent(context, token);\n                WidgetCache.clear(context);\n                break;\n            case NOT_FOUND:\n                WidgetCache.setState(context, WidgetCache.State.UNSUPPORTED_SERVER);\n                break;\n            case UPGRADE_REQUIRED:\n                WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n                break;\n            default:\n                workResult = failTemporarily(context);\n        }\n\n        YourDayWidgetProvider.updateAll(context);\n        return workResult;\n    }\n\n    /** 429, 5xx, offline: keep the last data, mark it outdated and back off. */\n    private Result failTemporarily(Context context) {\n        WidgetCache.markOutdated(context);\n        return getRunAttemptCount() < MAX_RETRIES ? Result.retry() : Result.success();\n    }\n}\nEOF\ncd /workspace && git add -A android && git commit -qm \"Add widget fetch worker and scheduling\" && echo ok"}}}
