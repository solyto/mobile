<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Keeps the widget token and widget data out of backups. -->
<full-backup-content>
    <exclude domain="sharedpref" path="widget_token.xml" />
    <exclude domain="sharedpref" path="widget_cache.xml" />
    <!-- Widget list rows on Android 11 and lower (androidx.core:core-remoteviews). -->
    <exclude domain="sharedpref" path="androidx.core.widget.prefs.RemoteViewsCompat.xml" />
</full-backup-content>
