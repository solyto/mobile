{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CRdidLFZB8X2WBdXUxdyPw","type":"tool_result","content":"1\tpackage app.solyto.widget;\n2\t\n3\timport java.util.ArrayList;\n4\timport java.util.Arrays;\n5\timport java.util.Collections;\n6\timport java.util.HashSet;\n7\timport java.util.List;\n8\timport java.util.Set;\n9\timport java.util.regex.Pattern;\n10\timport org.json.JSONArray;\n11\timport org.json.JSONObject;\n12\t\n13\t/**\n14\t * Widget data (schema version 1), the format all widget kinds share,\n15\t * flattened into section headers and rows. Unknown sections, icons and fields\n16\t * are ignored and malformed rows skipped. All text is display-ready from the server.\n17\t */\n18\tfinal class WidgetPayload {\n19\t\n20\t    static final int SCHEMA_VERSION = 1;\n21\t\n22\t    private static final Set<String> ICONS = new HashSet<>(Arrays.asList(\"event\", \"todo\", \"timer\"));\n23\t    private static final Set<String> BUTTON_ICONS = new HashSet<>(Arrays.asList(\"play\", \"stop\"));\n24\t    private static final Pattern COLOR = Pattern.compile(\"#[0-9A-Fa-f]{6}\");\n25\t    private static final int MAX_ROWS_PER_SECTION = 20;\n26\t    private static final int MAX_TEXT_LENGTH = 500;\n27\t\n28\t    /** Row action UI types native can render; rows with other types get no control. */\n29\t    static final String ACTION_CHECK = \"check\";\n30\t    static final String ACTION_BUTTON = \"button\";\n31\t    static final int NO_COLOR = 0;\n32\t    private static final Pattern ACTION_KEY = Pattern.compile(\"[a-z][a-z0-9_.-]*\");\n33\t    private static final int MAX_ACTION_KEY_LENGTH = 64;\n34\t    // Path-segment safe and covers the UUIDs the server sends.\n35\t    private static final Pattern ROW_ID = Pattern.compile(\"[A-Za-z0-9-]{1,64}\");\n36\t\n37\t    static final class Item {\n38\t        final boolean isHeader;\n39\t        final String title;\n40\t        final String subtitle;\n41\t        final String timeLabel;\n42\t        /** \"event\", \"todo\", \"timer\" or null. */\n43\t        final String icon;\n44\t        /** Whether the row shows the time elapsed since {@link #at}. */\n45\t        final boolean liveElapsed;\n46\t        /** Epoch millis of the row's {@code at}, or -1. */\n47\t        final long at;\n48\t        /** Opaque ARGB, or {@link #NO_COLOR}. */\n49\t        final int color;\n50\t        final String routeKey;\n51\t        final String routeId;\n52\t        /** The row id; only set together with an action. */\n53\t        final String id;\n54\t        /** A known action type ({@link #ACTION_CHECK}, {@link #ACTION_BUTTON}) or null when the row has no action. */\n55\t        final String actionType;\n56\t        final String actionKey;\n57\t        final boolean actionChecked;\n58\t        /** \"play\" or \"stop\" for button actions, else null. */\n59\t        final String actionIcon;\n60\t        /** The key of the section this header or row belongs to. */\n61\t        final String section;\n62\t\n63\t        Item(boolean isHeader, String title, String subtitle, String timeLabel, String icon,\n64\t                boolean liveElapsed, long at, int color, String routeKey, String routeId, String id,\n65\t                String actionType, String actionKey, boolean actionChecked, String actionIcon, String section) {\n66\t            this.isHeader = isHeader;\n67\t            this.title = title;\n68\t            this.subtitle = subtitle;\n69\t            this.timeLabel = timeLabel;\n70\t            this.icon = icon;\n71\t            this.liveElapsed = liveElapsed;\n72\t            this.at = at;\n73\t            this.color = color;\n74\t            this.routeKey = routeKey;\n75\t            this.routeId = routeId;\n76\t            this.id = id;\n77\t            this.actionType = actionType;\n78\t            this.actionKey = actionKey;\n79\t            this.actionChecked = actionChecked;\n80\t            this.actionIcon = actionIcon;\n81\t            this.section = section;\n82\t        }\n83\t    }\n84\t\n85\t    final String title;\n86\t    final String emptyLabel;\n87\t    final List<Item> items;\n88\t    /** Epoch millis when the data goes stale, or -1. */\n89\t    final long refreshAt;\n90\t\n91\t    private WidgetPayload(String title, String emptyLabel, List<Item> items, long refreshAt) {\n92\t        this.title = title;\n93\t        this.emptyLabel = emptyLabel;\n94\t        this.items = items;\n95\t        this.refreshAt = refreshAt;\n96\t    }\n97\t\n98\t    static boolean isValidActionKey(String key) {\n99\t        return key != null && key.length() <= MAX_ACTION_KEY_LENGTH && ACTION_KEY.matcher(key).matches();\n100\t    }\n101\t\n102\t    static boolean isValidRowId(String id) {\n103\t        return id != null && ROW_ID.matcher(id).matches();\n104\t    }\n105\t\n106\t    /** The row with this id and action, or null. */\n107\t    Item findAction(String type, String key, String id) {\n108\t        for (Item item : items) {\n109\t            if (item.actionType != null && item.actionType.equals(type)\n110\t                    && item.actionKey.equals(key) && item.id.equals(id)) {\n111\t                return item;\n112\t            }\n113\t        }\n114\t        return null;\n115\t    }\n116\t\n117\t    static boolean isNewerSchema(JSONObject data) {\n118\t        return data.optInt(\"schema_version\", SCHEMA_VERSION) > SCHEMA_VERSION;\n119\t    }\n120\t\n121\t    /** Null when the data is not a payload of this kind this version can read. */\n122\t    static WidgetPayload parse(JSONObject data, WidgetKind kind) {\n123\t        if (data == null || !kind.id.equals(data.optString(\"kind\")) || isNewerSchema(data)) return null;\n124\t\n125\t        JSONObject labels = data.optJSONObject(\"labels\");\n126\t        String title = labels != null ? text(labels, \"title\") : null;\n127\t        String emptyLabel = labels != null ? text(labels, \"empty\") : null;\n128\t\n129\t        List<Item> items = new ArrayList<>();\n130\t        JSONArray sections = data.optJSONArray(\"sections\");\n131\t        if (sections != null) {\n132\t            for (int i = 0; i < sections.length(); i++) {\n133\t                JSONObject section = sections.optJSONObject(i);\n134\t                if (section == null || !kind.sectionKeys.contains(section.optString(\"key\"))) continue;\n135\t                addSection(items, section);\n136\t            }\n137\t        }\n138\t\n139\t        return new WidgetPayload(title, emptyLabel, Collections.unmodifiableList(items),\n140\t                IsoTime.parse(data.optString(\"refresh_at\", null)));\n141\t    }\n142\t\n143\t    private static void addSection(List<Item> items, JSONObject section) {\n144\t        JSONArray rows = section.optJSONArray(\"rows\");\n145\t        if (rows == null) return;\n146\t        String sectionKey = section.optString(\"key\");\n147\t\n148\t        List<Item> sectionRows = new ArrayList<>();\n149\t        for (int i = 0; i < rows.length() && sectionRows.size() < MAX_ROWS_PER_SECTION; i++) {\n150\t            Item row = parseRow(rows.optJSONObject(i), sectionKey);\n151\t            if (row != null) sectionRows.add(row);\n152\t        }\n153\t        if (sectionRows.isEmpty()) return;\n154\t\n155\t        String sectionTitle = text(section, \"title\");\n156\t        if (sectionTitle != null) items.add(new Item(true, sectionTitle, null, null, null, false, -1, NO_COLOR,\n157\t                null, null, null, null, null, false, null, sectionKey));\n158\t        items.addAll(sectionRows);\n159\t    }\n160\t\n161\t    private static Item parseRow(JSONObject row, String sectionKey) {\n162\t        if (row == null) return null;\n163\t        String title = text(row, \"title\");\n164\t        if (title == null) return null;\n165\t\n166\t        String icon = row.optString(\"icon\", null);\n167\t        if (!ICONS.contains(icon)) icon = null;\n168\t\n169\t        String routeKey = null;\n170\t        String routeId = null;\n171\t        JSONObject route = row.optJSONObject(\"route\");\n172\t        if (route != null) {\n173\t            routeKey = text(route, \"key\");\n174\t            routeId = text(route, \"id\");\n175\t        }\n176\t\n177\t        String id = null;\n178\t        String actionType = null;\n179\t        String actionKey = null;\n180\t        boolean actionChecked = false;\n181\t        String actionIcon = null;\n182\t        JSONObject action = row.optJSONObject(\"action\");\n183\t        String rowId = text(row, \"id\");\n184\t        if (action != null && isValidRowId(rowId)) {\n185\t            String type = text(action, \"type\");\n186\t            String key = text(action, \"key\");\n187\t            if (ACTION_CHECK.equals(type) && isValidActionKey(key)) {\n188\t                id = rowId;\n189\t                actionType = type;\n190\t                actionKey = key;\n191\t                actionChecked = action.optBoolean(\"checked\", false);\n192\t            } else if (ACTION_BUTTON.equals(type) && isValidActionKey(key)\n193\t                    && BUTTON_ICONS.contains(text(action, \"icon\"))) {\n194\t                id = rowId;\n195\t                actionType = type;\n196\t                actionKey = key;\n197\t                actionIcon = text(action, \"icon\");\n198\t            }\n199\t        }\n200\t\n201\t        return new Item(false, title, text(row, \"subtitle\"), text(row, \"time_label\"), icon,\n202\t                \"elapsed\".equals(text(row, \"live\")), IsoTime.parse(text(row, \"at\")), color(text(row, \"color\")),\n203\t                routeKey, routeId, id, actionType, actionKey, actionChecked, actionIcon, sectionKey);\n204\t    }\n205\t\n206\t    /** A strict {@code #RRGGBB} as opaque ARGB, else {@link #NO_COLOR}. */\n207\t    private static int color(String value) {\n208\t        if (value == null || !COLOR.matcher(value).matches()) return NO_COLOR;\n209\t        return 0xFF000000 | Integer.parseInt(value.substring(1), 16);\n210\t    }\n211\t\n212\t    /** A non-empty string