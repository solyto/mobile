{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XzUXLSYvYYY6VVaH5ZPY3K","type":"tool_result","content":"package app.solyto.widget;\n\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.Collections;\nimport java.util.HashSet;\nimport java.util.List;\nimport java.util.Set;\nimport org.json.JSONArray;\nimport org.json.JSONObject;\n\n/**\n * The Your Day widget data (`kind: your-day`, schema version 1), flattened\n * into section headers and rows. Unknown sections, icons and fields are\n * ignored and malformed rows skipped. All text is display-ready from the server.\n */\nfinal class YourDayPayload {\n\n    static final String KIND = \"your-day\";\n    static final int SCHEMA_VERSION = 1;\n\n    private static final Set<String> SECTION_KEYS = new HashSet<>(Arrays.asList(\"today\", \"due\", \"upcoming\"));\n    private static final Set<String> ICONS = new HashSet<>(Arrays.asList(\"event\", \"todo\"));\n    private static final int MAX_ROWS_PER_SECTION = 20;\n    private static final int MAX_TEXT_LENGTH = 500;\n\n    static final class Item {\n        final boolean isHeader;\n        final String title;\n        final String subtitle;\n        final String timeLabel;\n        /** \"event\", \"todo\" or null. */\n        final String icon;\n        final String routeKey;\n        final String routeId;\n\n        Item(boolean isHeader, String title, String subtitle, String timeLabel, String icon,\n                String routeKey, String routeId) {\n            this.isHeader = isHeader;\n            this.title = title;\n            this.subtitle = subtitle;\n            this.timeLabel = timeLabel;\n            this.icon = icon;\n            this.routeKey = routeKey;\n            this.routeId = routeId;\n        }\n    }\n\n    final String title;\n    final String emptyLabel;\n    final List<Item> items;\n    /** Epoch millis when the data goes stale, or -1. */\n    final long refreshAt;\n\n    private YourDayPayload(String title, String emptyLabel, List<Item> items, long refreshAt) {\n        this.title = title;\n        this.emptyLabel = emptyLabel;\n        this.items = items;\n        this.refreshAt = refreshAt;\n    }\n\n    static boolean isNewerSchema(JSONObject data) {\n        return data.optInt(\"schema_version\", SCHEMA_VERSION) > SCHEMA_VERSION;\n    }\n\n    /** Null when the data is not a Your Day payload this version can read. */\n    static YourDayPayload parse(JSONObject data) {\n        if (data == null || !KIND.equals(data.optString(\"kind\")) || isNewerSchema(data)) return null;\n\n        JSONObject labels = data.optJSONObject(\"labels\");\n        String title = labels != null ? text(labels, \"title\") : null;\n        String emptyLabel = labels != null ? text(labels, \"empty\") : null;\n\n        List<Item> items = new ArrayList<>();\n        JSONArray sections = data.optJSONArray(\"sections\");\n        if (sections != null) {\n            for (int i = 0; i < sections.length(); i++) {\n                JSONObject section = sections.optJSONObject(i);\n                if (section == null || !SECTION_KEYS.contains(section.optString(\"key\"))) continue;\n                addSection(items, section);\n            }\n        }\n\n        return new YourDayPayload(title, emptyLabel, Collections.unmodifiableList(items),\n                IsoTime.parse(data.optString(\"refresh_at\", null)));\n    }\n\n    private static void addSection(List<Item> items, JSONObject section) {\n        JSONArray rows = section.optJSONArray(\"rows\");\n        if (rows == null) return;\n\n        List<Item> sectionRows = new ArrayList<>();\n        for (int i = 0; i < rows.length() && sectionRows.size() < MAX_ROWS_PER_SECTION; i++) {\n            Item row = parseRow(rows.optJSONObject(i));\n            if (row != null) sectionRows.add(row);\n        }\n        if (sectionRows.isEmpty()) return;\n\n        String sectionTitle = text(section, \"title\");\n        if (sectionTitle != null) items.add(new Item(true, sectionTitle, null, null, null, null, null));\n        items.addAll(sectionRows);\n    }\n\n    private static Item parseRow(JSONObject row) {\n        if (row == null) return null;\n        String title = text(row, \"title\");\n        if (title == null) return null;\n\n        String icon = row.optString(\"icon\", null);\n        if (!ICONS.contains(icon)) icon = null;\n\n        String routeKey = null;\n        String routeId = null;\n        JSONObject route = row.optJSONObject(\"route\");\n        if (route != null) {\n            routeKey = text(route, \"key\");\n            routeId = text(route, \"id\");\n        }\n\n        return new Item(false, title, text(row, \"subtitle\"), text(row, \"time_label\"), icon, routeKey, routeId);\n    }\n\n    /** A non-empty string field, cut to a sane length, or null. */\n    private static String text(JSONObject object, String name) {\n        Object value = object.opt(name);\n        if (!(value instanceof String)) return null;\n        String s = ((String) value).trim();\n        if (s.isEmpty()) return null;\n        return s.length() > MAX_TEXT_LENGTH ? s.substring(0, MAX_TEXT_LENGTH) : s;\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport android.content.pm.PackageManager;\nimport java.io.ByteArrayOutputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.net.HttpURLConnection;\nimport java.net.URL;\nimport java.nio.charset.StandardCharsets;\nimport org.json.JSONException;\nimport org.json.JSONObject;\n\n/**\n * Calls the widget routes with the widget token. Neither the token nor\n * response bodies are logged.\n */\nfinal class WidgetApi {\n\n    enum Outcome { OK, UNAUTHORIZED, NOT_FOUND, UPGRADE_REQUIRED, TEMPORARY_FAILURE }\n\n    static final class Result {\n        final Outcome outcome;\n        /** The envelope's `data` object; only set for {@link Outcome#OK}. */\n        final JSONObject data;\n\n        Result(Outcome outcome, JSONObject data) {\n            this.outcome = outcome;\n            this.data = data;\n        }\n    }\n\n    private static final String YOUR_DAY_PATH = \"/api/v1/widgets/your-day\";\n    private static final int TIMEOUT_MS = 15_000;\n    private static final int MAX_BODY_BYTES = 1024 * 1024;\n\n    private WidgetApi() {}\n\n    static Result fetchYourDay(Context context, String apiUrl, String token) {\n        HttpURLConnection connection = null;\n        try {\n            connection = (HttpURLConnection) new URL(apiUrl + YOUR_DAY_PATH).openConnection();\n            connection.setRequestMethod(\"GET\");\n            connection.setConnectTimeout(TIMEOUT_MS);\n            connection.setReadTimeout(TIMEOUT_MS);\n            connection.setUseCaches(false);\n            // A redirect could carry the token to another host.\n            connection.setInstanceFollowRedirects(false);\n            connection.setRequestProperty(\"Authorization\", \"Bearer \" + token);\n            connection.setRequestProperty(\"Accept\", \"application/json\");\n            connection.setRequestProperty(\"X-Client-Version\", appVersion(context));\n\n            int status = connection.getResponseCode();\n            if (status == 401) return new Result(Outcome.UNAUTHORIZED, null);\n            if (status == 404) return new Result(Outcome.NOT_FOUND, null);\n            if (status == 426) return new Result(Outcome.UPGRADE_REQUIRED, null);\n            if (status != 200) return new Result(Outcome.TEMPORARY_FAILURE, null);\n\n            JSONObject envelope = new JSONObject(readBody(connection.getInputStream()));\n            JSONObject data = envelope.optJSONObject(\"data\");\n            if (!envelope.optBoolean(\"success\", false) || data == null) {\n                return new Result(Outcome.TEMPORARY_FAILURE, null);\n            }\n            return new Result(Outcome.OK, data);\n        } catch (IOException | JSONException | RuntimeException e) {\n            return new Result(Outcome.TEMPORARY_FAILURE, null);\n        } finally {\n            if (connection != null) connection.disconnect();\n        }\n    }\n\n    private static String readBody(InputStream stream) throws IOException {\n        try (InputStream in = stream) {\n            ByteArrayOutputStream out = new ByteArrayOutputStream();\n            byte[] buffer = new byte[8192];\n            int read;\n            while ((read = in.read(buffer)) != -1) {\n                if (out.size() + read > MAX_BODY_BYTES) throw new IOException(\"Response too large\");\n                out.write(buffer, 0, read);\n            }\n            return new String(out.toByteArray(), StandardCharsets.UTF_8);\n        }\n    }\n\n    /** The versionName, which build-fdroid.sh sets from package.json, like the app's PUBLIC_VERSION. */\n    private static String appVersion(Context context) {\n        try {\n            String version = context.getPackageManager()\n                    .getPackageInfo(context.getPackageName(), 0).versionName;\n            return version != null ? version : \"\";\n        } catch (PackageManager.NameNotFoundException e) {\n            return \"\";\n        }\n    }\n}\npackage app.solyto.widget;\n\nimport android.content.Context;\nimport android.content.SharedPreferences;\n\n/**\n * The last widget payload and the state the widgets show, in private\n * SharedPreferences excluded from backup. {@link #clear} wipes the data.\n */\npublic final class WidgetCache {\n\n    /** Prefs file name; the backup rules exclude {@code widget_cache.xml}. */\n    static final String PREFS = \"widget_cache\";\n\n    public enum State { LOADING, OK, SIGNED_OUT, UNSUPPORTED_SERVER, UPDATE_APP }\n\n    private static final String KEY_STATE = \"state\";\n    private static final String KEY_PAYLOAD = \"payload\";\n    private static final String KEY_FETCHED_AT = \"fetched_at\";\n    private static final String KEY_OUTDATED = \"outdated\";\n    private static final String KEY_DEVICE_UNSUPPORTED = \"device_unsupported\";\n\n    private WidgetCache() {}\n\n    public static State state(Context context) {\n        try {\n            return State.valueOf(prefs(context).getString(KEY_STATE, State.LOADING.name()));\n        } catch (IllegalArgumentException e) {\n            return State.LOADING;\n        }\n    }\n\n    /** The `data` object of the last successful response, as JSON, or null. */\n    static String payload(Context context) {\n        return prefs(context).getString(KEY_PAYLOAD, null);\n    }\n\n    static long fetchedAt(Context context) {\n        return prefs(context).getLong(KEY_FETCHED_AT, 0);\n    }\n\n    static boolean isOutdated(Context context) {\n        return prefs(context).getBoolean(KEY_OUTDATED, false);\n    }\n\n    /**\n     * Whether the WebView lacks the message listener the bridge needs. Set\n     * again on every app start, since a WebView update can add the feature.\n     */\n    static boolean isDeviceUnsupported(Context context) {\n        return prefs(context).getBoolean(KEY_DEVICE_UNSUPPORTED, false);\n    }\n\n    static void saveData(Context context, String payload, long fetchedAt) {\n        prefs(context).edit()\n                .putString(KEY_STATE, State.OK.name())\n                .putString(KEY_PAYLOAD, payload)\n                .putLong(KEY_FETCHED_AT, fetchedAt)\n                .putBoolean(KEY_OUTDATED, false)\n                .commit();\n    }\n\n    public static void setState(Context context, State state) {\n        prefs(context).edit().putString(KEY_STATE, state.name()).commit();\n    }\n\n    static void markOutdated(Context context) {\n        prefs(context).edit().putBoolean(KEY_OUTDATED, true).commit();\n    }\n\n    /** Returns whether the value changed. */\n    public static boolean setDeviceUnsupported(Context context, boolean unsupported) {\n        if (isDeviceUnsupported(context) == unsupported) return false;\n        prefs(context).edit().putBoolean(KEY_DEVICE_UNSUPPORTED, unsupported).commit();\n        return