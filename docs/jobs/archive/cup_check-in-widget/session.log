ollections.unmodifiableList(items),\n                IsoTime.parse(data.optString(\"refresh_at\", null)));\n    }\n\n    private static void addSection(List<Item> items, JSONObject section) {\n        JSONArray rows = section.optJSONArray(\"rows\");\n        if (rows == null) return;\n        String sectionKey = section.optString(\"key\");\n\n        List<Item> sectionRows = new ArrayList<>();\n        for (int i = 0; i < rows.length() && sectionRows.size() < MAX_ROWS_PER_SECTION; i++) {\n            Item row = parseRow(rows.optJSONObject(i), sectionKey);\n            if (row != null) sectionRows.add(row);\n        }\n        if (sectionRows.isEmpty()) return;\n\n        String sectionTitle = text(section, \"title\");\n        if (sectionTitle != null) items.add(new Item(true, sectionTitle, null, null, null, false, -1, NO_COLOR,\n                null, null, null, null, null, false, null, sectionKey));\n        items.addAll(sectionRows);\n    }\n\n    private static Item parseRow(JSONObject row, String sectionKey) {\n        if (row == null) return null;\n        String title = text(row, \"title\");\n        if (title == null) return null;\n\n        String icon = row.optString(\"icon\", null);\n        if (!ICONS.contains(icon)) icon = null;\n\n        String routeKey = null;\n        String routeId = null;\n        JSONObject route = row.optJSONObject(\"route\");\n        if (route != null) {\n            routeKey = text(route, \"key\");\n            routeId = text(route, \"id\");\n        }\n\n        String id = null;\n        String actionType = null;\n        String actionKey = null;\n        boolean actionChecked = false;\n        String actionIcon = null;\n        JSONObject action = row.optJSONObject(\"action\");\n        String rowId = text(row, \"id\");\n        if (action != null && isValidRowId(rowId)) {\n            String type = text(action, \"type\");\n            String key = text(action, \"key\");\n            if (ACTION_CHECK.equals(type) && isValidActionKey(key)) {\n                id = rowId;\n                actionType = type;\n                actionKey = key;\n                actionChecked = action.optBoolean(\"checked\", false);\n            } else if (ACTION_BUTTON.equals(type) && isValidActionKey(key)\n                    && BUTTON_ICONS.contains(text(action, \"icon\"))) {\n                id = rowId;\n                actionType = type;\n                actionKey = key;\n                actionIcon = text(action, \"icon\");\n            }\n        }\n\n        return new Item(false, title, text(row, \"subtitle\"), text(row, \"time_label\"), icon,\n                \"elapsed\".equals(text(row, \"live\")), IsoTime.parse(text(row, \"at\")), color(text(row, \"color\")),\n                routeKey, routeId, id, actionType, actionKey, actionChecked, actionIcon, sectionKey);\n    }\n\n    /** A strict {@code #RRGGBB} as opaque ARGB, else {@link #NO_COLOR}. */\n    private static int color(String value) {\n        if (value == null || !COLOR.matcher(value).matches()) return NO_COLOR;\n        return 0xFF000000 | Integer.parseInt(value.substring(1), 16);\n    }\n\n    /** A non-empty string field, cut to a sane length, or null. */\n    private static String text(JSONObject object, String name) {\n        Object value = object.opt(name);\n        if (!(value instanceof String)) return null;\n        String s = ((String) value).trim();\n        if (s.isEmpty()) return null;\n        return s.length() > MAX_TEXT_LENGTH ? s.substring(0, MAX_TEXT_LENGTH) : s;\n    }\n}\npackage app.solyto.widget;\n\nimport android.appwidget.AppWidgetManager;\nimport android.content.ComponentName;\nimport android.content.Context;\nimport java.util.Arrays;\nimport java.util.Collections;\nimport java.util.HashSet;\nimport java.util.Set;\nimport java.util.function.Consumer;\n\n/**\n * Every widget kind native knows. A new widget is an entry here, a provider\n * with its layout, and the server's {@code /api/v1/widgets/<kind>} endpoint.\n */\npublic enum WidgetKind {\n\n    YOUR_DAY(\"your-day\", YourDayWidgetProvider.class, YourDayWidgetProvider::updateAll,\n            \"today\", \"due\", \"upcoming\"),\n    TIME_TRACKING(\"time-tracking\", TimeTrackingWidgetProvider.class, TimeTrackingWidgetProvider::updateAll,\n            \"running\", \"projects\");\n\n    private static final String PATH_PREFIX = \"/api/v1/widgets/\";\n\n    /** The payload's {@code kind} and the API path segment. */\n    final String id;\n    final String path;\n    final Class<?> provider;\n    /** The section keys the provider renders; other sections are ignored. */\n    final Set<String> sectionKeys;\n    private final Consumer<Context> render;\n\n    WidgetKind(String id, Class<?> provider, Consumer<Context> render, String... sectionKeys) {\n        this.id = id;\n        this.path = PATH_PREFIX + id;\n        this.provider = provider;\n        this.render = render;\n        this.sectionKeys = Collections.unmodifiableSet(new HashSet<>(Arrays.asList(sectionKeys)));\n    }\n\n    /** The kind with this id, or null. */\n    static WidgetKind fromId(String id) {\n        if (id == null) return null;\n        for (WidgetKind kind : values()) {\n            if (kind.id.equals(id)) return kind;\n        }\n        return null;\n    }\n\n    /** Re-renders every placed widget of every kind from the cache. */\n    public static void updateAll(Context context) {\n        for (WidgetKind kind : values()) kind.render(context);\n    }\n\n    /** Whether any widget of any kind is placed. */\n    static boolean anyPlaced(Context context) {\n        for (WidgetKind kind : values()) {\n            if (kind.hasWidgets(context)) return true;\n        }\n        return false;\n    }\n\n    boolean hasWidgets(Context context) {\n        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n        if (manager == null) return false;\n        return manager.getAppWidgetIds(new ComponentName(context, provider)).length > 0;\n    }\n\n    /** Re-renders this kind's placed widgets from the cache. */\n    void render(Context context) {\n        render.accept(context);\n    }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01VdyYrWjFLrobX9xYa8xrGT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
