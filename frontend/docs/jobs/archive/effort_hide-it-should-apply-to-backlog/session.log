medium')\n55\t\t\t);\n56\t\t}\n57\t\n58\t\tfilterByDueDate(due: TodoDueAtFilter, todos: Todo[]): Todo[] {\n59\t\t\tswitch (due) {\n60\t\t\t\tcase 'today':\n61\t\t\t\t\treturn todos.filter((t) => {\n62\t\t\t\t\t\treturn t.due_at ? isDateToday(new Date(t.due_at)) : false;\n63\t\t\t\t\t});\n64\t\t\t\tcase 'tomorrow':\n65\t\t\t\t\treturn todos.filter((t) => {\n66\t\t\t\t\t\treturn t.due_at ? isDateTomorrow(new Date(t.due_at)) : false;\n67\t\t\t\t\t});\n68\t\t\t\tcase 'week':\n69\t\t\t\t\treturn todos.filter((t) => {\n70\t\t\t\t\t\treturn t.due_at ? isDateThisWeek(new Date(t.due_at)) : false;\n71\t\t\t\t\t});\n72\t\t\t\tcase 'overdue':\n73\t\t\t\t\treturn todos.filter((t) => {\n74\t\t\t\t\t\treturn t.due_at ? isDateInThePast(new Date(t.due_at)) : false;\n75\t\t\t\t\t});\n76\t\t\t\tcase 'today-overdue':\n77\t\t\t\t\treturn todos.filter((t) => {\n78\t\t\t\t\t\treturn t.due_at\n79\t\t\t\t\t\t\t? isDateToday(new Date(t.due_at)) || isDateInThePast(new Date(t.due_at))\n80\t\t\t\t\t\t\t: false;\n81\t\t\t\t\t});\n82\t\t\t\tdefault:\n83\t\t\t\t\treturn todos;\n84\t\t\t}\n85\t\t}\n86\t\n87\t\tfilterByCategory(categoryId: number, todos: Todo[]): Todo[] {\n88\t\t\treturn todos.filter((t) => {\n89\t\t\t\tif (!t.category) return false;\n90\t\t\t\treturn t.category.id === categoryId;\n91\t\t\t});\n92\t\t}\n93\t\n94\t\tfilterByWorkspace(workspace: TodoWorkspace, todos: Todo[]): Todo[] {\n95\t\t\treturn todos.filter((t) => {\n96\t\t\t\tif (!t.category) return false;\n97\t\t\t\treturn workspace.categories.some((category) => category.id === t.category?.id);\n98\t\t\t});\n99\t\t}\n100\t\n101\t\tfilterByTag(tagId: number, todos: Todo[]): Todo[] {\n102\t\t\treturn todos.filter((t) => {\n103\t\t\t\tif (!t.tags) return false;\n104\t\t\t\treturn t.tags.some((tag) => tag.id === tagId);\n105\t\t\t});\n106\t\t}\n107\t\n108\t\tfilterByHideIt(todos: Todo[], workspaces: TodoWorkspace[]): Todo[] {\n109\t\t\treturn todos.filter((t) => {\n110\t\t\t\tif (!t.category) return true;\n111\t\t\t\tfor (const workspace of workspaces) {\n112\t\t\t\t\tif (\n113\t\t\t\t\t\tworkspace.is_hideable &&\n114\t\t\t\t\t\tworkspace.categories.some((category) => category.id === t.category?.id)\n115\t\t\t\t\t) {\n116\t\t\t\t\t\treturn false;\n117\t\t\t\t\t}\n118\t\t\t\t}\n119\t\t\t\treturn true;\n120\t\t\t});\n121\t\t}\n122\t\n123\t\tfilterCategoriesByHideIt(\n124\t\t\tcategories: TodoCategory[],\n125\t\t\tworkspaces: TodoWorkspace[]\n126\t\t): TodoCategory[] {\n127\t\t\treturn categories.filter((c) => {\n128\t\t\t\tfor (const workspace of workspaces) {\n129\t\t\t\t\tif (\n130\t\t\t\t\t\tworkspace.is_hideable &&\n131\t\t\t\t\t\tworkspace.categories.some((category) => category.id === c.id)\n132\t\t\t\t\t) {\n133\t\t\t\t\t\treturn false;\n134\t\t\t\t\t}\n135\t\t\t\t}\n136\t\t\t\treturn true;\n137\t\t\t});\n138\t\t}\n139\t}\n140\t"}]},"parent_tool_use_id":null,"session_id":"3a7f7f0d-9cdb-4c1d-aff0-7b779c16b9eb","uuid":"8f3bc43c-7dc4-4f4a-a824-53d68eeb79eb","timestamp":"2026-09-01T15:19:56.270Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/lib/services/TodoFilterService.ts","content":"import type {\n\tTodo,\n\tTodoPriority,\n\tTodoStatus,\n\tTodoEffort,\n\tTodoDueAtFilter,\n\tTodoFilter,\n\tTodoWorkspace,\n\tTodoCategory\n} from '$lib/types/todo';\nimport {\n\tisDateInThePast,\n\tisDateThisWeek,\n\tisDateToday,\n\tisDateTomorrow\n} from '$lib/helpers/DateHelper';\n\nexport default class TodoFilterService {\n\tfilter(request: TodoFilter, todos: Todo[]): Todo[] {\n\t\tswitch (request.type) {\n\t\t\tcase 'priority':\n\t\t\t\treturn this.filterByPriority(request.value as TodoPriority, todos);\n\t\t\tcase 'status':\n\t\t\t\treturn this.filterByStatus(request.value as TodoStatus, todos);\n\t\t\tcase 'effort':\n\t\t\t\treturn this.filterByEffort(request.value as TodoEffort, todos);\n\t\t\tcase 'due':\n\t\t\t\treturn this.filterByDueDate(request.value as TodoDueAtFilter, todos);\n\t\t\tcase 'category':\n\t\t\t\treturn this.filterByCategory(Number(request.value), todos);\n\t\t\tcase 'tag':\n\t\t\t\treturn this.filterByTag(Number(request.value), todos);\n\t\t\tcase 'workspace':\n\t\t\t\treturn this.filterByWorkspace(request.value as TodoWorkspace, todos);\n\t\t\tdefault:\n\t\t\t\treturn todos;\n\t\t}\n\t}\n\n\tfilterOutBacklog(todos: Todo[]): Todo[] {\n\t\treturn todos.filter((t) => t.status !== 'backlog');\n\t}\n\n\tfilterByPriority(priority: TodoPriority, todos: Todo[]): Todo[] {\n\t\treturn todos.filter((t) => t.priority === priority);\n\t}\n\n\tfilterByStatus(status: TodoStatus, todos: Todo[]): Todo[] {\n\t\treturn todos.filter((t) => t.status === status);\n\t}\n\n\tfilterByEffort(effort: TodoEffort, todos: Todo[]): Todo[] {\n\t\treturn todos.filter(\n\t\t\t(t) => t.effort === effort || (t.effort === null && effort === 'medium')\n\t\t);\n\t}\n\n\tfilterByDueDate(due: TodoDueAtFilter, todos: Todo[]): Todo[] {\n\t\tswitch (due) {\n\t\t\tcase 'today':\n\t\t\t\treturn todos.filter((t) => {\n\t\t\t\t\treturn t.due_at ? isDateToday(new Date(t.due_at)) : false;\n\t\t\t\t});\n\t\t\tcase 'tomorrow':\n\t\t\t\treturn todos.filter((t) => {\n\t\t\t\t\treturn t.due_at ? isDateTomorrow(new Date(t.due_at)) : false;\n\t\t\t\t});\n\t\t\tcase 'week':\n\t\t\t\treturn todos.filter((t) => {\n\t\t\t\t\treturn t.due_at ? isDateThisWeek(new Date(t.due_at)) : false;\n\t\t\t\t});\n\t\t\tcase 'overdue':\n\t\t\t\treturn todos.filter((t) => {\n\t\t\t\t\treturn t.due_at ? isDateInThePast(new Date(t.due_at)) : false;\n\t\t\t\t});\n\t\t\tcase 'today-overdue':\n\t\t\t\treturn todos.filter((t) => {\n\t\t\t\t\treturn t.due_at\n\t\t\t\t\t\t? isDateToday(new Date(t.due_at)) || isDateInThePast(new Date(t.due_at))\n\t\t\t\t\t\t: false;\n\t\t\t\t});\n\t\t\tdefault:\n\t\t\t\treturn todos;\n\t\t}\n\t}\n\n\tfilterByCategory(categoryId: number, todos: Todo[]): Todo[] {\n\t\treturn todos.filter((t) => {\n\t\t\tif (!t.category) return false;\n\t\t\treturn t.category.id === categoryId;\n\t\t});\n\t}\n\n\tfilterByWorkspace(workspace: TodoWorkspace, todos: Todo[]): Todo[] {\n\t\treturn todos.filter((t) => {\n\t\t\tif (!t.category) return false;\n\t\t\treturn workspace.categories.some((category) => category.id === t.category?.id);\n\t\t});\n\t}\n\n\tfilterByTag(tagId: number, todos: Todo[]): Todo[] {\n\t\treturn todos.filter((t) => {\n\t\t\tif (!t.tags) return false;\n\t\t\treturn t.tags.some((tag) => tag.id === tagId);\n\t\t});\n\t}\n\n\tfilterByHideIt(todos: Todo[], workspaces: TodoWorkspace[]): Todo[] {\n\t\treturn todos.filter((t) => {\n\t\t\tif (!t.category) return true;\n\t\t\tfor (const workspace of workspaces) {\n\t\t\t\tif (\n\t\t\t\t\tworkspace.is_hideable &&\n\t\t\t\t\tworkspace.categories.some((category) => category.id === t.category?.id)\n\t\t\t\t) {\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn true;\n\t\t});\n\t}\n\n\tfilterCategoriesByHideIt(\n\t\tcategories: TodoCategory[],\n\t\tworkspaces: TodoWorkspace[]\n\t): TodoCategory[] {\n\t\treturn categories.filter((c) => {\n\t\t\tfor (const workspace of workspaces) {\n\t\t\t\tif (\n\t\t\t\t\tworkspace.is_hideable &&\n\t\t\t\t\tworkspace.categories.some((category) => category.id === c.id)\n\t\t\t\t) {\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn true;\n\t\t});\n\t}\n}\n","numLines":140,"startLine":1,"totalLines":140}}}
