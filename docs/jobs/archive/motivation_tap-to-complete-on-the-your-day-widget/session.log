mplate, so row taps (open a route) and checkbox taps (run an action) both\n+ * arrive here. Fill-in extras come from the launcher and are untrusted.\n+ */\n+public class WidgetActionReceiver extends BroadcastReceiver {\n+\n+    static final String ACTION_ROW_TAP = \"app.solyto.action.WIDGET_ROW_TAP\";\n+    static final String EXTRA_ACTION_TYPE = \"app.solyto.extra.WIDGET_ACTION_TYPE\";\n+    static final String EXTRA_ACTION_KEY = \"app.solyto.extra.WIDGET_ACTION_KEY\";\n+    static final String EXTRA_ACTION_ID = \"app.solyto.extra.WIDGET_ACTION_ID\";\n+\n+    @Override\n+    public void onReceive(Context context, Intent intent) {\n+        if (intent == null || !ACTION_ROW_TAP.equals(intent.getAction())) return;\n+\n+        String type;\n+        String key;\n+        String id;\n+        String routeKey;\n+        String routeId;\n+        try {\n+            type = intent.getStringExtra(EXTRA_ACTION_TYPE);\n+            key = intent.getStringExtra(EXTRA_ACTION_KEY);\n+            id = intent.getStringExtra(EXTRA_ACTION_ID);\n+            routeKey = intent.getStringExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY);\n+            routeId = intent.getStringExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID);\n+        } catch (RuntimeException e) {\n+            // Malformed extras bundle.\n+            return;\n+        }\n+\n+        if (type != null) {\n+            runAction(context, type, key, id);\n+        } else if (routeKey != null) {\n+            openRoute(context, routeKey, routeId);\n+        }\n+    }\n+\n+    private static void runAction(Context context, String type, String key, String id) {\n+        if (!YourDayPayload.ACTION_CHECK.equals(type)) return;\n+        if (!YourDayPayload.isValidActionKey(key) || !YourDayPayload.isValidRowId(id)) return;\n+\n+        // Only rows the widget currently shows with this action, and not already done.\n+        if (WidgetCache.state(context) != WidgetCache.State.OK) return;\n+        YourDayPayload payload = cachedPayload(context);\n+        YourDayPayload.Item row = payload != null ? payload.findAction(type, key, id) : null;\n+        if (row == null || row.actionChecked) return;\n+\n+        // Repeated taps while a call is running are ignored.\n+        if (!WidgetCache.startAction(context, id)) return;\n+        YourDayWidgetProvider.updateAll(context);\n+        WidgetWork.runAction(context, key, id);\n+    }\n+\n+    /** MainActivity validates the route again: it is exported and gets these extras from anywhere. */\n+    private static void openRoute(Context context, String routeKey, String routeId) {\n+        Intent open = new Intent(context, MainActivity.class)\n+                .setAction(MainActivity.ACTION_WIDGET_ROUTE)\n+                .putExtra(MainActivity.EXTRA_WIDGET_ROUTE_KEY, routeKey)\n+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);\n+        if (routeId != null) open.putExtra(MainActivity.EXTRA_WIDGET_ROUTE_ID, routeId);\n+        context.startActivity(open);\n+    }\n+\n+    private static YourDayPayload cachedPayload(Context context) {\n+        String json = WidgetCache.payload(context);\n+        if (json == null) return null;\n+        try {\n+            return YourDayPayload.parse(new JSONObject(json));\n+        } catch (JSONException e) {\n+            return null;\n+        }\n+    }\n+}\ndiff --git a/android/app/src/main/java/app/solyto/widget/WidgetActionWorker.java b/android/app/src/main/java/app/solyto/widget/WidgetActionWorker.java\nnew file mode 100644\nindex 0000000..c78a430\n--- /dev/null\n+++ b/android/app/src/main/java/app/solyto/widget/WidgetActionWorker.java\n@@ -0,0 +1,68 @@\n+package app.solyto.widget;\n+\n+import android.content.Context;\n+import androidx.annotation.NonNull;\n+import androidx.work.Worker;\n+import androidx.work.WorkerParameters;\n+\n+/**\n+ * Runs one row action and applies the widget error contract. Failures are\n+ * not retried: the row is reverted and nothing is queued for later.\n+ */\n+public class WidgetActionWorker extends Worker {\n+\n+    static final String INPUT_KEY = \"key\";\n+    static final String INPUT_ID = \"id\";\n+\n+    public WidgetActionWorker(@NonNull Context context, @NonNull WorkerParameters params) {\n+        super(context, params);\n+    }\n+\n+    @NonNull\n+    @Override\n+    public Result doWork() {\n+        Context context = getApplicationContext();\n+        String key = getInputData().getString(INPUT_KEY);\n+        String id = getInputData().getString(INPUT_ID);\n+        if (!YourDayPayload.isValidActionKey(key) || !YourDayPayload.isValidRowId(id)) return Result.success();\n+\n+        String token = WidgetTokenStore.readToken(context);\n+        String apiUrl = WidgetTokenStore.apiUrl(context);\n+        if (token == null || apiUrl == null) {\n+            WidgetCache.clear(context);\n+            YourDayWidgetProvider.updateAll(context);\n+            return Result.success();\n+        }\n+\n+        WidgetApi.Outcome outcome = WidgetApi.postAction(context, apiUrl, token, key, id);\n+\n+        // A logout or a new token arrived during the request; its own handling wins.\n+        if (!token.equals(WidgetTokenStore.readToken(context))) {\n+            WidgetCache.revertAction(context, id, false);\n+            YourDayWidgetProvider.updateAll(context);\n+            return Result.success();\n+        }\n+\n+        switch (outcome) {\n+            case OK:\n+            case NOT_FOUND:\n+                // Done, or the row is gone: the re-fetch shows the server's state.\n+                WidgetCache.finishAction(context, id);\n+                WidgetWork.fetchNow(context);\n+                break;\n+            case UNAUTHORIZED:\n+                WidgetTokenStore.clearIfCurrent(context, token);\n+                WidgetCache.clear(context);\n+                break;\n+            case UPGRADE_REQUIRED:\n+                WidgetCache.revertAction(context, id, false);\n+                WidgetCache.setState(context, WidgetCache.State.UPDATE_APP);\n+                break;\n+            default:\n+                WidgetCache.revertAction(context, id, true);\n+        }\n+\n+        YourDayWidgetProvider.updateAll(context);\n+        return Result.success();\n+    }\n+}\ndiff --git a/android/app/src/main/java/app/solyto/widget/WidgetApi.java b/android/app/src/main/java/app/solyto/widget/WidgetApi.java\nindex 0ecc268..ca34605 100644\n--- a/android/app/src/main/java/app/solyto/widget/WidgetApi.java\n+++ b/android/app/src/main/java/app/solyto/widget/WidgetApi.java\n@@ -31,6 +31,7 @@ final class WidgetApi {\n     }\n \n     private static final String YOUR_DAY_PATH = \"/api/v1/widgets/your-day\";\n+    private static final String ACTIONS_PATH = \"/api/v1/widgets/actions/\";\n     private static final int TIMEOUT_MS = 15_000;\n     private static final int MAX_BODY_BYTES = 1024 * 1024;\n \n@@ -39,22 +40,11 @@ final class WidgetApi {\n     static Result fetchYourDay(Context context, String apiUrl, String token) {\n         HttpURLConnection connection = null;\n         try {\n-            connection = (HttpURLConnection) new URL(apiUrl + YOUR_DAY_PATH).openConnection();\n-            connection.setRequestMethod(\"GET\");\n-            connection.setConnectTimeout(TIMEOUT_MS);\n-            connection.setReadTimeout(TIMEOUT_MS);\n-            connection.setUseCaches(false);\n-            // A redirect could carry the token to another host.\n-            connection.setInstanceFollowRedirects(false);\n-            connection.setRequestProperty(\"Authorization\", \"Bearer \" + token);\n-            connection.setRequestProperty(\"Accept\", \"application/json\");\n-            connection.setRequestProperty(\"X-Client-Version\", appVersion(context));\n+            connection = open(context, apiUrl + YOUR_DAY_PATH, \"GET\", token);\n \n             int status = connection.getResponseCode();\n-            if (status == 401) return new Result(Outcome.UNAUTHORIZED, null);\n             if (status == 404) return new Result(Outcome.NOT_FOUND, null);\n-            if (status == 426) return new Result(Outcome.UPGRADE_REQUIRED, null);\n-            if (status != 200) return new Result(Outcome.TEMPORARY_FAILURE, null);\n+            if (status != 200) return new Result(outcome(status), null);\n \n             JSONObject envelope = new JSONObject(readBody(connection.getInputStream()));\n             JSONObject data = envelope.optJSONObject(\"data\");\n@@ -69,6 +59,54 @@ final class WidgetApi {\n         }\n     }\n \n+    /**\n+     * Runs a row action: {@code POST /widgets/actions/{key}/{id}} without a\n+     * body. 403 counts as {@link Outcome#NOT_FOUND}: the row is not the user's.\n+     */\n+    static Outcome postAction(Context context, String apiUrl, String token, String key, String id) {\n+        if (!YourDayPayload.isValidActionKey(key) || !YourDayPayload.isValidRowId(id)) {\n+            return Outcome.NOT_FOUND;\n+        }\n+        HttpURLConnection connection = null;\n+        try {\n+            connection = open(context, apiUrl + ACTIONS_PATH + key + \"/\" + id, \"POST\", token);\n+            connection.setDoOutput(true);\n+            connection.setFixedLengthStreamingMode(0);\n+            connection.getOutputStream().close();\n+\n+            int status = connection.getResponseCode();\n+            if (status == 200) return Outcome.OK;\n+            if (status == 403 || status == 404) return Outcome.NOT_FOUND;\n+            return outcome(status);\n+        } catch (IOException | RuntimeException e) {\n+            return Outcome.TEMPORARY_FAILURE;\n+        } finally {\n+            if (connection != null) connection.disconnect();\n+        }\n+    }\n+\n+    private static HttpURLConnection open(Context context, String url, String method, String token)\n+            throws IOException {\n+        HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();\n+        connection.setRequestMethod(method);\n+        connection.setConnectTimeout(TIMEOUT_MS);\n+        connection.setReadTimeout(TIMEOUT_MS);\n+        connection.setUseCaches(false);\n+        // A redirect could carry the token to another host.\n+        connection.setInstanceFollowRedirects(false);\n+        connection.setRequestProperty(\"Authorization\", \"Bearer \" + token);\n+        connection.setRequestProperty(\"Accept\", \"application/json\");\n+        connection.setRequestProperty(\"X-Client-Version\", appVersion(context));\n+        return connection;\n+    }\n+\n+    /** The outcome of a status other than 200, 403 and 404. */\n+    private static Outcome outcome(int status) {\n+        if (status == 401) return Outcome.UNAUTHORIZED;\n+        if (status == 426) return Outcome.UPGRADE_REQUIRED;\n+        return Outcome.TEMPORARY_FAILURE;\n+    }\n+\n     private static String readBody(InputStream stream) throws IOException {\n         try (InputStream in = stream) {\n             ByteArrayOutputStream out = new ByteArrayOutputStream();\ndiff --git a/android/app/src/main/java/app/solyto/widget/WidgetCache.java b/android/app/src/main/java/app/solyto/widget/WidgetCache.java\nindex 3107c56..93f4175 100644\n--- a/android/app/src/main/java/app/solyto/widget/WidgetCache.java\n+++ b/android/app/src/main/java/app/solyto/widget/WidgetCache.java\n@@ -2,6 +2,11 @@ package app.solyto.widget;\n \n import android.content.Context;\n import android.content.SharedPreferences;\n+import java.util.ArrayList;\n+import java.util.Iterator;\n+import java.util.List;\n+import org.json.JSONException;\n+import org.json.JSONObject;\n \n /**\n  * The last widget payload and the state the widgets show, in private\n@@ -19,6 +24,13 @@ public final class WidgetCache {\n     private static final String KEY_FETCHED_AT = \"fetched_at\";\n     private static final String KEY_OUTDATED = \"outdated\";\n     private static final String KEY_DEVICE_UNSUPPORTED = \"device_unsupported\";\n+    private static final String KEY_ACTION_ROWS = \"action_rows\";\n+    private static fi