{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HkEns87gUUeGQAWQj4bcqw","type":"tool_result","content":"1\tpackage app.solyto;\n2\t\n3\timport android.os.SystemClock;\n4\timport android.webkit.JavascriptInterface;\n5\timport android.webkit.WebView;\n6\timport androidx.webkit.WebViewCompat;\n7\timport androidx.webkit.WebViewFeature;\n8\timport com.getcapacitor.Logger;\n9\timport com.getcapacitor.Plugin;\n10\timport com.getcapacitor.WebViewListener;\n11\timport com.getcapacitor.annotation.CapacitorPlugin;\n12\timport java.util.Collections;\n13\t\n14\t/**\n15\t * Decides whether a pull-down gesture may start a refresh.\n16\t *\n17\t * The web app never scrolls the document itself; content scrolls inside nested\n18\t * elements, so the WebView always reports \"at top\". A small script injected\n19\t * into each page checks, on every touchstart, whether anything under the finger\n20\t * is scrolled down or is an overlay (modal, dialog, fixed sheet) or handles its\n21\t * own touch gestures, and reports the result through a JavascriptInterface.\n22\t *\n23\t * This is a Capacitor plugin only so that the JavascriptInterface is added\n24\t * during bridge setup, before the first page is loaded (interfaces added later\n25\t * only show up after the next page load).\n26\t *\n27\t * The script is registered as a document-start script, so the WebView runs it\n28\t * on every page load by itself. Capacitor's onPageLoaded is only a fallback\n29\t * for WebViews without that feature: Capacitor skips it whenever\n30\t * onPageFinished arrives before the progress reaches 100.\n31\t */\n32\t@CapacitorPlugin(name = \"PullToRefresh\")\n33\tpublic class PullToRefreshPlugin extends Plugin {\n34\t\n35\t    static final String JS_INTERFACE = \"SolytoPullToRefresh\";\n36\t\n37\t    // How long a touch waits for the page's answer before refresh is allowed\n38\t    // anyway (e.g. the page's main thread is busy or the script failed).\n39\t    private static final long JS_ANSWER_TIMEOUT_MS = 300;\n40\t\n41\t    private static final String SCRIPT = \"(function () {\"\n42\t            + \"  var bridge = window.\" + JS_INTERFACE + \";\"\n43\t            + \"  if (!bridge) return;\"\n44\t            + \"  if (window.__solytoPullToRefresh) { bridge.ready(); return; }\"\n45\t            + \"  window.__solytoPullToRefresh = true;\"\n46\t            + \"  var OVERLAY = 'dialog[open], [role=\\\"dialog\\\"], [role=\\\"alertdialog\\\"], [aria-modal=\\\"true\\\"]';\"\n47\t            + \"  function blocksPull(el) {\"\n48\t            + \"    if (window.visualViewport && window.visualViewport.scale > 1.01) return true;\"\n49\t            + \"    var root = document.scrollingElement;\"\n50\t            + \"    if (root && root.scrollTop > 0) return true;\"\n51\t            + \"    for (var n = el; n && n.nodeType === 1 && n !== document.documentElement; n = n.parentElement) {\"\n52\t            + \"      if (n.scrollTop > 0) return true;\"\n53\t            + \"      if (n.matches(OVERLAY)) return true;\"\n54\t            + \"      var s = getComputedStyle(n);\"\n55\t            + \"      if (s.position === 'fixed') return true;\"\n56\t            + \"      var ta = s.touchAction;\"\n57\t            + \"      if (ta && ta !== 'auto' && ta !== 'manipulation'\"\n58\t            + \"          && ta.indexOf('pan-y') < 0 && ta.indexOf('pan-down') < 0) return true;\"\n59\t            + \"    }\"\n60\t            + \"    return false;\"\n61\t            + \"  }\"\n62\t            + \"  var blocked = false;\"\n63\t            + \"  window.addEventListener('touchstart', function (e) {\"\n64\t            + \"    var t = e.target;\"\n65\t            + \"    if (t && t.nodeType !== 1) t = t.parentElement;\"\n66\t            + \"    try { blocked = e.touches.length > 1 || blocksPull(t); } catch (err) { blocked = true; }\"\n67\t            + \"    bridge.report(blocked);\"\n68\t            + \"  }, { capture: true, passive: true });\"\n69\t            // A page handler that calls preventDefault() on touchmove (drag and\n70\t            // drop, custom gestures) owns the gesture. Check after all\n71\t            // listeners have run.\n72\t            + \"  window.addEventListener('touchmove', function (e) {\"\n73\t            + \"    if (blocked) return;\"\n74\t            + \"    setTimeout(function () {\"\n75\t            + \"      if (e.defaultPrevented && !blocked) { blocked = true; bridge.report(true); }\"\n76\t            + \"    }, 0);\"\n77\t            + \"  }, { passive: true });\"\n78\t            + \"  bridge.ready();\"\n79\t            + \"})();\";\n80\t\n81\t    // Set once in load(), before the first page is loaded.\n82\t    private boolean documentStartScript = false;\n83\t\n84\t    // Written from the JavaBridge thread, read on the main thread.\n85\t    private volatile boolean scriptReady = false;\n86\t    private volatile boolean answered = false;\n87\t    private volatile boolean blocked = false;\n88\t\n89\t    // Main thread only.\n90\t    private long touchDownTime = 0;\n91\t\n92\t    @Override\n93\t    public void load() {\n94\t        WebView webView = getBridge().getWebView();\n95\t        webView.addJavascriptInterface(new JsInterface(), JS_INTERFACE);\n96\t        if (WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)) {\n97\t            try {\n98\t                WebViewCompat.addDocumentStartJavaScript(webView, SCRIPT,\n99\t                        Collections.singleton(getBridge().getLocalUrl()));\n100\t                documentStartScript = true;\n101\t            } catch (IllegalArgumentException e) {\n102\t                Logger.error(\"PullToRefresh: document-start script not added\", e);\n103\t            }\n104\t        }\n105\t        getBridge().addWebViewListener(new WebViewListener() {\n106\t            @Override\n107\t            public void onPageStarted(WebView view) {\n108\t                // A document-start script may already have called ready() for\n109\t                // the new page before this callback arrives, so only reset when\n110\t                // the script is injected after load.\n111\t                if (!documentStartScript) scriptReady = false;\n112\t            }\n113\t\n114\t            @Override\n115\t            public void onPageLoaded(WebView view) {\n116\t                view.evaluateJavascript(SCRIPT, null);\n117\t            }\n118\t        });\n119\t    }\n120\t\n121\t    /** Called on the main thread when a new touch sequence starts. */\n122\t    void onTouchDown() {\n123\t        answered = false;\n124\t        blocked = false;\n125\t        touchDownTime = SystemClock.uptimeMillis();\n126\t    }\n127\t\n128\t    /**\n129\t     * Whether the content under the finger can still scroll up (or otherwise\n130\t     * owns the gesture), i.e. a pull must not start a refresh.\n131\t     */\n132\t    boolean canContentScrollUp(WebView webView) {\n133\t        if (!scriptReady) {\n134\t            // No script on this page (still loading, error page): fall back to\n135\t            // the WebView's own scroll position.\n136\t            return webView.canScrollVertically(-1);\n137\t        }\n138\t        if (!answered) {\n139\t            // Wait briefly for the page's touchstart answer.\n140\t            return SystemClock.uptimeMillis() - touchDownTime < JS_ANSWER_TIMEOUT_MS;\n141\t        }\n142\t        return blocked;\n143\t    }\n144\t\n145\t    private class JsInterface {\n146\t        @JavascriptInterface\n147\t        public void ready() {\n148\t            scriptReady = true;\n149\t        }\n150\t\n151\t        @JavascriptInterface\n152\t        public void report(boolean isBlocked) {\n153\t            blocked = isBlocked;\n154\t            answered = true;\n155\t        }\n156\t    }\n157\t}\n158\t"}]},"parent_tool_use_id":null,"session_id":"0e8c61e8-895f-4f65-b097-20b0f80cb23c","uuid":"24c936a8-12c4-4270-9be8-91d20c388fa0","timestamp":"2026-10-29T16:42:49.955Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/android/app/src/main/java/app/solyto/PullToRefreshPlugin.java","content":"package app.solyto;\n\nimport android.os.SystemClock;\nimport android.webkit.JavascriptInterface;\nimport android.webkit.WebView;\nimport androidx.webkit.WebViewCompat;\nimport androidx.webkit.WebViewFeature;\nimport com.getcapacitor.Logger;\nimport com.getcapacitor.Plugin;\nimport com.getcapacitor.WebViewListener;\nimport com.getcapacitor.annotation.CapacitorPlugin;\nimport java.util.Collections;\n\n/**\n * Decides whether a pull-down gesture may start a refresh.\n *\n * The web app never scrolls the document itself; content scrolls inside nested\n * elements, so the WebView always reports \"at top\". A small script injected\n * into each page checks, on every touchstart, whether anything under the finger\n * is scrolled down or is an overlay (modal, dialog, fixed sheet) or handles its\n * own touch gestures, and reports the result through a JavascriptInterface.\n *\n * This is a Capacitor plugin only so that the JavascriptInterface is added\n * during bridge setup, before the first page is loaded (interfaces added later\n * only show up after the next page load).\n *\n * The script is registered as a document-start script, so the WebView runs it\n * on every page load by itself. Capacitor's onPageLoaded is only a fallback\n * for WebViews without that feature: Capacitor skips it whenever\n * onPageFinished arrives before the progress reaches 100.\n */\n@CapacitorPlugin(name = \"PullToRefresh\")\npublic class PullToRefreshPlugin extends Plugin {\n\n    static final String JS_INTERFACE = \"SolytoPullToRefresh\";\n\n    // How long a touch waits for the page's answer before refresh is allowed\n    // anyway (e.g. the page's main thread is busy or the script failed).\n    private static final long JS_ANSWER_TIMEOUT_MS = 300;\n\n    private static final String SCRIPT = \"(function () {\"\n            + \"  var bridge = window.\" + JS_INTERFACE + \";\"\n            + \"  if (!bridge) return;\"\n            + \"  if (window.__solytoPullToRefresh) { bridge.ready(); return; }\"\n            + \"  window.__solytoPullToRefresh = true;\"\n            + \"  var OVERLAY = 'dialog[open], [role=\\\"dialog\\\"], [role=\\\"alertdialog\\\"], [aria-modal=\\\"true\\\"]';\"\n            + \"  function blocksPull(el) {\"\n            + \"    if (window.visualViewport && window.visualViewport.scale > 1.01) return true;\"\n            + \"    var root = document.scrollingElement;\"\n            + \"    if (root && root.scrollTop > 0) return true;\"\n            + \"    for (var n = el; n && n.nodeType === 1 && n !== document.documentElement; n = n.parentElement) {\"\n            + \"      if (n.scrollTop > 0) return true;\"\n            + \"      if (n.matches(OVERLAY)) return true;\"\n            + \"      var s = getComputedStyle(n);\"\n            + \"      if (s.position === 'fixed') return true;\"\n            + \"      var ta = s.touchAction;\"\n            + \"      if (ta && ta !== 'auto' && ta !== 'manipulation'\"\n            + \"          && ta.indexOf('pan-y') < 0 && ta.indexOf('pan-down') < 0) return true;\"\n            + \"    }\"\n            + \"    return false;\"\n            + \"  }\"\n            + \"  var blocked = false;\"\n            + \"  window.addEventListener('touchstart', function (e) {\"\n            + \"    var t = e.target;\"\n            + \"    if (t && t.nodeType !== 1) t = t.parentElement;\"\n            + \"    try { blocked = e.touches.length > 1 || blocksPull(t); } catch (err) { blocked = true; }\"\n            + \"    bridge.report(blocked);\"\n            + \"  }, { capture: true, passive: true });\"\n            // A page handler that calls preventDefault() on touchmove (drag and\n            // drop, custom gestures) owns the gesture. Check after all\n            // listeners have run.\n            + \"  window.addEventListener('touchmove', function (e) {\"\n            + \"    if (blocked) return;\"\n            + \"    setTimeout(function () {\"\n            + \"      if (e.defaultPrevented && !blocked) { blocked = true; bridge.report(true); }\"\n            + \"    }, 0);\"\n            + \"  }, { passive: true });\"\n            + \"  bridge.ready();\"\n            + \"})();\";\n\n    // Set once in load(), before the first page is loaded.\n    private boolean documentStartScript = false;\n\n    // Written from the JavaBridge thread, read on the main thread.\n    private volatile boolean scriptReady = false;\n    private volatile boolean answered = false;\n    private volatile boolean blocked = false;\n\n    // Main thread only.\n    private long touchDownTime = 0;\n\n    @Override\n    public void load() {\n        WebView webView = getBridge().getWebView();\n        webView.addJavascriptInterface(new JsInterface(), JS_INTERFACE);\n        if (WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)) {\n            try {\n                WebViewCompat.addDocumentStartJavaScript(webView, SCRIPT,\n                        Collections.singleton(getBridge().getLocalUrl()));\n                documentStartScript = true;\n            } catch (IllegalArgumentException e) {\n                Logger.error(\"PullToRefresh: document-start script not added\", e);\n            }\n        }\n        getBridge().addWebViewListener(new WebViewListener() {\n            @Override\n            public void onPageStarted(WebView view) {\n                // A document-start script may already have called ready() for\n                // the new page before this callback arrives, so only reset when\n                // the script is injected after load.\n                if (!documentStartScript) scriptReady = false;\n            }\n\n            @Override\n            public void onPageLoaded(WebView view) {\n                view.evaluateJavascript(SCRIPT, null);\n            }\n        });\n    }\n\n    /** Called on the main thread when a new touch sequence starts. */\n    void onTouchDown() {\n        answered = false;\n        blocked = false;\n        touchDownTime = SystemClock.uptimeMillis();\n    }\n\n    /**\n     * Whether the content under the finger can still scroll up (or otherwise\n     * owns the gesture), i.e. a pull must not start a refresh.\n     */\n    boolean canContentScrollUp(WebView webView) {\n        if (!scriptReady) {\n            // No script on this page (still loading, error page): fall back to\n            // the WebView's own scroll position.\n            return webView.canScrollVertically(-1);\n        }\n        if (!answered) {\n            // Wait briefly for the page's touchstart answer.\n            return SystemClock.uptimeMillis() - touchDownTime < JS_ANSWER_TIMEOUT_MS;\n        }\n        return blocked;\n    }\n\n    private class JsInterface {\n        @JavascriptInterface\n        public void ready() {\n            scriptReady = true;\n        }\n\n        @JavascriptInterface\n        public void report(boolean isBlocked) {\n            blocked = isBlocked;\n            answered = true;\n        }\n    }\n}\n","numLines":158,"startLine":1,"totalLines":158}},"tool_result_meta":[{"id":"toolu_01HkEns87gUUeGQAWQj4bcqw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
