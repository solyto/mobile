<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the web app's light and dark background colors. -->
    <color name="solyto_bg_light">#FFFFFF</color>
    <color name="solyto_bg_dark">#121212</color>
    <!-- Pull-to-refresh spinner: web app surface colour (dark) and accent colours. -->
    <color name="solyto_surface_dark">#222222</color>
    <color name="solyto_lightblue">#14A5CD</color>
    <color name="solyto_green">#61D96A</color>
    <!-- Home-screen widgets; dark variants in values-night. -->
    <color name="widget_background">@color/solyto_bg_light</color>
    <color name="widget_text">#1F1F1F</color>
    <color name="widget_text_secondary">#6B6B6B</color>
    <color name="widget_divider">#E6E6E6</color>
    <color name="widget_accent">@color/solyto_lightblue</color>
</resources>
