port androidx.core.view.WindowCompat;\n import androidx.core.view.WindowInsetsControllerCompat;\n import com.getcapacitor.BridgeActivity;\n+import com.getcapacitor.WebViewListener;\n \n public class MainActivity extends BridgeActivity {\n \n+    // Safety net: hide the spinner even if no page-load callback arrives.\n+    private static final long REFRESH_TIMEOUT_MS = 15000;\n+\n+    private final Handler mainHandler = new Handler(Looper.getMainLooper());\n+    private final Runnable stopRefreshing = this::finishRefresh;\n+    // Where the spinner rests below the top of the WebView (SwipeRefreshLayout's default).\n+    private static final int REFRESH_INDICATOR_REST_DP = 64;\n+\n+    private PullToRefreshLayout swipeRefresh;\n+    private int appliedIndicatorTop = 0;\n+\n     @Override\n     protected void onCreate(Bundle savedInstanceState) {\n+        registerPlugin(PullToRefreshPlugin.class);\n         super.onCreate(savedInstanceState);\n+        setupPullToRefresh();\n         handleShareIntent(getIntent());\n         applySystemBarAppearance();\n+        styleRefreshIndicator();\n     }\n \n     @Override\n@@ -29,6 +50,114 @@ public class MainActivity extends BridgeActivity {\n     public void onConfigurationChanged(Configuration newConfig) {\n         super.onConfigurationChanged(newConfig);\n         applySystemBarAppearance();\n+        styleRefreshIndicator();\n+    }\n+\n+    /**\n+     * Wraps the Capacitor WebView in a SwipeRefreshLayout so pulling down from\n+     * the top reloads the page with the standard Material spinner.\n+     * PullToRefreshPlugin decides whether a pull may start (see there).\n+     *\n+     * The WebView is put into an intermediate FrameLayout because Capacitor's\n+     * edge-to-edge handling (\"adjustMarginsForEdgeToEdge\") insets the WebView\n+     * via its layout margins, and SwipeRefreshLayout ignores child margins.\n+     */\n+    private void setupPullToRefresh() {\n+        WebView webView = getBridge().getWebView();\n+        if (!(webView.getParent() instanceof ViewGroup)) return;\n+        ViewGroup parent = (ViewGroup) webView.getParent();\n+\n+        int index = parent.indexOfChild(webView);\n+        ViewGroup.LayoutParams webViewParams = webView.getLayoutParams();\n+        parent.removeView(webView);\n+\n+        FrameLayout container = new FrameLayout(this);\n+        container.addView(webView, webViewParams instanceof ViewGroup.MarginLayoutParams\n+                ? new FrameLayout.LayoutParams((ViewGroup.MarginLayoutParams) webViewParams)\n+                : new FrameLayout.LayoutParams(\n+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n+\n+        swipeRefresh = new PullToRefreshLayout(this);\n+        PullToRefreshPlugin gate = (PullToRefreshPlugin) getBridge()\n+                .getPlugin(\"PullToRefresh\").getInstance();\n+        swipeRefresh.setGate(new PullToRefreshLayout.Gate() {\n+            @Override\n+            public void onTouchDown() {\n+                gate.onTouchDown();\n+            }\n+\n+            @Override\n+            public boolean canContentScrollUp() {\n+                return gate.canContentScrollUp(webView);\n+            }\n+        });\n+        swipeRefresh.addView(container, new ViewGroup.LayoutParams(\n+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n+        parent.addView(swipeRefresh, index, new ViewGroup.LayoutParams(\n+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n+\n+        swipeRefresh.setOnRefreshListener(() -> {\n+            mainHandler.removeCallbacks(stopRefreshing);\n+            mainHandler.postDelayed(stopRefreshing, REFRESH_TIMEOUT_MS);\n+            webView.reload();\n+        });\n+\n+        getBridge().addWebViewListener(new WebViewListener() {\n+            @Override\n+            public void onPageLoaded(WebView view) {\n+                finishRefresh();\n+            }\n+\n+            @Override\n+            public void onReceivedError(WebView view) {\n+                finishRefresh();\n+            }\n+        });\n+\n+        // Keep the spinner below the status bar: under edge-to-edge (Android\n+        // 15+) the WebView's top margin is the status bar height.\n+        webView.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {\n+            if (t != ot) v.post(this::applyRefreshIndicatorOffset);\n+        });\n+\n+        // Re-dispatch insets so the WebView gets its edge-to-edge margins in\n+        // its new parent.\n+        ViewCompat.requestApplyInsets(swipeRefresh);\n+    }\n+\n+    private void finishRefresh() {\n+        mainHandler.removeCallbacks(stopRefreshing);\n+        if (swipeRefresh != null && swipeRefresh.isRefreshing()) {\n+            swipeRefresh.setRefreshing(false);\n+        }\n+        applyRefreshIndicatorOffset();\n+    }\n+\n+    /** Positions the spinner relative to the top of the WebView. */\n+    private void applyRefreshIndicatorOffset() {\n+        // setProgressViewOffset() resets the indicator, so never call it while\n+        // a refresh is showing; finishRefresh() calls this again afterwards.\n+        if (swipeRefresh == null || swipeRefresh.isRefreshing()) return;\n+        int top = getBridge().getWebView().getTop();\n+        if (top == appliedIndicatorTop) return;\n+        appliedIndicatorTop = top;\n+\n+        int restingDistance = Math.round(\n+                REFRESH_INDICATOR_REST_DP * getResources().getDisplayMetrics().density);\n+        swipeRefresh.setProgressViewOffset(false,\n+                top - swipeRefresh.getProgressCircleDiameter(), top + restingDistance);\n+    }\n+\n+    /** Spinner colours that follow the system light/dark mode. */\n+    private void styleRefreshIndicator() {\n+        if (swipeRefresh == null) return;\n+        boolean darkMode = (getResources().getConfiguration().uiMode\n+                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;\n+        swipeRefresh.setProgressBackgroundColorSchemeColor(ContextCompat.getColor(\n+                this, darkMode ? R.color.solyto_surface_dark : R.color.solyto_bg_light));\n+        swipeRefresh.setColorSchemeColors(\n+                ContextCompat.getColor(this, R.color.solyto_lightblue),\n+                ContextCompat.getColor(this, R.color.solyto_green));\n     }\n \n     private void handleShareIntent(Intent intent) {\ndiff --git a/android/app/src/main/java/app/solyto/PullToRefreshLayout.java b/android/app/src/main/java/app/solyto/PullToRefreshLayout.java\nnew file mode 100644\nindex 0000000..f54645f\n--- /dev/null\n+++ b/android/app/src/main/java/app/solyto/PullToRefreshLayout.java\n@@ -0,0 +1,50 @@\n+package app.solyto;\n+\n+import android.content.Context;\n+import android.view.MotionEvent;\n+import androidx.annotation.NonNull;\n+import androidx.swiperefreshlayout.widget.SwipeRefreshLayout;\n+\n+/**\n+ * SwipeRefreshLayout that tells the gate when a new touch starts.\n+ *\n+ * On ACTION_DOWN the page has not seen the touch yet, so the gate cannot know\n+ * whether a pull is allowed. The down event is always let through (so the\n+ * layout records the start position); the decision is made on the following\n+ * move events, once the page has answered.\n+ */\n+class PullToRefreshLayout extends SwipeRefreshLayout {\n+\n+    interface Gate {\n+        void onTouchDown();\n+\n+        boolean canContentScrollUp();\n+    }\n+\n+    private Gate gate;\n+    private boolean handlingDown = false;\n+\n+    PullToRefreshLayout(@NonNull Context context) {\n+        super(context);\n+        setOnChildScrollUpCallback((parent, child) ->\n+                !handlingDown && gate != null && gate.canContentScrollUp());\n+    }\n+\n+    void setGate(Gate gate) {\n+        this.gate = gate;\n+    }\n+\n+    @Override\n+    public boolean onInterceptTouchEvent(MotionEvent ev) {\n+        if (ev.getActionMasked() != MotionEvent.ACTION_DOWN) {\n+            return super.onInterceptTouchEvent(ev);\n+        }\n+        if (gate != null) gate.onTouchDown();\n+        handlingDown = true;\n+        try {\n+            return super.onInterceptTouchEvent(ev);\n+        } finally {\n+            handlingDown = false;\n+        }\n+    }\n+}\ndiff --git a/android/app/src/main/java/app/solyto/PullToRefreshPlugin.java b/android/app/src/main/java/app/solyto/PullToRefreshPlugin.java\nnew file mode 100644\nindex 0000000..43ffe05\n--- /dev/null\n+++ b/android/app/src/main/java/app/solyto/PullToRefreshPlugin.java\n@@ -0,0 +1,133 @@\n+package app.solyto;\n+\n+import android.os.SystemClock;\n+import android.webkit.JavascriptInterface;\n+import android.webkit.WebView;\n+import com.getcapacitor.Plugin;\n+import com.getcapacitor.WebViewListener;\n+import com.getcapacitor.annotation.CapacitorPlugin;\n+\n+/**\n+ * Decides whether a pull-down gesture may start a refresh.\n+ *\n+ * The web app never scrolls the document itself; content scrolls inside nested\n+ * elements, so the WebView always reports \"at top\". A small script injected\n+ * into each page checks, on every touchstart, whether anything under the finger\n+ * is scrolled down or is an overlay (modal, dialog, fixed sheet) or handles its\n+ * own touch gestures, and reports the result through a JavascriptInterface.\n+ *\n+ * This is a Capacitor plugin only so that the JavascriptInterface is added\n+ * during bridge setup, before the first page is loaded (interfaces added later\n+ * only show up after the next page load).\n+ */\n+@CapacitorPlugin(name = \"PullToRefresh\")\n+public class PullToRefreshPlugin extends Plugin {\n+\n+    static final String JS_INTERFACE = \"SolytoPullToRefresh\";\n+\n+    // How long a touch waits for the page's answer before refresh is allowed\n+    // anyway (e.g. the page's main thread is busy or the script failed).\n+    private static final long JS_ANSWER_TIMEOUT_MS = 300;\n+\n+    private static final String SCRIPT = \"(function () {\"\n+            + \"  var bridge = window.\" + JS_INTERFACE + \";\"\n+            + \"  if (!bridge) return;\"\n+            + \"  if (window.__solytoPullToRefresh) { bridge.ready(); return; }\"\n+            + \"  window.__solytoPullToRefresh = true;\"\n+            + \"  var OVERLAY = 'dialog[open], [role=\\\"dialog\\\"], [role=\\\"alertdialog\\\"], [aria-modal=\\\"true\\\"]';\"\n+            + \"  function blocksPull(el) {\"\n+            + \"    if (window.visualViewport && window.visualViewport.scale > 1.01) return true;\"\n+            + \"    var root = document.scrollingElement;\"\n+            + \"    if (root && root.scrollTop > 0) return true;\"\n+            + \"    for (var n = el; n && n.nodeType === 1 && n !== document.documentElement; n = n.parentElement) {\"\n+            + \"      if (n.scrollTop > 0) return true;\"\n+            + \"      if (n.matches(OVERLAY)) return true;\"\n+            + \"      var s = getComputedStyle(n);\"\n+            + \"      if (s.position === 'fixed') return true;\"\n+            + \"      var ta = s.touchAction;\"\n+            + \"      if (ta && ta !== 'auto' && ta !== 'manipulation'\"\n+            + \"          && ta.indexOf('pan-y') < 0 && ta.indexOf('pan-down') < 0) return true;\"\n+            + \"    }\"\n+            + \"    return false;\"\n+            + \"  }\"\n+            + \"  var blocked = false;\"\n+            + \"  window.addEventListener('touchstart', function (e) {\"\n+            + \"    var t = e.target;\"\n+            + \"    if (t && t.nodeType !== 1) t = t.parentElement;\"\n+            + \"    try { blocked = e.touches.length > 1 || blocksPull(t); } catch (err) { blocked = true; }\"\n+            + \"    bridge.report(blocked);\"\n+            + \"  }, { capture: true, passive: true });\"\n+            // A page handler that calls preventDefault() on touchmove (drag and\n+            // drop, custom gestures) owns the gesture. Check after all\n+            // listeners have run.\n+            + \"  window.addEventListener('touchmove', function (e) {\"\n+            + \"    if (blocked) return;\"\n+            + \"    setTimeout(function () {\"\n+            + \"      if (e.defaultPrevented && !blocked) { blocked = true; bridge.report(true); }\"\n+            + \"    }, 0);\"\n+            + \"  }, { passive: true });\"\n+            + \"  bridge.ready();\"\n+            + \"})();\";\n+\n+    // Written from the JavaBridge thread, read on the main thread.\n+    private volatile boolean scriptReady = false;\n+    private volatile boolean answered = false;\n+    private volatile boolean blocked = false;\n+\n+    // Main thread only.\n+    private long touchDownTime = 0;\n+\n+    @Override\n+    public void load() {\n+        WebView webView = getBridge().getWebView();\n+        webView.addJavascriptInterface(new JsInterface(), JS_INTERFACE);\n+        getBridge().addWebViewListener(new WebViewListener() {\n+            @Override\n+            public void onPageStarted(WebView view) {\n+                scriptReady = false;\n+            }\n+\n+            @Override\n+            public void onPageLoaded(WebView view) {\n+                view.evaluateJavascript(SCRIPT, null);\n+            }\n+        });\n+    }\n+\n+    /** Called on the main thread when a new touch sequence starts. */\n+    void onTouchDown() {\n+        answered = false;\n+        blocked = false;\n+        touchDownTime = SystemClock.uptimeMillis();\n+    }\n+\n+    /**\n+     * Whether the content under the finger can still scroll up (or otherwise\n+     * owns the gesture), i.e. a pull must not start a refresh.\n+     */\n+    boolean canContentScrollUp(WebView webView) {\n+        if (!scriptReady) {\n+            // No script on this page (still loading, error page): fall back to\n+            // the WebView's own scroll position.\n+            return webView.canScrollVertically(-1);\n+        }\n+        if (!answered) {\n+            // Wait briefly for the page's touchstart answer.\n+            return SystemClock.uptimeMillis() - touchDownTime < JS_ANSWER_TIMEOUT_MS;\n+        }\n+        return blocked;\n+    }\n+\n+    private class JsInterface {\n+        @JavascriptInterface\n+        public void ready() {\n+            scriptReady = true;\n+        }\n+\n+        @JavascriptInterface\n+        public void report(boolean isBlocked) {\n+            blocked = isBlocked;\n+            answered = true;\n+        }\n+    }\n+}\ndiff --git a/android/app/src/main/res/values/colors.xml b/android/app/src/main/res/values/colors.xml\nindex 8c0ff2f..92f5492 100644\n--- a/android/app/src/main/res/values/colors.xml\n+++ b/android/app/src/main/res/values/colors.xml\n@@ -3,4 +3,8 @@\n     <!-- Matches the web app's light and dark background colors. -->\n     <color name=\"solyto_bg_light\">#FFFFFF</color>\n     <color name=\"solyto_bg_dark\">#121212</color>\n+    <!-- Pull-to-refresh spinner: web app surface colour (dark) and accent colours. -->\n+    <color name=\"solyto_surface_dark\">#222222</color>\n+    <color name=\"solyto_lightblue\">#14A5CD</color>\n+    <color name=\"solyto_green\">#61D96A</color>\n </resources>\ndiff --git a/android/variables.gradle b/android/variables.gradle\nindex ee4ba41..933d22e 100644\n--- a/android/variables.gradle\n+++ b/android/variables.gradle\n@@ -9,6 +9,7 @@ ext {\n     androidxFragmentVersion = '1.8.9'\n     coreSplashScreenVersion = '1.2.0'\n     androidxWebkitVersion = '1.14.0'\n+    androidxSwipeRefreshLayoutVersion = '1.1.0'\n     junitVersion = '4.13.2'\n     androidxJunitVersion = '1.3.0'\n     androidxEspressoCoreVersion = '3.7.0'\n3:{\"type\":\"system\",\"subtype\":\"init\",\"cwd\":\"/workspace\",\"session_id\":\"1cb7cf17-d6d6-4b6e-8548-2d7e9a3a97c7\",\"tools\":[\"Read\",\"Write\",\"Edit\",\"WebFetch\",\"WebSearch\",\"Grep\",\"Glob\"],\"mcp_servers\":[{\"name\":\"context7\",\"status\":\"connected\",\"source\":\"project\"}],\"model\":\"claude-opus-5-5\",\"permissionMode\":\"bypassPermissions\",\"slas