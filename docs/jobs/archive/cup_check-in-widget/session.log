{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0141gn2YkYU1PsLMQ5ujDyGE","type":"tool_result","content":"1\tpackage app.solyto.widget;\n2\t\n3\timport android.appwidget.AppWidgetManager;\n4\timport android.content.ComponentName;\n5\timport android.content.Context;\n6\timport java.util.Arrays;\n7\timport java.util.Collections;\n8\timport java.util.HashSet;\n9\timport java.util.Set;\n10\timport java.util.function.Consumer;\n11\t\n12\t/**\n13\t * Every widget kind native knows. A new widget is an entry here, a provider\n14\t * with its layout, and the server's {@code /api/v1/widgets/<kind>} endpoint.\n15\t */\n16\tpublic enum WidgetKind {\n17\t\n18\t    YOUR_DAY(\"your-day\", YourDayWidgetProvider.class, YourDayWidgetProvider::updateAll,\n19\t            \"today\", \"due\", \"upcoming\"),\n20\t    TIME_TRACKING(\"time-tracking\", TimeTrackingWidgetProvider.class, TimeTrackingWidgetProvider::updateAll,\n21\t            \"running\", \"projects\");\n22\t\n23\t    private static final String PATH_PREFIX = \"/api/v1/widgets/\";\n24\t\n25\t    /** The payload's {@code kind} and the API path segment. */\n26\t    final String id;\n27\t    final String path;\n28\t    final Class<?> provider;\n29\t    /** The section keys the provider renders; other sections are ignored. */\n30\t    final Set<String> sectionKeys;\n31\t    private final Consumer<Context> render;\n32\t\n33\t    WidgetKind(String id, Class<?> provider, Consumer<Context> render, String... sectionKeys) {\n34\t        this.id = id;\n35\t        this.path = PATH_PREFIX + id;\n36\t        this.provider = provider;\n37\t        this.render = render;\n38\t        this.sectionKeys = Collections.unmodifiableSet(new HashSet<>(Arrays.asList(sectionKeys)));\n39\t    }\n40\t\n41\t    /** The kind with this id, or null. */\n42\t    static WidgetKind fromId(String id) {\n43\t        if (id == null) return null;\n44\t        for (WidgetKind kind : values()) {\n45\t            if (kind.id.equals(id)) return kind;\n46\t        }\n47\t        return null;\n48\t    }\n49\t\n50\t    /** Re-renders every placed widget of every kind from the cache. */\n51\t    public static void updateAll(Context context) {\n52\t        for (WidgetKind kind : values()) kind.render(context);\n53\t    }\n54\t\n55\t    /** Whether any widget of any kind is placed. */\n56\t    static boolean anyPlaced(Context context) {\n57\t        for (WidgetKind kind : values()) {\n58\t            if (kind.hasWidgets(context)) return true;\n59\t        }\n60\t        return false;\n61\t    }\n62\t\n63\t    boolean hasWidgets(Context context) {\n64\t        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n65\t        if (manager == null) return false;\n66\t        return manager.getAppWidgetIds(new ComponentName(context, provider)).length > 0;\n67\t    }\n68\t\n69\t    /** Re-renders this kind's placed widgets from the cache. */\n70\t    void render(Context context) {\n71\t        render.accept(context);\n72\t    }\n73\t}\n74\t"}]},"parent_tool_use_id":null,"session_id":"06ad74aa-1ba4-4cae-8c42-95d32284c601","uuid":"3e273d96-fab4-475a-94fb-71ef3eaccb53","timestamp":"2026-10-29T20:52:00.208Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/android/app/src/main/java/app/solyto/widget/WidgetKind.java","content":"package app.solyto.widget;\n\nimport android.appwidget.AppWidgetManager;\nimport android.content.ComponentName;\nimport android.content.Context;\nimport java.util.Arrays;\nimport java.util.Collections;\nimport java.util.HashSet;\nimport java.util.Set;\nimport java.util.function.Consumer;\n\n/**\n * Every widget kind native knows. A new widget is an entry here, a provider\n * with its layout, and the server's {@code /api/v1/widgets/<kind>} endpoint.\n */\npublic enum WidgetKind {\n\n    YOUR_DAY(\"your-day\", YourDayWidgetProvider.class, YourDayWidgetProvider::updateAll,\n            \"today\", \"due\", \"upcoming\"),\n    TIME_TRACKING(\"time-tracking\", TimeTrackingWidgetProvider.class, TimeTrackingWidgetProvider::updateAll,\n            \"running\", \"projects\");\n\n    private static final String PATH_PREFIX = \"/api/v1/widgets/\";\n\n    /** The payload's {@code kind} and the API path segment. */\n    final String id;\n    final String path;\n    final Class<?> provider;\n    /** The section keys the provider renders; other sections are ignored. */\n    final Set<String> sectionKeys;\n    private final Consumer<Context> render;\n\n    WidgetKind(String id, Class<?> provider, Consumer<Context> render, String... sectionKeys) {\n        this.id = id;\n        this.path = PATH_PREFIX + id;\n        this.provider = provider;\n        this.render = render;\n        this.sectionKeys = Collections.unmodifiableSet(new HashSet<>(Arrays.asList(sectionKeys)));\n    }\n\n    /** The kind with this id, or null. */\n    static WidgetKind fromId(String id) {\n        if (id == null) return null;\n        for (WidgetKind kind : values()) {\n            if (kind.id.equals(id)) return kind;\n        }\n        return null;\n    }\n\n    /** Re-renders every placed widget of every kind from the cache. */\n    public static void updateAll(Context context) {\n        for (WidgetKind kind : values()) kind.render(context);\n    }\n\n    /** Whether any widget of any kind is placed. */\n    static boolean anyPlaced(Context context) {\n        for (WidgetKind kind : values()) {\n            if (kind.hasWidgets(context)) return true;\n        }\n        return false;\n    }\n\n    boolean hasWidgets(Context context) {\n        AppWidgetManager manager = AppWidgetManager.getInstance(context);\n        if (manager == null) return false;\n        return manager.getAppWidgetIds(new ComponentName(context, provider)).length > 0;\n    }\n\n    /** Re-renders this kind's placed widgets from the cache. */\n    void render(Context context) {\n        render.accept(context);\n    }\n}\n","numLines":74,"startLine":1,"totalLines":74}},"tool_result_meta":[{"id":"toolu_0141gn2YkYU1PsLMQ5ujDyGE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
