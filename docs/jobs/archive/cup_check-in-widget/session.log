\t+                    actionType = type;\n603\t+                    actionKey = key;\n604\t+                    actionValue = integer(action.opt(\"value\"));\n605\t+                    options = scale;\n606\t+                }\n607\t             }\n608\t         }\n609\t \n610\t         return new Item(false, title, text(row, \"subtitle\"), text(row, \"time_label\"), icon,\n611\t                 \"elapsed\".equals(text(row, \"live\")), IsoTime.parse(text(row, \"at\")), color(text(row, \"color\")),\n612\t-                routeKey, routeId, id, actionType, actionKey, actionChecked, actionIcon, sectionKey);\n613\t+                routeKey, routeId, id, actionType, actionKey, actionChecked, actionIcon, actionValue, options, sectionKey);\n614\t+    }\n615\t+\n616\t+    /** The valid options, at most {@link #MAX_OPTIONS}; options with an unknown icon or invalid color or value are skipped. */\n617\t+    private static List<Option> options(JSONArray array) {\n618\t+        if (array == null) return Collections.emptyList();\n619\t+        List<Option> options = new ArrayList<>();\n620\t+        for (int i = 0; i < array.length() && options.size() < MAX_OPTIONS; i++) {\n621\t+            JSONObject option = array.optJSONObject(i);\n622\t+            if (option == null) continue;\n623\t+            Integer value = integer(option.opt(\"value\"));\n624\t+            String icon = text(option, \"icon\");\n625\t+            int color = color(text(option, \"color\"));\n626\t+            if (value == null || !OPTION_ICONS.contains(icon) || color == NO_COLOR) continue;\n627\t+            options.add(new Option(value, icon, color));\n628\t+        }\n629\t+        return Collections.unmodifiableList(options);\n630\t+    }\n631\t+\n632\t+    /** A JSON integer that fits an int, else null. */\n633\t+    private static Integer integer(Object value) {\n634\t+        if (value instanceof Integer) return (Integer) value;\n635\t+        if (value instanceof Long) {\n636\t+            long l = (Long) value;\n637\t+            if (l >= Integer.MIN_VALUE && l <= Integer.MAX_VALUE) return (int) l;\n638\t+        }\n639\t+        return null;\n640\t     }\n641\t \n642\t     /** A strict {@code #RRGGBB} as opaque ARGB, else {@link #NO_COLOR}. */\n643\tdiff --git a/android/app/src/main/java/app/solyto/widget/WidgetWork.java b/android/app/src/main/java/app/solyto/widget/WidgetWork.java\n644\tindex b57ad96..3cb1a6f 100644\n645\t--- a/android/app/src/main/java/app/solyto/widget/WidgetWork.java\n646\t+++ b/android/app/src/main/java/app/solyto/widget/WidgetWork.java\n647\t@@ -61,13 +61,27 @@ public final class WidgetWork {\n648\t \n649\t     /** Runs a row action once; while one is enqueued or running for this row, further requests are ignored. */\n650\t     static void runAction(Context context, WidgetKind kind, String key, String id) {\n651\t+        enqueueAction(context, kind, id, actionInput(kind, key, id));\n652\t+    }\n653\t+\n654\t+    /** Like {@link #runAction(Context, WidgetKind, String, String)}, sending the target value (null clears). */\n655\t+    static void runAction(Context context, WidgetKind kind, String key, String id, Integer value) {\n656\t+        Data.Builder input = actionInput(kind, key, id).putBoolean(WidgetActionWorker.INPUT_HAS_VALUE, true);\n657\t+        if (value != null) input.putInt(WidgetActionWorker.INPUT_VALUE, value);\n658\t+        enqueueAction(context, kind, id, input);\n659\t+    }\n660\t+\n661\t+    private static Data.Builder actionInput(WidgetKind kind, String key, String id) {\n662\t+        return new Data.Builder()\n663\t+                .putString(WidgetActionWorker.INPUT_KIND, kind.id)\n664\t+                .putString(WidgetActionWorker.INPUT_KEY, key)\n665\t+                .putString(WidgetActionWorker.INPUT_ID, id);\n666\t+    }\n667\t+\n668\t+    private static void enqueueAction(Context context, WidgetKind kind, String id, Data.Builder input) {\n669\t         OneTimeWorkRequest.Builder builder = new OneTime