{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012aNMt3vGj9ZT61Q3EYr4Tw","type":"tool_result","content":"1\tpackage app.solyto;\n2\t\n3\timport android.content.Intent;\n4\timport android.content.res.Configuration;\n5\timport android.graphics.drawable.ColorDrawable;\n6\timport android.os.Build;\n7\timport android.os.Bundle;\n8\timport android.os.Handler;\n9\timport android.os.Looper;\n10\timport android.view.ViewGroup;\n11\timport android.webkit.WebView;\n12\timport android.widget.FrameLayout;\n13\timport androidx.core.content.ContextCompat;\n14\timport androidx.core.view.ViewCompat;\n15\timport androidx.core.view.WindowCompat;\n16\timport androidx.core.view.WindowInsetsControllerCompat;\n17\timport com.getcapacitor.BridgeActivity;\n18\timport com.getcapacitor.WebViewListener;\n19\t\n20\tpublic class MainActivity extends BridgeActivity {\n21\t\n22\t    // Safety net: hide the spinner even if no page-load callback arrives.\n23\t    private static final long REFRESH_TIMEOUT_MS = 15000;\n24\t\n25\t    private final Handler mainHandler = new Handler(Looper.getMainLooper());\n26\t    private final Runnable stopRefreshing = this::finishRefresh;\n27\t    // Where the spinner rests below the top of the WebView (SwipeRefreshLayout's default).\n28\t    private static final int REFRESH_INDICATOR_REST_DP = 64;\n29\t\n30\t    private PullToRefreshLayout swipeRefresh;\n31\t    private int appliedIndicatorTop = 0;\n32\t\n33\t    @Override\n34\t    protected void onCreate(Bundle savedInstanceState) {\n35\t        registerPlugin(PullToRefreshPlugin.class);\n36\t        super.onCreate(savedInstanceState);\n37\t        setupPullToRefresh();\n38\t        handleShareIntent(getIntent());\n39\t        applySystemBarAppearance();\n40\t        styleRefreshIndicator();\n41\t    }\n42\t\n43\t    @Override\n44\t    protected void onNewIntent(Intent intent) {\n45\t        super.onNewIntent(intent);\n46\t        handleShareIntent(intent);\n47\t    }\n48\t\n49\t    @Override\n50\t    public void onConfigurationChanged(Configuration newConfig) {\n51\t        super.onConfigurationChanged(newConfig);\n52\t        applySystemBarAppearance();\n53\t        styleRefreshIndicator();\n54\t    }\n55\t\n56\t    /**\n57\t     * Wraps the Capacitor WebView in a SwipeRefreshLayout so pulling down from\n58\t     * the top reloads the page with the standard Material spinner.\n59\t     * PullToRefreshPlugin decides whether a pull may start (see there).\n60\t     *\n61\t     * The WebView is put into an intermediate FrameLayout because Capacitor's\n62\t     * edge-to-edge handling (\"adjustMarginsForEdgeToEdge\") insets the WebView\n63\t     * via its layout margins, and SwipeRefreshLayout ignores child margins.\n64\t     */\n65\t    private void setupPullToRefresh() {\n66\t        WebView webView = getBridge().getWebView();\n67\t        if (!(webView.getParent() instanceof ViewGroup)) return;\n68\t        ViewGroup parent = (ViewGroup) webView.getParent();\n69\t\n70\t        int index = parent.indexOfChild(webView);\n71\t        ViewGroup.LayoutParams webViewParams = webView.getLayoutParams();\n72\t        parent.removeView(webView);\n73\t\n74\t        FrameLayout container = new FrameLayout(this);\n75\t        container.addView(webView, webViewParams instanceof ViewGroup.MarginLayoutParams\n76\t                ? new FrameLayout.LayoutParams((ViewGroup.MarginLayoutParams) webViewParams)\n77\t                : new FrameLayout.LayoutParams(\n78\t                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n79\t\n80\t        swipeRefresh = new PullToRefreshLayout(this);\n81\t        PullToRefreshPlugin gate = (PullToRefreshPlugin) getBridge()\n82\t                .getPlugin(\"PullToRefresh\").getInstance();\n83\t        swipeRefresh.setGate(new PullToRefreshLayout.Gate() {\n84\t            @Override\n85\t            public void onTouchDown() {\n86\t                gate.onTouchDown();\n87\t            }\n88\t\n89\t            @Override\n90\t            public boolean canContentScrollUp() {\n91\t                return gate.canContentScrollUp(webView);\n92\t            }\n93\t        });\n94\t        swipeRefresh.addView(container, new ViewGroup.LayoutParams(\n95\t                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n96\t        parent.addView(swipeRefresh, index, new ViewGroup.LayoutParams(\n97\t                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));\n98\t\n99\t        swipeRefresh.setOnRefreshListener(() -> {\n100\t            mainHandler.removeCallbacks(stopRefreshing);\n101\t            mainHandler.postDelayed(stopRefreshing, REFRESH_TIMEOUT_MS);\n102\t            webView.reload();\n103\t        });\n104\t\n105\t        getBridge().addWebViewListener(new WebViewListener() {\n106\t            @Override\n107\t            public void onPageLoaded(WebView view) {\n108\t                finishRefresh();\n109\t            }\n110\t\n111\t            @Override\n112\t            public void onReceivedError(WebView view) {\n113\t                finishRefresh();\n114\t            }\n115\t        });\n116\t\n117\t        // Keep the spinner below the status bar: under edge-to-edge (Android\n118\t        // 15+) the WebView's top margin is the status bar height.\n119\t        webView.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {\n120\t            if (t != ot) v.post(this::applyRefreshIndicatorOffset);\n121\t        });\n122\t\n123\t        // Re-dispatch insets so the WebView gets its edge-to-edge margins in\n124\t        // its new parent.\n125\t        ViewCompat.requestApplyInsets(swipeRefresh);\n126\t    }\n127\t\n128\t    private void finishRefresh() {\n129\t        mainHandler.removeCallbacks(stopRefreshing);\n130\t        if (swipeRefresh != null && swipeRefresh.isRefreshing()) {\n131\t            swipeRefresh.setRefreshing(false);\n132\t        }\n133\t        applyRefreshIndicatorOffset();\n134\t    }\n135\t\n136\t    /** Positions the spinner relative to the top of the WebView. */\n137\t    private void applyRefreshIndicatorOffset() {\n138\t        // setProgressViewOffset() resets the indicator, so never call it while\n139\t        // a refresh is showing; finishRefresh() calls this again afterwards.\n140\t        if (swipeRefresh == null || swipeRefresh.isRefreshing()) return;\n141\t        int top = getBridge().getWebView().getTop();\n142\t        if (top == appliedIndicatorTop) return;\n143\t        appliedIndicatorTop = top;\n144\t\n145\t        int restingDistance = Math.round(\n146\t                REFRESH_INDICATOR_REST_DP * getResources().getDisplayMetrics().density);\n147\t        swipeRefresh.setProgressViewOffset(false,\n148\t                top - swipeRefresh.getProgressCircleDiameter(), top + restingDistance);\n149\t    }\n150\t\n151\t    /** Spinner colours that follow the system light/dark mode. */\n152\t    private void styleRefreshIndicator() {\n153\t        if (swipeRefresh == null) return;\n154\t        boolean darkMode = (getResources().getConfiguration().uiMode\n155\t                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;\n156\t        swipeRefresh.setProgressBackgroundColorSchemeColor(ContextCompat.getColor(\n157\t                this, darkMode ? R.color.solyto_surface_dark : R.color.solyto_bg_light));\n158\t        swipeRefresh.setColorSchemeColors(\n159\t                ContextCompat.getColor(this, R.color.solyto_lightblue),\n160\t                ContextCompat.getColor(this, R.color.solyto_green));\n161\t    }\n162\t\n163\t    private void handleShareIntent(Intent intent) {\n164\t        if (intent == null) return;\n165\t        if (!Intent.ACTION_SEND.equals(intent.getAction())) return;\n166\t        if (!\"text/plain\".equals(intent.getType())) return;\n167\t\n168\t        String sharedText = intent.getStringExtra(Intent.EXTRA_TEXT);\n169\t        if (sharedText == null || sharedText.isEmpt